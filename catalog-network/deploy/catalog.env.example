# /etc/koha-nexus-catalog/catalog.env (root:nexus-catalog, 0640). All optional.
# The unit sets the address (127.0.0.1:8088), the database
# (/var/lib/koha-nexus-catalog/catalog.db) and the tokens file; a value set
# here wins over the unit's (systemd reads this file last), e.g.
# NEXUS_CATALOG_PORT=8089 when 8088 is taken.

# Records per SRU page at most (Koha asks for 20 at a time).
NEXUS_CATALOG_MAX_RECORDS=50
# One sync request: bytes and records at most.
NEXUS_CATALOG_MAX_BODY=20000000
NEXUS_CATALOG_MAX_SYNC_RECORDS=1000
# The name in the SRU explain record.
NEXUS_CATALOG_TITLE="Rede koha.nexus (Catalogação Compartilhada)"
NEXUS_CATALOG_LOG_LEVEL=INFO
