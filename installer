MAX_STRUCTURED = 512 << 20


def _flat_value(v):
    if v is None:
        return ""
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, (list, tuple)):
        return "; ".join(x for x in (_flat_value(i) for i in v) if x)
    if isinstance(v, dict):
        return "; ".join(x for x in (_flat_value(i) for i in v.values()) if x)
    return str(v)


def _flat_object(obj, prefix="", depth=0):
    """{"autor": {"nome": "X"}} -> {"autor.nome": "X"}; lists of values
    joined with '; '."""
    out = {}
    for k, v in obj.items():
        key = prefix + str(k)
        if isinstance(v, dict) and depth < 2:
            out.update(_flat_object(v, key + ".", depth + 1))
        else:
            out[key] = _flat_value(v)
    return out


def _keyed_table(name, objects, enc, fmt):
    """A table from records with named fields: the names are the header."""
    flat = [_flat_object(o) for o in objects[:MAX_ROWS]]
    headers = list(OrderedDict((k, None) for f in flat for k in f))
    t = Table(name, [headers] + [[f.get(h, "") for h in headers] for f in flat], enc, fmt)
    t.headers = t.rows[0] if t.rows else []
    t.header_row = True
    return t


def _record_lists(data, where="", depth=0):
    """(where, [objects]) for every list of objects in a JSON document."""
    if isinstance(data, list):
        objs = [x for x in data if isinstance(x, dict)]
        if objs and len(objs) >= 0.8 * len(data):
            yield where, objs
    elif isinstance(data, dict) and depth < 4:
        for k, v in data.items():
            yield from _record_lists(v, (where + "." if where else "") + str(k), depth + 1)


def read_json(path, name):
    """A JSON export: every list of objects is a table, its keys the
    columns. JSON Lines (one object per line) too."""
    if os.path.getsize(path) > MAX_STRUCTURED:
        raise ValueError("JSON larger than 512 MB")
    with open(path, "rb") as fh:
        text, enc = R.decode_text(fh.read())
    try:
        data = json.loads(text)
    except ValueError:
        data = [json.loads(line) for line in text.splitlines() if line.strip()]
    if isinstance(data, dict) and not any(isinstance(v, (list, dict)) for v in data.values()):
        data = [data]
    return [_keyed_table("%s: %s" % (name, where) if where else name, objs, enc, "JSON")
            for where, objs in _record_lists(data)]


def _local(tag):
    return tag.split("}")[-1] if isinstance(tag, str) else ""


def _xml_text(el):
    return R.clean("".join(el.itertext()))


def _xml_record(el):
    """One element as a row: its attributes, its child elements and, one
    level down, their children ("autor.nome"); repeated ones joined."""
    row = OrderedDict()

    def put(key, value):
        if value:
            row[key] = row[key] + "; " + value if row.get(key) else value
    for k, v in el.attrib.items():
        put(_local(k), R.clean(v))
    for child in el:
        key = _local(child.tag)
        for k, v in child.attrib.items():
            put(key + "." + _local(k), R.clean(v))
        if len(child):
            for g in child:
                put(key + "." + _local(g.tag), _xml_text(g))
        else:
            put(key, _xml_text(child))
    return row


def read_xml(path, name):
    """An XML export (not MARCXML): each group of repeated elements with
    fields of their own (<livro>...</livro> <livro>...</livro>) is a table."""
    if os.path.getsize(path) > MAX_STRUCTURED:
        raise ValueError("XML larger than 512 MB")
    with open(path, "rb") as fh:
        data = fh.read()
    if re.search(rb"<!(DOCTYPE[^>]*\[|ENTITY)", data[:65536]):
        raise ValueError("XML with entity declarations is not read")
    enc = (re.match(rb'\s*<\?xml[^>]*encoding=["\']([\w.-]+)', data) or [None, b"UTF-8"])[1].decode("ascii").upper()
    try:
        root = ET.fromstring(data)
    except ET.ParseError:
        # No or wrong declaration: the bytes are read like a text file.
        text, enc = R.decode_text(data)
        root = ET.fromstring(re.sub(r"^\s*<\?xml[^>]*\?>", "", text).encode("utf-8"))
    found = []

    def walk(el, where, depth):
        groups = OrderedDict()
        for child in el:
            groups.setdefault(_local(child.tag), []).append(child)
        for tag, kids in groups.items():
            fields = [k for k in kids if len(k) or k.attrib]
            if len(kids) >= 2 and len(fields) >= 0.8 * len(kids):
                found.append((tag, kids))
            elif depth < 6:
                for k in kids:
                    walk(k, where + "/" + tag, depth + 1)
    walk(root, "", 0)
    if not found and len(root):
        found.append((_local(root.tag), [root]))
    return [_keyed_table("%s: %s" % (name, tag), [_xml_record(k) for k in kids], enc, "XML") for tag, kids in found]
