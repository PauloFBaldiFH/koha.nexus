class TablePlan:
    def __init__(self, member, table, columns, entity, evidence, how):
        self.member = member
        self.table = table
        self.columns = columns
        self.entity = entity        # biblio | patrons | mixed | koha_patrons | circulation | skip | None
        self.evidence = evidence
        self.how = how              # detected | answered | profile
        self.asked = False


class MarcPlan:
    def __init__(self, member, kind, info):
        self.member = member
        self.kind = kind
        self.info = info
        self.route = "stage"        # stage | legacy
        self.encoding = info.get("encoding", "UTF-8")
        self.item_tag = info.get("item_tag")
        self.item_map = info.get("item_map", "")
        self.callnumber = info.get("callnumber", holdings.CALLNUMBER)


class Analysis:
    def __init__(self):
        self.detections = []
        self.tables = []
        self.marcs = []
        self.readers = []
        self.koha_backups = []
        self.unsupported = []
        self.needs = set()
        self.questions = None
        self.intake = None
        self.isbn_answer = "apart"
        self.koha = {}              # branch | itemtype | location -> {normalised code or name: code}


