# ======================================================================
# 3. RESTORE DATABASE
# ======================================================================
drop_trial_db() {
    [ -n "$RESTORE_TRIAL_DB" ] && mysql -e "DROP DATABASE IF EXISTS \`${RESTORE_TRIAL_DB}\`;" >/dev/null 2>&1
    RESTORE_TRIAL_DB=""
}

# Ends a restore that did not touch the live catalog.
restore_release() {
    drop_trial_db
    maintenance_end
    backup_lock_release
}

# Puts the previous catalog back from the safety copy after a failed restore.
# Succeeds only when the previous catalog is complete again.
restore_rollback() {
    local rescue="$1" errlog="$2"
    [ -n "$rescue" ] && [ -f "$rescue" ] || return 1
    mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$errlog" \
        && import_sql_file "$rescue" "$DB_NAME" "$errlog" \
        && [ -z "$(koha_schema_missing "$DB_NAME")" ] \
        && ensure_db_grants
}

# A restore failed after the live catalog was touched ($1 = stage: recreate,
# import or schema): puts the previous catalog back when possible, restarts
# every service (indexer included) and only then explains what happened.
restore_failed() {
    local stage="$1" rescue="$2" errlog="$3" details outcome
    details=$(grep -v "^=====" "$errlog" 2>/dev/null | tail -n 6 | cut -c1-76)
    [ "$stage" = "schema" ] && details=$(tail -n 6 "${LOG_DIR}/schema-upgrade.log" 2>/dev/null | cut -c1-76)
    if [ "$stage" = "recreate" ] && [ -z "$(koha_schema_missing "$DB_NAME")" ]; then
        outcome="intact"            # DROP failed: the previous catalog is still there
    elif [ -z "$rescue" ] && [ "$stage" = "schema" ]; then
        outcome="kept"              # nothing to go back to: keep it for diagnosis
    elif [ -z "$rescue" ]; then
        outcome="empty"             # the database was empty before the restore
    elif tui_run "$(t "Putting the previous catalog back")" restore_rollback "$rescue" "$errlog"; then
        outcome="rolled-back"
    else
        outcome="lost"
    fi
    log "restore failed at '${stage}': ${outcome} (safety copy: ${rescue:-none})"
    tui_run "$(t "Restarting Koha services")" resume_koha_services
    unshield_signals
    maintenance_end
    backup_lock_release
    case "$outcome" in
        intact)      msg_error "" "$(t 'Could not recreate the database.\n\n${details}')" 14 80 ;;
        kept)        msg_error "" "$(t "Schema migration failed. The imported database was preserved for diagnosis.")" 11 78 ;;
        empty)       msg_error "" "$(t 'The backup could not be imported. Nothing was changed in the current catalog.\n\nLast error lines:\n${details}')" 18 80 ;;
        rolled-back) msg_error "" "$(t 'The import failed. The previous catalog was restored from the safety backup.\n\nLast error lines:\n${details}')" 18 80 ;;
        *)           msg_error "" "$(t 'The import failed and the safety backup could not be restored automatically.\nRestore it with option 3: ${rescue}\n\nLast error lines:\n${details}')" 18 80 ;;
    esac
}

# Search engine for a restored catalog: the one this server was running
# ($1; its services are installed and tuned), else the one in the backup.
# An Elasticsearch that does not answer here falls back to Zebra, which
# every Koha installation has.
restored_search_engine() {
    local engine="$1" i
    [ -z "$engine" ] && engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ] && dpkg -s elasticsearch >/dev/null 2>&1; then
        systemctl start elasticsearch >/dev/null 2>&1
        for i in $(seq 1 60); do
            curl -sS --max-time 2 http://127.0.0.1:9200/ >/dev/null 2>&1 && { printf 'Elasticsearch'; return 0; }
            sleep 1
        done
    fi
    [ "$engine" = "Elasticsearch" ] && log "restore: Elasticsearch does not answer on this server; using Zebra"
    printf 'Zebra'
}

# function_restore_database [FILE]: FILE comes from the Magic Import Tool
# (a Koha backup dropped there); without it the operator picks the backup.
# Restore steps run through tui_run (one Pac-Man line each); their output
# goes to restore.log, the SQL errors to restore-import.log.
restore_task_trial() {
    mysql -e "DROP DATABASE IF EXISTS \`${RESTORE_TRIAL_DB}\`; CREATE DATABASE \`${RESTORE_TRIAL_DB}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$2" \
        && import_sql_file "$1" "$RESTORE_TRIAL_DB" "$2"
}
restore_task_recreate() {
    mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$1"
}
restore_task_import() {
    import_sql_file "$1" "$DB_NAME" "$2" && [ -z "$(koha_schema_missing "$DB_NAME")" ]
}
restore_task_schema() {
    systemctl restart memcached >/dev/null 2>&1 || true
    koha_ctl /usr/sbin/koha-upgrade-schema "$INSTANCE" > "${LOG_DIR}/schema-upgrade.log" 2>&1 \
        && [ -z "$(koha_schema_missing "$DB_NAME")" ]
}
restore_task_engine() {
    mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${1}' WHERE variable='SearchEngine';" || return 1
    systemctl restart memcached || true
}
restore_task_reindex() {
    local engine="$1" cut_time="$2"
    if [ "$engine" = "Elasticsearch" ]; then
        set_xml_elasticsearch inserir
        prepare_koha_broker || true
        ensure_koha_services
        manage_koha_indexers start && rebuild_koha_elasticsearch "$cut_time"
    else
        zebra_stop
        zebra_start || true
        koha_ctl /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" > "${LOG_DIR}/zebra-rebuild.log" 2>&1
    fi
}

# restore_preflight FILE: 1) the file itself: readable, not empty, intact
# gzip, SQL inside, ending like a complete mysqldump; 2) room for the trial
# import and then the new catalog (InnoDB takes about 1.5 times the size of
# the SQL text). 1 = not usable, RESTORE_PREFLIGHT_ERROR says why; the
# DUMP_* values are left for the questions about a suspicious file.
restore_preflight() {
    local file="$1" datadir free_mb need_mb
    RESTORE_PREFLIGHT_ERROR=""
    if ! check_dump_file "$file"; then
        RESTORE_PREFLIGHT_ERROR="$DUMP_ERROR"
        return 1
    fi
    datadir=$(run_sql "SELECT @@datadir;")
    datadir="${datadir:-/var/lib/mysql}"
    free_mb=$(get_free_space_mb "$datadir")
    need_mb=$(( DUMP_MB + DUMP_MB / 2 + 256 ))
    kei_result size_mb "$DUMP_MB"
    kei_result need_mb "$need_mb"
    kei_result free_mb "${free_mb:-0}"
    kei_result has_sql "$DUMP_HAS_SQL"
    kei_result complete "$DUMP_COMPLETE"
    if [ "${free_mb:-0}" -lt "$need_mb" ] 2>/dev/null; then
        RESTORE_PREFLIGHT_ERROR="$(t 'Not enough free disk space for a safe restore.\n\nNeeded: ~${need_mb} MB\nFree  : ${free_mb} MB (${datadir})\n\nNothing was changed.')"
        return 1
    fi
    return 0
}

function_restore_database() {
    require_koha || return 0
    require_db_admin || return 0

    local file="${1:-}"
    if [ -z "$file" ]; then
        show_restore_transfer_help
        file=$(select_file "$REAL_HOME") || return 0
    fi
    [ -z "$file" ] && return 0

    # 1-2) The file (readable, intact, SQL inside, complete) and the room
    #      for the restore: see restore_preflight.
    display_explanation "Checking the backup file..."
    if ! restore_preflight "$file"; then
        msg_error "" "$RESTORE_PREFLIGHT_ERROR" 13 76
        return 0
    fi
    if [ "$DUMP_HAS_SQL" != "yes" ]; then
        if [[ "$file" == *.gz ]]; then
            prompt_yes_no "$(t "Suspicious file")" "$(t "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        else
            prompt_yes_no "$(t "Suspicious file")" "$(t "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi
    if [ "$DUMP_COMPLETE" != "yes" ]; then
        prompt_yes_no "$(t "Suspicious file")" "$(t "The file does not end with the mysqldump completion line (-- Dump completed): it may be truncated.\n\nContinue anyway? It will still be tested in a temporary database first.")" 12 76 || return 0
    fi

    prompt_yes_no "$(t "Confirm Restore")" \
"$(t "File:\n\$file\n\nWARNING: the current catalog will be REPLACED.\n\nContinue?")" 13 74 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 0
    fi
    maintenance_begin

    local import_log="${LOG_DIR}/restore-import.log" details tables missing
    local TUI_LOG="${LOG_DIR}/restore.log"
    printf '===== %s | restore from %s =====\n' "$(date '+%F %T')" "$file" >> "$import_log"
    tui_title "📥" "$(t "Restoring the catalog")"

    # 3) Import into a temporary database: the current catalog is only
    #    touched after the backup has proven to be a complete Koha database.
    RESTORE_TRIAL_DB="koha_restore_check"
    if ! tui_run "$(t "Testing the backup in a temporary database")" restore_task_trial "$file" "$import_log"; then
        restore_release
        details=$(grep -v "^=====" "$import_log" | tail -n 6 | cut -c1-76)
        msg_error "" "$(t 'The backup could not be imported. Nothing was changed in the current catalog.\n\nLast error lines:\n${details}')" 18 80
        return 1
    fi
    tables=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${RESTORE_TRIAL_DB}';")
    missing=$(koha_schema_missing "$RESTORE_TRIAL_DB")
    drop_trial_db
    if [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        restore_release
        msg_error "" "$(t 'The backup has only ${tables} tables; it is not a complete Koha database. Nothing was changed.')" 10 76
        return 1
    fi
    if [ -n "$missing" ]; then
        restore_release
        msg_error "" "$(t 'The backup is not a complete Koha database (missing: ${missing}).\nNothing was changed.')" 11 76
        return 1
    fi

    # 4) Verified safety copy of the current catalog: without it, the
    #    current catalog is never dropped.
    local rescue="" cur_tables pre_engine
    if ! cur_tables=$(koha_table_count); then
        restore_release
        msg_error "" "$(t "MariaDB is not accepting connections and could not be started.\nNothing was changed.\n\nCheck: systemctl status mariadb")" 12 76
        return 1
    fi
    pre_engine=$(get_search_engine)
    if [ "$cur_tables" -gt 0 ]; then
        rescue="${DIR_SQL}/PRE-RESTORE_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        CLEANUP_FILE="$rescue"
        if ! tui_run "$(t "Saving a safety backup")" create_safety_backup "$rescue" "$import_log"; then
            CLEANUP_FILE=""
            restore_release
            msg_error "$(t "Safety backup failed")" "$(t 'The safety backup of the current database could not be created or validated (check the free space and ${DIR_SQL}).\n\nNothing was changed.')" 12 76
            return 1
        fi
        CLEANUP_FILE=""
        display_explanation "$(t "Safety backup:") $rescue"
        log "pre-restore safety backup: $rescue"
    fi

    # 5) Replace the catalog. From here on the restore can only end with the
    #    backup fully imported or with the previous catalog back in place.
    shield_signals
    display_explanation "Do not interrupt: CTRL+C is disabled until the restore finishes."
    tui_run "$(t "Stopping Koha services")" stop_koha_db_clients

    local stage="done"
    if ! tui_run "$(t "Recreating the database")" restore_task_recreate "$import_log"; then
        stage="recreate"
    else
        ensure_db_grants
        if ! tui_run "$(t "Importing the catalog")" restore_task_import "$file" "$import_log"; then
            stage="import"
        elif ! tui_run "$(t "Upgrading the database schema")" restore_task_schema; then
            stage="schema"
        fi
    fi
    if [ "$stage" != "done" ]; then
        restore_failed "$stage" "$rescue" "$import_log"
        return 1
    fi
    ensure_db_grants

    # 6) Search engine and full reindex, then every service back.
    local engine engine_ok="yes" rebuild_ok="yes" cut_time
    engine=$(restored_search_engine "$pre_engine")
    tui_run "$(t "Synchronizing the search engine")" restore_task_engine "$engine" || engine_ok="no"
    cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    tui_run "$(t "Reindexing the catalog")" restore_task_reindex "$engine" "$cut_time" || rebuild_ok="no"

    tui_run "$(t "Restarting Koha services")" resume_koha_services
    unshield_signals
    maintenance_end
    backup_lock_release
    db_app_login_ok || log "restore: the Koha database user cannot log in (check <hostname> in koha-conf.xml)"

    tui_run "$(t "Checking that everything works")" install_task_check "$(t "database restore")"
    log "restore completed from $file (engine=$engine rebuild=$rebuild_ok)"
    kei_result engine "$engine"
    kei_result tables "$tables"
    kei_result safety_backup "$rescue"

    if [ "$engine_ok" = "no" ]; then
        msg_error "" "$(t "Could not set the search engine after restore.")" 9 72
        return 1
    fi
    if [ "$rebuild_ok" = "no" ]; then
        msg_error "" "$(t "The database was restored, but index rebuilding failed.\nCheck /var/log/koha-easy-install/zebra-rebuild.log")" 11 78
        if [ -z "${KEI_TASK:-}" ] && prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi

    msg_ok "$(t "Catalog restored and indexed successfully!\n\nSearch engine: \${engine}\nTables: \${tables}")" 12 74

    if [ -z "${KEI_TASK:-}" ] && prompt_yes_no "$(t "View Report")" \
        "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
        show_validation_report
    fi

    return 0
}

# ======================================================================
# 4. MANUAL LOCAL BACKUP
# ======================================================================
# function_manual_backup [DIR]: DIR comes from the new panel's folder
# picker; without it the operator picks the folder here.
function_manual_backup() {
    require_database || return 1
    if ! backup_lock_acquire; then
        msg_info "$(t "Backup in progress")" "$(t "Another backup or restore is already running. Try again later.")" 9 72
        return 1
    fi
    local target_dir="${1:-}" target_file
    if [ -z "$target_dir" ]; then
        local srv_ip
        srv_ip=$(get_server_ip)
        msg_info "$(t "Backup Destination")" \
"$(t "Choose where to save the file.\n\n  USB drive: usually under /media or /mnt\n  To download later: scp root@\${srv_ip}:PATH Downloads/")" 12 76
        target_dir=$(select_directory "$REAL_HOME") || { backup_lock_release; return 0; }
        [ -z "$target_dir" ] && { backup_lock_release; return 0; }
    fi
    if [ ! -d "$target_dir" ] || [ ! -w "$target_dir" ]; then
        backup_lock_release
        msg_error "" "$(t "The folder does not exist or cannot be written:") $target_dir" 9 74
        return 1
    fi
    target_file="${target_dir%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"

    clear
    display_explanation "Generating the backup..."

    # Same checks as the safety copies: gzip test, complete mysqldump, size.
    if create_safety_backup "$target_file"; then

        log "manual backup generated: $target_file"
        backup_lock_release

        local size ip_addr
        size=$(du -h "$target_file" | cut -f1)
        ip_addr=$(get_server_ip)
        if [ -n "${KEI_TASK:-}" ]; then
            kei_result file "$target_file"
            kei_result size "$size"
            kei_result scp "scp ${REAL_USER:-root}@${ip_addr}:${target_file} Downloads/"
            kei_result user "${REAL_USER:-root}"
            return 0
        fi

        echo "======================================================================"
        echo -e "\e[1;32m$(t "BACKUP GENERATED AND VERIFIED SUCCESSFULLY!")\e[0m"
        echo "======================================================================"
        echo "$(t "File:") $target_file"
        echo "$(t "Size:") $size"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;36m$(t "HOW TO SAVE TO YOUR DOWNLOADS FOLDER (WINDOWS / MAC / LINUX)")\e[0m"
        echo "----------------------------------------------------------------------"
        echo "$(t "Open Terminal or PowerShell on your personal computer and paste the exact command:")"
        echo ""
        echo -e "\e[1;33mscp ${REAL_USER:-root}@${ip_addr}:${target_file} Downloads/\e[0m"
        echo ""
        echo "$(t "1. The file will be saved directly into your Downloads folder.")"
        echo "$(t "2. Make sure to include 'Downloads/' at the end of the command.")"
        echo "$(t "3. You will be asked for the password of user '\${REAL_USER:-root}'.")"
        echo ""
        echo "======================================================================"
        pause_terminal
    else
        backup_lock_release
        msg_error "" "$(t "Failed to generate the backup. Check the free disk space.")" 9 70
        return 1
    fi
}

# ======================================================================
# 5. TEST THE LATEST BACKUP
# ======================================================================
newest_sql_backup() {
    find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-
}
# function_test_backup [FILE]: the newest automatic backup unless the new
# panel names another file.
function_test_backup() {
    require_koha || return 1
    require_db_admin || return 1
    local newest="${1:-}"
    [ -z "$newest" ] && newest=$(newest_sql_backup)
    if [ -z "$newest" ]; then
        msg_error "" "$(t "No automatic backup found in \${DIR_SQL}.")" 9 70
        return 0
    fi
    if ! check_dump_file "$newest"; then
        msg_error "" "$DUMP_ERROR" 9 74
        return 1
    fi

    local b_name b_date p_msg
    b_name="$(basename "$newest")"
    b_date="$(date -r "$newest" '+%Y-%m-%d %H:%M')"
    p_msg="$(printf "%s\n\n%s: %s\n%s: %s\n\n%s" \
        "$(t "A backup is only worth it if it restores. This test imports the newest file into a temporary database and checks it. Production data is NOT touched.")" \
        "$(t "File")" "$b_name" \
        "$(t "Date")" "$b_date" \
        "$(t "Run the test now?")")"

    prompt_yes_no "$(t "Test Backup")" "$p_msg" 15 76 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_info "$(t "Backup in progress")" "$(t "Another backup or restore is already running. Try again later.")" 9 72
        return 0
    fi
    display_explanation "Importing into a temporary database..."
    RESTORE_TRIAL_DB="koha_teste_restauracao"
    if ! mysql -e "DROP DATABASE IF EXISTS \`${RESTORE_TRIAL_DB}\`; CREATE DATABASE \`${RESTORE_TRIAL_DB}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" >/dev/null 2>&1; then
        RESTORE_TRIAL_DB=""
        backup_lock_release
        msg_error "" "$(t "Could not create the temporary test database.")" 9 72
        return 1
    fi
    # import_sql_file drops the CREATE DATABASE/USE lines: a dump made with
    # --databases would otherwise be imported into the production database.
    local ok="yes" tab bib usu missing
    import_sql_file "$newest" "$RESTORE_TRIAL_DB" "${LOG_DIR}/restore-import.log" || ok="no"
    tab=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${RESTORE_TRIAL_DB}';")
    bib=$(run_sql "SELECT COUNT(*) FROM ${RESTORE_TRIAL_DB}.biblio;")
    usu=$(run_sql "SELECT COUNT(*) FROM ${RESTORE_TRIAL_DB}.borrowers;")
    missing=$(koha_schema_missing "$RESTORE_TRIAL_DB")
    drop_trial_db
    backup_lock_release
    log "backup test: $newest import=$ok tables=$tab biblios=$bib missing=${missing:-none}"

    if [ "$ok" = "no" ]; then
        msg_error "" "$(t "The backup DID NOT restore. Check the file urgently.")" 9 72
        return 1
    fi
    kei_result file "$newest"
    kei_result tables "${tab:-0}"
    kei_result biblios "${bib:-0}"
    kei_result patrons "${usu:-0}"
    if [ "${tab:-0}" -gt 50 ] 2>/dev/null && [ -z "$missing" ]; then
        local ok_test_msg
        ok_test_msg="$(printf "%s\n\n%s: %s\n%s: %s\n%s: %s\n%s: %s" \
            "$(t "BACKUP IS INTACT AND RESTORABLE.")" \
            "$(t "File")" "$b_name" \
            "$(t "Tables")" "${tab}" \
            "$(t "Bibliographic records")" "${bib}" \
            "$(t "Patrons")" "${usu}")"

        msg_ok "$ok_test_msg" 13 74
    elif [ -n "$missing" ] && [ "${tab:-0}" -gt 50 ] 2>/dev/null; then
        msg_error "" "$(t 'The backup is not a complete Koha database (missing: ${missing}).\nNothing was changed.')" 11 76
        return 1
    else
        local err_tab_msg
        err_tab_msg="$(printf "$(t "The backup imported but has only %s tables. Suspicious.")" "${tab}")"
        msg_error "" "$err_tab_msg" 9 72
        return 1
    fi
    return 0
}

# ======================================================================
# 6. KOHA LANGUAGES
# ======================================================================
# koha-translate --install, then --update (its templates), for one language.
lang_task_install() {
    ${3:-} "$1" --install "$2"
    ${3:-} "$1" --update "$2" || true
    return 0
}

function_install_languages() {
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

    local sudo_cmd=""
    [ "$EUID" -ne 0 ] && sudo_cmd="sudo"
    local created_mock=0

    # ==================================================================
    # LANGUAGE SELECTOR (native names)
    # ==================================================================
    local choice
    ask_menu "$(t "Koha & Panel Languages")" \
        "$(t "Choose the language to install in Koha and apply to this Panel:")" \
        "${KOHA_PANEL_LANG_FULL:-pt-BR}" "${PANEL_LANG_ITEMS[@]}" || return 0
    choice="$REPLY"
    [ -z "$choice" ] && return 0

    # ==================================================================
    # APPLY AND PERSIST THE PANEL LANGUAGE (works even without Koha)
    # ==================================================================
    set_panel_language "$choice"
    log "panel language set to $choice ($SYS_LANG)"
    kei_result panel_lang "$choice"

    if ! is_koha_installed || ! mysql -e "USE ${DB_NAME};" >/dev/null 2>&1; then
        msg_info "$(t "Koha & Panel Languages")" \
            "$(t "The panel language was changed.\n\nKoha is not installed yet, so its language pack will be installed later (the installer uses the panel language automatically).")" 12 74
        return 0
    fi

    if ! command -v koha-foreach >/dev/null 2>&1; then
        echo -e '#!/bin/bash\nexit 0' |
            $sudo_cmd tee /usr/local/bin/koha-foreach >/dev/null 2>&1 && chmod +x /usr/local/bin/koha-foreach 2>/dev/null || {
                echo -e '#!/bin/bash\nexit 0' > /tmp/koha-foreach
                chmod +x /tmp/koha-foreach
                export PATH="/tmp:$PATH"
            }
        created_mock=1
    fi

    # ==================================================================
    # PREPARE SYSTEM LOCALE
    # ==================================================================
    clear
    tui_title "🌍" "$(t "Koha & Panel Languages")"

    local loc_prefix
    loc_prefix=$(echo "$choice" | cut -d'-' -f1,2 | sed 's/-/_/')

    case "$choice" in
        zh-Hans-CN) loc_prefix="zh_CN" ;;
        zh-Hant-TW) loc_prefix="zh_TW" ;;
        ja-Jpan-JP) loc_prefix="ja_JP" ;;
        ko-Kore-KP) loc_prefix="ko_KR" ;;
        ar-Arab)    loc_prefix="ar_.*" ;;
        fa-Arab)    loc_prefix="fa_IR" ;;
        sr-Cyrl)    loc_prefix="sr_RS" ;;
        bg-Cyrl)    loc_prefix="bg_BG" ;;
        hi)         loc_prefix="hi_IN" ;;
        ta)         loc_prefix="ta_IN" ;;
        te)         loc_prefix="te_IN" ;;
        ml)         loc_prefix="ml_IN" ;;
        kn-Knda)    loc_prefix="kn_IN" ;;
        mr)         loc_prefix="mr_IN" ;;
        bn-IN)      loc_prefix="bn_IN" ;;
        gl)         loc_prefix="gl_ES" ;;
        eu)         loc_prefix="eu_ES" ;;
        my)         loc_prefix="my_MM" ;;
    esac

    if [ -f /etc/locale.gen ]; then
        $sudo_cmd sed -i -E \
            "s/^#[[:space:]]*(${loc_prefix}[^[:space:]]*\.UTF-8[[:space:]]+UTF-8)/\1/i" \
            /etc/locale.gen 2>/dev/null || true

        tui_run "$(t "Setting up language and UTF-8")" $sudo_cmd locale-gen || true
    fi

    # ==================================================================
    # KOHA TRANSLATION PACKAGE
    # ==================================================================
    local koha_trans_cmd
    koha_trans_cmd="$(command -v koha-translate || echo "/usr/sbin/koha-translate")"

    if [ ! -x "$koha_trans_cmd" ]; then
        msg_error "" \
            "$(t "Koha translation utility was not found.\n\nExpected:\n/usr/sbin/koha-translate")" \
            11 74

        [ "$created_mock" -eq 1 ] && rm -f /tmp/koha-foreach /usr/local/bin/koha-foreach 2>/dev/null
        return 0
    fi

    : > /tmp/koha_lang.log
    if $sudo_cmd "$koha_trans_cmd" --list 2>/dev/null | grep -Fq "$choice"; then
        TUI_LOG=/tmp/koha_lang.log tui_run "$(t "Updating the Koha language pack")" \
            $sudo_cmd "$koha_trans_cmd" --update "$choice"
    else
        TUI_LOG=/tmp/koha_lang.log tui_run "$(t "Installing the Koha language pack")" \
            lang_task_install "$koha_trans_cmd" "$choice" "$sudo_cmd"
    fi

    # ==================================================================
    # VERIFY KOHA LANGUAGE
    # ==================================================================
    if $sudo_cmd "$koha_trans_cmd" --list 2>/dev/null | grep -Fq "$choice"; then
        $sudo_cmd systemctl restart memcached >/dev/null 2>&1 || true
        plack_restart || true

        # ==============================================================
        # ENABLE LANGUAGE IN KOHA
        # ==============================================================
        if prompt_yes_no "$(t "Enable language")" "$(t "Package processed.\n\nEnable it right away in the preferences (OPAC and Staff)?")" 10 70; then
            local mysql_runner="mysql"

            if ! mysql -e "SELECT 1" >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
                mysql_runner="sudo mysql"
            fi

            # ----------------------------------------------------------
            # OPAC
            # ----------------------------------------------------------
            $mysql_runner -e "
                INSERT INTO ${DB_NAME}.systempreferences (variable, value, type)
                VALUES ('OPACLanguages', '${choice}', 'Free')
                ON DUPLICATE KEY UPDATE value = CASE
                    WHEN value = '' OR value IS NULL THEN '${choice}'
                    WHEN FIND_IN_SET('${choice}', value) THEN value
                    ELSE CONCAT(value, ',', '${choice}')
                END;
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # STAFF INTERFACE
            # ----------------------------------------------------------
            $mysql_runner -e "
                INSERT INTO ${DB_NAME}.systempreferences (variable, value, type)
                VALUES ('StaffInterfaceLanguages', '${choice}', 'Free')
                ON DUPLICATE KEY UPDATE value = CASE
                    WHEN value = '' OR value IS NULL THEN '${choice}'
                    WHEN FIND_IN_SET('${choice}', value) THEN value
                    ELSE CONCAT(value, ',', '${choice}')
                END;
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # Legacy compatibility
            # ----------------------------------------------------------
            $mysql_runner -e "
                UPDATE ${DB_NAME}.systempreferences SET value='${choice}' WHERE variable='language';
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # Clear sessions
            # ----------------------------------------------------------
            $mysql_runner -e "DELETE FROM ${DB_NAME}.sessions;" >/dev/null 2>&1 || true

            $sudo_cmd systemctl restart memcached >/dev/null 2>&1 || true
            plack_restart || true
            $sudo_cmd systemctl reload apache2 >/dev/null 2>&1 || true
        fi

        msg_ok "$(t "Language '\$choice' enabled successfully.\nFine tuning in: Administration > Preferences > I18N/L10N.")" 10 74

    else
        local err_msg
        err_msg=$(tail -n 12 /tmp/koha_lang.log 2>/dev/null || echo "$(t "Empty log.")")
        msg_error "" "$(t "Failed to process language '\$choice'.\n\nKoha native error details:\n\$err_msg")" 18 80
    fi

    [ "$created_mock" -eq 1 ] && rm -f /tmp/koha-foreach /usr/local/bin/koha-foreach 2>/dev/null
}

# ======================================================================
# 7. TOGGLE SEARCH ENGINE
# ======================================================================
# Tasks of the search engine switch (run under tui_run, output to the log).
# The <elasticsearch> block of koha-conf.xml stays when leaving it (Debian
# ships it even for Zebra); only the damage left there by older panel
# versions is repaired.
se_task_es_off() {
    manage_koha_indexers stop
    systemctl disable --now elasticsearch || true
    repair_koha_conf_xml
    return 0
}

se_task_zebra_off() {
    rm -f "$CRON_ZEBRA"
    systemctl restart cron || true
    zebra_stop
    return 0
}

se_task_es_install() {
    wait_for_apt_locks
    ensure_elastic_repo || apt_update_indices
    apt_install elasticsearch koha-elasticsearch
}

# Exit 1: memory settings not written; 2: elasticsearch.yml missing;
# 3: the analysis-icu plugin could not be installed.
se_task_es_configure() {
    local yml=/etc/elasticsearch/elasticsearch.yml
    adjust_elasticsearch_heap || return 1
    [ -f "$yml" ] || return 2
    cp -f "$yml" "${yml}.bak-$(date +%Y%m%d-%H%M%S)" || true
    grep -q '^discovery.type: single-node' "$yml" || echo 'discovery.type: single-node' >> "$yml"
    grep -q '^network.host: 127.0.0.1' "$yml" || echo 'network.host: 127.0.0.1' >> "$yml"
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu || return 3
    fi
    return 0
}

# Exit 1: the service did not start; 2: nothing answers on 9200 after a minute.
se_task_es_start() {
    systemctl daemon-reload
    systemctl enable elasticsearch || true
    systemctl restart elasticsearch || return 1
    local _
    for _ in $(seq 1 60); do
        curl -sS --max-time 2 http://127.0.0.1:9200 && return 0
        sleep 1
    done
    return 2
}

# Koha switched to Elasticsearch: cache flushed, broker ready, old indices
# dropped, Koha restarted.
se_task_koha_on_es() {
    systemctl restart memcached || true
    prepare_koha_broker || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_authorities" || true
    systemctl restart koha-common || true
    return 0
}

# Zebra unlocked (stale locks and pid file removed, owner fixed) and started.
zebra_unlock_start() {
    zebra_stop
    force_stop_koha_zebra
    rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
    rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
    chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
        "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
        "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
    zebra_start
    return 0
}

function_toggle_search_engine() {
    require_koha_tables || return 0
    local TUI_LOG="${LOG_DIR}/search-engine.log"
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "$(t "Search Engine")" \
"$(t "Current engine: ELASTICSEARCH.\n\nSwitch back to ZEBRA? It uses about 1.5 GB less RAM,\nbut loses dynamic facets and advanced search.")" 12 74 || return 0
        clear
        tui_title "🔎" "$(t "Switching the search engine to Zebra")"
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Another backup/restore is running. Engine switch cancelled.")" 9 72
            return 1
        fi
        maintenance_begin
        tui_run "$(t "Stopping Elasticsearch")" se_task_es_off
        if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Zebra' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            maintenance_end; backup_lock_release
            msg_error "" "$(t "Could not set SearchEngine to Zebra. Elasticsearch configuration was restored.")" 10 74
            return 1
        fi
        tui_run "$(t "Clearing the preferences cache")" systemctl restart memcached
        tui_run "$(t "Unlocking and starting Zebra")" zebra_unlock_start
        if ! is_koha_zebra_running; then
            ensure_search_indexing >/dev/null 2>&1
            maintenance_end; backup_lock_release
            msg_error "" "$(t "Zebra daemon could not be started. Engine switch was interrupted.")" 10 74
            return 1
        fi
        write_cron_zebra
        tui_run "$(t "Restarting Koha services")" systemctl restart koha-common
        : > "${LOG_DIR}/zebra-rebuild.log"
        if ! TUI_LOG="${LOG_DIR}/zebra-rebuild.log" tui_run "$(t "Reindexing the catalog")" \
                koha_ctl /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE"; then
            ensure_search_indexing >/dev/null 2>&1
            maintenance_end; backup_lock_release
            msg_error "" "$(t "Zebra rebuild failed. The system will remain on Zebra; use the repair option.")" 11 76
            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
                show_validation_report
            fi
            return 1
        fi
        ensure_search_indexing >/dev/null 2>&1
        maintenance_end; backup_lock_release
        tui_run "$(t "Starting Koha (Plack)")" plack_restart
        tui_run "$(t "Checking that everything works")" install_task_check "$(t "switch to Zebra")"
        msg_ok "$(t "System now running on ZEBRA.\nIncremental indexing runs every 2 minutes.")" 10 70

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi

        return 0
    fi

    prompt_yes_no "$(t "Search Engine")" \
"$(t "Current engine: ZEBRA.\n\nEnable ELASTICSEARCH? It brings advanced search and dynamic\nfacets, but needs about 1.5 GB more RAM and more disk.")" 12 76 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ] 2>/dev/null; then
        prompt_yes_no "$(t "Low disk space")" "$(t "Less than 4 GB free. Elasticsearch may fail to start.\n\nContinue anyway?")" 10 70 || return 0
    fi

    local es_arch
    es_arch=$(dpkg --print-architecture 2>/dev/null)
    if ! es_arch_supported; then
        msg_error "" "$(t 'Elasticsearch 7 has no packages for this architecture (${es_arch}). Zebra was kept.')" 9 76
        return 1
    fi

    clear
    tui_title "🔎" "$(t "Switching the search engine to Elasticsearch")"
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Another backup/restore is running. Engine switch cancelled.")" 9 72
        return 1
    fi
    maintenance_begin

    tui_run "$(t "Stopping Zebra")" se_task_zebra_off

    if ! dpkg -s koha-elasticsearch >/dev/null 2>&1 || ! dpkg -s elasticsearch >/dev/null 2>&1; then
        if ! TUI_LOG="$APT_LOG" tui_run "$(t "Installing Elasticsearch 7")" se_task_es_install; then
            restore_apt_timers
            write_cron_zebra
            zebra_start >/dev/null 2>&1 || true
            maintenance_end; backup_lock_release
            msg_error "" "$(t "Elasticsearch installation failed. Zebra was restored.")" 10 72
            return 1
        fi
    fi

    local es_rc=0
    tui_run "$(t "Configuring Elasticsearch")" se_task_es_configure || es_rc=$?
    if [ "$es_rc" -ne 0 ]; then
        [ "$es_rc" -eq 3 ] && systemctl disable --now elasticsearch >/dev/null 2>&1
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        maintenance_end; backup_lock_release
        case "$es_rc" in
            2) msg_error "" "$(t "Elasticsearch configuration file is missing.")" 9 70 ;;
            3) msg_error "" "$(t "Could not install the Elasticsearch analysis-icu plugin. Zebra was restored.")" 11 78 ;;
            *) msg_error "" "$(t "Could not write Elasticsearch memory configuration. Zebra was restored.")" 11 78 ;;
        esac
        return 1
    fi

    es_rc=0
    tui_run "$(t "Starting Elasticsearch")" se_task_es_start || es_rc=$?
    if [ "$es_rc" -ne 0 ]; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        maintenance_end; backup_lock_release
        if [ "$es_rc" -eq 2 ]; then
            msg_error "" "$(t "Elasticsearch did not start on port 9200. Zebra was kept.")" 12 76
        else
            msg_error "" "$(t "Elasticsearch failed to start. Zebra was restored.")" 12 76
        fi
        return 1
    fi

    if ! tui_run "$(t "Declaring Elasticsearch in Koha")" set_xml_elasticsearch inserir; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        maintenance_end; backup_lock_release
        msg_error "" "$(t "Could not enable the Elasticsearch block in koha-conf.xml. Zebra was restored.")" 11 78
        return 1
    fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        write_cron_zebra; zebra_start >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        maintenance_end; backup_lock_release
        msg_error "" "$(t "Could not set SearchEngine to Elasticsearch. Zebra was restored.")" 10 76
        return 1
    fi
    tui_run "$(t "Restarting Koha services")" se_task_koha_on_es
    local indexer_ok="yes"
    tui_run "$(t "Starting the indexer")" manage_koha_indexers start || indexer_ok="no"
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    if [ "$indexer_ok" = "yes" ] && ! tui_run "$(t "Reindexing the catalog")" rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    maintenance_end; backup_lock_release
    tui_run "$(t "Starting Koha (Plack)")" plack_restart
    tui_run "$(t "Checking that everything works")" install_task_check "$(t "Elasticsearch activation")"
    if [ "$indexer_ok" = "yes" ] && [ "$rebuild_ok" = "yes" ] && is_koha_indexer_running; then
        msg_ok "$(t "System now running on ELASTICSEARCH.\n\nThe indexer has automatic recovery and the watchdog checks the queue every 5 minutes.")" 12 78

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi
        return 0
    elif [ "$indexer_ok" = "no" ]; then
        msg_error "" "$(t "Elasticsearch is active but the indexer did not start. Use the repair option.")" 11 76
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    else
        msg_error "" "$(t "Elasticsearch is active but rebuilding failed. Use Repair Indexing option.")" 11 78
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi
}

# ======================================================================
# 8. REPAIR INDEXING
# ======================================================================
# The indexes are built from the Koha tables: an empty database (Web
# Installer not finished, or a restore that stopped halfway in older
# versions) is reported clearly instead of a cryptic rebuild error.
require_koha_tables() {
    require_database || return 1
    local tables rescue_hint=""
    tables=$(koha_table_count)
    if [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        local rescue
        rescue=$(ls -1t "${DIR_SQL}"/PRE-RESTORE_*.sql.gz "${DIR_SQL}"/PRE-REINSTALLATION_*.sql.gz 2>/dev/null | head -n1)
        [ -n "$rescue" ] && rescue_hint="\n\n$(t "Safety copy made before the last restore:")\n${rescue}"
        msg_error "" "$(t 'The Koha database is empty or incomplete (${tables} tables).\n\nRestore a backup (option 3) or finish the Web Installer first.')${rescue_hint}" 15 80
        return 1
    fi
    return 0
}

# Unlocks Zebra and rebuilds both of its indices from scratch: the core of
# "Repair / rebuild indexing", also run by the Koha window on Windows
# (--rebuild-search-index). The rebuild's output goes to zebra-rebuild.log;
# with "show" the screen gets one Pac-Man line per task. Returns 1 if
# anything failed.
zebra_full_rebuild() {
    local show="${1:-}" ok=0
    maintenance_begin
    repair_koha_conf_xml
    if [ -n "$show" ]; then
        TUI_LOG="${LOG_DIR}/zebra-rebuild.log" tui_run "$(t "Unlocking and starting Zebra")" zebra_unlock_start
    else
        zebra_unlock_start >/dev/null 2>&1
    fi
    write_cron_zebra
    if [ -n "$show" ]; then
        : > "${LOG_DIR}/zebra-rebuild.log"
        TUI_LOG="${LOG_DIR}/zebra-rebuild.log" tui_run "$(t "Reindexing the catalog")" \
            koha_ctl /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" || ok=1
    else
        koha_ctl /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" > "${LOG_DIR}/zebra-rebuild.log" 2>&1 || ok=1
    fi
    zebra_stop
    zebra_start >/dev/null 2>&1 || ok=1
    maintenance_end
    ensure_search_indexing >/dev/null 2>&1 || ok=1
    return "$ok"
}

# config.sh --rebuild-search-index: the search index of the active engine
# rebuilt from scratch, without questions (the Koha window's "Rebuild search
# index"). Exit 0 when it worked, 2 when Koha is not installed.
kei_rebuild_search_index() {
    local rc=0
    is_koha_installed || return 2
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        # No screen to show "already running" on: it goes to the log.
        msg_info() { log "$1: $2"; }
        rebuild_koha_elasticsearch || rc=1
    else
        zebra_full_rebuild || rc=1
    fi
    log "search index rebuilt from the Windows tools (exit $rc)"
    return "$rc"
}

se_task_es_repair() {
    systemctl restart elasticsearch
    prepare_koha_broker
    set_xml_elasticsearch inserir >/dev/null 2>&1 || true
    systemctl restart memcached koha-common
    manage_koha_indexers start
    plack_restart
    return 0
}

# The index made again with Koha's default mappings, then Koha restarted
# so its pages use them.
se_task_es_reset() {
    rebuild_koha_es_reset_mappings || return 1
    systemctl restart memcached >/dev/null 2>&1 || true
    plack_restart
    return 0
}

# The search test of the repair, with the error in plain words. Sets
# SEARCH_PROBE (the probe's line); 0 = the search works.
se_search_check() {
    SEARCH_PROBE=$(koha_search_probe) && return 0
    log "search probe: ${SEARCH_PROBE}"
    return 1
}

function_repair_indexing() {
    require_koha_tables || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        local es_up idx broker pend bibs docs
        es_up=$(curl -s --max-time 5 http://127.0.0.1:9200 >/dev/null 2>&1 && echo "OK" || echo "$(t "DOWN")")
        is_koha_indexer_running && idx="$(t "running")" || idx="$(t "STOPPED")"
        ss -lnt 2>/dev/null | grep -q ":$(koha_stomp_port) " && broker="OK" || broker="$(t "absent")"
        pend=$(get_pending_es_jobs); bibs=$(get_total_biblios); docs=$(get_total_es_documents)
        local search_now
        if se_search_check; then search_now="OK"; else search_now="$(t "FAILS"): ${SEARCH_PROBE#FAIL }"; fi
        msg_info "$(t "Diagnostics")" \
"$(t "Catalogue search")     : ${search_now}
Elasticsearch (9200) : ${es_up}
$(t "Block in XML")         : $(is_koha_es_active_in_xml && echo OK || echo "$(t "MISSING")")
$(t "Indexer")              : ${idx}
RabbitMQ/STOMP       : ${broker}
$(t "Pending jobs")         : ${pend:-?}
$(t "Index / database")     : ${docs:-?} / ${bibs:-?}
$(t "Growing queue + smaller index = indexer is down.")" 18 76
        prompt_yes_no "$(t "Repair")" "$(t "Reinstall the indexer service, flush the cache and restart everything?")" 10 74 || return 0
        local TUI_LOG="${LOG_DIR}/search-engine.log"
        clear
        tui_title "🔎" "$(t "Repairing the search index")"
        tui_run "$(t "Repairing the indexing services")" se_task_es_repair
        local rebuild_ok="yes"
        if prompt_yes_no "$(t "Reindex")" "$(t "Rebuild the whole index from scratch?\nOn large catalogs this can take several minutes.")" 10 74; then
            local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
            tui_run "$(t "Reindexing the catalog")" rebuild_koha_elasticsearch "$cut_time" || rebuild_ok="no"
        fi

        # The search itself, as the staff pages make it. An index whose
        # mappings Koha no longer matches (sort fields missing: "There was an
        # error searching for analytic records") is made again from Koha's
        # default mappings, after asking.
        local search_ok="yes"
        if ! se_search_check; then
            search_ok="no"
            case "$(koha_search_problem "$SEARCH_PROBE")" in
                es_down|probe) ;;
                *)
                    if prompt_yes_no "$(t "Catalogue search")" "$(t "The catalogue search still fails:")"$'\n\n'"${SEARCH_PROBE#FAIL }"$'\n\n'"$(t "Make the index again with Koha's default search mappings? Changes made in Administration > Search engine configuration are replaced. On large catalogs this can take several minutes.")" 18 78; then
                        local reset_time; reset_time=$(date '+%Y-%m-%d %H:%M:%S')
                        if tui_run "$(t "Making the index again with Koha's mappings")" se_task_es_reset; then
                            clear_orphan_jobs "$reset_time"
                            se_search_check && search_ok="yes"
                        fi
                    fi
                    ;;
            esac
        fi

        tui_run "$(t "Checking that everything works")" install_task_check "$(t "Elasticsearch indexing repair")"

        if [ "$search_ok" = "no" ]; then
            msg_error "" "$(t "The catalogue search still fails, so the staff pages show 'Unable to perform the search'. Koha's error:")"$'\n\n'"${SEARCH_PROBE#FAIL }"$'\n\n'"$(t "Check: systemctl status elasticsearch, and /var/log/koha/\${INSTANCE}/plack-error.log")" 16 80
            return 1
        fi

        if is_koha_indexer_running && [ "$rebuild_ok" = "yes" ]; then
            msg_ok "$(t "Indexer is running and catalog synchronized.\nAdd a test record and search for it after ~10 seconds.")" 11 76

            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
                show_validation_report
            fi
            return 0
        else
            msg_error "" "$(t "Elasticsearch repair failed (indexer stopped or rebuild error).\nCheck:\njournalctl -u koha-es-indexer@\${INSTANCE} -n 50")" 12 78
            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
                show_validation_report
            fi
            return 1
        fi
    fi

    prompt_yes_no "$(t "Repair Zebra")" "$(t "Unlock Zebra and rebuild the indices from scratch?")" 10 70 || return 0
    clear
    tui_title "🔎" "$(t "Repairing the search index")"
    local zebra_ok="yes"
    zebra_full_rebuild show || zebra_ok="no"
    tui_run "$(t "Restarting Koha services")" ensure_koha_services

    tui_run "$(t "Checking that everything works")" install_task_check "$(t "Zebra indexing repair")"

    if [ "$zebra_ok" = "yes" ]; then
        msg_ok "$(t "Zebra unlocked and catalog reindexed successfully.")" 9 68

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi
        return 0
    else
        local details
        details=$(tail -n 6 "${LOG_DIR}/zebra-rebuild.log" 2>/dev/null | cut -c1-76)
        msg_error "" "$(t "Zebra index rebuild encountered errors.\nCheck logs at /var/log/koha/\${INSTANCE}.")\n\n${details}" 16 80
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi
}

# ======================================================================
# 9. SERVER SIZING
# ======================================================================
function_size_server() {
    require_koha || return 0
    local ram ram_int recommended profile wk mem db
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
    ram_int=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo)
    if   [ "$ram_int" -lt 4 ];  then recommended=1
    elif [ "$ram_int" -lt 8 ];  then recommended=2
    elif [ "$ram_int" -lt 16 ]; then recommended=3
    else recommended=4; fi
    ask_menu "$(t "Sizing")" "$(t "Detected RAM:") ${ram} GB\n$(t "Recommended profile:") ${recommended}" \
        "$recommended" \
        "1" "< 4 GB   - 2 Plack, 64MB cache, 512M InnoDB" \
        "2" "4-8 GB   - 3 Plack, 128MB cache, 768M InnoDB" \
        "3" "8-16 GB  - 4 Plack, 128MB cache, 1G InnoDB" \
        "4" "16 GB+   - 6 Plack, 256MB cache, 2G InnoDB" || return 0
    profile=$REPLY
    case "$profile" in
        1) wk=2; mem=64;  db=512M ;;
        2) wk=3; mem=128; db=768M ;;
        3) wk=4; mem=128; db=1G ;;
        4) wk=6; mem=256; db=2G ;;
        *) return 0 ;;
    esac
    clear
    display_explanation "Applying profile \$profile..."
    adjust_conf_key() {
        local file="$1" pattern="$2" line="$3"
        [ -f "$file" ] || return 0
        if grep -qE "$pattern" "$file"; then sed -i -E "s|${pattern}|${line}|" "$file"
        else echo "$line" >> "$file"; fi
    }
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*'      "PLACK_WORKERS=$wk"
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*' "PLACK_MAX_REQUESTS=100"
    adjust_conf_key /etc/memcached.conf       '^[[:space:]]*-m[[:space:]]+.*'                   "-m $mem"
    mkdir -p /etc/mysql/mariadb.conf.d
    local tuning="/etc/mysql/mariadb.conf.d/99-koha-tuning.cnf"
    local tuning_bak="/tmp/99-koha-tuning.bak"
    local had_tuning="no"
    if [ -f "$tuning" ]; then
        cp -f "$tuning" "$tuning_bak" 2>/dev/null && had_tuning="yes" || {
            msg_error "" "$(t "Could not back up the MariaDB tuning file. Change cancelled.")" 9 74
            return 1
        }
    else
        rm -f "$tuning_bak"
    fi
    printf '[mysqld]\ninnodb_buffer_pool_size = %s\n' "$db" > "$tuning"
    systemctl restart memcached >/dev/null 2>&1
    if ! systemctl restart mariadb; then
        if [ "$had_tuning" = "yes" ] && [ -f "$tuning_bak" ]; then
            cp -f "$tuning_bak" "$tuning" 2>/dev/null || true
        else
            rm -f "$tuning"
        fi
        systemctl restart mariadb >/dev/null 2>&1
        msg_error "" "$(t "MariaDB failed to start with innodb_buffer_pool_size=\$db.\nThe change was REVERTED and the database is back up.\n\nPick a smaller profile.")" 12 76
        return 1
    fi
    systemctl restart koha-common >/dev/null 2>&1
    plack_restart
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        if ! adjust_elasticsearch_heap || ! systemctl restart elasticsearch >/dev/null 2>&1; then
            msg_error "" "$(t "Elasticsearch memory tuning failed or the service did not restart.")" 9 74
            return 1
        fi
    fi
    log "tuning profile=$profile plack=$wk memcached=$mem innodb=$db"
    msg_ok "$(t "Profile \$profile applied.\n\nPlack: \$wk workers\nMemcached: \${mem} MB\nMariaDB InnoDB: \$db\n\nAll services restarted successfully.")" 13 74
}

# ======================================================================
# 10. CLOUD BACKUP (RCLONE)
# ======================================================================
# Every rclone call of the set-up test is bounded: rclone's own limits
# (connection, idle transfer, a single retry) and, around it, timeout(1), so
# a stalled network or API can never keep the screen waiting.
RCLONE_TEST_SECS=30
RCLONE_TEST_FLAGS=(--contimeout 15s --timeout 20s --retries 1 --low-level-retries 1)

# rclone_probe ARGS...: rclone with the test limits. REPLY = its stdout and
# stderr (last lines); the exit code is rclone's, 124 when the time ran out.
rclone_probe() {
    local out rc
    out=$(timeout --kill-after=5s "${RCLONE_TEST_SECS}s" rclone "${RCLONE_TEST_FLAGS[@]}" "$@" 2>&1 </dev/null)
    rc=$?
    [ "$rc" -eq 137 ] && rc=124
    REPLY=$(printf '%s\n' "$out" | sed -e '/^[[:space:]]*$/d' | tail -n 12)
    if [ "$rc" -eq 124 ]; then
        local secs="$RCLONE_TEST_SECS"
        REPLY="$(t "The cloud did not answer within \$secs seconds, so the test was stopped.")${REPLY:+$'\n'$REPLY}"
    elif [ "$rc" -ne 0 ] && [ -z "$REPLY" ]; then
        REPLY=$(t "rclone exited with code \$rc.")
    fi
    return "$rc"
}

# The first full backup after a successful test: in the background, so the
# set-up ends as soon as the cloud answered.
kei_first_cloud_backup() {
    nohup setsid bash /root/backup_sql.sh >/dev/null 2>&1 </dev/null &
}

validate_and_register_rclone() {
    local name="$1" err probe
    [ -z "$name" ] && return 1
    if ! rclone listremotes 2>/dev/null | grep -qx "${name}:"; then
        local remotes
        remotes=$(rclone listremotes 2>/dev/null)
        msg_error "" "$(t "There is no rclone remote called '\$name'.\n\nExisting remotes:\n\$remotes")" 14 74
        return 1
    fi
    if ! rclone_probe mkdir "${name}:Backup_SQL_Koha"; then
        err=$REPLY
        log "rclone: write test on ${name} failed"
        msg_error "" "$(t "Remote '\$name' exists but the write test failed.\n\nDetail:\n\$err")" 20 78
        return 1
    fi
    rclone_probe mkdir "${name}:Backup_MARC_Koha" || true
    display_explanation "Testing the real cloud upload..."
    probe=$(mktemp /tmp/kei-cloud-test.XXXXXX) || return 1
    printf 'koha.nexus cloud upload test %s\n' "$(date '+%F %T')" > "$probe"
    if ! rclone_probe copyto "$probe" "${name}:Backup_SQL_Koha/kei-upload-test.txt"; then
        err=$REPLY
    elif ! rclone_probe lsf "${name}:Backup_SQL_Koha" --include kei-upload-test.txt || [ "$REPLY" != "kei-upload-test.txt" ]; then
        err=${REPLY:-$(t "The test file was sent but could not be read back.")}
    else
        err=""
    fi
    rm -f "$probe"
    if [ -n "$err" ]; then
        log "rclone: upload test on ${name} failed"
        msg_error "" "$(t "The test upload to \${name}:Backup_SQL_Koha failed.\n\nDetail:\n\$err")" 20 78
        return 1
    fi
    rclone_probe deletefile "${name}:Backup_SQL_Koha/kei-upload-test.txt" || true
    write_backup_config
    if grep -qE "^RCLONE_REMOTE=" "$BACKUP_CONF" 2>/dev/null; then
        sed -i -E "s|^RCLONE_REMOTE=.*|RCLONE_REMOTE=\"${name}\"|" "$BACKUP_CONF"
    else
        echo "RCLONE_REMOTE=\"${name}\"" >> "$BACKUP_CONF"
    fi
    if ! grep -qE "^RCLONE_REMOTE=\"${name}\"$" "$BACKUP_CONF" 2>/dev/null; then
        msg_error "" "$(t "The remote was validated, but I could NOT save '\${name}' in \${BACKUP_CONF}.\nCheck the file permissions.")" 11 76
        return 1
    fi
    chmod 600 "$BACKUP_CONF"
    log "rclone remote configured: $name"
    kei_first_cloud_backup
    msg_ok "$(t "Cloud enabled and tested successfully.\n\nRemote: \${name}\nSQL folder: Backup_SQL_Koha (a test file was sent and read back)\n\nThe first full backup is now running in the background.\nLog: \${LOG_DIR}/backup_sql.log")" 14 76
    return 0
}

# After a failed test in the terminal menu: REPLY = retry, edit or "" (back).
# WITH_EDIT=1 offers to paste the token again.
rclone_failure_choice() {
    local with_edit="${1:-0}" choice items=()
    items+=("retry" "$(t "Try the test again")")
    [ "$with_edit" = "1" ] && items+=("edit" "$(t "Edit the token")")
    items+=("back" "$(t "Back")")
    REPLY=""
    choice=$(whiptail --title "$(t "Cloud Backup")" --nocancel \
        --menu "$(t "The cloud test failed. What do you want to do?")" 14 70 3 "${items[@]}" 3>&1 1>&2 2>&3) || return 0
    [ "$choice" = "back" ] || REPLY=$choice
}

# ======================================================================
# AUTHORIZATION LINKS: QR CODE, BROWSER OR COPY
# ----------------------------------------------------------------------
# rclone and cloudflared print a link and wait until someone authorizes it
# in a browser. The panel runs them in the background, catches the link and
# lets the person choose how to open it: a QR code for a phone, the browser
# of this computer (Windows under WSL, or the desktop session on Linux) or
# the plain link to copy. Every method stays available while the tool waits.
# ======================================================================
KEI_WIN_OPENER="${KEI_WIN_OPENER:-/mnt/c/Windows/System32/rundll32.exe}"
AUTH_CANCELLED=0 AUTH_PID="" AUTH_URL="" RCLONE_TOKEN=""

# Only plain http(s) links are ever shown, encoded or opened.
is_auth_url() {
    case "$1" in http://?*|https://?*) ;; *) return 1 ;; esac
    case "$1" in *[[:space:]\"\'\`\<\>\\]*) return 1 ;; esac
    [ "${#1}" -le 2048 ]
}

# First link matching the extended regex $2 in file $1 (tool output).
extract_auth_url() {
    local url
    url=$(grep -oE "$2" "$1" 2>/dev/null | head -n1)
    is_auth_url "$url" || return 1
    printf '%s' "$url"
}

# How a link can be opened on this computer: "windows" (WSL: the Windows
# default browser), "desktop" (xdg-open in the Linux graphical session) or
# nothing (a server reached over SSH).
browser_opener() {
    if is_wsl && [ -x "$KEI_WIN_OPENER" ]; then printf 'windows'; return 0; fi
    if { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } && command -v xdg-open >/dev/null 2>&1; then
        printf 'desktop'; return 0
    fi
    return 1
}

open_in_browser() {
    local url="$1" how
    is_auth_url "$url" || return 1
    how=$(browser_opener) || return 1
    log "authorization link opened in the browser ($how)"
    if [ "$how" = "windows" ]; then
        # rundll32 takes the link as one argument: no cmd.exe parsing of "&".
        ( cd /mnt/c 2>/dev/null || cd /; "$KEI_WIN_OPENER" url.dll,FileProtocolHandler "$url" ) >/dev/null 2>&1 &
    elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && command -v sudo >/dev/null 2>&1; then
        # The browser belongs to the person logged in, not to root.
        sudo -u "$SUDO_USER" env DISPLAY="${DISPLAY:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
            XAUTHORITY="${XAUTHORITY:-}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
            xdg-open "$url" >/dev/null 2>&1 &
    else
        xdg-open "$url" >/dev/null 2>&1 &
    fi
    return 0
}

# Prints the link as a QR code (qrencode, installed on first use). Low error
# correction keeps long OAuth links small enough for an 80x24 terminal.
show_auth_qr() {
    local url="$1" rows
    is_auth_url "$url" || return 1
    if ! command -v qrencode >/dev/null 2>&1; then
        echo "$(t "Installing the QR code generator (qrencode)...")"
        apt_install qrencode >/dev/null 2>&1
        command -v qrencode >/dev/null 2>&1 || {
            echo "$(t "[WARN] The QR code generator could not be installed: use the link or the browser.")"
            return 1
        }
    fi
    qrencode -t ANSIUTF8 -l L -m 2 "$url" || return 1
    rows=$(qrencode -t ANSIUTF8 -l L -m 2 "$url" 2>/dev/null | wc -l)
    if [ -t 1 ] && [ "${rows:-0}" -gt "$(tput lines 2>/dev/null || echo 24)" ]; then
        echo "$(t "[WARN] The QR code is taller than this window: enlarge it or use the link.")"
    fi
    echo "$(t "Scan it with the phone camera and authorize in the page that opens.")"
    return 0
}

# Methods offered for a link, one tag per line: qr (only when $2 = yes, as
# some flows must return to this very computer), browser (only when one can
# be opened here) and link (always).
auth_methods() {
    [ "${2:-yes}" = "yes" ] && echo qr
    browser_opener >/dev/null && echo browser
    echo link
    return 0
}

# Runs one method: qr | browser | link.
auth_link_render() {
    local method="$1" url="$2"
    case "$method" in
        qr)      show_auth_qr "$url" ;;
        browser) open_in_browser "$url" && echo "$(t "The link was opened in the browser. Authorize there, then come back here.")" ;;
        link)
            echo "$(t "Open this link in a browser:")"
            echo ""
            printf '%s\n' "$url"
            echo ""
            ;;
        *) return 1 ;;
    esac
}

# auth_link_session PID URL QR_OK [HINT]: lets the person pick a method, then
# waits for the tool (PID, a child of this shell) to finish, with keys to
# switch method or cancel. Returns the tool's exit status, or 130 when
# cancelled (the tool is stopped).
auth_link_session() {
    local pid="$1" url="$2" qr_ok="$3" hint="${4:-}" methods=() items=() m choice key keys rc
    mapfile -t methods < <(auth_methods "$url" "$qr_ok")
    for m in "${methods[@]}"; do
        case "$m" in
            qr)      items+=("qr"      "$(t "QR code: scan it with a phone")") ;;
            browser) items+=("browser" "$(t "Open the browser of this computer")") ;;
            link)    items+=("link"    "$(t "Show the link to copy")") ;;
        esac
    done
    choice=$(ui_menu "$(t "Authorization")" "$(t "How do you want to open the authorization page?")" "${items[@]}") \
        || choice="${methods[0]}"
    [ -n "$choice" ] || choice="${methods[0]}"

    AUTH_CANCELLED=0
    trap 'AUTH_CANCELLED=1' INT
    clear
    auth_link_render "$choice" "$url"
    [ -n "$hint" ] && printf '%b\n\n' "$hint"
    keys="[L] $(t "link")"
    [[ " ${methods[*]} " == *" browser "* ]] && keys="[B] $(t "browser")  $keys"
    [[ " ${methods[*]} " == *" qr "* ]] && keys="[Q] $(t "QR code")  $keys"
    echo -e "\e[1;33m$(t "Waiting for the authorization...")\e[0m  $keys  [C] $(t "cancel")"
    while kill -0 "$pid" 2>/dev/null; do
        [ "$AUTH_CANCELLED" = "1" ] && break
        key=""
        read -r -s -n1 -t 2 key </dev/tty 2>/dev/null
        rc=$?
        [ "$rc" -ne 0 ] && [ "$rc" -le 128 ] && sleep 1    # no terminal: just wait
        case "$key" in
            q|Q) [[ " ${methods[*]} " == *" qr "* ]] && { echo ""; auth_link_render qr "$url"; } ;;
            b|B) [[ " ${methods[*]} " == *" browser "* ]] && auth_link_render browser "$url" ;;
            l|L) echo ""; auth_link_render link "$url" ;;
            c|C) AUTH_CANCELLED=1 ;;
        esac
    done
    unshield_signals
    if [ "$AUTH_CANCELLED" = "1" ]; then
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        log "authorization cancelled"
        return 130
    fi
    wait "$pid" 2>/dev/null
}

# Starts COMMAND... in the background with its output in FILE ($1, created
# 0600: rclone prints the OAuth token there) and waits up to 30 s for a link
# matching the regex $2. Sets AUTH_PID and AUTH_URL (no command substitution:
# the tool must stay a child of this shell); returns 1, with the tool
# stopped, when no link appears.
auth_tool_start() {
    local out="$1" pattern="$2" i
    shift 2
    AUTH_PID="" AUTH_URL=""
    ( umask 077; : > "$out" )
    # Without the panel's lock descriptors (see koha_ctl).
    "$@" > "$out" 2>&1 < /dev/null 7>&- 8>&- 9>&- &
    AUTH_PID=$!
    for i in $(seq 1 60); do
        AUTH_URL=$(extract_auth_url "$out" "$pattern") && return 0
        kill -0 "$AUTH_PID" 2>/dev/null || break
        sleep 0.5
    done
    kill "$AUTH_PID" 2>/dev/null
    wait "$AUTH_PID" 2>/dev/null
    AUTH_URL=""
    return 1
}

RCLONE_AUTH_URL_RE='http://127\.0\.0\.1:53682/auth\?state=[A-Za-z0-9_-]+'
CLOUDFLARE_AUTH_URL_RE='https://dash\.cloudflare\.com/argotunnel\?[^[:space:]]+'

# Google Drive authorization on this computer. Google only sends the answer
# back to 127.0.0.1:53682 of the machine running rclone, so a phone cannot
# finish it: no QR code here. On a server reached over SSH the link works
# through a tunnel (ssh -L), which the hint explains. The token is left in
# RCLONE_TOKEN and never printed.
rclone_authorize_here() {
    local out hint="" token rc
    RCLONE_TOKEN=""
    out=$(mktemp /root/.kei-rclone-auth.XXXXXX) || return 1
    if ! auth_tool_start "$out" "$RCLONE_AUTH_URL_RE" rclone authorize "drive" --auth-no-open-browser; then
        echo -e "\e[1;31m[ERROR] $(t "rclone did not print an authorization link (is port 53682 busy?).")\e[0m"
        grep -v '_token' "$out" | tail -n 5
        rm -f "$out"
        return 1
    fi
    if ! browser_opener >/dev/null; then
        hint="$(t "This server has no browser. On your PC, first open an SSH tunnel:")\n  ssh -L 53682:127.0.0.1:53682 ${REAL_USER:-root}@$(get_server_ip)\n$(t "then open the link in the browser of that PC.")\n"
    fi
    hint+="$(t "A QR code is not offered: Google returns only to the computer running rclone.")"
    auth_link_session "$AUTH_PID" "$AUTH_URL" no "$hint"
    rc=$?
    token=$(grep -o '{.*}' "$out" 2>/dev/null | head -n1)
    rm -f "$out"
    [ "$rc" -eq 0 ] && is_rclone_token "$token" || return 1
    RCLONE_TOKEN="$token"
}

# Cloudflare authorization: the page can be opened on any device (the cert
# is fetched by cloudflared itself), so the QR code is offered.
cloudflare_login() {
    local out rc
    out=$(mktemp /root/.kei-cloudflared-login.XXXXXX) || return 1
    if ! auth_tool_start "$out" "$CLOUDFLARE_AUTH_URL_RE" cloudflared tunnel login; then
        tail -n 5 "$out"
        rm -f "$out"
        return 1
    fi
    auth_link_session "$AUTH_PID" "$AUTH_URL" yes "$(t "Select the domain you activated in Cloudflare and click Authorize. Nothing needs to be pasted back.")"
    rc=$?
    rm -f "$out"
    return "$rc"
}

# A complete rclone OAuth token as printed by "rclone authorize": one JSON
# object with the access and refresh tokens and the expiry (a copy cut
# short loses the end). rclone itself checks it with a real write test.
is_rclone_token() {
    [[ "$1" =~ ^\{.*\}$ ]] && [[ "$1" == *'"access_token"'* ]] \
        && [[ "$1" == *'"refresh_token"'* ]] && [[ "$1" == *'"expiry"'* ]]
}

# rclone_token_clean RAW: REPLY = the pasted token as one line of compact
# JSON, safe to hand to rclone.conf. Line breaks, tabs and other control
# characters, a byte-order mark, quotes around the whole token, typographic
# quotes and the \" escaping of a PowerShell copy are removed; with Python
# the JSON itself is checked and written again (a token cut short fails).
rclone_token_clean() {
    local s
    s=$(printf '%s' "${1:-}" | tr -d '\000-\037\177')
    s=${s#$'\xef\xbb\xbf'}
    s=${s//$'\xe2\x80\x9c'/\"}
    s=${s//$'\xe2\x80\x9d'/\"}
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    case "$s" in
        "'{"*"}'"|'"{'*'}"') s=${s:1:${#s}-2} ;;
    esac
    [[ "$s" == *'\"'* ]] && s=${s//\\\"/\"}
    REPLY=$s
    if command -v python3 >/dev/null 2>&1; then
        REPLY=$(printf '%s' "$s" | python3 -c 'import json, sys
d = json.loads(sys.stdin.read())
assert isinstance(d, dict)
print(json.dumps(d, separators=(",", ":")))' 2>/dev/null) || return 1
    fi
    is_rclone_token "$REPLY"
}

# 0 when rclone.conf holds the gdrive token as valid JSON (what was written
# can be read back); without Python only the remote itself is checked.
rclone_token_saved_ok() {
    rclone listremotes 2>/dev/null | grep -qx "gdrive:" || return 1
    command -v python3 >/dev/null 2>&1 || return 0
    rclone config dump 2>/dev/null | python3 -c 'import json, sys
token = json.loads(json.load(sys.stdin)["gdrive"]["token"])
sys.exit(0 if token.get("refresh_token") else 1)' 2>/dev/null
}

# rclone_create_gdrive TOKEN: the gdrive remote with the token cleaned
# (rclone_token_clean), then read back from rclone.conf.
rclone_create_gdrive() {
    rclone_token_clean "$1" || return 1
    rclone config delete gdrive >/dev/null 2>&1 || true
    rclone config create gdrive drive config_is_local false token "$REPLY" --non-interactive < /dev/null || return 1
    if ! rclone_token_saved_ok; then
        echo "rclone.conf: the gdrive token could not be read back"
        rclone config delete gdrive >/dev/null 2>&1 || true
        return 1
    fi
}

function_configure_rclone() {
    require_database || return 0
    command -v rclone >/dev/null 2>&1 || apt_install rclone >/dev/null 2>&1
    [ -f /root/backup_sql.sh ] || write_backup_scripts
    local choice
    choice=$(whiptail --title "$(t "Cloud Backup")" \
        --cancel-button "$(t "Back")" \
        --menu "$(t "How do you want to configure auto cloud backups?")" 16 76 3 \
        "1" "$(t "Express: Generate token on another PC (SSH / Headless)")" \
        "2" "$(t "Express: Authenticate directly on this server")" \
        "3" "$(t "Manual: Standard Rclone Wizard (Other services)")" 3>&1 1>&2 2>&3) || return 0
    [ -z "$choice" ] && return 0

    if [ "$choice" = "1" ]; then
        clear
        echo "======================================================================"
        echo -e "\e[1;36m$(t "EXPRESS GOOGLE DRIVE CONFIGURATION (VIA PERSONAL PC)")\e[0m"
        echo "======================================================================"
        echo ""
        echo "$(t "Because this server has no direct web browser, you can authorize")"
        echo "$(t "the connection from your personal computer (Windows/Mac/Linux).")"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;33m$(t "STEP 1: On your personal PC, open PowerShell as an admin (Windows) or Terminal (Mac/Linux).")\e[0m"
        echo "$(t "If on Windows and 'rclone' is not recognized, install with: winget install Rclone.Rclone")"
        echo ""
        echo '  rclone authorize "drive"'
        echo ""
        echo "$(t "If the above command gives a socket/port error on Windows, run as Administrator:")"
        echo ""
        echo "  wsl --shutdown"
        echo "  net stop winnat"
        echo "  net stop hns"
        echo "  netsh int ipv4 set dynamic tcp start=49152 num=16384"
        echo "  netsh int ipv6 set dynamic tcp start=49152 num=16384"
        echo '  rclone authorize "drive"'
        echo "----------------------------------------------------------------------"
        echo "$(t "STEP 2: Your browser will open. Log in with the library Google account and authorize.")"
        echo "$(t "STEP 3: Your PC will print a long token string starting with '{\"' and ending with '}'.")"
        echo "----------------------------------------------------------------------"
        echo ""
        local token_input="" more
        # Paste, register, test; after a failed test: test again, paste the
        # token again (edit) or go back.
        while true; do
            ALLOW_CTRL_C_RETURN=1
            while true; do
                echo -e "\e[1;32m$(t "Paste the complete token JSON string below and press [ENTER]:")\e[0m"
                if ! read -r token_input; then
                    ALLOW_CTRL_C_RETURN=0
                    return 0
                fi
                # A paste broken over several lines: the rest arrives at once.
                while [[ "$token_input" == *"{"* ]] && [[ "${token_input%"${token_input##*[![:space:]]}"}" != *"}" ]] \
                    && IFS= read -r -t 1 more; do
                    token_input+="$more"
                done
                rclone_token_clean "$token_input"
                token_input=$REPLY
                if [ -z "$token_input" ]; then
                    echo -e "\n\e[1;31m$(t "[ERROR] Token cannot be empty. Try again or press Ctrl+C to cancel.")\e[0m\n"
                    continue
                fi
                if [[ ! "$token_input" =~ ^\{.*\}$ ]]; then
                    echo -e "\n\e[1;31m$(t "[ERROR] Invalid format! Token must start with '{' and end with '}'. Try again:")\e[0m\n"
                    continue
                fi
                if ! is_rclone_token "$token_input"; then
                    echo -e "\n\e[1;31m$(t "[ERROR] Provided JSON is corrupt or was truncated when copying. Try again:")\e[0m\n"
                    continue
                fi
                break
            done
            ALLOW_CTRL_C_RETURN=0
            echo ""
            echo -e "\e[1;34m[INFO] $(t "Registering 'gdrive' remote in Rclone...")\e[0m"
            if ! rclone_create_gdrive "$token_input" >/dev/null 2>&1; then
                echo -e "\e[1;31m[ERROR] $(t "Failed to register connection in Rclone.")\e[0m"
                read -r -p "$(t "Press [ENTER] to return to menu...")"
                return 0
            fi
            echo -e "\e[1;32m[OK] $(t "'gdrive' remote successfully created!")\e[0m"
            REPLY=retry
            while [ "$REPLY" = "retry" ]; do
                validate_and_register_rclone "gdrive" && return 0
                rclone_failure_choice 1
            done
            [ "$REPLY" = "edit" ] || return 0
            clear
        done

    elif [ "$choice" = "2" ]; then
        clear
        echo "======================================================================"
        echo -e "\e[1;36m$(t "DIRECT SERVER AUTHENTICATION (LOCAL / WITH BROWSER OR TUNNEL)")\e[0m"
        echo "======================================================================"
        echo ""
        echo "$(t "Rclone will start an authentication server on this machine on port 53682.")"
        echo "$(t "Log in with the library Google account and authorize: the token is captured automatically.")"
        echo ""
        ALLOW_CTRL_C_RETURN=1
        if rclone_authorize_here; then
            ALLOW_CTRL_C_RETURN=0
            echo ""
            echo -e "\e[1;32m[OK] $(t "Token captured automatically!")\e[0m"
            if rclone_create_gdrive "$RCLONE_TOKEN" >/dev/null 2>&1; then
                RCLONE_TOKEN=""
                echo -e "\e[1;32m[OK] $(t "'gdrive' remote successfully created!")\e[0m"
                until validate_and_register_rclone "gdrive"; do
                    rclone_failure_choice 0
                    [ "$REPLY" = "retry" ] || break
                done
            else
                RCLONE_TOKEN=""
                msg_error "" "$(t "Failed to register gdrive remote in Rclone.")" 8 66
            fi
        else
            ALLOW_CTRL_C_RETURN=0
            echo ""
            echo -e "\e[1;31m[ERROR] $(t "Could not capture token automatically. Try Option 1.")\e[0m"
            echo ""
            pause_terminal
        fi
        return 0

    else
        clear
        rclone config
        local conn_name
        conn_name=$(whiptail --title "$(t "Remote Name")" \
            --inputbox "$(t "Enter the EXACT NAME configured in Rclone:")" 10 70 3>&1 1>&2 2>&3) || return 0
        until validate_and_register_rclone "$conn_name"; do
            rclone_failure_choice 0
            [ "$REPLY" = "retry" ] || break
        done
        return 0
    fi
}

# ======================================================================
