# ======================================================================
# TERMINAL LOOK (installation screens)
# ----------------------------------------------------------------------
# Long tasks show one friendly line each; the commands' own output goes to
# $TUI_LOG (the installation log) and never reaches the screen.
#   tui_header                          title of the screen
#   tui_step N TOTAL ICON "Title" [long]  numbered step with a calm note
#   tui_run "Label" cmd [args...]       Pac-Man eats dots while cmd runs
#                                       (any length of time); the line ends
#                                       as Done! or Failed! and cmd's exit
#                                       code is returned
#   tui_progress CUR TOTAL "Label"      0-100% bar headed by Pac-Man, for
#   tui_progress_end                    tasks that can be counted
#   tui_fail_card "Step" [log]          calm troubleshooting card
#   tui_celebrate IP                    final screen with the real addresses
# cmd runs in the panel's own shell (the variables it sets are kept); the
# animation is a small background process that follows the panel's life.
# A dialog opened by cmd (a question, an error) stops the animation and is
# drawn on the terminal, not in the log.
# Plain terminals (the Linux console, the classic Windows console) get
# ASCII symbols; without a terminal (pipes, tests) nothing is animated.
# ======================================================================
TUI_LOG="$APT_LOG"
TUI_TRACK=20
TUI_ANIM_PID=""
TUI_MOUTH=0

tui_init() {
    TUI_ANIM=0
    [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] && TUI_ANIM=1
    if [ "$TUI_ANIM" = "1" ] && [ -z "${NO_COLOR:-}" ]; then
        TUI_YEL=$'\e[1;33m' TUI_GRN=$'\e[32m' TUI_CYN=$'\e[36m' TUI_RED=$'\e[31m'
        TUI_BLD=$'\e[1m' TUI_DIM=$'\e[2m' TUI_RST=$'\e[0m'
    else
        TUI_YEL="" TUI_GRN="" TUI_CYN="" TUI_RED="" TUI_BLD="" TUI_DIM="" TUI_RST=""
    fi
    TUI_PLAIN="${KEI_PLAIN_GLYPHS:-0}"
    [ "${TERM:-}" = "linux" ] && TUI_PLAIN=1
    if [ "$TUI_PLAIN" = "1" ]; then
        TUI_DOT="." TUI_OK="[OK]" TUI_KO="[X]" TUI_LINE="-" TUI_BAR="|" TUI_TOP="+-" TUI_BOT="+-"
    else
        TUI_DOT="·" TUI_OK="✅" TUI_KO="❌" TUI_LINE="─" TUI_BAR="│" TUI_TOP="╭─" TUI_BOT="╰─"
    fi
}

# REPLY = "$1 " on terminals that draw emoji, "" on plain ones.
tui_icon() { if [ "$TUI_PLAIN" = "1" ]; then REPLY=""; else REPLY="$1 "; fi; }

# Columns a text takes on screen (accents count once, CJK twice).
tui_width() { printf '%s' "$1" | LC_ALL=C.UTF-8 wc -L 2>/dev/null || printf '%s' "${#1}"; }

# REPLY = $2 copies of $1.
tui_rep() { local s; printf -v s '%*s' "$2" ""; REPLY="${s// /$1}"; }

# REPLY = $1 cut or padded to exactly $2 columns.
tui_fit() {
    local s="$1" w="$2" n cut=0
    n=$(tui_width "$s")
    if [ "$n" -gt "$w" ]; then
        s="${s:0:w}"
        n=$(tui_width "$s")
        while [ "$n" -gt $((w - 1)) ]; do s="${s%?}"; n=$(tui_width "$s"); done
        s+="${TUI_DOT}"
        n=$((n + 1))
        cut=1
    fi
    printf -v REPLY '%s%*s' "$s" $((w - n)) ""
    return "$cut"
}

tui_cols() {
    local c
    c=$(tput cols 2>/dev/null)
    [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 40 ] || c=80
    printf '%s' "$c"
}

tui_cursor_hide() { [ "$TUI_ANIM" = "1" ] && { tput civis 2>/dev/null || printf '\e[?25l'; }; return 0; }
tui_cursor_show() { [ -t 1 ] && { tput cnorm 2>/dev/null || printf '\e[?25h'; }; return 0; }

# Stops the animation (also called on exit, CTRL+C included).
tui_stop_anim() {
    [ -n "$TUI_ANIM_PID" ] || return 0
    kill "$TUI_ANIM_PID" 2>/dev/null
    wait "$TUI_ANIM_PID" 2>/dev/null
    TUI_ANIM_PID=""
    tui_cursor_show
}

# Label column of the task lines: what is left of the terminal after the
# indentation, the bar and the result.
tui_label_width() {
    local w a b
    a=$(tui_width "$(t "Done!")"); b=$(tui_width "$(t "Failed!")")
    [ "$b" -gt "$a" ] && a=$b
    # "   " label "  [" track "] " icon " " result, one column spare.
    w=$(( $(tui_cols) - 3 - 3 - TUI_TRACK - 2 - 3 - a - 1 ))
    [ "$w" -gt 36 ] && w=36
    [ "$w" -lt 12 ] && w=12
    printf '%s' "$w"
}

tui_header() {
    local rule sub
    tui_rep "$TUI_LINE" 60; rule=$REPLY
    tui_icon "📚"
    printf '\n   %s%s%s%s%s\n' "$REPLY" "$TUI_CYN" "$TUI_BLD" "$(panel_name)" "$TUI_RST"
    printf '   %s%s%s\n' "$TUI_DIM" "$rule" "$TUI_RST"
    sub="$(t "Setting up your library, step by step. We take care of the technical part.")"
    printf '   %s\n' "$sub"
}

# tui_title ICON "Title": the heading of a panel screen that runs tasks.
tui_title() {
    local rule
    tui_rep "$TUI_LINE" 60; rule=$REPLY
    tui_icon "$1"
    printf '\n   %s%s%s%s\n' "$REPLY" "$TUI_CYN$TUI_BLD" "$2" "$TUI_RST"
    printf '   %s%s%s\n' "$TUI_DIM" "$rule" "$TUI_RST"
    tui_icon "☕"
    printf '   %s%s%s%s\n\n' "$TUI_DIM" "$REPLY" "$(t "This might take a few minutes. Please keep this window open.")" "$TUI_RST"
    log "screen: $2"
}

# tui_step N TOTAL ICON "Title" [long]
tui_step() {
    local note
    tui_icon "$3"
    printf '\n %s%s%s[%s/%s]%s %s%s%s\n' "$REPLY" "$TUI_CYN" "$TUI_BLD" "$1" "$2" "$TUI_RST" "$TUI_BLD" "$4" "$TUI_RST"
    if [ "${5:-}" = "long" ]; then
        note="$(t "This is the longest step: it can take 10 to 20 minutes. Please keep this window open.")"
    else
        note="$(t "This might take a few minutes. Please keep this window open.")"
    fi
    tui_icon "☕"
    printf '   %s%s%s%s\n' "$TUI_DIM" "$REPLY" "$note" "$TUI_RST"
    log "step $1/$2: $4"
}

# REPLY = the looping track: dots Pac-Man has not eaten yet in this lap.
tui_track_loop() {
    local pos="$1" mouth="$2" eaten dots
    printf -v eaten '%*s' "$pos" ""
    tui_rep "$TUI_DOT" $((TUI_TRACK - pos - 1)); dots=$REPLY
    REPLY="${eaten}${TUI_YEL}${mouth}${TUI_RST}${TUI_DIM}${dots}${TUI_RST}"
}

# tui_task_line LABEL RC: the finished line.
tui_task_line() {
    local label="$2" bar
    tui_rep "=" "$TUI_TRACK"; bar=$REPLY
    if [ "$1" -eq 0 ]; then
        printf '\r\e[K   %s  %s[%s%s%s%s]%s %s %s%s%s\n' "$label" "$TUI_DIM" "$TUI_RST" "$TUI_GRN" "$bar" "$TUI_DIM" "$TUI_RST" \
            "$TUI_OK" "$TUI_GRN" "$(t "Done!")" "$TUI_RST"
    else
        tui_rep "-" "$TUI_TRACK"; bar=$REPLY
        printf '\r\e[K   %s  %s[%s%s%s%s]%s %s %s%s%s\n' "$label" "$TUI_DIM" "$TUI_RST" "$TUI_RED" "$bar" "$TUI_DIM" "$TUI_RST" \
            "$TUI_KO" "$TUI_RED" "$(t "Failed!")" "$TUI_RST"
    fi
}

# tui_run "Label" cmd [args...]  (Mode A: unknown duration)
tui_run() {
    local label="$1" rc TUI_IN_RUN=1 full="$1"
    shift
    tui_fit "$label" "$(tui_label_width)"; label=$REPLY
    mkdir -p "$(dirname "$TUI_LOG")" 2>/dev/null
    printf '\n===== %s | %s =====\n' "$(date '+%F %T')" "$1" >>"$TUI_LOG" 2>/dev/null
    if [ "$TUI_ANIM" = "1" ]; then
        tui_cursor_hide
        (
            trap 'exit 0' TERM
            pos=0 frame=0
            while kill -0 "$$" 2>/dev/null; do
                if [ $((frame % 2)) -eq 0 ]; then m="C"; else m="c"; fi
                tui_track_loop "$pos" "$m"
                printf '\r\e[K   %s  %s[%s%s%s]%s' "$label" "$TUI_DIM" "$TUI_RST" "$REPLY" "$TUI_DIM" "$TUI_RST"
                frame=$((frame + 1))
                pos=$(( (pos + 1) % TUI_TRACK ))
                sleep 0.15
            done
        ) &
        TUI_ANIM_PID=$!
    fi
    [ -n "${KEI_TASK:-}" ] && kei_emit step "$full"
    # Its output goes to the log, where the panel cannot answer a question.
    KEI_TASK_INTERACTIVE=0 "$@" >>"$TUI_LOG" 2>&1 </dev/null
    rc=$?
    tui_stop_anim
    if [ -n "${KEI_TASK:-}" ]; then
        kei_emit done "$rc $full"
        log "task '${1}': exit $rc"
        return "$rc"
    fi
    tui_task_line "$rc" "$label"
    log "task '${1}': exit $rc"
    return "$rc"
}

# REPLY = $1 with the thousands separator of the panel language.
tui_thousands() {
    local n="$1" out="" sep=","
    case "${SYS_LANG:-en}" in
        pt|es|de|it|nl|id|tr|vi) sep="." ;;
        fr|ru|uk|pl|cs|sv) sep=" " ;;
    esac
    while [ "${#n}" -gt 3 ]; do out="${sep}${n: -3}${out}"; n="${n:0:${#n}-3}"; done
    REPLY="${n}${out}"
}

# tui_progress CUR TOTAL "Label"  (Mode B: 45% [=========C··········] (5,625 / 12,500))
# Call it as often as wanted; end the line with tui_progress_end.
tui_progress() {
    local cur="${1:-0}" total="${2:-0}" label pct head done_n bar rest counts a b
    [[ "$cur" =~ ^[0-9]+$ ]] || cur=0
    [[ "$total" =~ ^[0-9]+$ ]] && [ "$total" -gt 0 ] || total=1
    [ "$cur" -gt "$total" ] && cur=$total
    # Without a terminal only the finished line is printed.
    [ "$TUI_ANIM" = "1" ] || [ "$cur" -eq "$total" ] || return 0
    pct=$((cur * 100 / total))
    done_n=$((cur * TUI_TRACK / total))
    tui_rep "=" "$done_n"; bar=$REPLY
    if [ "$cur" -lt "$total" ]; then
        TUI_MOUTH=$((1 - TUI_MOUTH))
        if [ "$TUI_MOUTH" = "1" ]; then head="C"; else head="c"; fi
        tui_rep "$TUI_DOT" $((TUI_TRACK - done_n - 1)); rest=$REPLY
        bar="${TUI_GRN}${bar}${TUI_RST}${TUI_YEL}${head}${TUI_RST}${TUI_DIM}${rest}${TUI_RST}"
        tui_cursor_hide
    else
        bar="${TUI_GRN}${bar}${TUI_RST}"
    fi
    tui_thousands "$cur"; a=$REPLY
    tui_thousands "$total"; b=$REPLY
    counts="${TUI_DIM}(${a} / ${b})${TUI_RST}"
    tui_fit "$3" "$(tui_label_width)"; label=$REPLY
    printf '\r\e[K   %s  %3d%% %s[%s%s%s]%s %s' "$label" "$pct" "$TUI_DIM" "$TUI_RST" "$bar" "$TUI_DIM" "$TUI_RST" "$counts"
    TUI_PROGRESS_OPEN=1
}

tui_progress_end() {
    [ "${TUI_PROGRESS_OPEN:-0}" = "1" ] && printf '\n'
    TUI_PROGRESS_OPEN=0
    tui_cursor_show
}

# Last lines of a log, readable: no carriage returns or colour codes.
tui_log_tail() {
    tail -n "$(( ${2:-6} * 3 ))" "$1" 2>/dev/null | tr -d '\r' | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' \
        | grep -v -e '^[[:space:]]*$' -e '^===== ' | cut -c1-66 | tail -n "${2:-6}"
}

# tui_fail_card "Step" [log]: a calm card instead of a wall of text.
tui_fail_card() {
    local step="$1" file="${2:-$TUI_LOG}" rule line
    tui_stop_anim
    tui_rep "$TUI_LINE" 60; rule=$REPLY
    tui_icon "🧰"
    printf '\n   %s%s%s %s%s%s%s\n' "$TUI_DIM" "$TUI_TOP" "$TUI_RST" "$REPLY" "$TUI_BLD" "$(t "Something needs attention")" "$TUI_RST"
    tui_card_text ""
    tui_card_text "$(t 'The step "${step}" could not be completed.')"
    tui_card_text "$(t "Nothing was lost. This usually comes from the internet connection, a full disk or another installation running at the same time.")"
    tui_card_text ""
    tui_card_text "$(t "Check the internet connection and the free disk space, then run option 1 again.")"
    tui_card_text "$(t "If it happens again, send this file to your IT support:")"
    printf '   %s%s%s     %s%s%s\n' "$TUI_DIM" "$TUI_BAR" "$TUI_RST" "$TUI_CYN" "$file" "$TUI_RST"
    if [ -s "$file" ]; then
        tui_card_text ""
        tui_card_text "$(t "Last lines of the log:")"
        while IFS= read -r line; do
            printf '   %s%s     %s%s\n' "$TUI_DIM" "$TUI_BAR" "$line" "$TUI_RST"
        done < <(tui_log_tail "$file" 6)
    fi
    printf '   %s%s%s%s\n\n' "$TUI_DIM" "$TUI_BOT" "$rule" "$TUI_RST"
}

# One paragraph of the card, wrapped at 64 columns behind its left border.
tui_card_text() {
    local line
    if [ -z "$1" ]; then printf '   %s%s%s\n' "$TUI_DIM" "$TUI_BAR" "$TUI_RST"; return 0; fi
    while IFS= read -r line; do
        printf '   %s%s%s  %s\n' "$TUI_DIM" "$TUI_BAR" "$TUI_RST" "$line"
    done < <(tui_wrap "$1" 64)
}

# tui_wrap TEXT WIDTH: TEXT in lines of WIDTH columns, broken between words
# (inside a word only when it is longer than a line, as CJK sentences are).
# Counts characters, not bytes; CJK characters take two columns.
tui_wrap() {
    local width="$2" word cur="" k=1 max words=()
    case "${SYS_LANG:-en}" in ja|zh|ko) k=2 ;; esac
    max=$((width / k))
    read -ra words <<< "$1"
    for word in "${words[@]}"; do
        while [ "${#word}" -gt "$max" ]; do
            [ -n "$cur" ] && { printf '%s\n' "$cur"; cur=""; }
            printf '%s\n' "${word:0:max}"
            word="${word:max}"
        done
        if [ -z "$cur" ]; then
            cur="$word"
        elif [ $(( (${#cur} + 1 + ${#word}) * k )) -le "$width" ]; then
            cur+=" $word"
        else
            printf '%s\n' "$cur"; cur="$word"
        fi
    done
    [ -n "$cur" ] && printf '%s\n' "$cur"
    return 0
}

# tui_celebrate IP [FAILURES]: the addresses come from this machine's own
