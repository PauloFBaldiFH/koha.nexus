our %SMALL_TALK_TRIGGER = map { $_ => 1 } qw(
    hi hello hey hiya morning afternoon evening thanks thank bye goodbye you your help assistant
    olá ola oi dia tarde noite obrigado obrigada valeu tchau você voce vc ajuda ajude
