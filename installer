# The page: Perl code around the strings of the panel language.
cutter_page_script() {
    cat <<'CUTPL1'
#!/usr/bin/perl

# cutter_calculator.pl (koha-easy-installer)
# The author number of the call number while cataloguing: the notation of
# the library's Cutter-Sanborn or PHA table (the entry right before the name
# in alphabetical order, the initial, the number and, unless turned off, the
# initial of the title without its article; an anonymous work is entered by
# its title), with the edition and the copy when given, worked out by
# KohaEasy::Cataloguing::Rules::author_code, the same rules as the panel. The class number shows the call numbers of the
# catalogue that already use the same Cutter number in that class.
# Opened from the Cutter button next to 090 / 092 $b and the item call
# number (952 $o), "Use in the record" puts the notation in that field;
# otherwise it is copied. ?format=json answers with the result as JSON.
# Installed and removed by the panel (Library tools > Cutter Calculator).
#
# Read only: nothing in Koha is changed by this page. The table is the
# library's own copy, loaded by the panel; it is not distributed with it.
#
# Under Koha's persistent Plack the Perl process lives between requests:
# no named sub captures file-scope lexical variables (package variables).

use Modern::Perl;
use CGI qw ( -utf8 );
use C4::Auth qw( checkauth );
use C4::Context;
use Encode qw( decode encode );
use JSON::PP;
use MIME::Base64 qw( decode_base64 );
use KohaEasy::Cataloguing::Rules;

sub _d { return decode( 'UTF-8', decode_base64( $_[0] ) ) }
CUTPL1
    local k
    printf "our %%TABLES = ( cutter => '%s', pha => '%s' );\nour \$CDD_INDEX = '%s';\nour %%CACHE;\nour %%T = (\n" "$(cat_table_path cutter)" "$(cat_table_path pha)" "$CDD_DB"
    for k in $CUTTER_KEYS; do
        printf '    %s => _d(q{%s}),\n' "$k" "$(cutter_text "$k" | base64 -w0)"
    done
    printf ');\n'
    cat <<'CUTPL2'

run();

sub h {
    my $s = shift // '';
    $s =~ s/&/&amp;/g;
    $s =~ s/</&lt;/g;
    $s =~ s/>/&gt;/g;
    $s =~ s/"/&quot;/g;
    $s =~ s/'/&#39;/g;
    return $s;
}

sub run {
    my $cgi = CGI->new;
    # Any member of the staff who can see the catalogue (read only).
    my ( $user, $cookie ) = checkauth( $cgi, 0, { catalogue => 1 }, 'intranet' );
    my %p = map { my $v = $cgi->param($_) // ''; $v =~ s/^\s+|\s+$//g; $v =~ s/\s+/ /g; ( $_ => substr( $v, 0, 300 ) ) } qw( name title ind2 mode class bn target format table edition copy noletter scheme c080 c082 c084 subjects );
    $p{mode}   = 'auto'   unless $p{mode} =~ /^(auto|person|corporate|title)$/;
    $p{scheme} = 'auto'   unless $p{scheme} =~ /^(auto|cdd|cdu|local)$/;
    # The table asked for when it is loaded, otherwise PHA, otherwise Cutter-Sanborn (as the AI cataloguing).
    my @loaded = grep { -s $TABLES{$_} } qw( pha cutter );
    $p{table}    = $loaded[0] // '' unless grep { $_ eq $p{table} } @loaded;
    $p{edition}  = '' unless $p{edition} =~ /^[0-9]{1,3}$/;
    $p{copy}     = '' unless $p{copy} =~ /^[0-9]{1,4}$/;
    $p{noletter} = $p{noletter} eq '1' ? '1' : '';
    $p{target} = ''       unless $p{target} =~ /^[A-Za-z0-9_-]{1,80}$/;
    $p{bn}     = ''       unless $p{bn} =~ /^[0-9]{1,10}$/;
    $p{ind2}   = ''       unless $p{ind2} =~ /^[0-9]$/;
    for my $k (qw( class c080 c082 c084 )) { $p{$k} = '' unless $p{$k} =~ m{^[\p{L}0-9./ ()\[\]:"=+-]{1,40}$} }
    $p{subjects} =~ s/[\x00-\x1f<>]//g;
    # From the item editor only the record is known: its 100 / 110 / 245 / 08x / 650.
    from_record( \%p ) if $p{bn} ne '' && $p{name} eq '' && $p{title} eq '';
    my $r = calculate( \%p );
    if ( $p{format} eq 'json' ) {
        print $cgi->header( -type => 'application/json', -cookie => $cookie, -charset => 'utf-8' );
        print JSON::PP->new->utf8->canonical->encode($r);
        return;
    }
    print $cgi->header( -cookie => $cookie, -charset => 'utf-8' );
    print encode( 'UTF-8', $p{format} eq 'part' ? result_html( \%p, $r ) : page( \%p, $r ) );
    return;
}

sub xml_text {
    my $s = shift // '';
    $s =~ s/&lt;/</g;
    $s =~ s/&gt;/>/g;
    $s =~ s/&quot;/"/g;
    $s =~ s/&apos;/'/g;
    $s =~ s/&#(\d+);/chr $1/ge;
    $s =~ s/&#x([0-9a-fA-F]+);/chr hex $1/ge;
    $s =~ s/&amp;/&/g;
    return $s;
}

# The heading, title and class of a catalogue record (MARCXML).
sub from_record {
    my $p = shift;
    my ($xml) = eval { C4::Context->dbh->selectrow_array( q{SELECT metadata FROM biblio_metadata WHERE biblionumber = ? AND format = 'marcxml'}, undef, $p->{bn} ) };
    return unless defined $xml;
    $xml = decode( 'UTF-8', $xml ) unless utf8::is_utf8($xml);
    my $sub = sub {
        my ( $tag, $code ) = @_;
        my ($f) = $xml =~ m{<datafield tag="$tag"[^>]*>(.*?)</datafield>}s or return '';
        my ($v) = $f =~ m{<subfield code="$code">([^<]*)</subfield>} or return '';
        return KohaEasy::Cataloguing::Rules::trim( xml_text($v) );
    };
    my ( $a100, $a110, $a111, $t245 ) = ( $sub->( '100', 'a' ), $sub->( '110', 'a' ), $sub->( '111', 'a' ), $sub->( '245', 'a' ) );
    $t245 =~ s/[\s\/:;=.]+$//;
    my ($ind2) = $xml =~ m{<datafield tag="245"[^>]*ind2="([0-9])"};
    if    ( $a100 ne '' )          { ( $p->{name} = $a100 ) =~ s/[,.\s]+$//; $p->{mode} = 'person' }
    elsif ( "$a110$a111" ne '' )   { $p->{name} = $a110 ne '' ? $a110 : $a111; $p->{mode} = 'corporate' }
    else                           { $p->{mode} = 'title' }
    $p->{title} = $t245;
    $p->{ind2}  = $ind2 // '';
    ( $p->{edition} ) = $sub->( '250', 'a' ) =~ /^\D{0,3}([0-9]{1,3})/ if $p->{edition} eq '';
    $p->{edition} //= '';
    my $ok = sub { my $v = shift; return $v =~ m{^[\p{L}0-9./ ()\[\]:"=+-]{1,40}$} ? $v : '' };
    $p->{class} = $ok->( $sub->( '090', 'a' ) ) if $p->{class} eq '';
    $p->{"c$_"} = $ok->( $sub->( $_, 'a' ) ) for qw( 080 082 084 );
    if ( $p->{subjects} eq '' ) {
        my @s = map { m{<subfield code="a">([^<]*)</subfield>} ? KohaEasy::Cataloguing::Rules::trim( xml_text($1) ) : () } $xml =~ m{<datafield tag="650"[^>]*>(.*?)</datafield>}sg;
        s/[\s.]+$// for @s;
        $p->{subjects} = join ' ; ', grep { $_ ne '' } @s[ 0 .. ( $#s < 2 ? $#s : 2 ) ];
    }
    return;
}

# ----------------------------------------------------------------------
# The class of the call number: CDD, CDU or the library's own (local)
# codes, told from the settings, the record or the call numbers of the
# catalogue, and suggested from the catalogue (titles of the same author,
# the same subjects, words of the title) and the CDD index when the record
# has none. These are hints: the cataloguer decides.
# ----------------------------------------------------------------------

# The scheme a call number looks like: cdd (869.3), cdu (821.134.3(81),
# 82-3), local (LIT, INF J: letters first) or ''.
sub scheme_of {
    my $cn = shift // '';
    return 'cdd'   if $cn =~ /(?:^|\s)\d{3}(?:\.\d+)?(?=\s|$)/;
    return 'cdu'   if $cn =~ m{(?:^|\s)\d[\d.]*(?:[(:"=+/-]|\.\d+\.)} || $cn =~ /(?:^|\s)\d{1,2}(?:\.\d+)?(?=\s|$)/;
    return 'local' if $cn =~ /^\s*\p{L}[\p{L}.-]*(?:\s|$)/;
    return '';
}

# The class part of a call number in SCHEME ("R 869.3 A848d" -> 869.3,
# "821.134.3(81)-1 A848d" -> 821.134.3(81)-1, "LIT INF A848d" -> LIT INF).
sub class_of {
    my ( $cn, $scheme ) = @_;
    $cn //= '';
    return $1 if $scheme eq 'cdd' && $cn =~ /(?:^|\s)(\d{3}(?:\.\d+)?)(?=\s|$)/;
    if ( $scheme eq 'cdu' && $cn =~ m{(?:^|\s)(\d[\d.:()"=+/-]*)} ) { ( my $c = $1 ) =~ s{[.:=+/-]+$}{}; return $c }
    if ( $scheme eq 'local' && $cn =~ /^\s*\p{L}/ ) {
        my @t;
        for ( split ' ', $cn ) { last if /^\p{Lu}\d{1,4}\p{Ll}*$/ || /\d{3}/; push @t, $_ }
        return join ' ', @t;
    }
    return '';
}

# How the catalogue's call numbers look: { cdd, cdu, local, total } of the
# latest 2000 items, kept ten minutes (Plack keeps the process).
sub collection_schemes {
    return $CACHE{schemes} if $CACHE{schemes} && time - $CACHE{at} < 600;
    my $rows = eval {
        C4::Context->dbh->selectall_arrayref( q{/* kei-cutter:sample */
            SELECT itemcallnumber FROM items WHERE itemcallnumber IS NOT NULL AND itemcallnumber <> '' ORDER BY itemnumber DESC LIMIT 2000} );
    } || [];
    my %n = ( total => 0 );
    for (@$rows) { my $s = scheme_of( $_->[0] ) or next; $n{$s}++; $n{total}++ }
    $CACHE{at} = time;
    return $CACHE{schemes} = \%n;
}

# ( scheme, why, count, total ): the settings, the class typed, the class
# fields of the record (082 CDD, 080 CDU, 084 other), then the catalogue.
sub detect_scheme {
    my $p = shift;
    return ( $p->{scheme}, 'setting' ) if $p->{scheme} ne 'auto';
    if ( my $s = scheme_of( $p->{class} ) ) { return ( $s, 'class' ) }
    return ( 'cdu', 'record', '080' ) if $p->{c080} ne '' && $p->{c082} eq '';
    return ( 'cdd', 'record', '082' ) if $p->{c082} ne '';
    return ( 'local', 'record', '084' ) if $p->{c084} ne '';
    my $n = collection_schemes();
    if ( $n->{total} ) {
        my ($s) = sort { ( $n->{$b} // 0 ) <=> ( $n->{$a} // 0 ) || $a cmp $b } qw( cdd cdu local );
        return ( $s, 'collection', $n->{$s} // 0, $n->{total} );
    }
    return ( 'cdd', 'default' );
}

sub _like { my $t = shift; $t =~ s/([%_\\])/\\$1/g; return $t }

# Call numbers of other records than BN near this one: [ call number, biblionumber ].
# author: biblio.author starts with the heading; subject: a 650 $a holds
# it; words: the title has all the words.
sub near {
    my ( $kind, $bn, @like ) = @_;
    my $cond = {
        author  => 'b.author LIKE ?',
        subject => q{ExtractValue(m.metadata, '//datafield[@tag="650"]/subfield[@code="a"]') LIKE ?},
        words   => join( ' AND ', ('b.title LIKE ?') x @like ),
    }->{$kind};
    my $join = $kind eq 'subject' ? 'JOIN biblio_metadata m ON m.biblionumber = i.biblionumber' : 'JOIN biblio b ON b.biblionumber = i.biblionumber';
    return eval {
        C4::Context->dbh->selectall_arrayref( qq{/* kei-cutter:$kind */
            SELECT i.itemcallnumber, i.biblionumber FROM items i $join
            WHERE $cond AND i.biblionumber <> ? AND i.itemcallnumber <> '' LIMIT 400}, undef, @like, $bn eq '' ? 0 : $bn );
    } || [];
}

# Classes for a record without one: [ { class, score, why => [ { kind, n, label } ] } ],
# best first. HEADING is the author as the catalogue writes it.
sub suggestions {
    my ( $p, $scheme, $heading ) = @_;
    my %s;
    my $add = sub {
        my ( $kind, $label, $weight, $rows ) = @_;
        my %by;
        for (@$rows) { my $c = class_of( $_->[0], $scheme ); $by{$c}{ $_->[1] } = 1 if $c ne '' }
        for my $c ( keys %by ) {
            my $n = scalar keys %{ $by{$c} };
            my $x = $s{$c} //= { class => $c, score => 0, why => [] };
            $x->{score} += $weight * $n;
            push @{ $x->{why} }, { kind => $kind, n => $n, label => $label };
        }
    };
    ( my $h = $heading // '' ) =~ s/[,.\s]+$//;
    $add->( 'author', $h, 3, near( 'author', $p->{bn}, _like($h) . '%' ) ) if length $h >= 3;
    my @subj = grep { length >= 3 } map { KohaEasy::Cataloguing::Rules::trim($_) } split /;/, $p->{subjects};
    splice @subj, 3 if @subj > 3;
    $add->( 'subject', $_, 2, near( 'subject', $p->{bn}, '%' . _like($_) . '%' ) ) for @subj;
    my @w = grep { length >= 4 && !KohaEasy::Cataloguing::Rules::is_article( lc $_ ) } split /[^\p{L}\p{N}]+/, KohaEasy::Cataloguing::Rules::title_rest( $p->{title}, $p->{ind2} );
    splice @w, 4 if @w > 4;
    $add->( 'words', join( ' ', @w ), 1, near( 'words', $p->{bn}, map { '%' . _like($_) . '%' } @w ) ) if @w;
    # The CDD index of the library (CDD lookup), when it was built.
    if ( $scheme eq 'cdd' && -s $CDD_INDEX && eval { require KohaEasy::CDD; 1 } ) {
        my $dbh = eval { KohaEasy::CDD::connect_db($CDD_INDEX) };
        for my $q ( grep { $_ ne '' } @subj, $p->{title} ) {
            last unless $dbh;
            my $found = eval { KohaEasy::CDD::search( $dbh, $q, 3 ) } || [];
            for my $x (@$found) {
                next unless $x->{num} =~ /^\d{3}(?:\.\d+)?$/;
                my $y = $s{ $x->{num} } //= { class => $x->{num}, score => 0, why => [] };
                $y->{score} += 1;
                push @{ $y->{why} }, { kind => 'cdd', n => 0, label => $x->{heading} } unless grep { $_->{kind} eq 'cdd' } @{ $y->{why} };
            }
        }
    }
    my @r = sort { $b->{score} <=> $a->{score} || $a->{class} cmp $b->{class} } values %s;
    splice @r, 6 if @r > 6;
    return \@r;
}

# The class part of the result: scheme, class from the record, suggestions.
sub class_part {
    my ( $p, $r, $heading ) = @_;
    my ( $scheme, $why, $n, $t ) = detect_scheme($p);
    my %field = ( cdd => '082', cdu => '080', local => '084' );
    if ( $p->{class} eq '' ) {
        my $v = $p->{ 'c' . $field{$scheme} };
        my $c = $scheme eq 'cdd' ? ( ( $v =~ /(\d{3}(?:\.\d+)?)/ )[0] // '' ) : $v;
        if ( $c ne '' ) { $p->{class} = $c; $r->{class_from} = $field{$scheme} }
    }
    $r->{scheme}     = $scheme;
    $r->{scheme_why} = $why;
    $r->{scheme_field} = $n if $why eq 'record';
    $r->{scheme_count} = [ $n, $t ] if $why eq 'collection';
    # No class, or a CDD class without its decimals (800, 869): suggestions.
    if ( $p->{class} eq '' || ( $scheme eq 'cdd' && $p->{class} =~ /^\d{3}$/ ) ) {
        $r->{suggestions} = suggestions( $p, $scheme, $heading );
        $r->{suggested_class} = $r->{suggestions}[0]{class} if $p->{class} eq '' && @{ $r->{suggestions} };
    }
    return;
}

# Call numbers of the catalogue with the class and the Cutter number BASE
# (A848, not A8481), other records than BN: [ call number, author, title ].
sub used {
    my ( $class, $base, $bn ) = @_;
    ( my $c = $class ) =~ s/([.()\[\]+*?^\$|{}\\])/\\$1/g;
    $c =~ s/ /[[:space:]]+/g;
    my $re = "(^|[[:space:]])${c}[[:space:]]+${base}([^0-9]|\$)";
    return eval {
        C4::Context->dbh->selectall_arrayref( q{/* kei-cutter:used */
            SELECT DISTINCT i.itemcallnumber, COALESCE(b.author, ''), COALESCE(b.title, '')
            FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber
            WHERE i.itemcallnumber REGEXP ? AND i.biblionumber <> ?
            ORDER BY i.itemcallnumber LIMIT 20}, undef, $re, $bn eq '' ? 0 : $bn );
    } || [];
}

# The result: { notation, entry, number, read_as, call_number, used,
# alternatives } or { error => no_table | no_letter | no_entry }.
sub calculate {
    my $p = shift;
    my %r = map { $_ => $p->{$_} } qw( name title ind2 mode table edition copy subjects );
    my $name = $p->{name};
    my $mode = $p->{mode} eq 'auto' ? ( $name ne '' ? 'person' : 'title' ) : $p->{mode};
    $r{mode} = $mode;
    # "Machado de Assis" is read "Assis, Machado de" (AACR2, as the AI cataloguing does).
    if ( $mode eq 'person' && index( $name, ',' ) < 0 && $name =~ /^\p{L}\S* / ) {
        $name = KohaEasy::Cataloguing::Rules::invert_name($name);
        $r{read_as} = $name;
    }
    class_part( $p, \%r, $mode eq 'title' ? '' : $name );
    $r{class} = $p->{class};
    if ( $p->{table} eq '' ) { $r{error} = 'no_table'; return \%r }
    return \%r if ( $mode eq 'title' ? $p->{title} : $name ) eq '';
    my $n = KohaEasy::Cataloguing::Rules::author_code(
        table => $TABLES{ $p->{table} }, name => $name, title => $p->{title}, ind2 => $p->{ind2}, mode => $mode,
        title_letter => $p->{noletter} ? 0 : 1, edition => $p->{edition}, copy => $p->{copy} );
    if ( $n->{error} ) {
        $r{error} = { 2 => 'no_table', 3 => 'no_letter', 4 => 'no_entry' }->{ $n->{error} } // 'no_letter';
        return \%r;
    }
    my $L = substr( $n->{notation}, 0, 1 );
    $r{$_} = $n->{$_} for qw( code notation entry number );
    $r{call_number} = join ' ', grep { $_ ne '' } $p->{class}, $n->{code};
    $r{suggested_call_number} = "$r{suggested_class} $n->{code}" if $r{suggested_class};
    if ( $p->{class} ne '' ) {
        $r{used} = [ map { { call_number => $_->[0], author => $_->[1], title => $_->[2] } } @{ used( $p->{class}, $L . $n->{number}, $p->{bn} ) } ];
        $r{alternatives} = [ map { { number => $L . $_, free => @{ used( $p->{class}, $L . $_, $p->{bn} ) } ? JSON::PP::false : JSON::PP::true } } grep { $_ ne '' } $n->{prev}, $n->{next} ]
            if @{ $r{used} };
    }
    return \%r;
}

sub fill { my ( $s, %v ) = @_; $s =~ s{\{(\w+)\}}{$v{$1} // ''}ge; return $s }

# Why a class is suggested, in words.
sub why_text {
    my $w = shift;
    return fill( $T{sug_cdd}, s => $w->{label} ) if $w->{kind} eq 'cdd';
    return fill( $T{"sug_$w->{kind}"}, n => $w->{n}, s => $w->{label} );
}

# The classification of the call number and, without a class, the suggestions.
sub class_html {
    my ( $p, $r ) = @_;
    return '' unless $r->{scheme};
    my $why = $r->{scheme_why} eq 'record' ? fill( $T{w_record}, f => $r->{scheme_field} )
        : $r->{scheme_why} eq 'collection' ? fill( $T{w_collection}, n => $r->{scheme_count}[0], t => $r->{scheme_count}[1] )
        : $T{"w_$r->{scheme_why}"};
    my $html = '<div class="cls">' . h( $T{f_scheme} ) . ': <b>' . h( $T{"s_$r->{scheme}"} ) . '</b> <span class="hint">(' . h($why) . ')</span>'
        . ( $r->{class_from} ? ' &middot; <span class="hint">' . h( fill( $T{class_from}, f => $r->{class_from}, c => $r->{class} ) ) . '</span>' : '' ) . '</div>';
    $html .= '<p class="hint">' . h( $T{cdu_note} ) . '</p>' if $r->{scheme} eq 'cdu' && $r->{suggestions};
    return $html unless $r->{suggestions};
    $html .= '<h3>' . h( $T{sug_title} ) . '</h3>';
    return $html . '<p class="hint">' . h( $T{sug_none} ) . '</p>' unless @{ $r->{suggestions} };
    return $html . '<table class="list sug"><tbody>' . join(
        '',
        map {
            '<tr><td class="n">' . h( $_->{class} ) . '</td><td>' . join( ' &middot; ', map { h( why_text($_) ) } @{ $_->{why} } )
                . '</td><td class="act"><button type="button" class="use" data-class="' . h( $_->{class} ) . '">' . h( $T{use_class} ) . '</button></td></tr>'
        } @{ $r->{suggestions} }
    ) . '</tbody></table>';
}

sub result_html {
    my ( $p, $r ) = @_;
    my $cls = class_html( $p, $r );
    return '<div class="msg warn">' . h( $T{ $r->{error} } ) . '</div>' . $cls if $r->{error};
    return '<p class="hint">' . h( $T{intro} ) . '</p>' . $cls unless $r->{notation};
    my $class = $p->{class} ne '' ? $p->{class} : $r->{suggested_class} // '';
    my $full  = $p->{class} ne '' ? $r->{call_number} : $r->{suggested_call_number} // '';
    my $apply = $p->{target} ne '' ? ' <button type="button" class="apply" data-n="' . h( $r->{code} ) . '" data-c="' . h($class) . '">' . h( $T{apply} ) . '</button>' : '';
    my $html = '<div class="res"><div class="big">' . h( $r->{code} ) . '</div><div class="facts">'
        . '<div>' . h( $T{entry} ) . ': <b>' . h( $r->{entry} ) . '</b> (' . h( $r->{number} ) . ')</div>'
        . ( $r->{read_as} ? '<div>' . h( $T{read_as} ) . ': ' . h( $r->{read_as} ) . '</div>' : '' )
        . ( $p->{class} ne '' ? '<div>' . h( $T{call_number} ) . ': <b>' . h( $r->{call_number} ) . '</b></div>' : '' )
        . ( $p->{class} eq '' && $full ne '' ? '<div>' . h( $T{suggested} ) . ': <b>' . h($full) . '</b></div>' : '' )
        . '</div><div class="acts"><button type="button" class="copy" data-v="' . h( $r->{code} ) . '">' . h( $T{copy} ) . '</button>'
        . ( $full ne '' ? ' <button type="button" class="copy" data-v="' . h($full) . '">' . h( $T{copy_cn} ) . '</button>' : '' )
        . $apply . '</div></div>' . $cls;
    return $html if $p->{class} eq '';
    return $html . '<p class="ok">' . h( $T{not_used} ) . '</p>' unless @{ $r->{used} };
    $html .= '<p>' . h( $T{used} ) . '</p><table class="list"><tbody>'
        . join( '', map { '<tr><td class="n">' . h( $_->{call_number} ) . '</td><td>' . h( $_->{author} ) . '</td><td>' . h( $_->{title} ) . '</td></tr>' } @{ $r->{used} } )
        . '</tbody></table>';
    if ( @{ $r->{alternatives} } ) {
        $html .= '<p>' . h( $T{other} ) . '</p><ul class="alt">'
            . join( '', map { '<li><b>' . h( $_->{number} ) . '</b> (' . h( $_->{free} ? $T{free} : $T{in_use} ) . ')</li>' } @{ $r->{alternatives} } )
            . '</ul>';
    }
    return $html;
}

sub page {
    my ( $p, $r ) = @_;
    my $count = 0;
    if ( $p->{table} ne '' && open( my $fh, '<', $TABLES{ $p->{table} } ) ) { $count++ while <$fh>; close $fh }
    ( my $info = $T{table_info} ) =~ s/\{n\}/$count/;
    my $opts = sub { my $cur = shift; join '', map { '<option value="' . $_->[0] . '"' . ( $cur eq $_->[0] ? ' selected' : '' ) . '>' . h( $_->[1] ) . '</option>' } @_ };
    my $sel = $opts->( $p->{mode}, [ auto => $T{m_auto} ], [ person => $T{m_person} ], [ corporate => $T{m_corporate} ], [ title => $T{m_title} ] );
    my $tsel = $opts->( $p->{table}, map { [ $_ => $T{"t_$_"} ] } grep { -s $TABLES{$_} } qw( pha cutter ) );
    my $nol = $p->{noletter} ? ' checked' : '';
    my $ssel = $opts->( $p->{scheme}, map { [ $_ => $T{"s_$_"} ] } qw( auto cdd cdu local ) );
    my $stab = $opts->( '', map { [ $_ => $T{"t_$_"} ] } grep { -s $TABLES{$_} } qw( pha cutter ) );
    my $sset = $opts->( '', map { [ $_ => $T{"s_$_"} ] } qw( auto cdd cdu local ) );
    my $js   = JSON::PP->new->ascii->encode( { target => $p->{target}, copied => $T{copied}, gone => $T{gone} } );
    my $home = $p->{target} ? '' : '<a class="back" href="/cgi-bin/koha/cataloguing/cataloging-home.pl">' . h( $T{cataloguing} ) . '</a>';
    my $res  = result_html( $p, $r );
    my $f    = sub { my $k = shift; return h( $p->{$k} ) };
    return <<"HTML" . page_script($js);
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@{[ h( $T{title} ) ]}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; color: #222; background: #fff; }
    header { background: #408540; color: #fff; padding: 10px 16px; display: flex; gap: 16px; align-items: center; }
    header h1 { font-size: 1.2em; margin: 0; } header a.back { color: #fff; font-size: .9em; text-decoration: none; }
