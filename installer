# The page: Perl code around the strings of the panel language.
cdd_page_script() {
    cat <<'CDDPL1'
#!/usr/bin/perl

# cdd_lookup.pl (koha-easy-installer)
# The CDD (Dewey Decimal Classification) while cataloguing: search by
# number or by words of the subject, the hierarchy above and below each
# number, the numbers of the list of subjects, how a number not printed in
# the schedules was probably built, and how many titles of the library
# already use each class (the class number of the item call numbers).
# Opened from the button next to the class fields of the cataloguing form
# (082, 083, 090, 092, item call number), the number chosen goes into that
# field ("Use in the record"); otherwise it is copied. Installed and removed
# by the panel (Library tools > CDD lookup).
#
# Read only: nothing in Koha is changed by this page. The index is built by
# the panel from the library's own copy of the CDD (KohaEasy::CDD); the
# DDC is copyrighted by OCLC and is not distributed with the panel.
#
# Under Koha's persistent Plack the Perl process lives between requests:
# no named sub captures file-scope lexical variables (package variables).

use Modern::Perl;
use CGI qw ( -utf8 );
use C4::Auth qw( checkauth );
use C4::Context;
use Encode qw( decode encode );
use JSON::PP;
use MIME::Base64 qw( decode_base64 );
use KohaEasy::CDD;

sub _d { return decode( 'UTF-8', decode_base64( $_[0] ) ) }
CDDPL1
    local k
    printf "our \$INDEX = '%s';\nour %%CTX;\nour %%CACHE;\nour %%T = (\n" "$CDD_DB"
    for k in $CDD_KEYS; do
        printf '    %s => _d(q{%s}),\n' "$k" "$(cdd_text "$k" | base64 -w0)"
    done
    printf ');\n'
    cat <<'CDDPL2'

run();

sub h {
    my $s = shift // '';
    $s =~ s/&/&amp;/g;
    $s =~ s/</&lt;/g;
    $s =~ s/>/&gt;/g;
    $s =~ s/"/&quot;/g;
    $s =~ s/'/&#39;/g;
    return $s;
}

sub u { my $s = encode( 'UTF-8', shift // '' ); $s =~ s/([^A-Za-z0-9_.~-])/sprintf( '%%%02X', ord $1 )/ge; return $s }

# Link to the page, keeping the field of the cataloguing form it serves.
sub link_to {
    my %p = @_;
    $p{target} = $CTX{target} if $CTX{target};
    return 'cdd_lookup.pl?' . join( '&amp;', map { u($_) . '=' . u( $p{$_} ) } sort grep { defined $p{$_} && $p{$_} ne '' } keys %p );
}

sub num_link {
    my ( $num, $label ) = @_;
    return '<a class="num" href="' . link_to( n => $num ) . '">' . h( $label // KohaEasy::CDD::display_number($num) ) . '</a>';
}

sub run {
    my $cgi = CGI->new;
    # Any member of the staff who can see the catalogue (read only).
    my ( $user, $cookie ) = checkauth( $cgi, 0, { catalogue => 1 }, 'intranet' );
    print $cgi->header( -cookie => $cookie, -charset => 'utf-8' );

    %CTX = ( target => '', edition => '' );
    my $target = $cgi->param('target') // '';
    $CTX{target} = $target if $target =~ /^[A-Za-z0-9_-]{1,80}$/;
    my ( $q, $n, $t, $hint ) = map { my $v = $cgi->param($_) // ''; $v =~ s/^\s+|\s+$//g; substr( $v, 0, 400 ) } qw( q n t hint );

    my $dbh = -r $INDEX ? eval { KohaEasy::CDD::connect_db($INDEX) } : undef;
    my $meta = $dbh ? eval { KohaEasy::CDD::meta($dbh) } : undef;
    if ( !$meta ) {
        render_page( '<div class="msg warn">' . h( $T{no_index} ) . '</div>', '' );
        return;
    }
    $CTX{edition} = $meta->{edition} // '';

    my $body;
    my $num = KohaEasy::CDD::clean_number( $n ne '' ? $n : $q );
    if ( $t =~ /^[1-6]$/ ) {
        $body = table_view( $dbh, $meta, $t );
    } elsif ( defined $num && ( $n ne '' || $q ne '' ) ) {
        $body = number_view( $dbh, $meta, $num );
        $q = KohaEasy::CDD::display_number($num) if $n eq '';
    } elsif ( $q ne '' ) {
        $body = search_view( $dbh, $q );
    } else {
        $body = home_view( $dbh, $meta, $hint );
    }
    render_page( $body, $q, $meta );
    $dbh->disconnect;
    return;
}

# ----------------------------------------------------------------------
# The collection: class numbers of the call numbers of the items (the
# first number with three digits, "R 869.3 A848d" -> 869.3), counted once
# for the whole collection and kept a minute (Plack keeps the process).
# ----------------------------------------------------------------------

sub classes {
    return $CACHE{classes} if $CACHE{classes} && time - $CACHE{at} < 60;
    my $rows = eval {
        C4::Context->dbh->selectall_arrayref( q{/* kei-cdd:classes */
            SELECT c, COUNT(DISTINCT biblionumber), COUNT(*)
            FROM (SELECT REGEXP_SUBSTR(itemcallnumber, '[0-9]{3}([.][0-9]+)?') AS c, biblionumber FROM items WHERE itemcallnumber REGEXP '[0-9]{3}') x
            GROUP BY c} );
    } || [];
    $CACHE{classes} = { map { $_->[0] => [ $_->[1], $_->[2] ] } grep { defined $_->[0] && $_->[0] ne '' } @$rows };
    $CACHE{at} = time;
    return $CACHE{classes};
}

# The start of the class numbers under NUM (800 -> "8", 810 -> "81").
sub class_prefix {
    my $num = shift;
    return $num if $num =~ /\./;
    ( my $p = $num ) =~ s/0+$//;
    return $p eq '' ? substr( $num, 0, 1 ) : $p;
}

# ( titles, items ) with exactly NUM and ( titles, items ) with NUM and the
# numbers under it; a range counts the numbers inside it.
sub usage {
    my $num = shift;
    my $c   = classes();
    my @r   = ( 0, 0, 0, 0 );
    return @r if $num =~ /^T/;
    if ( $num =~ /^(\d{3}(?:\.\d+)?)-(\d{3}(?:\.\d+)?)$/ ) {
        my ( $a, $b ) = ( KohaEasy::CDD::digits($1), KohaEasy::CDD::digits($2) );
        my $w = length $b;
        $a = substr( $a . '0' x $w, 0, $w );
        for my $k ( keys %$c ) {
            my $d = substr( KohaEasy::CDD::digits($k), 0, $w );
            next unless $d ge $a && $d le $b;
            $r[2] += $c->{$k}[0];
            $r[3] += $c->{$k}[1];
        }
        return @r;
    }
    @r[ 0, 1 ] = @{ $c->{$num} // [ 0, 0 ] };
    my $p = class_prefix($num);
    for my $k ( keys %$c ) {
        next unless index( $k, $p ) == 0;
        $r[2] += $c->{$k}[0];
        $r[3] += $c->{$k}[1];
    }
    return @r;
}

sub usage_cell {
    my $num = shift;
    my ( $t, $i, $tb, $ib ) = usage($num);
    return '<span class="none">&ndash;</span>' unless $tb;
    my $s = $t ? '<b>' . $t . '</b> ' . h( $T{titles} ) : '';
    $s .= ( $s ne '' ? ' ' : '' ) . '<span class="sub">+' . ( $tb - $t ) . ' ' . h( $T{with_sub} ) . '</span>' if $tb > $t;
    return $s;
}

# Titles of the library in NUM and under it: [ biblionumber, title, author, call number ].
sub titles_in {
    my $num = shift;
    return [] if $num =~ /^T/;
    my ($start) = $num =~ /^(\d{3}(?:\.\d+)?)/;
    my $rows = eval {
        C4::Context->dbh->selectall_arrayref( q{/* kei-cdd:titles */
            SELECT b.biblionumber, b.title, b.author, MIN(i.itemcallnumber) AS cn
            FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber
            WHERE REGEXP_SUBSTR(i.itemcallnumber, '[0-9]{3}([.][0-9]+)?') LIKE ?
            GROUP BY b.biblionumber, b.title, b.author ORDER BY cn, b.title LIMIT 15}, undef, class_prefix($start) . '%' );
    };
    return $rows || [];
}

# How the library classified titles (or authors) with the words of a search.
sub classified_as {
    my @tok = grep { length >= 3 } @_;
    return [] unless @tok;
    splice @tok, 5 if @tok > 5;
    my $where = join ' AND ', map {'(b.title LIKE ? OR b.author LIKE ?)'} @tok;
    my $rows = eval {
        C4::Context->dbh->selectall_arrayref( qq{/* kei-cdd:words */
            SELECT REGEXP_SUBSTR(i.itemcallnumber, '[0-9]{3}([.][0-9]+)?') AS c, COUNT(DISTINCT b.biblionumber) AS n
            FROM biblio b JOIN items i ON i.biblionumber = b.biblionumber
            WHERE i.itemcallnumber REGEXP '[0-9]{3}' AND $where
            GROUP BY c ORDER BY n DESC, c LIMIT 8}, undef, map { ( "%$_%", "%$_%" ) } @tok );
    };
    return $rows || [];
}

# ----------------------------------------------------------------------
# Views
# ----------------------------------------------------------------------

# Buttons of a number: use it in the field of the record, copy it.
sub actions {
    my ( $num, $status ) = @_;
    return '' if $num =~ /-/ || $status eq 'bracket';
    my $d = h( KohaEasy::CDD::display_number($num) );
    my $s = '';
    $s .= '<button type="button" class="apply" data-num="' . $d . '">' . h( $T{apply} ) . '</button>' if $CTX{target} && $num !~ /^T/;
    $s .= '<button type="button" class="copy" data-num="' . $d . '">' . h( $T{copy} ) . '</button>';
    return '<span class="actions">' . $s . '</span>';
}

sub badge {
    my $x = shift;
    return '<span class="badge no">' . h( $T{st_bracket} ) . '</span>' if ( $x->{status} // '' ) eq 'bracket';
    return '<span class="badge opt">' . h( $T{st_option} ) . '</span>' if ( $x->{status} // '' ) eq 'option';
    return '<span class="badge idx">' . h( $T{st_index} ) . '</span>' if ( $x->{kind} // '' ) eq 'index';
    return '';
}

# Numbers in the notes become links ("classe em 641.5", "T1—09", and "—072"
# in the notes of a table: a number of the same table).
sub notes_html {
    my ( $notes, $tbl ) = @_;
    my $s = h($notes);
    $s =~ s{(T[1-6])\s?\x{2014}\s?(\d+)|(?<![\w\x{2014}])\x{2014}\s?(\d+)|(?<![\d.,])(\d{3}(?:[.,]\d+)?)(?![\d])}{
        defined $1 ? num_link( "$1-$2", "$1\x{2014}$2" )
        : defined $3 ? ( $tbl ? "\x{2014}" . num_link( "T$tbl-$3", $3 ) : "\x{2014}$3" )
        : do { ( my $n = $4 ) =~ tr/,/./; '<a class="num" href="' . link_to( n => $n ) . '">' . $4 . '</a>' }
    }ge;
    return $s;
}

sub result_rows {
    my ($rows) = @_;
    my $html = '';
    for my $x (@$rows) {
        my @other = grep { KohaEasy::CDD::norm($_) ne KohaEasy::CDD::norm( $x->{heading} ) } @{ $x->{terms} // [] };
        $html .= '<tr><td class="n">' . num_link( $x->{num} ) . '</td><td>'
            . '<div class="head">' . h( $x->{heading} ) . ' ' . badge($x) . '</div>'
            . ( @other ? '<div class="terms">' . join( ' &middot; ', map { h($_) } @other ) . '</div>' : '' )
            . ( ( $x->{snippet} // '' ) ne '' ? '<div class="snip">' . h( $x->{snippet} ) . '</div>' : '' )
            . '</td><td class="use">' . usage_cell( $x->{num} ) . '</td><td class="act">' . actions( $x->{num}, $x->{status} // '' ) . '</td></tr>';
    }
    return $html;
}

sub results_table {
    my ($rows) = @_;
    return '<table class="list"><thead><tr><th>CDD</th><th></th><th>' . h( $T{in_library} ) . '</th><th></th></tr></thead><tbody>' . result_rows($rows) . '</tbody></table>';
}

sub search_view {
    my ( $dbh, $q ) = @_;
    my $r = KohaEasy::CDD::search( $dbh, $q, 40 );
    my $html = '<h2>' . h( $T{results} ) . '</h2>';
    $html .= @$r ? results_table($r) : '<p class="msg warn">' . h( $T{no_results} ) . '</p>';
    my $w = classified_as( KohaEasy::CDD::tokens($q) );
    if (@$w) {
        $html .= '<h3>' . h( $T{words} ) . '</h3><ul class="words">'
            . join( '', map { '<li>' . num_link( $_->[0] ) . ' <span class="sub">' . $_->[1] . ' ' . h( $T{titles} ) . '</span></li>' } @$w ) . '</ul>';
    }
    return $html;
}

sub classes_grid {
    my ($rows) = @_;
    return '<div class="grid">' . join(
        '',
        map {
            my ( undef, undef, $tb ) = usage( $_->{num} );
            '<a class="cell" href="' . link_to( n => $_->{num} ) . '"><span class="n">' . h( KohaEasy::CDD::display_number( $_->{num} ) ) . '</span> '
                . h( $_->{heading} ) . ( $tb ? ' <span class="sub">' . $tb . ' ' . h( $T{titles} ) . '</span>' : '' ) . '</a>'
        } @$rows
    ) . '</div>';
}

sub home_view {
    my ( $dbh, $meta, $hint ) = @_;
    my $html = '';
    # Opened from the cataloguing form: the title and the subjects of the
    # record are searched at once.
    my @parts = grep { /\S/ } split /\s*;\s*/, $hint;
    if (@parts) {
        my ( %seen, @rows );
        for my $p ( @parts[ 0 .. ( $#parts < 3 ? $#parts : 3 ) ] ) {
            for my $x ( @{ KohaEasy::CDD::search( $dbh, $p, 5 ) } ) {
                push @rows, $x unless $seen{ $x->{num} }++;
            }
        }
        $html .= '<h2>' . h( $T{suggest} ) . '</h2><p class="hint">' . h( $T{from} ) . ': ' . join( ' &middot; ', map { h($_) } @parts ) . '</p>'
            . ( @rows ? results_table( \@rows ) : '<p class="msg warn">' . h( $T{no_results} ) . '</p>' );
    }
    $html .= '<h2>' . h( $T{main_classes} ) . '</h2>' . classes_grid( KohaEasy::CDD::roots($dbh) );
    return $html;
}

sub table_name {
    my ( $meta, $t ) = @_;
    return $T{table} . " $t" . ( $meta->{"t$t"} ? " \x{2014} " . $meta->{"t$t"} : '' );
}

sub table_view {
    my ( $dbh, $meta, $t ) = @_;
    my $rows = KohaEasy::CDD::roots( $dbh, $t );
    return '<h2>' . h( table_name( $meta, $t ) ) . '</h2>' . ( @$rows ? results_table($rows) : '<p class="msg warn">' . h( $T{no_results} ) . '</p>' );
}

sub number_view {
    my ( $dbh, $meta, $num ) = @_;
    my $x    = KohaEasy::CDD::entry( $dbh, $num );
    my $up   = KohaEasy::CDD::ancestors( $dbh, $num );
    my $html = '<nav class="crumbs"><a href="' . link_to() . '">' . h( $T{main_classes} ) . '</a>';
    $html .= ' &rsaquo; <a href="' . link_to( t => $1 ) . '">' . h( $T{table} . " $1" ) . '</a>' if $num =~ /^T(\d)/;
    $html .= ' &rsaquo; ' . num_link( $_->{num} ) . ' <span class="sub">' . h( $_->{heading} ) . '</span>' for @$up;
    $html .= '</nav>';

    my $terms = $num =~ /^T/ ? [] : KohaEasy::CDD::terms_of( $dbh, $num );
    my $heading = $x ? $x->{heading} : $terms->[0] // '';
    my $shown = { %{ $x // { kind => @$terms ? 'index' : '' } } };
    $html .= '<div class="entry"><div class="big">' . h( KohaEasy::CDD::display_number($num) ) . '</div><div><div class="title">' . h($heading) . ' ' . badge($shown) . '</div>'
        . actions( $num, $x ? $x->{status} : '' ) . '</div></div>';
    $html .= '<p class="notes">' . notes_html( $x->{notes}, $x->{tbl} ) . '</p>' if $x && $x->{notes} ne '';
    my @other = grep { KohaEasy::CDD::norm($_) ne KohaEasy::CDD::norm($heading) } @$terms;
    $html .= '<h3>' . h( $T{subjects} ) . '</h3><p>' . join( ' &middot; ', map { h($_) } @other ) . '</p>' if @other;

    for my $r ( @{ KohaEasy::CDD::ranges_with( $dbh, $num ) } ) {
        next if $r->{num} eq $num;
        $html .= '<p>' . h( $T{within} ) . ' ' . num_link( $r->{num} ) . ': ' . h( $r->{heading} ) . '</p>';
    }

    # A number made with the tables (not printed in the schedules).
    if ( ( !$x || $x->{kind} eq 'main' ) && $num =~ /^\d{3}\.\d/ ) {
        my $steps = KohaEasy::CDD::analyse( $dbh, $num );
        if (@$steps) {
            $html .= '<div class="msg info"><b>' . h( $T{built} ) . '</b><br>' . h( $T{analysis} ) . ': '
                . join( ' + ', map { $_->{num} ne '' ? num_link( $_->{num} ) . ( $_->{add} ne '' ? ' (' . h( $_->{add} ) . ')' : '' ) . ' ' . h( $_->{heading} ) : h( $_->{add} ) . ' <i>(' . h( $T{rest} ) . ')</i>' } @$steps )
                . '<br><span class="hint">' . h( $T{analysis_hint} ) . '</span></div>';
        }
    }

    my $kids = $num =~ /^T/ || $num =~ /^\d/ ? KohaEasy::CDD::children( $dbh, $num ) : [];
    $html .= '<h3>' . h( $T{narrower} ) . '</h3>' . results_table($kids) if @$kids;

    if ( $num !~ /^T/ ) {
        my $below = KohaEasy::CDD::terms_below( $dbh, $num, 60 );
        if (@$below) {
            $html .= '<h3>' . h( $T{subjects_below} ) . '</h3><table class="list"><tbody>'
                . join( '', map { '<tr><td class="n">' . num_link( $_->{num} ) . '</td><td>' . h( $_->{term} ) . '</td><td class="use">' . usage_cell( $_->{num} ) . '</td><td class="act">' . actions( $_->{num}, '' ) . '</td></tr>' } @$below )
                . '</tbody></table>';
        }
        $html .= build_box($num) if $num =~ /^\d{3}(?:\.\d+)?$/ && ( !$x || $x->{status} ne 'bracket' );

        my ( $t, $i, $tb, $ib ) = usage($num);
        $html .= '<h3>' . h( $T{in_library} ) . '</h3><p><b>' . $t . '</b> ' . h( $T{titles} ) . ', ' . $i . ' ' . h( $T{items} )
            . ( $tb > $t ? ' <span class="sub">(' . $tb . ' ' . h( $T{titles} ) . ', ' . $ib . ' ' . h( $T{items} ) . ' ' . h( $T{incl_sub} ) . ')</span>' : '' ) . '</p>';
        my $list = titles_in($num);
        if (@$list) {
            $html .= '<p class="hint">' . h( $T{lib_titles} ) . '</p><table class="list"><tbody>'
                . join( '', map { '<tr><td class="n">' . h( $_->[3] ) . '</td><td><a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=' . int( $_->[0] ) . '" target="_blank">' . h( $_->[1] ) . '</a> <span class="sub">' . h( $_->[2] ) . '</span></td></tr>' } @$list )
                . '</tbody></table>';
        }
    }
    return $html;
}

# Adds the notation of a table to the number (worked out in the page).
sub build_box {
    my $num = shift;
    my $d = h($num);
    return '<h3>' . h( $T{build} ) . '</h3><div class="build" data-base="' . $d . '"><span class="big2">' . $d . '</span> + <input type="text" id="kei-add" size="10" maxlength="20" inputmode="numeric" placeholder="09"> = <span class="big2" id="kei-built">' . $d . '</span> '
        . '<a id="kei-look" class="btn" href="' . link_to( n => $num ) . '">' . h( $T{lookup} ) . '</a> '
        . actions( $num, '' ) . '<p class="hint">' . h( $T{build_hint} ) . '</p></div>';
}

