def _load_map(path):
    m = {}
    if path and os.path.exists(path):
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if parts and parts[0]:
                    m[R.norm_header(parts[0])] = parts[0]
                    if len(parts) > 1 and parts[1]:
                        m.setdefault(R.norm_header(parts[1]), parts[0])
    return m


def _sha(path):
    if os.path.isdir(path):
        return "folder"
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()[:16]


def _sample_iso(path, n=2):
    out = []
    with open(path, "rb") as fh:
        for leader, fields in marc.iso2709_records(fh, n):
            out.append(marc.iso_to_record(leader, fields).formatted())
    return out


def _columns_text(plan):
    lines = []
    for c in plan.columns:
        if c.role:
            how = {"accepted": "%.2f" % c.score, "answered": "your answer", "profile": "saved answer"}.get(c.status, "%.2f" % c.score)
            lines.append("  %-30s -> %s (%s)" % (flat(c.header, 30), c.role, how))
        else:
            lines.append("  %-30s -> - (left out)" % flat(c.header, 30))
    return lines


ENTITY_TEXT = {"biblio": "books and copies", "patrons": "patrons", "mixed": "books and copies, with patrons in the same rows",
               "koha_patrons": "patrons in Koha's own layout", "circulation": "loans or holds (not imported by this version)",
               "skip": "nothing to import (left out)", None: "unclear"}


def build(opts):
    a = analyse(opts)
    log = sys.stdout
    if a.questions.open:
        print("Open questions: %d (answer them first)" % len(a.questions.open), file=log)
        return 6
    if a.needs:
        for n in sorted(a.needs):
            print("Needs package: %s" % n, file=log)
        return 7
    out_dir = os.path.join(opts.work, "out")
    os.makedirs(out_dir, exist_ok=True)
    itypes = _load_map(opts.itypes)
    cats = _load_map(opts.categories)
    today = date.fromisoformat(opts.today) if opts.today else date.today()
    preview = ["File: %s (sha256 %s)" % (os.path.basename(opts.src.rstrip("/")), _sha(opts.src)), ""]
    manifest = []
    totals = Counter()
    for d in a.detections:
        if d.kind != "part":
            preview.append("%s: %s" % (d.member.display, detect.KINDS.get(d.kind, d.kind)))
    for name, why in a.intake.skipped:
        preview.append("%s: skipped, %s" % (name, why))
    for name, why in a.unsupported:
        preview.append("Not imported: %s: %s" % (name, why))
    for d in a.koha_backups:
        preview.append("Koha backup (goes to Restore database, not imported here): %s" % d.member.display)
    preview.append("")

    # ---- spreadsheets
    grouper = group.Grouper(opts.branch, opts.itype, itypes, today, a.isbn_answer == "merge")
    pats = patrons.Patrons(opts.cpf_attr, cats, today)
    has_bib = False
    for n, p in enumerate(a.tables, 1):
        t = p.table
        head = "== %s  (%s" % (t.name, t.format)
        if t.encoding:
            head += ", encoding %s" % t.encoding
        if getattr(t, "separator", None):
            head += ', separator "%s"' % t.separator
        preview.append(head + ")")
        ev = "" if p.entity in ("koha_patrons", "skip") else "  (evidence: bibliographic %d, personal %d, circulation %d)" % p.evidence
        preview.append("Holds: %s%s%s" % (ENTITY_TEXT.get(p.entity, p.entity), " [your answer]" if p.how == "answered" else (" [saved answer]" if p.how == "profile" else ""), ev))
        if p.entity == "koha_patrons":
            path = os.path.join(out_dir, "patrons-koha-%d.csv" % n)
            k = patrons.write_koha_layout(t, path)
            match = "cardnumber" if "cardnumber" in t.headers else "userid"
            manifest.append(("patrons", "CSV", "UTF-8", path, k, 0, match, t.name))
            totals["patrons"] += k
            preview.append("Patrons: %d (columns as they are: %s)" % (k, ", ".join(t.headers)))
        elif p.entity in ("biblio", "patrons", "mixed"):
            preview.extend(_columns_text(p))
            preview.append("Rows: %d" % len(t.data()))
            if getattr(t, "deleted", 0):
                preview.append("Deleted rows in the table (left out): %d" % t.deleted)
            if p.entity in ("biblio", "mixed"):
                if any(c.role == "title" for c in p.columns):
                    has_bib = True
                    _feed(grouper, p)
                else:
                    preview.append("No title column: no record can be built from this table.")
            if p.entity in ("patrons", "mixed"):
                has_card = any(c.role == "cardnumber" for c in p.columns)
                has_name = any(c.role in ("fullname", "surname") for c in p.columns)
                if not has_name or not (has_card or any(c.role == "cpf" for c in p.columns)):
                    preview.append("Patrons need a name column and a card number or CPF column: none built from this table.")
                else:
                    first_line = 2 if t.header_row else 1
                    for i, row in enumerate(t.data()):
                        v = {k: (x if isinstance(x, str) else "; ".join(x)) for k, x in _row_values(p, row).items()
                             if classify.ROLES[k][0] == "pat"}
                        if v:
                            pats.add(v, first_line + i, t.name, p.entity == "patrons", has_card)
            if p.asked or p.how == "answered":
                Questions.save_profile(os.path.join(opts.work, "profiles-new"), t.headers, p.entity, p.columns)
        preview.append("")
    if has_bib:
        grouper.plan()
        recs = grouper.records()
        st = grouper.stats
        preview.append("== Records built from the spreadsheets (MARCXML for Koha's staged import)")
