"""Questions for the operator, their answers and the mapping profiles.

The engine never prompts: it writes the open questions to questions.tsv and
the panel asks them in its own dialogs, in the operator's language, then
runs the engine again with answers.tsv. Answers about the columns of a table
are saved as a profile keyed by its column names, so the next file with the
same columns needs no question."""
import hashlib
import json
import os

from . import rules as R


def qid(*parts):
    return hashlib.sha1("\x1f".join(str(p) for p in parts).encode("utf-8")).hexdigest()[:12]


def flat(s, n=160):
    s = R.clean(s).replace("\t", " ")
    return s if len(s) <= n else s[:n - 1] + "…"


class Questions:
    def __init__(self, answers_path=None, profiles_dir=None):
        self.answers = {}
        self.open = []          # [(id, type, where, subject, samples, options)]
        if answers_path and os.path.exists(answers_path):
            with open(answers_path, encoding="utf-8") as fh:
                for line in fh:
                    parts = line.rstrip("\n").split("\t")
                    if len(parts) >= 2 and parts[0]:
                        self.answers[parts[0]] = parts[1]
        self.profiles_dir = profiles_dir

    def answer(self, id_, options):
        a = self.answers.get(id_)
        return a if a in options else None

    def ask(self, id_, kind, where, subject, samples, options):
        if not any(q[0] == id_ for q in self.open):
            # An item field's subject lists each subfield's role: never cut.
            self.open.append((id_, kind, flat(where, 90), flat(subject, 400 if kind == "items" else 90), flat(samples), ",".join(options)))

    def write(self, path):
        with open(path, "w", encoding="utf-8") as fh:
            for q in self.open:
                fh.write("\t".join(q) + "\n")

