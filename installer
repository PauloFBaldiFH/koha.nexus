# Loans and holds of the Biblioteca Fácil database: counted in a rolled back
# transaction first, then added in one transaction after a PRE-CIRCULATION backup.
_lt_br_bfdb_circ() {
    local circ="$1" check="$2" log linked open holds old new held
    log=$(tools_log bf-circulation)
    display_explanation "Preview (dry run): nothing is changed yet..."
    if ! koha_sql_run "$log" "$check"; then
        ui_textbox "$(t "Legacy migration")" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    linked=$(tools_num "$log" "Loans to add:"); open=$(tools_num "$log" "Open loans to add:"); holds=$(tools_num "$log" "Holds to add:")
    tools_output "$log" | grep -E '^(Loans|Open loans|Holds) ' > "$TOOLS_WORK/bf-circulation.txt"
    ui_textbox "$(t "Preview (dry run)")" "$TOOLS_WORK/bf-circulation.txt"
    if [ $((linked + holds)) -eq 0 ]; then
        msg_info "$(t "Legacy migration")" "$(t 'No loan or hold to add: they are already in Koha, or the collection and the patrons must be imported first.\nNothing was changed.\n\nLog: ${log}')" 12 76
        return 0
    fi
    prompt_yes_no "$(t "Legacy migration")" "$(t 'Loans: ${linked} (${open} still open)\nHolds: ${holds}\n\nAdd them to Koha now? A verified backup is made first.')" 12 72 defaultno || return 0
    tools_safety_backup CIRCULATION || return 1
    display_explanation "Applying the changes..."
    if ! koha_sql_run "$log" "$circ"; then
        ui_textbox "$(t "Legacy migration")" "$log"
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    old=$(tools_num "$log" "Returned loans added:"); new=$(tools_num "$log" "Open loans added:"); held=$(tools_num "$log" "Holds added:")
    log "tools: Biblioteca Fácil loans and holds added (returned=$old open=$new holds=$held)"
    if [ -n "$MAGIC_RUN" ]; then
        MAGIC_N_LOANS=$((MAGIC_N_LOANS + old + new)); MAGIC_N_HOLDS=$((MAGIC_N_HOLDS + held))
        return 0
    fi
    msg_ok "$(t '✅ Loans and holds added.\n\nReturned loans: ${old}\nOpen loans: ${new}\nHolds: ${held}\n\nSafety backup: ${TOOLS_PRE}\nLog: ${log}')" 15 76
}

# ----------------------------------------------------------------------
# ISIS catalogue: the PostgreSQL export ("backup") of the CDS/ISIS database,
# a pg_dump of the acervo table (one row per MFN, the tombos of every copy
# in "registro") and of the occurrences. Read with its noise, compression and
# encoding detected, cleaned (tombos split on hyphens, commas and carets) and
# turned into MARC 21 with one 952 item per tombo, which the Magic Import
# Tool hands to the staged MARC import (its own preview, confirmation and
# PRE-* backup). The format is
# described in docs/isis-format.md.
# ----------------------------------------------------------------------
isis_write_reader() {
    cat > "$1" <<'ISISDB'
use strict;
use warnings;
use utf8;
use Getopt::Long;
use Encode qw( decode encode );
use POSIX qw( strftime );

# koha-easy-installer: reads the ISIS catalogue from its PostgreSQL export
# (a pg_dump "backup": plain SQL text with COPY or INSERT data, also gzip,
# bzip2, zlib or zip compressed; a custom-format dump goes through
# pg_restore when it is installed) and builds MARC 21 records, one per MFN,
# with one 952 item per tombo (accession number) of the "registro" field.
# The format and the cleaning rules are described in docs/isis-format.md.
#   --marc FILE  write the records (ISO 2709, UTF-8)
#   --dry-run    print the report and a sample
# Exit codes: 4 = not a PostgreSQL dump, 5 = no catalogue table in it.
my %o = ( sample => 2, lang => 'por', country => 'bl ' );
GetOptions( \%o, 'in=s', 'marc=s', 'branch=s', 'itype=s', 'dry-run', 'sample=i', 'lang=s' ) or exit 2;
$o{branch} //= ''; $o{itype} //= '';

binmode STDOUT, ':encoding(UTF-8)';
sub fail { my ( $code, $msg ) = @_; print "$msg\n"; exit $code }
sub norm { my $s = lc( shift // '' ); $s =~ tr/áàâãäéèêëíìîïóòôõöúùûüçñ/aaaaaeeeeiiiiooooouuuucn/; $s =~ s/[^a-z0-9]+/ /g; $s =~ s/^ | $//g; return $s }
my ( %stat, @warn, %review );

# ---------------------------------------------------------------- file
open( my $fh, '<:raw', $o{in} // '' ) or fail( 1, "Cannot read " . ( $o{in} // '(no file)' ) );
my $d = do { local $/; <$fh> };
close $fh;
my @layers;
for ( 1 .. 4 ) {
    my ( $out, $how );
    if ( $d =~ /^\x1f\x8b/ ) {
        require IO::Uncompress::Gunzip; $how = 'gzip';
        IO::Uncompress::Gunzip::gunzip( \$d => \$out, MultiStream => 1, Transparent => 0 ) or undef $out;
    } elsif ( $d =~ /^BZh[1-9]/ ) {
        require IO::Uncompress::Bunzip2; $how = 'bzip2';
        IO::Uncompress::Bunzip2::bunzip2( \$d => \$out ) or undef $out;
    } elsif ( $d =~ /^PK\x03\x04/ ) {
        require IO::Uncompress::Unzip; $how = 'zip';
        IO::Uncompress::Unzip::unzip( \$d => \$out ) or undef $out;
    } elsif ( $d =~ /^\x78[\x01\x5e\x9c\xda]/ ) {
        require Compress::Zlib; $how = 'zlib';
        $out = Compress::Zlib::uncompress($d);
    } elsif ( $d =~ /^PGDMP/ ) {
        # Custom-format dump (pg_dump -Fc): pg_restore writes it back as SQL without a database.
        $how = 'pg_dump custom format';
        my $pr = ( grep { -x } map {"$_/pg_restore"} split( /:/, $ENV{PATH} // '' ), glob('/usr/lib/postgresql/*/bin') )[0];
        fail( 4, "This is a PostgreSQL custom-format dump (pg_dump -Fc). Install postgresql-client, or export it again as plain SQL (pg_dump -Fp), then try again." ) unless $pr;
        open( my $p, '-|', $pr, '-f', '-', $o{in} ) or fail( 4, "This is a PostgreSQL custom-format dump (pg_dump -Fc) that pg_restore could not open." );
        $out = do { local $/; <$p> };
        close $p;
