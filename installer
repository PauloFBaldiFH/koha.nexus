    cat > "$d/kei_import/rules.py" <<'KEIPY'
"""Patterns, check digits and normalisation shared by the whole engine.

Every rule here is a pure function, so the classifier, the grouping and the
writers judge a value the same way.
"""
import re
import unicodedata
from datetime import date

# ---------------------------------------------------------------- text

_ORDINALS = str.maketrans({"º": " ", "ª": " ", "°": " "})


def strip_accents(s):
    s = unicodedata.normalize("NFKD", s.translate(_ORDINALS))
    return "".join(c for c in s if not unicodedata.combining(c))


def norm_header(s):
    """Column name without accents, case or punctuation ("Nº CPF" -> "n cpf")."""
    s = strip_accents(str(s or "")).lower()
    return re.sub(r"[^a-z0-9]+", " ", s).strip()


ARTICLES = {"o", "a", "os", "as", "um", "uma", "uns", "umas", "the", "an", "el", "la",
            "los", "las", "lo", "le", "les", "un", "une", "il", "gli", "der", "die", "das",
            "ein", "eine"}
# Leading articles that are not a word of their own ("L'enfant").
_ELIDED = re.compile(r"^(l'|l’|d'|d’)", re.I)


def norm_key(s):
    """Text for grouping keys: no case, accents, punctuation or leading article."""
    s = norm_header(s)
    words = s.split()
    if len(words) > 1 and words[0] in ARTICLES:
        words = words[1:]
    return " ".join(words)


def nonfiling(title):
    """Characters to skip when filing a title (245 second indicator)."""
    m = re.match(r"^(\S+)\s", title or "")
    if m and m.group(1).lower() in ARTICLES:
        return min(len(m.group(1)) + 1, 9)
    m = _ELIDED.match(title or "")
    return len(m.group(1)) if m else 0


def clean(s):
    """One line of text: control characters and repeated spaces removed."""
    s = re.sub(r"[\x00-\x1f\x7f]+", " ", str(s if s is not None else ""))
    return re.sub(r"\s+", " ", s).strip()


def words_overlap(a, b):
    """Share of words two titles have in common (0..1)."""
    wa, wb = set(norm_key(a).split()), set(norm_key(b).split())
    if not wa or not wb:
        return 0.0
    return len(wa & wb) / len(wa | wb)


def has_letters(s):
    return any(c.isalpha() for c in s)


# ---------------------------------------------------------------- encoding

_MOJIBAKE = re.compile("[ÃÂ][\u0080-¿]|â€")


def repair_mojibake(s):
    """Text encoded twice ("JosÃ©") read back once more as Windows-1252."""
    if not _MOJIBAKE.search(s):
        return s
    try:
        fixed = s.encode("cp1252").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return s
    return fixed if len(_MOJIBAKE.findall(fixed)) < len(_MOJIBAKE.findall(s)) else s


def _reads_well(text):
    """How well the non-ASCII characters of a decoded text read as letters:
    an accented letter with the case of the letters next to it counts one,
    a symbol in the middle of a word ("a‡Æo") takes one away."""
    score = 0
    for m in re.finditer(r"(?<=[A-Za-z])[^\x00-\x7f]|[^\x00-\x7f](?=[A-Za-z])", text[:1 << 20]):
        c, i = m.group(0), m.start()
        near = [x for x in (text[i - 1:i], text[i + 1:i + 2]) if x.isascii() and x.isalpha()]
        if c.isalpha():
            score += any(x.isupper() == c.isupper() for x in near)
        elif len(near) == 2:
            score -= 1
    return score


def decode_text(data):
    """Bytes of a text file -> (text, encoding name). UTF-8 when valid,
    otherwise Windows-1252 (a superset of ISO-8859-1) or, when it reads
    better, IBM850 (MS-DOS: dBase, ISIS and Clipper exports)."""
    if data.startswith(b"\xef\xbb\xbf"):
        data = data[3:]
    elif data.startswith((b"\xff\xfe", b"\xfe\xff")):
        return data.decode("utf-16"), "UTF-16"
    try:
        text, enc = data.decode("utf-8"), "UTF-8"
    except UnicodeDecodeError:
        text, enc = data.decode("cp1252", errors="replace"), "Windows-1252"
        dos = data.decode("cp850")
        if _reads_well(dos) > _reads_well(text):
            text, enc = dos, "IBM850 (MS-DOS)"
    fixed = repair_mojibake(text)
    if fixed != text:
        enc += " (double-encoded text repaired)"
    return fixed, enc


# ---------------------------------------------------------------- numbers with check digits

def isbn_clean(v):
    s = re.sub(r"(?i)^\s*isbn[\s:.-]*", "", str(v or ""))
    s = re.sub(r"\(.*?\)", "", s)
    return re.sub(r"[\s.-]", "", s).upper()


def isbn10_ok(s):
    if not re.fullmatch(r"\d{9}[\dX]", s):
        return False
    total = sum((10 - i) * (10 if c == "X" else int(c)) for i, c in enumerate(s))
    return total % 11 == 0


def isbn13_ok(s):
    if not re.fullmatch(r"97[89]\d{10}", s):
        return False
    return sum(int(c) * (1 if i % 2 == 0 else 3) for i, c in enumerate(s)) % 10 == 0


def isbn13(s):
    """ISBN-13 of a valid ISBN-10 or ISBN-13, else ''."""
    if isbn13_ok(s):
        return s
    if isbn10_ok(s):
        core = "978" + s[:9]
        check = (10 - sum(int(c) * (1 if i % 2 == 0 else 3) for i, c in enumerate(core)) % 10) % 10
        return core + str(check)
    return ""


def isbn_shape(s):
    return bool(re.fullmatch(r"(97[89])?\d{9}[\dX]", s))


def isbn_list(v):
    """Every ISBN written in a cell, as (cleaned, valid?)."""
    out = []
    for part in re.split(r"[;,/|]| e ", str(v or "")):
        s = isbn_clean(part)
        if s:
            out.append((s, bool(isbn13(s))))
    return out


def issn_ok(v):
    s = re.sub(r"[\s-]", "", str(v or "")).upper()
    if not re.fullmatch(r"\d{7}[\dX]", s):
        return False
    total = sum(int(c) * (8 - i) for i, c in enumerate(s[:7]))
    check = (11 - total % 11) % 11
    return s[7] == ("X" if check == 10 else str(check))


def cpf_digits(v):
    return re.sub(r"\D", "", str(v or ""))


def cpf_ok(v):
    s = str(v or "").strip()
    if not re.fullmatch(r"\d{3}\.?\d{3}\.?\d{3}-?\d{2}", s):
        return False
    d = cpf_digits(s)
    if d == d[0] * 11:
        return False
    for n in (9, 10):
        r = sum(int(d[i]) * (n + 1 - i) for i in range(n)) * 10 % 11 % 10
        if r != int(d[n]):
            return False
    return True


# ---------------------------------------------------------------- dates, money, codes

def iso_date(v, today=None):
    """dd/mm/yyyy, dd-mm-yyyy, dd.mm.yyyy, yyyy-mm-dd (time ignored) or
    dd/mm/yy -> 'YYYY-MM-DD'; '' when it is not a real date."""
    s = str(v or "").strip()
    s = re.sub(r"[ T]\d{1,2}:\d{2}(:\d{2})?(\.\d+)?$", "", s)
    m = re.fullmatch(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})", s)
    if m:
        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
    else:
        m = re.fullmatch(r"(\d{1,2})[-/.](\d{1,2})[-/.](\d{2}|\d{4})", s)
        if not m:
            return ""
        d, mo, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if y < 100:
            this = (today or date.today()).year % 100
            y += 2000 if y <= this else 1900
    try:
        return date(y, mo, d).isoformat()
    except ValueError:
        return ""


def year_of(v):
    m = re.search(r"\b(1[5-9]\d\d|20\d\d)\b", str(v or ""))
    return m.group(1) if m else ""


def price(v):
    """'R$ 1.234,50' -> '1234.50'; '' when it is not an amount."""
    s = re.sub(r"[^\d,.]", "", str(v or ""))
    if not s:
        return ""
    s = re.sub(r"[.,](?=.*[.,])", "", s).replace(",", ".")
    return s if re.fullmatch(r"\d+(\.\d+)?", s) else ""


def edition_text(v):
    v = clean(v)
    return v + ". ed." if re.fullmatch(r"\d{1,3}", v) else v


def pages_text(v):
    v = clean(v)
    return v + " p." if re.fullmatch(r"\d{1,5}", v) else v


def split_list(v):
    """Values separated by ';' (or '|', or ' -- ')."""
    v = str(v or "")
    if ";" in v:
        parts = v.split(";")
    elif "|" in v:
        parts = v.split("|")
    else:
        parts = re.split(r"\s+--\s+", v)
    return [clean(p) for p in parts if clean(p)]


LANGUAGES = {"portugues": "por", "portuguese": "por", "pt": "por", "por": "por",
