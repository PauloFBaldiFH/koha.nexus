"""Item fields of legacy exports (852, 949, 950, 990, or another 9XX that
most records repeat): what each subfield holds and the 952 map that
remap952.pl applies, one Koha item per field. 852 is read by its MARC 21
definition; in a 9XX each subfield is judged by its values, never by its
code, since every system lays them out its own way. Library, item type and
shelving location count only when the values are Koha's own codes or
names; what a field leaves out or Koha does not have comes from the
operator's choices."""
import re
from datetime import date

from . import marc
from . import rules as R
from .group import DAMAGED, LOST, NOT_FOR_LOAN, WITHDRAWN

TAGS = ("852", "949", "950", "990")
CALLNUMBER = "090:ab|082:a"     # the record's call number, for items without one
AVAILABLE = {"disponivel", "normal", "emprestado", "circulante", "ativo", "em circulacao", "livre",
             "available", "on loan", "checked out"}
# Status word -> the 952 subfield it sets to 1 ("" = nothing to set).
STATUS = {}
for _words, _code in ((LOST, "1"), (WITHDRAWN, "0"), (DAMAGED, "4"), (NOT_FOR_LOAN, "7"), (AVAILABLE, "")):
    STATUS.update((w, _code) for w in _words)
# 852 by MARC 21 (library and shelving location only when Koha knows the values).
HOLDINGS = {"a": "branch", "b": "branch", "c": "location", "h": "callnumber", "i": "callnumber",
            "j": "callnumber", "k": "callnumber", "m": "callnumber", "p": "barcode", "t": "copy",
            "x": "itemnote", "z": "publicnote"}
# Role -> 952 subfield ("S" is the status, which sets $0, $1, $4 or $7).
TARGET = {"itemtype": "y", "location": "c", "itemstatus": "S", "acqdate": "d", "price": "g", "volume": "h",
          "copy": "t", "barcode": "p", "tombo": "i", "itemnote": "x", "publicnote": "z"}
TEXT = {"branch": "library", "itemtype": "item type", "location": "shelving location",
        "itemstatus": "status", "acqdate": "date acquired",
        "price": "price", "volume": "volume", "copy": "copy number", "callnumber": "call number",
        "barcode": "barcode", "tombo": "inventory number", "itemnote": "internal note", "publicnote": "public note"}
# 952 subfields the engine checks or normalises before the remapper writes them.
LOOKUP = {"a": "branch", "b": "branch", "y": "itemtype", "c": "location", "S": "itemstatus", "d": "acqdate", "g": "price"}
ACCEPT = 0.8

_SPACE = b" \t\n\r\f\v"
_CLASS = re.compile(r"([A-Za-z]{1,3}\s+)?\d{1,3}(\.\d+)?([-(:/\"=][^\s]*)?(\s+\S+)*")
_CUTTER = re.compile(r"[A-Z][a-z]{0,2}\d{1,4}[a-z]{0,3}\.?")
_VOLUME = re.compile(r"(?i)(v|vol|volume|t|tomo|n|num|no)(\.\s*|\s+)\d{1,4}\b.*")
_COPY = re.compile(r"(?i)((ex|exs|exemplar|exempl|exemp|c|cop|copia|copy)(\.\s*|\s+)\d{1,3}|\d{1,3}\s*[ºªoa]?\.?\s*(ex|exemplar)\.?)")
_MONEY = re.compile(r"(R\$|US\$|\$|€|£)\s*\d|^\d{1,3}(\.\d{3})*,\d{2}$")


def item_date(v):
    """A date of acquisition as YYYY-MM-DD, also from YYYYMMDD; '' otherwise."""
    d = R.iso_date(v)
    if d:
        return d
    m = re.fullmatch(r"(1[89]\d\d|20\d\d)(\d\d)(\d\d)", v.strip())
    if m:
        try:
            return date(int(m.group(1)), int(m.group(2)), int(m.group(3))).isoformat()
        except ValueError:
            return ""
    return ""


class Sub:
    """The values one subfield has across the studied fields."""

    def __init__(self, code, values):
        self.code = code
        self.values = values
        self.n = len(values)
        self.distinct = len(set(values)) / self.n

    def ratio(self, test):
        return sum(1 for v in self.values if test(v)) / self.n

    def sample(self, k=3):
        seen = []
        for v in self.values:
            if v not in seen:
                seen.append(v)
            if len(seen) == k:
                break
        return ", ".join(x[:30] for x in seen)


def _in(table):
    return lambda s, koha: s.ratio(lambda v: R.norm_header(v) in koha[table]) if koha.get(table) else 0.0


def _class_like(v):
    """A class with or without its Cutter: "869.3", "869.3 A848d", "R 981",
    "821.134.3(81)-31", or three digits alone ("981")."""
    return bool(_CLASS.fullmatch(v)) and bool(re.search(r"[.\s(]", v) or re.fullmatch(r"\d{3}", v))


def _barcode_like(s):
    if s.distinct < 0.9:
        return 0.0
    return s.ratio(lambda v: len(v) <= 30 and not re.search(r"\s", v) and bool(re.search(r"\d", v)))


def _copy(s, koha):
    r = s.ratio(lambda v: bool(_COPY.fullmatch(v)))
    if r >= ACCEPT:
        return r
    # Plain copy numbers: small, repeated, never 0.
    if s.n >= 2 and s.distinct <= 0.5 and all(re.fullmatch(r"[1-9]\d?", v) for v in s.values):
        return 1.0
    return 0.0


def _date(s, koha):
    r = s.ratio(lambda v: bool(R.iso_date(v)))
    if r >= ACCEPT:
        return r
    # YYYYMMDD only when values repeat: a column of barcodes never does.
    return s.ratio(lambda v: bool(item_date(v))) if s.distinct < 0.9 else 0.0


def _callnumber(s, koha):
    # Three digits alone are a class only next to others with a point or a
    # space, or when they repeat: a numbering never does.
    if not s.ratio(lambda v: bool(re.search(r"[.\s(]", v))) and s.distinct >= 0.6:
        return 0.0
    return s.ratio(_class_like)


# In order: the first test a subfield passes is its role.
TESTS = [
    ("branch", _in("branch")),
    ("itemtype", _in("itemtype")),
    ("location", _in("location")),
    ("itemstatus", lambda s, k: s.ratio(lambda v: R.norm_header(v) in STATUS)),
    ("acqdate", _date),
    ("price", lambda s, k: s.ratio(lambda v: bool(_MONEY.search(v)) and bool(R.price(v)))),
    ("volume", lambda s, k: s.ratio(lambda v: bool(_VOLUME.fullmatch(v)))),
    ("copy", _copy),
    ("callnumber", _callnumber),
    ("cutter", lambda s, k: s.ratio(lambda v: bool(_CUTTER.fullmatch(v)))),
    ("barcode", lambda s, k: _barcode_like(s)),
    # Text: at least half the values are a few words long.
    ("itemnote", lambda s, k: 1.0 if s.ratio(lambda v: len(v) >= 12 and " " in v) >= 0.5 else 0.0),
]


def _judge(subs, koha):
    """(role, why) for each subfield of a 9XX, from its values."""
    cands = {}
    for s in subs:
        cands[s.code] = [(role, r) for role, test in TESTS for r in [test(s, koha)] if r >= ACCEPT]
    out = {s.code: ("", "values not recognised") for s in subs}
    taken = {}
    order = ["branch", "itemtype", "location", "itemstatus", "acqdate", "price", "volume", "copy",
             "callnumber", "cutter", "barcode", "itemnote"]
    has_class = any(c and c[0][0] == "callnumber" for c in cands.values())
    for role in order:
        hits = []
        for s in subs:
            if out[s.code][0]:
                continue
            for r, ratio in cands[s.code]:
                if r == "cutter" and not has_class:
                    continue
                if r == role:
                    hits.append((-ratio, s.code, s))
                break
        hits.sort(key=lambda h: (h[0], h[1]))
        for _, code, s in hits:
            name = "callnumber" if role == "cutter" else role
            n = taken.get(name, 0)
            limit = {"branch": 2, "callnumber": 9, "barcode": 2, "itemnote": 9}.get(name, 1)
            if n >= limit:
                out[code] = ("", "another subfield already gives the %s" % TEXT[name])
                continue
            taken[name] = n + 1
            out[code] = (name, role)
    # No barcode: the most distinct unrecognised subfield with numbers in it.
    if not taken.get("barcode"):
        free = [s for s in subs if out[s.code] == ("", "values not recognised") and s.distinct >= 0.9
                and s.ratio(lambda v: bool(re.search(r"\d", v))) >= ACCEPT]
        if free:
            best = max(free, key=lambda s: (s.distinct, -ord(s.code[:1] or " ")))
            out[best.code] = ("barcode", "barcode")
    # Two numberings: the barcode is $p, else $i, else the one of steady length;
    # the other is the inventory number (tombo).
    bars = [s for s in subs if out[s.code][0] == "barcode"]
    if len(bars) == 2:
        bars.sort(key=lambda s: (s.code != "p", s.code != "i", len(set(len(v) for v in s.values)), -s.distinct, s.code))
        out[bars[1].code] = ("tombo", "tombo")
    return out


def infer(tag, values, koha):
    """[(code, role, sample, why)] for the subfields of an item field and the
    952 map ("p=a,o=h+i|j,..."): role '' = not used, for the reason given."""
    subs = [Sub(c, values[c]) for c in sorted(values)]
    roles = []
    if tag == "852":
        for s in subs:
            role, why = HOLDINGS.get(s.code, ""), "not part of a Koha item"
            if role == "branch" and _in("branch")(s, koha) < ACCEPT:
                role, why = "", "not a library Koha has"
            elif role == "location" and _in("location")(s, koha) < ACCEPT:
                role, why = "", "not a shelving location Koha has (authorised values LOC)"
            roles.append((s.code, role, s.sample(), "" if role else why))
        cn = [c for c in "khim" if any(r[0] == c and r[1] for r in roles)]
        spec = "+".join(cn)
        if any(r[0] == "j" for r in roles):
            spec = spec + "|j" if spec else "j"
        callnumber = spec
    else:
        judged = _judge(subs, koha)
        for s in subs:
            role, why = judged[s.code]
            roles.append((s.code, role, s.sample(), "" if role else why))
        classes = [s.code for s in subs if judged[s.code] == ("callnumber", "callnumber")]
        cutters = [s.code for s in subs if judged[s.code] == ("callnumber", "cutter")]
        callnumber = "+".join(classes + cutters)
    parts = []
    branches = [c for c, r, _, _ in roles if r == "branch"]
    if branches:
        parts.append("a=" + branches[0])
    if len(branches) > 1:
        parts.append("b=" + branches[1])
    if callnumber:
        parts.append("o=" + callnumber)
    for role, key in TARGET.items():
        codes = [c for c, r, _, _ in roles if r == role]
        if codes:
            parts.append("%s=%s" % (key, "+".join(codes)))
    return roles, ",".join(parts)


def find(recs, tag_recs, n, encoding, koha):
    """The item field of a legacy export among the studied records, with its
    roles and 952 map; {} when there is none. 'item_auto' is False when the
    panel must ask first (a 9XX it does not expect, or a field without a
    numbering that could be the barcode)."""
    if not n or tag_recs.get("952", 0) >= n:
        return {}
    known = [t for t in TAGS if tag_recs.get(t)]
    others = [(c, t) for t, c in tag_recs.items()
              if t[:1] == "9" and t not in TAGS and t not in ("942", "952", "999") and c >= 0.3 * n]
    if not known and not others:
        return {}
    found = [study(recs, t, encoding, koha, tag_recs[t]) for t in known or [max(others)[1]]]
    # Of the usual fields, the one with a numbering, in the most records.
    return max(found, key=lambda f: (f["item_auto"], f["item_records"], -TAGS.index(f["item_tag"]) if f["item_tag"] in TAGS else 0))


def study(recs, tag, encoding, koha, records):
    enc = "utf-8" if encoding == "UTF-8" else "latin-1"
    values = {}
    sample = []
    for _, fields in recs:
        for t, data in fields:
            if t != tag:
                continue
            subs = [(c, v.decode(enc, "replace").strip()) for c, v in marc.iso_subfields(data)[2]]
            if len(sample) < 2:
                sample.append(" ".join("$%s %s" % (c, v) for c, v in subs))
            for c, v in subs:
                if v and re.fullmatch(r"[a-z0-9]", c):
                    values.setdefault(c, []).append(v)
    roles, mapping = infer(tag, values, koha)
    auto = tag in TAGS and any(r in ("barcode", "tombo") for _, r, _, _ in roles)
    return {"item_tag": tag, "item_roles": roles, "item_map": mapping, "item_auto": auto,
            "item_records": records, "item_sample": " | ".join(sample), "callnumber": CALLNUMBER}


def subject(tag, roles):
    """The question's subject: '945 b=barcode c=' (the panel names the roles)."""
    return " ".join([tag] + ["%s=%s" % (c, r) for c, r, _, _ in roles])


def describe(tag, mapping, roles, branch="", itype=""):
    """Preview lines: where each subfield goes."""
    dest = {}
    keys = dict(p.split("=", 1) for p in mapping.split(",") if "=" in p)
    for key, spec in keys.items():
        for code in re.split(r"[+|]", spec):
            dest.setdefault(code, []).append(key)
    lines = ["Items: field %s moved to 952, one item per field:" % tag]
    for code, role, sample, why in roles:
        if role and code in dest:
            ks = dest[code]
            if ks == ["a"] and "b" not in keys:
                ks = ["a", "b"]
            target = " ".join("$0/$1/$4/$7" if k == "S" else "$" + k for k in ks)
            lines.append("  %s $%s -> 952 %s, %s: %s" % (tag, code, target, TEXT[role], sample))
        else:
            lines.append("  %s $%s not used, %s: %s" % (tag, code, why or "not part of a Koha item", sample))
    if "o" not in keys:
        lines.append("  call number: the record's 090 $a $b, else 082 $a")
    else:
        lines.append("  call number when the field has none: the record's 090 $a $b, else 082 $a")
    lines.append("  library and item type when the field has none Koha knows: %s, %s" % (branch or "your choice", itype or "your choice"))
    return lines


def value_table(src, tag, mapping, koha, out):
    """The values of the checked 952 subfields as the remapper will meet them
    (the UTF-8 file it reads), each with what Koha gets: "key<TAB>value<TAB>
    Koha value", '' when Koha has no such library, item type or location, or
    the date or price cannot be read; '-' for a status that sets nothing
    (available)."""
    keys = {}
    for part in mapping.split(","):
        k, _, spec = part.partition("=")
        if k in LOOKUP and spec:
            keys[k] = spec.split("|")[0].split("+")
    seen = {k: set() for k in keys}
    with open(src, "rb") as fh:
        for _, fields in marc.iso2709_records(fh):
            for t, data in fields:
                if t != tag:
                    continue
                subs = marc.iso_subfields(data)[2]
                for k, codes in keys.items():
                    v = b" ".join(x for code in codes for c, x in subs if c == code and x).strip(_SPACE)
                    if v:
                        seen[k].add(v)
    with open(out, "wb") as fh:
        for k in sorted(keys):
            for raw in sorted(seen[k]):
                if b"\t" in raw or b"\n" in raw:
                    continue
                fh.write(b"%s\t%s\t%s\n" % (k.encode(), raw, koha_value(k, raw.decode("utf-8", "replace"), koha).encode("utf-8")))


def koha_value(key, v, koha):
    role = LOOKUP[key]
    if role in ("branch", "itemtype", "location"):
        return koha.get(role, {}).get(R.norm_header(v), "")
    if role == "itemstatus":
        code = STATUS.get(R.norm_header(v))
        return "" if code is None else code or "-"
    if role == "acqdate":
        return item_date(v)
    return R.price(v)
