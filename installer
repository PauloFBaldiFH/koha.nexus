_DBF_CODEPAGE = {0x01: "cp437", 0x02: "cp850", 0x03: "cp1252", 0x57: "cp1252", 0x58: "cp1252",
                 0x59: "cp1252", 0x64: "cp852", 0x65: "cp866", 0x7d: "cp1255", 0xc8: "cp1250",
                 0xc9: "cp1251", 0x26: "cp866", 0x37: "cp850"}
_PT_LETTERS = set("áàâãéêíóôõúüçÁÀÂÃÉÊÍÓÔÕÚÜÇ")


def dbf_header(data):
    """(fields, header length, record length, records) or None when the
    bytes are not a dBase table."""
    if len(data) < 65 or data[0] not in (0x02, 0x03, 0x30, 0x31, 0x32, 0x43, 0x63, 0x83, 0x8b, 0x8e, 0xcb, 0xf5, 0xfb):
        return None
    nrec, hlen, rlen = struct.unpack("<IHH", data[4:12])
    if hlen < 65 or rlen < 2 or hlen > len(data) + 1:
        return None
    fields, pos, total = [], 32, 1
    while pos + 32 <= min(hlen, len(data)) and data[pos] != 0x0D:
        raw = data[pos:pos + 32]
        fname = raw[:11].split(b"\0")[0].decode("latin-1").strip()
        ftype = chr(raw[11])
        flen, fdec = raw[16], raw[17]
        if ftype == "C":
            flen += fdec << 8   # Clipper long character fields
        if not fname or ftype not in "CNFDLMIBYTGPV@+O0":
            return None
        fields.append((fname, ftype, flen))
        total += flen
        pos += 32
    if not fields or total != rlen:
        return None
    return fields, hlen, rlen, nrec


def _guess_codepage(sample):
    best, best_n = "cp1252", -1
    for cp in ("cp1252", "cp850", "cp437"):
        txt = sample.decode(cp, errors="replace")
        n = sum(1 for ch in txt if ch in _PT_LETTERS) - 3 * sum(1 for ch in txt if "─" <= ch <= "◿")
        if n > best_n:
            best, best_n = cp, n
    return best


def _memo_reader(path):
    base = os.path.splitext(path)[0]
    for ext in (".dbt", ".DBT", ".fpt", ".FPT"):
        p = base + ext
        if os.path.exists(p):
            with open(p, "rb") as fh:
                memo = fh.read()
            if ext.lower() == ".fpt":
                block = struct.unpack(">H", memo[6:8])[0] or 64

                def fpt(n, memo=memo, block=block):
                    off = n * block
                    if off + 8 > len(memo):
                        return b""
                    ln = struct.unpack(">I", memo[off + 4:off + 8])[0]
                    return memo[off + 8:off + 8 + ln]
                return fpt

            def dbt(n, memo=memo):
                off = n * 512
                end = memo.find(b"\x1a", off)
                return memo[off:end if end >= 0 else off + 512 * 64]
            return dbt
    return None


def read_dbf(path, name):
    with open(path, "rb") as fh:
        data = fh.read()
    head = dbf_header(data)
    if not head:
        return []
    fields, hlen, rlen, nrec = head
    cp = _DBF_CODEPAGE.get(data[29])
    body = data[hlen:hlen + rlen * nrec]
    if not cp:
        cp = _guess_codepage(body[:200000])
    memo = _memo_reader(path)
    rows = [[f[0] for f in fields]]
    deleted = 0
    for i in range(min(nrec, MAX_ROWS)):
        rec = body[i * rlen:(i + 1) * rlen]
        if len(rec) < rlen:
            break
        if rec[0:1] == b"*":
            deleted += 1
            continue
        pos, row = 1, []
        for fname, ftype, flen in fields:
            raw = rec[pos:pos + flen]
            pos += flen
            if ftype == "D":
                s = raw.decode("ascii", "replace").strip()
                val = "%s-%s-%s" % (s[:4], s[4:6], s[6:8]) if re.fullmatch(r"\d{8}", s) else ""
            elif ftype == "L":
                val = {"T": "TRUE", "Y": "TRUE", "F": "FALSE", "N": "FALSE"}.get(raw.decode("ascii", "replace").strip().upper(), "")
            elif ftype == "I" and flen == 4:
                val = str(struct.unpack("<i", raw)[0])
            elif ftype in "MGPB" and memo:
                s = raw.decode("ascii", "replace").strip()
                if flen == 4 and not s.isdigit():
                    n = struct.unpack("<I", raw)[0]
                else:
                    n = int(s) if s.isdigit() else 0
                val = memo(n).decode(cp, "replace").rstrip("\x00") if n else ""
            else:
                val = raw.decode(cp, "replace").strip()
            row.append(R.repair_mojibake(val))
        rows.append(row)
    t = Table(name, rows, "%s (dBase)" % cp, "DBF")
    t.deleted = deleted
    t.headers = rows[0]
    t.header_row = True
    return [t]


