def _letters(n):
    s = ""
    n += 1
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def set_header(table, synonyms_hit):
    """Decides whether the first row names the columns."""
    if not table.rows:
        table.headers = []
