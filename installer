# ======================================================================
# 38. AI ASSISTANT ON THE STAFF HOME PAGE (staff interface, opt-in)
# ----------------------------------------------------------------------
# tools/ai_assistant.pl and KohaEasy::Assistant: a chat in the place of the
# news block of the staff home page (mainpage.pl). The librarian asks in
# plain language and the model of the AI settings (vision.conf of the AI
# cataloguing: Ollama, Gemini, OpenAI...) answers through read-only tools
# (catalogue, patrons, reports, system preferences, Koha pages), every
# record it names a link to its page. The block is put there by a marked
# block in IntranetUserJS, like the other staff tools of the panel: Koha's
# own templates (intranet-main.tt) are never edited, so a Koha update keeps
# the assistant.
#
# Never SQL from the model: the catalogue is searched with Koha's own
# search engine (Zebra or Elasticsearch) and the other tools are fixed
# queries on kei_ai_ro_<instance>, a MariaDB account with SELECT only, table
# by table (no sessions, API keys, queued notices or plugin data; no
# password, secret or token column), its login in readonly.cnf (root and
# the instance user only). Small talk is answered without tools; each
# answer keeps the records it found for the follow-up questions. A change
# is only an action proposal (the record, each field before and after):
# Koha's own objects make it after the librarian presses Approve &
# Execute, with their own permissions, the values read again and saved
# first (undo folder, changes.log). Anything else opens the Koha page that
# does it.
# ======================================================================
AIA_FILE="${KOHA_INTRA_CGI}/tools/ai_assistant.pl"
AIA_DIR="/var/lib/koha/${INSTANCE}/kei-ai"
AIA_CNF="${AIA_DIR}/readonly.cnf"
AIA_PM_DIR="${KEI_PERL_DIR}/KohaEasy"
AIA_STATE="${CONF_DIR}/ai_assistant.state"
AIA_RO_USER="kei_ai_ro_${INSTANCE//[^A-Za-z0-9_]/_}"
AIA_RO_USER="${AIA_RO_USER:0:32}"
AIA_JS_BEGIN="/* koha-easy-installer ai-assistant begin */"
AIA_JS_END="/* koha-easy-installer ai-assistant end */"
# Never readable by the assistant (the same lists as KohaEasy::Assistant).
AIA_SENSITIVE_TABLES="sessions api_keys borrower_password_recovery oauth_access_tokens identity_providers message_queue plugin_data"
AIA_SENSITIVE_COLUMN='(^|_)(password|passwd|secret|token|api_key|apikey)$'
AIA_KEYS="title read_only expand new_chat placeholder send examples hello you assistant error waiting proposal target \
    field current proposed approve reject open_page done opened cancelled failed thinking settings err_network err_session \
    err_csrf no_ro no_provider err_state err_empty err_model err_gone err_done err_perm err_changed err_run err_hold err_marc \
    act_place_hold act_update_patron act_update_record act_write_off act_open_page"

# The module: the tools, the read-only checks and the system prompt.
aia_pm() {
    cat <<'AIAPM'
package KohaEasy::Assistant;

# koha-easy-installer: the AI assistant of the staff home page.
#
# Used by tools/ai_assistant.pl, the chat that takes the place of the news
# block on the Koha staff home page. A librarian asks in plain language
# ("that book about the clown that became a movie", "the last patron with
# 4 overdue books and 144 in fines"); the model of the AI settings
# (vision.conf, the same as the AI cataloguing) answers by calling the tools
# below, and every record it names becomes a link to its page in Koha.
#
# A worker with fixed tools, never SQL from the model:
#   1. a router: small talk ("hello", "who are you?") is answered by the
#      model alone, with no tool; library questions go to the tools;
#   2. reads: the catalogue through Koha's own search engine (Zebra or
#      Elasticsearch, a callback of the page) with the database as a
#      fallback, and fixed, quoted queries (patrons, loans, statistics,
#      opening hours, reports, preferences) on kei_ai_ro, a MariaDB account
#      with SELECT only (no sessions, API keys, queued notices or password
#      columns), each connection READ ONLY with a 10 s statement limit;
#      every tool returns JSON, and an empty one says so (no inventing);
#   3. changes: propose_action only records an action proposal (the
#      record, each field's value now and after). The page shows it with
#      Approve & Execute / Reject; on Approve it reads the values again and
#      Koha's own objects make the change, with the librarian's own
#      permissions (holds, patron editing, cataloguing, write-offs);
#   4. memory: each answer keeps the records its tools found ("context"),
#      so "which one is his clown book?" can be resolved on the next turn.
#
# Nothing here talks to Koha's own modules: a database handle, a search
# callback and a model in, answers and proposals out. The page does the
# login, the permissions, the search engine and the changes.

use strict;
use warnings;
use utf8;
use DBI;
use HTTP::Tiny;
use JSON::PP;

our $VERSION = '1';

our $MAX_STEPS     = 6;
our $RESULT_CHARS  = 6000;
our $HISTORY_TURNS = 6;
our $OLLAMA_CTX    = 16384;

my $JSON = JSON::PP->new->utf8(0)->canonical(1)->allow_nonref(1);

# ----------------------------------------------------------------------
# The model's settings (vision.conf of the AI cataloguing, read-only here)
# ----------------------------------------------------------------------
our %DEFAULTS = (
    openai     => { url => 'https://api.openai.com/v1', model => 'gpt-4.1-mini' },
    anthropic  => { url => 'https://api.anthropic.com', model => 'claude-sonnet-5' },
    gemini     => { url => 'https://generativelanguage.googleapis.com/v1beta/openai', model => 'gemini-2.5-flash' },
    ollama     => { url => 'http://127.0.0.1:11434',    model => 'qwen2.5vl:7b' },
    compatible => { url => 'http://localhost:1234/v1',  model => '' },
);

sub load_conf {
    my ($path) = @_;
    my %c;
    if ( defined $path && open( my $fh, '<:encoding(UTF-8)', $path ) ) {
        while ( my $line = <$fh> ) {
            $line =~ s/\r?\n$//;
            next if $line =~ /^\s*(#|$)/;
            my ( $k, $v ) = split /=/, $line, 2;
            $c{$k} = $v // '' if defined $k && $k =~ /^\w+$/;
        }
        close $fh;
    }
    $c{provider} = 'openai' unless $c{provider} && $DEFAULTS{ $c{provider} };
    $c{url}   ||= $DEFAULTS{ $c{provider} }{url};
    # The chat may have a lighter model than the vision one (panel: AI tools).
    $c{model} = $c{chat_model} if defined $c{chat_model} && $c{chat_model} ne '';
    $c{model} ||= $DEFAULTS{ $c{provider} }{model};
    $c{token} //= '';
    $c{timeout} = 120 unless ( $c{timeout} // '' ) =~ /^\d+$/ && $c{timeout} > 0;
    return \%c;
}

sub _local_host {
    my $h = lc( shift // '' );
    return 1 if $h =~ /^(localhost|127\.\d+\.\d+\.\d+|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)$/;
    return 1 if $h =~ /\.(local|lan|internal|home\.arpa)$/ || $h !~ /\./;
    return 0;
}

# '' when usable, else URL / TOKEN_PLAIN / NO_TOKEN (the codes of the AI settings).
sub endpoint_problem {
    my ($c) = @_;
    my ( $scheme, $host ) = ( $c->{url} // '' ) =~ m{^(https?)://([A-Za-z0-9.-]+)(?::\d{1,5})?(?:/\S*)?$};
    return 'URL' unless $scheme;
    return 'TOKEN_PLAIN' if lc($scheme) eq 'http' && $c->{token} && !_local_host($host);
    my $needs = $c->{provider} =~ /^(anthropic|gemini)$/ || ( $c->{provider} eq 'openai' && !_local_host($host) );
    return 'NO_TOKEN' if $needs && !$c->{token};
    return '';
}

sub _base {
    my ($c) = @_;
    my $u = $c->{url};
    $u =~ s{/+$}{};
    my $host_only = ( $u =~ tr{/}{} ) == 2;
    my $p = $c->{provider};
    if ( $p eq 'anthropic' ) { $u =~ s{/v1$}{}; return $u }
    if ( $p eq 'ollama' ) { $u =~ s{/(api|v1)$}{}; $u =~ s{^(https?://)localhost(?=[:/]|$)}{${1}127.0.0.1}; return $u }    # IPv4: see Vision.pm
    if ( $p eq 'gemini' ) {
        return "$u/v1beta/openai" if $host_only;
        return "$u/openai" if $u =~ m{/v1(beta)?$};
        return $u;
    }
    return $host_only ? "$u/v1" : $u;
}

sub endpoint {
    my ($c) = @_;
    my $b = _base($c);
    return "$b/v1/messages" if $c->{provider} eq 'anthropic';
    return "$b/api/chat"    if $c->{provider} eq 'ollama';
    return "$b/chat/completions";
}

sub request_body {
    my ( $c, $messages ) = @_;
    my $system = join "\n\n", map { $_->{content} } grep { $_->{role} eq 'system' } @$messages;
    my @turns = grep { $_->{role} ne 'system' } @$messages;
    my $p = $c->{provider};
    if ( $p eq 'anthropic' ) {
        my @alt;    # user / assistant turns must alternate
        for my $m (@turns) {
            if ( @alt && $alt[-1]{role} eq $m->{role} ) { $alt[-1]{content} .= "\n\n$m->{content}" }
            else                                          { push @alt, {%$m} }
        }
        return { model => $c->{model}, max_tokens => 2000, system => $system, messages => \@alt };
    }
    my @msgs = ( { role => 'system', content => $system }, @turns );
    # num_ctx: Ollama's default window (2048 or 4096 tokens) is smaller than
    # the instructions plus one tool result, and Ollama silently drops the
    # start of the prompt (the tools) to fit: the model then says it has no
    # access to the database.
    return { model => $c->{model}, stream => JSON::PP::false, format => 'json', options => { temperature => 0, num_ctx => $OLLAMA_CTX }, messages => \@msgs }
        if $p eq 'ollama';
    my %body = ( model => $c->{model}, messages => \@msgs );
    if    ( $p eq 'openai' ) { %body = ( %body, response_format => { type => 'json_object' }, max_completion_tokens => 4000 ) }
    elsif ( $p eq 'gemini' ) { %body = ( %body, response_format => { type => 'json_object' }, temperature => 0, max_tokens => 8192 ) }
    else                     { %body = ( %body, temperature => 0, max_tokens => 2000 ) }
    return \%body;
}

sub reply_text {
    my ( $c, $d ) = @_;
    return '' unless ref $d eq 'HASH';
    if ( $c->{provider} eq 'anthropic' ) {
        return join '', map { $_->{text} // '' } grep { ref $_ eq 'HASH' && ( $_->{type} // '' ) eq 'text' } @{ $d->{content} || [] };
    }
    if ( $c->{provider} eq 'ollama' ) { return ref $d->{message} eq 'HASH' ? $d->{message}{content} // '' : '' }
    my $m = ref $d->{choices} eq 'ARRAY' && ref $d->{choices}[0] eq 'HASH' ? $d->{choices}[0]{message} : undef;
    return '' unless ref $m eq 'HASH';
    return $m->{content} // '' unless ref $m->{content};
    return join '', map { ref $_ eq 'HASH' ? $_->{text} // '' : '' } @{ ref $m->{content} eq 'ARRAY' ? $m->{content} : [] };
}

# One round trip; dies with a short message (the address and the HTTP
# status, never the key).
sub chat {
    my ( $c, $messages ) = @_;
    my $problem = endpoint_problem($c);
    die "$problem\n" if $problem;
    my %h = ( 'Content-Type' => 'application/json' );
    if    ( $c->{provider} eq 'anthropic' ) { %h = ( %h, 'x-api-key' => $c->{token}, 'anthropic-version' => '2023-06-01' ) }
    elsif ( $c->{token} && $c->{provider} ne 'ollama' ) { $h{Authorization} = "Bearer $c->{token}" }
    my $url  = endpoint($c);
    my $http = HTTP::Tiny->new( timeout => $c->{timeout}, verify_SSL => 1, agent => "koha-easy-installer-assistant/$VERSION" );
    my $res  = $http->post( $url, { headers => \%h, content => JSON::PP->new->utf8->encode( request_body( $c, $messages ) ) } );
    if ( !$res->{success} ) {
        my $code = $res->{status} == 599 ? ( $res->{content} =~ /^(.{0,120})/s )[0] : "HTTP $res->{status}";
        $code =~ s/\s+/ /g;
        die "$url: $code\n";
    }
    my $d = eval { JSON::PP->new->utf8->decode( $res->{content} ) };
    die "$url: the answer is not JSON\n" unless $d;
    return reply_text( $c, $d );
}

