    streams = set()
    for p in a.tables:
        if p.entity in ("biblio", "mixed"):
            streams.add("records")
        if p.entity in ("patrons", "mixed", "koha_patrons"):
            streams.add("patrons")
    if a.marcs:
        streams.add("records")
    for d in a.readers:
        streams.add("records")
