# "user@ip" (plus -p PORT when SSH is not on 22) used to reach this server.
get_ssh_login() {
    local ip="${1:-$(get_server_ip)}" user="${REAL_USER:-root}" port
    [ "$user" = "root" ] && [ -n "${SUDO_USER:-}" ] && user="$SUDO_USER"
    port=$(get_ssh_ports | head -n1)
    if [ -n "$port" ] && [ "$port" != "22" ]; then
        printf '%s@%s -p %s' "$user" "$ip" "$port"
    else
        printf '%s@%s' "$user" "$ip"
    fi
}

# Prints the credentials as plain terminal text instead of a whiptail box:
# each value sits alone on its line, flush left, so a triple-click (or a
# drag) copies exactly the URL, user or password, with no border, label or
# padding glued to it and no wrap inserted by the dialog.
_cred_head() { printf '%s%s%s\n' "$TUI_BLD" "$1" "$TUI_RST"; }
_cred_item() {
    local label="${1%:}"
    label="${label%"${label##*[! ]}"}"
    printf '%s%s:%s\n%s\n' "$TUI_DIM" "$label" "$TUI_RST" "$2"
}

function_view_credentials() {
    require_koha || return 0
    local ip cf_opac cf_staff ssh_login rule head
    ip=$(get_server_ip)
    ssh_login=$(get_ssh_login "$ip")

    read -r cf_opac cf_staff < <(tunnel_public_hosts)
    [ "$cf_opac" = "-" ] && cf_opac=""
    [ "$cf_staff" = "-" ] && cf_staff=""

    tui_rep "$TUI_LINE" 60; rule=$REPLY
    clear
    printf '%s%s%s\n' "$TUI_YEL" "$(t "Access Credentials")" "$TUI_RST"
    printf '%s%s%s\n\n' "$TUI_DIM" "$rule" "$TUI_RST"

    _cred_head "$(t "ON THIS MACHINE (localhost):")"
    _cred_item "$(t "OPAC  (catalog)       :")" "http://localhost:80"
    _cred_item "$(t "Staff (administration):")" "http://localhost:8080"
    echo ""
    _cred_head "$(t "FROM OTHER COMPUTERS ON THE NETWORK:")"
    _cred_item "$(t "OPAC  (catalog)       :")" "http://${ip}:80"
    _cred_item "$(t "Staff (administration):")" "http://${ip}:8080"
    echo ""
    if [ -n "$cf_opac" ] || [ -n "$cf_staff" ]; then
        head=$(t "\n[ INTERNET / CLOUDFLARE TUNNEL ]\n")
        _cred_head "${head//\\n/}"
        [ -n "$cf_opac" ] && _cred_item "$(t "OPAC  (catalog)       :")" "https://${cf_opac}"
        [ -n "$cf_staff" ] && _cred_item "$(t "Staff (administration):")" "https://${cf_staff}"
        echo ""
    fi
    _cred_head "$(t "SSH ACCESS (remote terminal):")"
    printf '%s\n\n' "ssh ${ssh_login}"
    _cred_head "$(t "DATABASE CREDENTIALS (1st Access / Web Installer):")"
    _cred_item "$(t "User :")" "${DB_NAME}"
    _cred_item "$(t "Pass :")" "$(get_database_password)"
    echo ""
    _cred_item "$(t "Full file:")" "${CREDENTIALS_FILE}"
    printf '%s%s%s\n' "$TUI_DIM" "$rule" "$TUI_RST"
    pause_terminal
}

