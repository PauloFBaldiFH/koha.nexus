            .append(\$("<i></i>").attr("class", "fa fa-magic")).append(document.createTextNode(" ${new_label}"));
        var grp = nr.closest(".btn-group");
        if (grp.length) grp.after(\$("<div class=\"btn-group\"></div>").append(nb)); else nr.after(nb);
    }
    // The same entry in the New menu of the record pages.
    var nm = \$("#newbiblio");
    if (nm.length && !\$("#kei-mr-new-item").length) {
        nm.closest("li").after(\$("<li></li>").append(\$("<a></a>").attr({ id: "kei-mr-new-item", "class": nm.attr("class") || "", href: "/cgi-bin/koha/tools/marc_replace.pl?op=vision" }).text("${new_label}")));
    }
    // Cataloguing home page: shortcuts in the column of the tools (the list
    // with the inventory, the MARC modification templates or the labels;
    // otherwise the last list of tools of the page).
    if (/\/cgi-bin\/koha\/cataloguing\/cataloging-home\.pl\$/.test(location.pathname)) {
        var tools = \$("a[href*='tools/inventory.pl'], a[href*='marc_modification_templates.pl'], a[href*='labels/label-home.pl']").closest("ul").first();
        if (!tools.length) tools = \$("a[href*='/cgi-bin/koha/tools/']").closest("ul").last();
        if (tools.length && !tools.find("a[href*='marc_replace.pl']").length) {
            var cls = tools.find("a").first().attr("class") || "circ-button";
            \$.each([["/cgi-bin/koha/tools/marc_replace.pl", "fa-exchange", "${home_label}"], ["/cgi-bin/koha/tools/marc_replace.pl?op=vision", "fa-camera", "${vision_label}"]], function (i, l) {
                var a = \$("<a></a>").attr({ "class": cls, href: l[0] }).append(\$("<i></i>").attr("class", "fa " + l[1])).append(document.createTextNode(" " + l[2]));
                tools.append(\$("<li></li>").append(a));
            });
        }
        return;
    }
    var m = location.pathname.match(/\/cgi-bin\/koha\/catalogue\/(detail|MARCdetail|ISBDdetail|labeledMARCdetail|moredetail)\.pl\$/);
    var bn = new URLSearchParams(location.search).get("biblionumber");
    if (!m || !bn || !/^[0-9]+\$/.test(bn)) return;
    var eb = \$("#editbiblio");
    var menu = eb.closest(".dropdown-menu");
    if (!menu.length) return;
    var url = "/cgi-bin/koha/tools/marc_replace.pl?biblionumber=" + bn;
    var a = \$("<a class=\"dropdown-item\"></a>").attr("href", url).text("${label}");
    menu.append(\$("<li></li>").append(a));
    // Replace via MARC / AI next to Edit: both open the page with this
    // record, which shows a preview to confirm before anything is replaced.
    var eg = menu.closest(".btn-group");
    var toggle = eg.children(".dropdown-toggle").first();
    if (!eg.length || !toggle.length || \$("#kei-mr-replace").length) return;
    var ic = eb.attr("class") || "";
    var items = \$("<ul class=\"dropdown-menu\"></ul>");
    \$.each([[url, "${repl_marc}"], [url.replace("?", "?op=vision&"), "${repl_ai}"]], function (i, l) {
        items.append(\$("<li></li>").append(\$("<a></a>").attr({ "class": ic, href: l[0] }).text(l[1])));
    });
    var rb = toggle.clone().removeAttr("id").attr({ id: "kei-mr-replace", "aria-expanded": "false" }).empty()
        .append(\$("<i></i>").attr("class", "fa fa-refresh")).append(document.createTextNode(" ${repl_label} "));
    eg.after(\$("<div class=\"btn-group\"></div>").append(rb).append(items));
});
${MR_JS_END}
MRJS
}

# IntranetUserJS as stored (--raw: line breaks and backslashes unescaped).
mr_js_current() {
    mysql --default-character-set=utf8mb4 -N -B --raw -e "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'IntranetUserJS';" 2>/dev/null
}

mr_js_sql() {   # mr_js_sql add|remove FILE: SQL that rewrites IntranetUserJS
    local cur new
    cur=$(mr_js_current)
    cur=$(printf '%s\n' "$cur" | awk -v b="$MR_JS_BEGIN" -v e="$MR_JS_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }')
    new="$cur"
    if [ "$1" = "add" ]; then new="${cur:+${cur}$'\n'}$(mr_js_block)"; fi
    printf "START TRANSACTION;\nUPDATE systempreferences SET value = %s WHERE variable = 'IntranetUserJS';\nCOMMIT;\n" "$(sql_quote "$new")" > "$2"
}

mr_installed() { [ -f "$MR_FILE" ]; }
mr_js_on() { mr_js_current | grep -qxF "$MR_JS_BEGIN"; }
# The block in IntranetUserJS is the one of this version (an update of the
# page brings new shortcuts to libraries that already had the link).
mr_js_current_block() { mr_js_current | awk -v b="$MR_JS_BEGIN" -v e="$MR_JS_END" '$0 == b { on = 1 } on { print } $0 == e { on = 0 }'; }
mr_js_latest() { [ "$(mr_js_current_block)" = "$(mr_js_block)" ]; }

function_marc_replace() {
    require_database || return 0
    local opt status
    while true; do
        if mr_installed; then status="$(t "Installed"): /cgi-bin/koha/tools/marc_replace.pl"; else status="$(t "Not installed.")"; fi
        opt=$(ui_menu "$(t "🔀  Replace a MARC record (staff tool)")" "$(t "A page of the staff interface that replaces a record by its biblionumber with a .mrc or .xml file or pasted text, showing a preview first. The items are never changed and the previous version is saved.")"$'\n\n'"$status" \
            "1" "$(t "Install or update the page")" \
            "2" "$(t "Remove the page")" \
            "3" "$(t "Versions saved by the page")") || return 0
        case "$opt" in
            1) lt_mr_install ;;
            2) lt_mr_remove ;;
            3) lt_mr_versions ;;
        esac
        clear
    done
}

lt_mr_install() {
    if [ ! -d "${KOHA_INTRA_CGI}/tools" ]; then
        msg_error "" "$(t "The staff interface folder of Koha was not found. Nothing was changed.")" 9 72
        return 1
    fi
    local link="no"
