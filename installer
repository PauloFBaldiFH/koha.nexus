def _header_hit(c):
    return bool(classify.header_match(c))


def plan_table(a, member, table):
    q = a.questions
    if table.headers is None:
        tables.set_header(table, _header_hit)
    data = table.data()
    sample = data[:classify.SAMPLE]
    cols = [classify.Column(i, h, [r[i] for r in sample if i < len(r) and r[i]]) for i, h in enumerate(table.headers)]
    for c in cols:
        classify.score_column(c, len(sample))
    profile = q.load_profile(table.headers) if table.header_row else None
    how = "detected"
    if profile and profile["entity"]:
        entity, ev, how = profile["entity"], classify.evidence(cols), "profile"
    else:
        entity, ev = classify.table_entity(cols, table.headers if table.header_row else None)
    plan = TablePlan(member, table, cols, entity, ev, how)
    a.tables.append(plan)
    if not data:
        plan.entity = "skip"
        return
    if entity is None:
        tid = qid(member.display, table.name, "table")
        opts = ["biblio", "patrons", "skip"] if ev[0] >= ev[1] else ["patrons", "biblio", "skip"]
        ans = q.answer(tid, opts)
        if ans:
            plan.entity, plan.how = ans, "answered"
            plan.asked = True
        else:
            first = next((r for r in data if any(r)), [])
            q.ask(tid, "table", table.name, ", ".join(h for h in table.headers[:10]),
                  " | ".join(v for v in first[:8] if v), opts)
            return
    if plan.entity not in ("biblio", "patrons", "mixed"):
        return
    allowed = classify.allowed_roles(plan.entity)
    fixed = {}
    if profile:
        fixed.update({i: r for i, r in profile["roles"].items() if i < len(cols) and (r == "" or r in allowed)})
    ids = {}
    for c in cols:
        cid = qid(member.display, table.name, "column", c.index, c.header)
        ids[c.index] = cid
        ans = q.answer(cid, allowed + ["ignore"])
        if ans:
            fixed[c.index] = "" if ans == "ignore" else ans
            plan.asked = True
    asked = classify.assign_roles(cols, plan.entity, fixed)
    for c in cols:
        if c.index in fixed and profile and c.index in profile["roles"] and q.answers.get(ids[c.index]) is None:
            c.status = "profile"
    classify.name_guard(cols, plan.entity)
    for c in asked:
        opts = [r for r, s in c.candidates if s >= classify.ASK][:4]
        if plan.entity == "mixed" and c.role in ("author", "fullname", "coauthors"):
            opts = ["fullname", "author"] if c.role == "fullname" else ["author", "fullname"]
        q.ask(ids[c.index], "column", table.name, c.header, " | ".join(c.samples(5)), opts + ["ignore"])


def plan_marc(a, d, work):
    info = detect.inspect_marc(d.member, d.kind, a.koha)
    mp = MarcPlan(d.member, d.kind, info)
    a.marcs.append(mp)
    q = a.questions
    if d.kind == "marc" and info.get("enc_conf", 1) < classify.ACCEPT:
        eid = qid(d.member.display, "encoding")
        ans = q.answer(eid, MARC_ENCODINGS)
        if ans:
            mp.encoding = ans
        else:
            q.ask(eid, "encoding", d.member.display, "", info.get("enc_sample", ""), ["ISO_8859-1", "MARC-8", "UTF-8"])
    # Copies in a legacy item field: moved to 952 at once when the field is
    # one of the usual ones and holds a numbering; otherwise asked, with
    # what each subfield was read as.
    if mp.item_tag and info.get("item_auto"):
        mp.route = "legacy"
    elif mp.item_tag:
        iid = qid(d.member.display, "items", mp.item_tag)
        ans = q.answer(iid, ["items", "keep"])
        if ans == "items":
            mp.route = "legacy"
        elif ans is None:
            q.ask(iid, "items", d.member.display, holdings.subject(mp.item_tag, info["item_roles"]),
                  info.get("item_sample", ""), ["items", "keep"])
    if mp.route == "legacy" and not bridge.yaz_available(getattr(a, "yaz", "yaz-marcdump")):
        a.needs.add("yaz")


def analyse(opts):
    a = Analysis()
    a.yaz = getattr(opts, "yaz", "yaz-marcdump")
    a.koha = {"branch": _load_map(getattr(opts, "branches", None)), "itemtype": _load_map(getattr(opts, "itypes", None)),
              "location": _load_map(getattr(opts, "locations", None))}
    a.questions = Questions(opts.answers, opts.profiles)
    a.intake = intake.Intake(opts.work)
    a.intake.add(opts.src)
    for m in a.intake.members:
        d = detect.detect(m, opts.work)
        a.detections.append(d)
        if d.kind == "koha_backup":
            a.koha_backups.append(d)
        elif d.kind in ("marc", "marcxml"):
            plan_marc(a, d, opts.work)
        elif d.kind in ("isis", "bf_backup", "bf_folder"):
            a.readers.append(d)
        elif d.kind == "table":
            reader = {"csv": tables.read_csv, "xlsx": tables.read_xlsx, "ods": tables.read_ods,
                      "xls": tables.read_xls, "dbf": tables.read_dbf, "json": tables.read_json,
                      "xml": tables.read_xml}[d.info.get("fmt", "csv")]
            try:
                found = reader(m.plain(opts.work), m.display)
            except tables.NeedPackage as e:
                a.needs.add(str(e))
                continue
            except Exception as e:      # a damaged workbook must not stop the other files
                a.unsupported.append((m.display, "cannot be read (%s)" % e))
                continue
            for t in found:
                plan_table(a, m, t)
        elif d.kind != "part":
            a.unsupported.append((m.display, UNSUPPORTED.get(d.kind, d.evidence)))
    if not a.questions.open:
        isbn_question(a, opts)
    return a


def _row_values(plan, row):
    v = {}
    for c in plan.columns:
        if not c.role or c.index >= len(row) or not row[c.index]:
            continue
        if c.role in classify.MULTI:
            v.setdefault(c.role, []).append(row[c.index])
        elif c.role not in v:
            v[c.role] = row[c.index]
    return v


def _feed(grouper, plan):
    first_line = 2 if plan.table.header_row else 1
    for n, row in enumerate(plan.table.data()):
        v = _row_values(plan, row)
        if not v:
            continue
        bib = {k: x for k, x in v.items() if classify.ROLES[k][0] == "bib"}
        if bib:
            grouper.add(bib, first_line + n, plan.table.name, [])


def isbn_question(a, opts):
    """ISBNs shared by different titles: kept apart, unless they would change
    the record count by more than 1 %, when the operator decides."""
    plans = [p for p in a.tables if p.entity in ("biblio", "mixed")]
    if not plans:
        return
    g = group.Grouper("", "", {})
    for p in plans:
        _feed(g, p)
    shared = g.plan()
    iid = qid(*[p.table.name for p in plans] + ["isbn"])
    ans = a.questions.answer(iid, ["apart", "merge"])
    if ans:
        a.isbn_answer = ans
    elif shared and shared > 0.01 * max(len(g.groups), 1):
        examples = [f.split(": ", 1)[1] for f in g.flags if f.startswith("ISBN ")][:3]
        a.questions.ask(iid, "isbn", ", ".join(p.table.name for p in plans), str(shared), " / ".join(examples), ["apart", "merge"])


