            p.subjects = subj.join(" ; ").slice(0, 300);
        }
        var cp = val("input[id^='tag_952_subfield_t']");
        if (/^\d{1,4}\$/.test(cp)) p.copy = cp;
        var q = []; for (var k in p) if (p[k]) q.push(k + "=" + encodeURIComponent(p[k]));
        var w = window.open(url + "?" + q.join("&"), "kei_cutter", "width=900,height=640,scrollbars=yes,resizable=yes");
        if (w) w.focus();
    });
});
${CUTTER_JS_END}
CUTJS
}

