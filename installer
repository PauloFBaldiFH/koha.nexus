    repl_ai=$(t "Photos of the book (AI)")
    for v in label home_label vision_label new_label repl_label repl_marc repl_ai; do
        declare -n _s=$v
        _s=${_s//\\/\\\\}; _s=${_s//\"/\\\"}; _s=${_s//</\\u003c}
        unset -n _s
    done
    cat <<MRJS
${MR_JS_BEGIN}
\$(document).ready(function () {
    // MARC Injection & AI beside New record (cataloguing home, cataloguing
    // search, catalogue search results): the AI cataloguing of the page,
    // which drafts a new record from photos of the book.
    var nr = \$("#newRecord");
    if (!nr.length) nr = \$("#toolbar a.btn[href*='cataloguing/addbiblio.pl']").not("[href*='biblionumber=']").first();
