"""MARC 21: the record model, the MARCXML writer Koha's stage_file.pl reads,
and readers for ISO 2709 and MARCXML used to inspect incoming files (item
fields, encoding) and to show sample records in the preview."""
import re
from xml.etree import ElementTree as ET
from xml.sax.saxutils import escape, quoteattr

SLIM = "http://www.loc.gov/MARC21/slim"
_BAD_XML = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f￾￿]")


class Field:
    def __init__(self, tag, ind1=" ", ind2=" ", subfields=None, value=None):
        self.tag = tag
        self.ind1 = ind1
        self.ind2 = ind2
        self.subfields = [(c, v) for c, v in (subfields or []) if v not in (None, "")]
        self.value = value          # control fields (001-009)

    def is_control(self):
        return self.tag < "010"

    def get(self, code):
        for c, v in self.subfields:
            if c == code:
                return v
        return ""


class Record:
    def __init__(self, leader="00000nam a22000007a 4500"):
        self.leader = leader
        self.fields = []

    def add(self, tag, ind1=" ", ind2=" ", *subfields):
        f = Field(tag, ind1, ind2, list(subfields))
        if f.subfields:
            self.fields.append(f)
        return f

    def control(self, tag, value):
        self.fields.append(Field(tag, value=value))

    def sort(self):
        self.fields.sort(key=lambda f: f.tag)

    def count(self, tag):
        return sum(1 for f in self.fields if f.tag == tag)

    def formatted(self):
        out = ["LDR %s" % self.leader]
        for f in self.fields:
            if f.is_control():
                out.append("%s    %s" % (f.tag, f.value))
            else:
                out.append("%s %s%s %s" % (f.tag, f.ind1, f.ind2, " ".join("$%s %s" % (c, v) for c, v in f.subfields)))
        return "\n".join(out)


def _x(s):
    return escape(_BAD_XML.sub("", s))


def write_marcxml(records, path):
    with open(path, "w", encoding="utf-8", newline="\n") as out:
        out.write('<?xml version="1.0" encoding="UTF-8"?>\n<collection xmlns="%s">\n' % SLIM)
        for r in records:
            out.write("<record>\n  <leader>%s</leader>\n" % _x(r.leader))
            for f in r.fields:
                if f.is_control():
                    out.write("  <controlfield tag=%s>%s</controlfield>\n" % (quoteattr(f.tag), _x(f.value)))
                    continue
                out.write("  <datafield tag=%s ind1=%s ind2=%s>" % (quoteattr(f.tag), quoteattr(f.ind1), quoteattr(f.ind2)))
                for c, v in f.subfields:
                    out.write("<subfield code=%s>%s</subfield>" % (quoteattr(c), _x(v)))
                out.write("</datafield>\n")
            out.write("</record>\n")
        out.write("</collection>\n")


