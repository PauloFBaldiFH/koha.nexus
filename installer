}
my $items = 0; $items += @{ $_->{items} } for @recs;
my %what = ( $cat => 'collection' );
$what{$occ} = 'occurrences (notes and lost copies of the items)' if $occ;
print 'File: ', join( ' + ', @layers, 'PostgreSQL plain SQL dump' ), ( $crlf ? ', Windows line ends' : '' ), ( $bom ? ", $bom" : '' ), "\n";
print 'Dump: PostgreSQL ', $pgver // '?', ', pg_dump ', $pgdump // '?', ', encoding ', ( $declared || 'not declared' ), "\n";
printf "Noise left out: %d byte(s) before the dump, %d byte(s) after it\n", $stat{junk_head}, $stat{junk_tail};
