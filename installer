                    if kind in ("float", "percentage", "currency"):
                        val = _number(cell.get(_q("office", "value"), ""))
                    elif kind == "date":
                        val = cell.get(_q("office", "date-value"), "")[:10]
                    elif kind == "boolean":
                        val = cell.get(_q("office", "boolean-value"), "").upper()
                    else:
                        val = _ods_text(cell)
                    rep = int(cell.get(_q("table", "number-columns-repeated"), "1"))
                    row.extend([val] * min(rep, MAX_COLS))
                while row and not row[-1]:
                    row.pop()
                rep = int(el.get(_q("table", "number-rows-repeated"), "1"))
                if row:
                    rows.extend([row[:MAX_COLS]] * min(rep, MAX_ROWS))
                else:
                    rows.extend([[]] * min(rep, 1000))
