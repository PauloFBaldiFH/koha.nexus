    named = sum(1 for c in first if c and synonyms_hit(c))
    looks_text = all(c and R.has_letters(c) and not R.iso_date(c) for c in first if c)
    if named or (looks_text and len(table.rows) > 1 and _types_differ(first, table.rows[1:21])):
