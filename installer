"""Intake: the dropped file (or folder) becomes a list of members. Archives
are unpacked inside the work folder with limits (no path outside it, no
links or devices, size and count caps, zip bombs refused); compressed
single files (.gz, .bz2, .xz) are read through their decompressor and only
written out when a reader needs a real file."""
import bz2
import gzip
import lzma
import os
import re
import shutil
import stat
import tarfile
import zipfile

MAX_MEMBERS = 2000
MAX_TOTAL = 8 << 30        # bytes written by unpacking, all members together
MAX_RATIO = 300            # uncompressed / compressed size of one zip member
MAX_DEPTH = 3              # archives inside archives
JUNK = re.compile(r"(^|/)(__MACOSX|\.DS_Store|Thumbs\.db|desktop\.ini|~\$[^/]*|\.~lock\.[^/]*)(/|$)", re.I)


class Member:
    n_plain = 0

    def __init__(self, path, display, codec=None, in_archive=False):
        self.path = path            # file on disk
        self.display = display      # name shown to the operator
        self.codec = codec          # 'gz' | 'bz2' | 'xz' when read through a decompressor
        self.in_archive = in_archive
        self._plain = None

    def open(self):
        if self.codec == "gz":
            return gzip.open(self.path, "rb")
        if self.codec == "bz2":
            return bz2.open(self.path, "rb")
        if self.codec == "xz":
            return lzma.open(self.path, "rb")
        return open(self.path, "rb")

    def plain(self, work):
        """Path of the member as a plain file (decompressed once if needed)."""
        if not self.codec:
            return self.path
        if not self._plain:
            os.makedirs(os.path.join(work, "plain"), exist_ok=True)
            base = os.path.basename(self.path)
            base = re.sub(r"\.(gz|bz2|xz)$", "", base, flags=re.I)
            Member.n_plain += 1
            self._plain = os.path.join(work, "plain", "%d-%s" % (Member.n_plain, safe_name(base)))
            with self.open() as src, open(self._plain, "wb") as dst:
                shutil.copyfileobj(src, dst, 1 << 20)
        return self._plain


class IntakeError(Exception):
    pass


def safe_name(name):
    name = re.sub(r"[^\w .()+@-]", "_", name, flags=re.UNICODE).strip(" .")
    return name[:120] or "file"


def magic(path):
    try:
        with open(path, "rb") as fh:
            return fh.read(512)
    except OSError:
        return b""


def codec_of(head):
    if head.startswith(b"\x1f\x8b"):
        return "gz"
    if head.startswith(b"BZh") and head[3:4].isdigit():
        return "bz2"
    if head.startswith(b"\xfd7zXZ\x00"):
        return "xz"
    return None


def _is_tar(head):
    return len(head) >= 262 and head[257:262] == b"ustar"


def is_office_zip(path):
    try:
        with zipfile.ZipFile(path) as z:
            names = set(z.namelist())
            if "xl/workbook.xml" in names:
                return "xlsx"
            if "mimetype" in names and z.read("mimetype").strip() == b"application/vnd.oasis.opendocument.spreadsheet":
                return "ods"
    except (zipfile.BadZipFile, OSError, KeyError):
        return None
    return None


class Intake:
    def __init__(self, work):
        self.work = work
        self.members = []
        self.skipped = []        # (name, reason)
        self.written = 0
        self.n_archive = 0

    def add(self, path, display=None, depth=0, in_archive=False):
        display = display or os.path.basename(path.rstrip("/")) or path
        if os.path.isdir(path):
            for root, dirs, files in os.walk(path):
                dirs[:] = sorted(d for d in dirs if not JUNK.search(d + "/"))
                for f in sorted(files):
                    p = os.path.join(root, f)
                    rel = os.path.relpath(p, path)
                    if JUNK.search(rel) or os.path.islink(p):
                        continue
                    self.add(p, os.path.join(display, rel), depth, in_archive)
            return
        if len(self.members) >= MAX_MEMBERS:
            raise IntakeError("more than %d files" % MAX_MEMBERS)
        head = magic(path)
        codec = codec_of(head)
        if codec:
            # A compressed tar is an archive; anything else is read as it streams.
            m = Member(path, display, codec, in_archive)
            with m.open() as fh:
                try:
                    inner = fh.read(512)
                except (OSError, EOFError, lzma.LZMAError):
                    self.skipped.append((display, "damaged %s file" % codec))
                    return
            if _is_tar(inner) and depth < MAX_DEPTH:
                self._untar(path, display, depth)
            else:
                self.members.append(m)
            return
        if head.startswith(b"PK\x03\x04") and not is_office_zip(path) and depth < MAX_DEPTH:
            self._unzip(path, display, depth)
            return
        if _is_tar(head) and depth < MAX_DEPTH:
            self._untar(path, display, depth)
            return
        self.members.append(Member(path, display, None, in_archive))

    def _dest(self):
        self.n_archive += 1
        d = os.path.join(self.work, "members", str(self.n_archive))
        os.makedirs(d, exist_ok=True)
        return d

    def _target(self, dest, name):
        parts = [safe_name(p) for p in re.split(r"[\\/]+", name) if p not in ("", ".", "..")]
        if not parts:
            return None
        target = os.path.join(dest, *parts)
        if not os.path.realpath(target).startswith(os.path.realpath(dest) + os.sep):
            return None
        return target

    def _account(self, size):
        self.written += size
        if self.written > MAX_TOTAL:
            raise IntakeError("the archive unpacks to more than %d GiB" % (MAX_TOTAL >> 30))

    def _unzip(self, path, display, depth):
        try:
            z = zipfile.ZipFile(path)
        except (zipfile.BadZipFile, OSError) as e:
            self.skipped.append((display, "damaged zip file (%s)" % e))
            return
        dest = self._dest()
        with z:
            for info in z.infolist():
                name = info.filename
                if info.is_dir() or JUNK.search(name):
                    continue
                mode = info.external_attr >> 16
                if stat.S_ISLNK(mode):
                    self.skipped.append((display + "/" + name, "link, not unpacked"))
                    continue
                if info.compress_size and info.file_size / max(info.compress_size, 1) > MAX_RATIO and info.file_size > (64 << 20):
                    self.skipped.append((display + "/" + name, "refused: compression ratio too high"))
                    continue
                target = self._target(dest, name)
                if not target:
                    self.skipped.append((display + "/" + name, "refused: unsafe path"))
                    continue
                self._account(info.file_size)
                os.makedirs(os.path.dirname(target), exist_ok=True)
                try:
                    with z.open(info) as src, open(target, "wb") as dst:
                        copied = 0
                        while True:
                            buf = src.read(1 << 20)
                            if not buf:
                                break
                            copied += len(buf)
                            if copied > info.file_size + (1 << 20):
                                raise IntakeError("a member of %s is larger than it says" % display)
                            dst.write(buf)
                except (zipfile.BadZipFile, RuntimeError, OSError, EOFError, NotImplementedError) as e:
                    self.skipped.append((display + "/" + name, "cannot be unpacked (%s)" % e))
                    continue
                self.add(target, display + "/" + name, depth + 1, True)

    def _untar(self, path, display, depth):
        try:
            tf = tarfile.open(path, "r:*")
        except (tarfile.TarError, OSError, EOFError) as e:
            self.skipped.append((display, "damaged tar file (%s)" % e))
            return
        dest = self._dest()
        with tf:
            for info in tf:
                if info.isdir():
                    continue
                if not info.isreg():
                    self.skipped.append((display + "/" + info.name, "link or device, not unpacked"))
                    continue
                if JUNK.search(info.name):
                    continue
                target = self._target(dest, info.name)
                if not target:
                    self.skipped.append((display + "/" + info.name, "refused: unsafe path"))
                    continue
                self._account(info.size)
                os.makedirs(os.path.dirname(target), exist_ok=True)
                src = tf.extractfile(info)
                if src is None:
                    continue
                with src, open(target, "wb") as dst:
                    shutil.copyfileobj(src, dst, 1 << 20)
                self.add(target, display + "/" + info.name, depth + 1, True)
