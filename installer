# ---------------------------------------------------------------- names

CORPORATE = re.compile(
    r"\b(universidade|university|instituto|institute|ministerio|secretaria|editora|associacao|"
    r"fundacao|sociedade|society|conselho|empresa|companhia|comissao|departamento|biblioteca|"
