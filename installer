EOF

    tui_run "$(t "Registering the catalog address")" cloudflare_route_dns "$tunnel_name" "${opac_sub}.${dominio}"
    tui_run "$(t "Registering the staff address")" cloudflare_route_dns "$tunnel_name" "${staff_sub}.${dominio}"
