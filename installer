);

# 'chat' (small talk, no tools) or 'tools'.
sub route {
    my ($q) = @_;
    my @w = map { lc } ( $q // '' ) =~ /([\p{L}']+)/g;
    return 'tools' if !@w || @w > 10 || grep { !$SMALL_TALK{$_} } @w;
    return ( grep { $SMALL_TALK_TRIGGER{$_} } @w ) ? 'chat' : 'tools';
}

# ----------------------------------------------------------------------
# The loop: question -> tool calls -> answer
# ----------------------------------------------------------------------

# The first complete {...} of the text (models wrap it in ```json or prose).
sub parse_envelope {
    my ($text) = @_;
    $text //= '';
    my $start = index( $text, '{' );
    while ( $start >= 0 ) {
        my ( $depth, $in, $esc ) = ( 0, 0, 0 );
        for my $i ( $start .. length($text) - 1 ) {
            my $ch = substr( $text, $i, 1 );
            if ($in) {
                if    ($esc)        { $esc = 0 }
                elsif ( $ch eq '\\' ) { $esc = 1 }
                elsif ( $ch eq '"' )  { $in  = 0 }
                next;
            }
            if    ( $ch eq '"' ) { $in = 1 }
            elsif ( $ch eq '{' ) { $depth++ }
            elsif ( $ch eq '}' && --$depth == 0 ) {
                my $obj = eval { JSON::PP->new->relaxed->decode( substr( $text, $start, $i - $start + 1 ) ) };
                return $obj if ref $obj eq 'HASH';
                last;
            }
        }
        $start = index( $text, '{', $start + 1 );
    }
    return {};
}

# "I have no access to the database": what a model says when it answers
# without trying a tool (small local models do, and so does any model whose
# instructions were cut off). English, Portuguese, Spanish and French.
our $REFUSAL = qr/
      \b(?:don'?t|do\ not|doesn'?t|does\ not|cannot|can'?t|unable\ to|not\ able\ to)\b[^.\n]{0,50}?\b(?:access|connect|query|look\ up)
    | \b(?:no|without)\ (?:direct\ )?access\b
    | \bn[ãa]o\ (?:tenho|possuo|consigo|posso|h[áa]|disponho)\b[^.\n]{0,50}?\b(?:acess|consult|conect|pesquis)
    | \bsem\ acesso\b
    | \bno\ (?:tengo|puedo)\b[^.\n]{0,50}?\b(?:acce|consult|conect)
    | \bsin\ acceso\b
    | \bn'ai\ pas\b[^.\n]{0,50}?\bacc[eè]s
    | \bas\ an\ ai\b | \bcomo\ (?:uma\ )?(?:ia|intelig[êe]ncia\ artificial)\b
/xi;

our $NUDGE = 'You answered without calling a tool. You DO have live read access to this library\'s Koha catalogue and data through the tools in your instructions; '
    . 'nothing else is needed. Call the tool that fits the librarian\'s question now, as {"tool": "<name>", "args": {...}}.';

sub refuses { my ($answer) = @_; return defined $answer && !ref $answer && $answer =~ $REFUSAL ? 1 : 0 }

# Search terms of a question, for when the model will not search itself:
# names in capitals ("Machado de Assis") whole, then the other long words.
our %QUESTION_STOP = map { $_ => 1 } qw( about acervo algum alguma algo autor autora autores book books catalogue catálogo
    como could does have livro livros temos there tem tenho what which with sobre quais qual quem onde quero queria
    please favor biblioteca library from para pelo pela este esta isso that this mostre mostrar show find list liste encontre );

sub question_terms {
    my ($q) = @_;
    my ( @terms, %seen );
    my $cap = qr/\p{Lu}[\p{L}'-]+/;
    while ( $q =~ /($cap(?:\s+(?:(?:de|da|do|dos|das|del|di|van|von|the|of)\s+)?$cap)+)/g ) { push @terms, $1 }
    my $named = join ' ', @terms;
    push @terms, grep { length >= 4 && !$QUESTION_STOP{ lc $_ } && index( $named, $_ ) < 0 } $q =~ /([\p{L}\d'-]+)/g;
    @terms = grep { !$seen{ lc $_ }++ } @terms;
    splice @terms, 6 if @terms > 6;
    return \@terms;
}

# What a turn leaves for the next ones: the tools it called and the
# records they returned (the conversation buffer of the follow-ups).
our $CONTEXT_RECORDS = 12;

sub turn_context {
    my ( $ctx, $calls ) = @_;
    my @found = map { "$_ " . ( $ctx->{refs}{$_}{label} // '' ) } grep { $ctx->{refs}{$_} } @{ $ctx->{seen} || [] };
    splice @found, $CONTEXT_RECORDS if @found > $CONTEXT_RECORDS;
    my %c;
    $c{tools} = $calls if @$calls;
    $c{found} = \@found if @found;
    return \%c;
}

# ask($ctx, $model, $history, $question, $lang): $model->(\@messages) returns
# the model's text; $history holds the past questions and answers (with
# their context). Returns { answer, steps, proposals, route } and appends
# the turn to $history.
sub ask {
    my ( $ctx, $model, $history, $question, $lang ) = @_;
    $ctx->{proposals} //= [];
    $ctx->{seen} = [];
    my $first = @{ $ctx->{proposals} };
    my $route = route($question);
    my ( @steps, @calls, $answer, $nudged );
    if ( $route eq 'chat' ) {
        my $raw = $model->( [ { role => 'system', content => system_prompt( $ctx, $lang, 'chat' ) }, @$history, { role => 'user', content => $question } ] );
        my $env = parse_envelope($raw);
        if ( defined $env->{answer} && !ref $env->{answer} && $env->{answer} =~ /\S/ ) { $answer = $env->{answer} }
        elsif ( !%$env && defined $raw && $raw =~ /\S/ && $raw !~ /[{}]/ ) { $answer = $raw }
        else { $route = 'tools' }    # it wanted a tool after all: the full way
    }
    if ( $route eq 'tools' ) {
        my @msgs = ( { role => 'system', content => system_prompt( $ctx, $lang ) }, @$history, { role => 'user', content => $question } );
        for my $step ( 0 .. $MAX_STEPS ) {
            my $raw  = $model->( \@msgs );
            my $env  = parse_envelope($raw);
            my $name = $env->{tool};
            if ( !$name || ref $name || $step == $MAX_STEPS ) {
                $answer = $env->{answer};
                if ( !defined $answer || ref $answer || $answer !~ /\S/ ) {
                    $answer = %$env ? 'I could not finish this answer. Please rephrase the question.' : $raw;
                }
                # "No access" before trying anything: reminded once; then the
                # catalogue is searched for it with the words of the question.
                if ( !@steps && $step < $MAX_STEPS && refuses($answer) ) {
                    if ( !$nudged++ ) {
                        push @msgs, { role => 'assistant', content => $raw // '' }, { role => 'user', content => $NUDGE };
                        next;
                    }
                    my $terms = question_terms($question);
                    if (@$terms) {
                        my $args = { terms => $terms };
                        push @steps, 'search_catalogue';
                        push @calls, { tool => 'search_catalogue', args => $args };
                        my $result = call_tool( $ctx, 'search_catalogue', $args );
                        push @msgs, { role => 'assistant', content => $JSON->encode( { tool => 'search_catalogue', args => $args } ) },
                            { role => 'user', content => "TOOL RESULT search_catalogue: $result\n\nAnswer the librarian's question with this result (or call another tool)." };
                        next;
                    }
                }
                last;
            }
            my $args = ref $env->{args} eq 'HASH' ? $env->{args} : {};
            push @steps, $name;
            push @calls, { tool => $name, args => $args };
            my $result = call_tool( $ctx, $name, $args );
            push @msgs, { role => 'assistant', content => $JSON->encode($env) }, { role => 'user', content => "TOOL RESULT $name: $result" };
        }
    }
    $answer //= '';
    $answer =~ s/^\s+|\s+$//g;
    # A refusal is not kept: the next question would copy it.
    if ( @steps || !refuses($answer) ) {
        my $context = turn_context( $ctx, \@calls );
        push @$history, { role => 'user', content => $question },
            { role => 'assistant', content => $JSON->encode( { answer => $answer, %$context ? ( context => $context ) : () } ) };
    }
    splice @$history, 0, @$history - 2 * $HISTORY_TURNS if @$history > 2 * $HISTORY_TURNS;
    return { answer => $answer, steps => \@steps, route => $route, proposals => [ @{ $ctx->{proposals} }[ $first .. $#{ $ctx->{proposals} } ] ] };
}

# The links of an answer the page may show: only those a tool returned.
sub answer_refs {
    my ( $ctx, $answer ) = @_;
    my %out;
    while ( $answer =~ /\[\[(biblio|patron|report|syspref|page):([A-Za-z0-9_.-]+)\|[^\]]*\]\]/g ) {
        my $k = "$1:$2";
        $out{$k} = $ctx->{refs}{$k} if $ctx->{refs}{$k};
    }
    return \%out;
}

1;
AIAPM
}

