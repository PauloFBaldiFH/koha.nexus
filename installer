altcontactaddress2 altcontactaddress3 altcontactstate altcontactzipcode altcontactcountry altcontactphone
smsalertnumber sms_provider_id privacy privacy_guarantor_fines privacy_guarantor_checkouts
checkprevcheckout updated_on lastseen lang login_attempts overdrive_auth_token anonymized
autorenew_checkouts primary_contact_method protected patron_attributes guarantor_relationship
guarantor_id""".split())


def header_match(header):
    """{role: 1.0 (same name) or 0.7 (name inside a longer header)}."""
    h = R.norm_header(header)
    if not h:
        return {}
    out = {}
    padded = " " + h + " "
    for role, names in HEADERS.items():
        if h in names:
            out[role] = 1.0
            continue
        best = 0
        for n in names:
            # Short names ("v", "ex", "id", "uf") only count as the whole header.
            if len(n) >= 4 and " " + n + " " in padded:
                best = max(best, len(n))
        if best:
            out[role] = 0.7
    # A longer header naming another role wins ("data de nascimento" is not "data").
    if out:
        top = max(out.values())
        if top == 1.0:
            out = {r: s for r, s in out.items() if s == 1.0}
    return out


def entities_of(matches):
    return {ROLES[r][0] for r in matches}


class Column:
    def __init__(self, index, header, values):
        self.index = index
        self.header = header
        self.values = values            # sampled non-empty values
        self.scores = {}
        self.role = None                # final role (None = left out)
        self.score = 0.0
        self.status = "ignored"         # accepted | asked | answered | profile | ignored
        self.candidates = []            # [(role, score)] best first
        self.header_roles = header_match(header) if header else {}

    def samples(self, n=4):
        seen, out = set(), []
        for v in self.values:
            if v not in seen:
                seen.add(v)
                out.append(v)
            if len(out) >= n:
                break
        return out


def score_column(col, n_rows):
    vals = col.values
    distinct = len(set(vals))
    for role, (entity, test, _) in ROLES.items():
        h = col.header_roles.get(role, 0.0)
        if vals:
            vs = sum(test(v) for v in vals) / len(vals)
        else:
            vs = 0.0
        if vals and role in FEW and distinct > max(30, 0.2 * len(vals)):
            vs *= 0.3
        if vals and role in UNIQUE and len(vals) >= 5:
            ratio = distinct / len(vals)
            if ratio < 0.9:
                vs *= ratio
        s = 0.4 * h + 0.6 * vs
        if role in STRONG and vs >= 0.9:
            s = max(s, 0.9)
        if not vals and h:
            s = 0.4 * h        # an empty column: only its name speaks
        col.scores[role] = round(s, 3)


def evidence(columns):
    """(B, P, T): bibliographic, personal and circulation evidence of a table.
    A column whose name could belong to several entities ("registro",
    "situação") counts only through an unmistakable value test."""
    b = p = t = 0
    for col in columns:
        best_role, best = max(col.scores.items(), key=lambda kv: kv[1]) if col.scores else (None, 0)
        if best < ACCEPT:
            continue
        ambiguous = len(entities_of(col.header_roles)) > 1
        if ambiguous and best_role not in STRONG:
            continue
        b += BIB_EVIDENCE.get(best_role, 0)
        p += PAT_EVIDENCE.get(best_role, 0)
        t += CIRC_EVIDENCE.get(best_role, 0)
    return b, p, t


def is_koha_patron_layout(headers):
    hs = [str(h or "").strip() for h in headers]
    if not hs or any(h not in KOHA_BORROWER for h in hs if h):
        return False
    return "surname" in hs and ("cardnumber" in hs or "userid" in hs)


def has_bib_core(columns):
    return any(c.scores.get("title", 0) >= ACCEPT or c.scores.get("isbn", 0) >= ACCEPT for c in columns)


def table_entity(columns, headers):
    """'koha_patrons', 'circulation', 'biblio', 'patrons', 'mixed' or None
    (unclear: the operator is asked), with the evidence."""
    if headers and is_koha_patron_layout(headers):
        return "koha_patrons", (0, 0, 0)
    b, p, t = evidence(columns)
    if t >= 2 or (t >= 1 and (b >= 1 or p >= 1)):
        return "circulation", (b, p, t)
    if b >= 3 and p == 0:
        return "biblio", (b, p, t)
    if p >= 2 and not has_bib_core(columns):
        return "patrons", (b, p, t)
    if b >= 3 and p >= 2:
        return "mixed", (b, p, t)
    return None, (b, p, t)


def allowed_roles(entity):
    if entity == "biblio":
        return ENTITY_ROLES["bib"]
    if entity == "patrons":
        return ENTITY_ROLES["pat"]
    if entity == "mixed":
        return ENTITY_ROLES["bib"] + ENTITY_ROLES["pat"]
    return []


def assign_roles(columns, entity, fixed):
    """Gives each column its role inside the entity. fixed = {index: role}
    from answers or a profile. Returns the columns that need a question."""
    allowed = allowed_roles(entity)
    taken = {}
    for col in columns:
        if col.index in fixed:
            col.role = fixed[col.index] or None
            col.status = "answered"
            if col.role and col.role not in MULTI:
                taken[col.role] = col
    # Strongest columns first, so a weaker column never takes a role first.
    order = sorted((c for c in columns if c.index not in fixed),
                   key=lambda c: -max([c.scores.get(r, 0) for r in allowed] or [0]))
    questions = []
    for col in order:
        cands = sorted(((r, col.scores.get(r, 0)) for r in allowed if r in MULTI or r not in taken),
                       key=lambda rs: -rs[1])
        col.candidates = cands[:5]
        if not cands or cands[0][1] < ASK:
            col.role, col.status = None, "ignored"
            continue
        best_role, best = cands[0]
        second = cands[1][1] if len(cands) > 1 else 0.0
        name_doubt = entity == "mixed" and best_role in ("author", "fullname", "coauthors") \
            and col.scores.get("author", 0) > ASK and col.scores.get("fullname", 0) > ASK
        if best >= ACCEPT and best - second >= MARGIN and not name_doubt:
            col.role, col.score, col.status = best_role, best, "accepted"
            if best_role not in MULTI:
                taken[best_role] = col
        else:
            col.role, col.score, col.status = best_role, best, "asked"
            questions.append(col)
    return questions


def name_guard(columns, entity):
    """No patron name in a table with titles or ISBNs unless the operator chose
    it; a column of inverted names ("Assis, Machado de") is an author there."""
    if entity not in ("biblio", "mixed"):
        return
    for col in columns:
        if col.role not in ("fullname", "surname", "firstname"):
            continue
        if col.status in ("answered", "profile") and entity == "mixed":
            continue
        inverted = sum(1 for v in col.values if R.is_inverted_name(v))
        if entity == "biblio" or (col.values and inverted / len(col.values) > 0.6):
            col.role, col.status = ("author", "accepted") if entity == "biblio" else (None, "ignored")
