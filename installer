_PARTICLES = {"de", "da", "do", "das", "dos", "e", "van", "von", "del", "della", "di", "du", "y"}
_SUFFIXES = {"filho", "neto", "junior", "jr", "sobrinho", "segundo", "bisneto"}
_NAME_WORD = re.compile(r"^[^\W\d_][^\W\d_'’.-]*(['’.-][^\W\d_]*)*\.?$")


def name_words(s):
    return [w for w in clean(s).split(" ") if w]


def is_inverted_name(s):
    """'Assis, Machado de' or 'AZEVEDO, Aluísio' (surname first)."""
    s = clean(s)
    m = re.fullmatch(r"([^,;\d]{2,}),\s*([^,;\d]{1,})(,\s*[\d?-]+\.?)?\.?", s)
    if not m:
        return False
    return all(_NAME_WORD.match(w) for w in name_words(m.group(1) + " " + m.group(2)))


def is_natural_name(s):
    """'Machado de Assis': 2 to 6 words, capitalised except the particles."""
    words = name_words(s)
    if not 2 <= len(words) <= 6:
        return False
    for w in words:
        if not _NAME_WORD.match(w):
            return False
        if w.lower() not in _PARTICLES and not w[0].isupper():
            return False
    return not CORPORATE.search(norm_header(s))


def is_corporate(s):
    return bool(CORPORATE.search(norm_header(s)))


def invert_name(s):
    """Entry form of a personal name: 'Machado de Assis' -> 'Assis, Machado de',
    'José Bento Filho' -> 'Bento Filho, José'. Names already inverted, single
    words and corporate names are kept as they are."""
    s = clean(s)
    if "," in s or is_corporate(s):
        return s
    words = name_words(s)
    if len(words) < 2:
        return s
    cut = _surname_cut(words)
    return " ".join(words[cut:]) + ", " + " ".join(words[:cut])


def _surname_cut(words):
    """Index of the first word of the surname: the last word, with the
    agnomen (Filho, Neto, Júnior...) bound to the surname before it. The
    particles stay with the forenames ('Maria de Lourdes dos | Santos')."""
    cut = len(words) - 1
    if norm_header(words[-1]) in _SUFFIXES and len(words) > 2:
        cut -= 1
    return cut


def natural_name(s):
    """Direct order of an entry: 'Assis, Machado de' -> 'Machado de Assis',
    'Silva Filho, Carlos Eduardo da' -> 'Carlos Eduardo da Silva Filho'
    (dates of the heading left out)."""
    s = clean(s)
    if "," not in s or is_corporate(s):
        return s
    sur, rest = [p.strip() for p in s.split(",", 1)]
    rest = re.sub(r",?\s*[\d?]+\s*-\s*[\d?]*\.?$", "", rest).strip(" ,")
    return (rest + " " + sur).strip() if rest else sur


def split_patron_name(full):
    """(firstname, surname) for Koha's borrowers, by the same rule as the
    authors: 'João Pedro Santos' -> ('João Pedro', 'Santos'),
    'Carlos Eduardo da Silva Filho' -> ('Carlos Eduardo da', 'Silva Filho'),
    'Souza, Ana' -> ('Ana', 'Souza')."""
    full = clean(full)
    if "," in full:
        sur, first = [p.strip() for p in full.split(",", 1)]
        return first, sur
    words = full.split(" ")
    if len(words) == 1:
        return "", full
    cut = _surname_cut(words)
    return " ".join(words[:cut]), " ".join(words[cut:])


# ---------------------------------------------------------------- casing

ACRONYMS = {"abnt", "unesco", "eua", "ufpr", "usp", "ufrj", "ufmg", "ufrgs", "ufsc", "ufpe", "ufba", "ufc", "unb",
            "uerj", "uel", "unicamp", "unesp", "utfpr", "ifpr", "ibge", "onu", "mec", "inep", "cnpq", "capes",
            "sesc", "senac", "senai", "sebrae", "embrapa", "fgv", "puc", "ibict", "fiocruz", "oms", "oea", "fao",
            "unicef", "otan", "nato", "usa", "urss", "isbn", "issn", "marc", "cdd", "cdu", "aacr", "ldb", "clt",
            "eca", "sus", "stf", "stj", "oab", "aids", "hiv", "dna", "rna", "dvd", "tv", "ti"}
# Words without vowels that are words, not acronyms.
_ABBREVIATIONS = {"dr", "dra", "sr", "sra", "srta", "st", "sta", "sto", "mr", "mrs", "ms", "jr", "pr"}
# Lowercase inside a title or a name (particles, articles, prepositions).
_SMALL = {"de", "da", "do", "das", "dos", "e", "em", "por", "von", "van", "del", "della", "di", "du", "y",
          "a", "o", "os", "as", "um", "uma", "ao", "aos", "à", "às", "na", "no", "nas", "nos", "num", "numa",
          "pela", "pelo", "pelas", "pelos", "com", "sem", "para", "sob", "sobre", "entre", "the", "of", "and",
          "in", "on", "at", "to", "for", "an", "or", "el", "la", "los", "las", "le", "les", "des", "et", "en",
          "und", "der", "die", "zu", "dem", "den", "dei", "degli", "ten", "ter"}
# Proper nouns kept capitalised in sentence case (subtitles, subjects, notes).
_PROPER = {"brasil", "portugal", "angola", "mocambique", "america", "europa", "africa", "asia", "oceania",
           "franca", "espanha", "inglaterra", "alemanha", "italia", "japao", "china", "russia", "argentina",
           "mexico", "chile", "peru", "uruguai", "paraguai", "bolivia", "venezuela", "colombia", "cuba",
           "canada", "deus", "jesus", "cristo", "parana", "bahia", "amazonia", "amazonas", "pernambuco",
           "londres", "roma"} | {c for c in CITIES if " " not in c and c != "porto"}
_ROMAN_RE = re.compile(r"m{0,3}(cm|cd|d?c{0,3})(xc|xl|l?x{0,3})(ix|iv|v?i{0,3})")
_WORD_RE = re.compile(r"[^\W\d_]+(?:['’][^\W\d_]+)*")
_SENTENCE_END = re.compile(r"(?:[.!?;|]|\s-{1,2}|\s–)\s*$")


def is_roman(w):
    """A Roman numeral of two or more letters ('iii', 'xiv')."""
    return len(w) > 1 and bool(_ROMAN_RE.fullmatch(w.lower()))


def is_shouting(s):
    """Text typed in capitals (DOS and ISIS catalogues): 90% or more of its
    letters, and at least four of them, upper case."""
    letters = [c for c in str(s or "") if c.isalpha()]
    return len(letters) >= 4 and sum(1 for c in letters if c.isupper()) >= 0.9 * len(letters)


def _capitalise(low, start):
    parts = re.split(r"(['’])", low)
    if len(parts) == 3 and parts[0] in ("d", "l") and not start:      # d'Água, l'Enfant
        return parts[0] + parts[1] + parts[2][:1].upper() + parts[2][1:]
    out = parts[0][:1].upper() + parts[0][1:]
    for i in range(2, len(parts), 2):                                  # Sant'Anna, but Didn't
        p = parts[i]
        out += parts[i - 1] + (p[:1].upper() + p[1:] if len(p) > 1 else p)
    return out


def _case_word(word, start, mode, gap):
    low = word.lower()
    key = strip_accents(low)
    if key in ACRONYMS or is_roman(key):
        return word.upper()
    if 2 <= len(key) <= 6 and not re.search(r"[aeiouy]", key) and key not in _ABBREVIATIONS:
        return word.upper()                                            # SP, CNPQ, BNDS
    if len(key) == 1:
        return low if not start and key in ("e", "a", "o", "y") else word.upper()
    if key in UF and re.search(r"[-/,(]\s*$", gap):                    # Salvador, BA
        return word.upper()
    if not start and low in _SMALL:
        return low
    if mode == "sentence" and not start and key not in _PROPER:
        return low
    return _capitalise(low, start)


def smart_case(s, mode="title"):
    """Text typed in capitals, written the way a catalogue writes it. mode
    "title" (titles, names, publishers, places): every word capitalised but
    the particles and articles; "sentence" (subtitles, subjects, notes):
    only the first word of each sentence or subject, and proper nouns.
    Acronyms (ABNT, UFPR), Roman numerals (XIV) and initials stay in capitals.
    Text that is not in capitals is returned as it is."""
    s = str(s or "")
    if not is_shouting(s):
        return s
    out, pos = [], 0
    for m in _WORD_RE.finditer(s):
        gap = s[pos:m.start()]
        start = pos == 0 or (mode == "sentence" and bool(_SENTENCE_END.search(s[:m.start()])))
        out.append(gap)
        out.append(_case_word(m.group(0), start, mode, gap))
        pos = m.end()
    out.append(s[pos:])
    return "".join(out)


