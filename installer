# ---------------------------------------------------------------- tombos
# The "registro" field holds the accession numbers (tombos) of every copy:
# "-1655 v1 - 1656 v2", "-2134 I^f2135 II", "10441, 10442 v1", "669 a 694",
# "3404^3462", "18705^", "d^12452", "2717$", "12730(Baixa)". Returns the
# copies as { tombo, vol, flags } and what was dropped.
my %roman = map { $_ => 1 } qw( I II III IV V VI VII VIII IX X XI XII XIII XIV XV XVI XVII XVIII XIX XX );
sub parse_registro {
    my ( $raw, $mfn ) = @_;
    my ( @copies, @dropped, %status );
    my $s = $raw // '';
    $s =~ s/([$latin14])/$latin14{$1}/g;
    $s =~ s/\\+N//g; $s =~ s/[\x00-\x1f\x7f\\]+/ /g;
    return ( [], [] ) if $s =~ /^\s*informa[cç][aã]o n[aã]o encontrada/i;
    # Status written next to a tombo: "12730(Baixa)", "516 (atrasado)".
    $s =~ s/(\d+)\s*\(\s*([^()]{1,40}?)\s*\)/ push @{ $status{$1} }, lc $2; $1 /ge;
    # Call numbers typed into the tombo field ("863 M42", "306.43 M57").
    $s =~ s/(?<![\d.])(\d{3}(?:\.\d+)?\s+[A-HJ-UW-Z]\d{1,3}[a-z]?)(?![\d.])/ push @dropped, $1; $stat{callno_in_tombo}++; ' - ' /ge;
    # Ranges: "669 a 694", "7670 v1 a 7673 v4".
    $s =~ s{(\d+)(?:\s*[vV]\.?\s*(\d{1,3}))?\s+a\s+(\d+)(?:\s*[vV]\.?\s*(\d{1,3}))?}{
        my ( $a, $va, $b, $vb ) = ( $1, $2, $3, $4 );
        if ( $b >= $a && $b - $a <= 100 && ( !defined $va || !defined $vb || $vb - $va == $b - $a ) ) {
            $stat{ranges}++;
            join ' - ', map { $_ . ( defined $va && defined $vb ? ' v' . ( $va + $_ - $a ) : '' ) } $a .. $b;
        } else {
            $stat{ranges_kept}++; push @{ $review{'tombo range'} }, $mfn;
            "$a" . ( defined $va ? " v$va" : '' ) . " - $b" . ( defined $vb ? " v$vb" : '' );
        }
    }ge;
    # Tokens: volumes, tombos, separators; anything else is noise.
    my ( @groups, $g ) = ();
    $g = { nums => [], vols => [] };
    my $close = sub { push @groups, $g if @{ $g->{nums} } || @{ $g->{vols} }; $g = { nums => [], vols => [] } };
    pos($s) = 0;
    my ( $noise, $last_len ) = ( '', 0 );
    while ( pos($s) < length $s ) {
        if    ( $s =~ /\G\s+/gc ) { }
        elsif ( $s =~ /\G(\d{1,2})\s*[ªº°]\s*s[ée]rie\b/gci ) { push @{ $g->{vols} }, "$1ª série" }
        elsif ( $s =~ /\G[vV]\.?\s*(\d{1,3})(?!\d)/gc ) { push @{ $g->{vols} }, "v. $1" }
        # A volume glued to the next tombo: "4779 v54495 v6" is v. 5, then tombo 4495.
        elsif ( $last_len && $s =~ /\G[vV](\d{5,8})(?!\d)/gc && length($1) - $last_len >= 1 && length($1) - $last_len <= 2 ) {
            my $cut = length($1) - $last_len;
            push @{ $g->{vols} }, 'v. ' . substr( $1, 0, $cut );
            $close->();
            push @{ $g->{nums} }, { tombo => substr( $1, $cut ), dollar => 0 };
            $stat{glued_volume}++;
        }
        elsif ( $s =~ /\G\b([IVX]+)\b(?!\d)/gc ) { if ( $roman{$1} ) { push @{ $g->{vols} }, "v. $1" } else { $noise .= $1 } }
        elsif ( $s =~ /\G\^[a-z]?(?=\d|\s|$)/gc || $s =~ /\G\^/gc ) { $stat{caret_sep}++; $close->() }
        elsif ( $s =~ /\G-+/gc ) { $close->() }
        elsif ( $s =~ /\G,/gc ) { }
        elsif ( $s =~ /\G(\d+)(\$?)/gc ) {
            my ( $n, $dollar ) = ( $1, $2 );
            if ( length $n > 9 || $n =~ /^0+$/ ) { push @dropped, $n; next }
            # A new tombo after a volume starts a new copy ("13964 v6 13965 v7").
            $close->() if @{ $g->{vols} };
            push @{ $g->{nums} }, { tombo => $n, dollar => $dollar ? 1 : 0 };
            $last_len = length $n;
        }
        elsif ( $s =~ /\G([^\s\d,^-]+)/gc ) { $noise .= $1 }
    }
    $close->();
    if ( $noise ne '' ) { $stat{noise_in_tombo}++; push @dropped, $noise }
    for my $grp (@groups) {
        if ( !@{ $grp->{nums} } ) { push @dropped, join ' ', @{ $grp->{vols} }; next }
        my $vol = join ', ', @{ $grp->{vols} };
        for my $n ( @{ $grp->{nums} } ) {
            push @copies, { tombo => $n->{tombo}, vol => $vol, dollar => $n->{dollar}, status => $status{ $n->{tombo} } // [] };
        }
    }
    return ( \@copies, \@dropped );
}

