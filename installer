# What the librarian may do through the tools: Koha's own permissions.
sub permissions {
    my ($user) = @_;
    my $has = sub { my $r = eval { haspermission( $user, $_[0] ) }; return $r ? 1 : 0 };
    return {
        patrons        => $has->( { borrowers => '*' } ),
        reports        => $has->( { reports => '*' } ),
        prefs          => $has->( { parameters => '*' } ),
        holds          => $has->( { reserveforothers => 'place_holds' } ),
        edit_patrons   => $has->( { borrowers => 'edit_borrowers' } ),
        edit_catalogue => $has->( { editcatalogue => 'edit_catalogue' } ),
        writeoff       => $has->( { updatecharges => 'writeoff' } ),
    };
}

# '' when the assistant can answer, else the reason for the librarian.
sub setup_problem {
    return $T{no_ro} unless -r $RO_CNF;
    return $T{no_provider} unless -r $VISION_CONF;
    my $problem = KohaEasy::Assistant::endpoint_problem( KohaEasy::Assistant::load_conf($VISION_CONF) );
    return $problem ? "$T{no_provider} ($problem)" : '';
}

# The catalogue search of Koha itself (Zebra or Elasticsearch, as the
# SearchEngine preference says), as the staff search builds it: the
# biblionumbers of the hits, best first. Dies when the engine cannot
# answer; the assistant then searches the catalogue's tables.
sub engine_search {
    my ( $terms, $max ) = @_;
    require Koha::SearchEngine;
    require Koha::SearchEngine::Search;
    require Koha::SearchEngine::QueryBuilder;
    require C4::Biblio;
    require C4::Search;
    my $index    = do { no warnings 'once'; $Koha::SearchEngine::BIBLIOS_INDEX };
    my $builder  = Koha::SearchEngine::QueryBuilder->new( { index => $index } );
    my $searcher = Koha::SearchEngine::Search->new( { index => $index } );
    my @ops = ('or') x ( @$terms - 1 );
    my ( $error, $query ) = $builder->build_query_compat( \@ops, [@$terms], [ ('kw') x @$terms ], [], [], 0, $LANG );
    die "$error\n" if $error;
    my ( $err, $results ) = $searcher->simple_search_compat( $query, 0, $max );
    die "$err\n" if $err;
    my ( $tag, $code ) = C4::Biblio::GetMarcFromKohaField('biblio.biblionumber');
    my @ids;
    for my $r ( @{ $results || [] } ) {
        my $rec = ref $r ? $r : eval { C4::Search::new_record_from_zebra( 'biblioserver', $r ) };
        my $f = $rec && $tag ? $rec->field($tag) : undef;
        next unless $f;
        my $id = $f->is_control_field ? $f->data : $f->subfield($code);
        push @ids, $id if defined $id && $id =~ /^\d+$/;
    }
    return { engine => C4::Context->preference('SearchEngine') || 'Zebra', ids => \@ids };
}

# ----------------------------------------------------------------------
# The conversation of this login (sessions/<sha1 of the session>.json)
# ----------------------------------------------------------------------
sub with_state {
    my ( $session, $code ) = @_;
    my $dir = "$DIR/sessions";
    mkdir $dir, 0700 unless -d $dir;
    prune_sessions($dir);
    my $file = "$dir/" . sha1_hex( $session // '' ) . '.json';
    sysopen( my $fh, $file, O_RDWR | O_CREAT, 0600 ) or return { error => $T{err_state} };
    flock( $fh, LOCK_EX );
    my $raw = do { local $/; <$fh> };
    my $st = ( $raw && eval { $JSON->decode($raw) } ) || {};
    $st->{$_} //= [] for qw( history transcript );
    $st->{$_} //= {} for qw( proposals refs );
    $st->{next} //= 1;
    my $out = eval { $code->($st) };
    if ( !$out ) {
        my $e = $@ || 'error';
        $e =~ s/ at \S+ line \d+.*//s;
        $e =~ s/\s+$//;
        $out = { error => substr( "$e", 0, 300 ) };
    }
    splice @{ $st->{transcript} }, 0, @{ $st->{transcript} } - 40 if @{ $st->{transcript} } > 40;
    my %live = map { $_ => 1 } map { @{ $_->{proposals} || [] } } @{ $st->{transcript} };
    delete $st->{proposals}{$_} for grep { !$live{$_} } keys %{ $st->{proposals} };
    my @refs = keys %{ $st->{refs} };
    if ( @refs > 400 ) { delete @{ $st->{refs} }{ @refs[ 0 .. $#refs - 400 ] } }
    seek( $fh, 0, 0 );
    truncate( $fh, 0 );
    print {$fh} $JSON->encode($st);
    close $fh;
    return $out;
}

# Conversations of sessions idle for more than a day go.
sub prune_sessions {
    my ($dir) = @_;
    return if -e "$dir/.pruned" && -M "$dir/.pruned" < 0.04;
    for my $f ( glob "$dir/*.json" ) { unlink $f if -M $f > 1 }
    if ( open( my $t, '>', "$dir/.pruned" ) ) { close $t }
    return;
}

# What the widget shows of a proposal (never the arguments it runs with).
sub public_proposal {
    my ($p) = @_;
    return { map { defined $p->{$_} ? ( $_ => $p->{$_} ) : () } qw( id action summary target diff label url state result ) };
}

sub view {
    my ($st) = @_;
    my @t = map {
        my %e = %$_;
        $e{proposals} = [ map { public_proposal( $st->{proposals}{$_} ) } grep { $st->{proposals}{$_} && $st->{proposals}{$_}{action} } @{ $_->{proposals} || [] } ];
        \%e
    } @{ $st->{transcript} };
    return { transcript => \@t };
}

# ----------------------------------------------------------------------
# Operations
# ----------------------------------------------------------------------
sub op_ask {
    my ( $cgi, $user, $can, $st ) = @_;
    my $q = $cgi->param('question') // '';
    $q =~ s/^\s+|\s+$//g;
    return { error => $T{err_empty} } if $q eq '';
    $q = substr( $q, 0, 2000 );
    my $problem = setup_problem();
    return { error => $problem } if $problem;
    my $dbh = eval { KohaEasy::Assistant::connect_ro($RO_CNF) };
    return { error => $T{no_ro} } unless $dbh;
    my $c   = KohaEasy::Assistant::load_conf($VISION_CONF);
    my $ctx = { dbh => $dbh, refs => $st->{refs}, proposals => [], can => $can, search => \&engine_search };
    my $res = eval { KohaEasy::Assistant::ask( $ctx, sub { KohaEasy::Assistant::chat( $c, $_[0] ) }, $st->{history}, $q, $LANG ) };
    $dbh->disconnect;
    if ( !$res ) {
        ( my $e = $@ || '' ) =~ s/\s+$//;
        return { error => "$T{err_model} $e" };
    }
    my @ids;
    for my $p ( @{ $res->{proposals} } ) {
        my $id = $st->{next}++;
        $st->{proposals}{$id} = { %$p, id => $id, user => $user };
        push @ids, $id;
    }
    my $entry = { role => 'assistant', text => $res->{answer}, refs => KohaEasy::Assistant::answer_refs( $ctx, $res->{answer} ), proposals => \@ids };
    push @{ $st->{transcript} }, { role => 'user', text => $q }, $entry;
    return { entry => { %$entry, proposals => [ map { public_proposal( $st->{proposals}{$_} ) } @ids ] } };
}

sub find_proposal {
    my ( $cgi, $user, $st ) = @_;
    my $p = $st->{proposals}{ $cgi->param('proposal') // '' };
    die "$T{err_gone}\n" unless $p && $p->{action} && ( $p->{user} // '' ) eq ( $user // '' );
    die "$T{err_done}\n" unless $p->{state} eq 'pending';
    return $p;
}

sub op_cancel {
    my ( $cgi, $user, $can, $st ) = @_;
    my $p = find_proposal( $cgi, $user, $st );
    $p->{state} = 'cancelled';
    return { proposal => public_proposal($p) };
}

sub op_reset {
    my ( $cgi, $user, $can, $st ) = @_;
    %$st = ( history => [], transcript => [], proposals => {}, refs => {}, next => $st->{next} );
    return { transcript => [] };
}

# Approve & Execute: the values read again, saved, then Koha makes it.
sub op_confirm {
    my ( $cgi, $user, $can, $st ) = @_;
    my $p = find_proposal( $cgi, $user, $st );
    if ( $p->{action} eq 'open_page' ) {
        $p->{state} = 'done';
        return { proposal => public_proposal($p), go => $p->{url} };
    }
    my $need = $KohaEasy::Assistant::ACTIONS{ $p->{action} };
    my $run  = executors()->{ $p->{action} };
    die "$T{err_gone}\n" unless defined $need && $run;
    die "$T{err_perm}\n" unless $can->{$need};
    my $ro  = KohaEasy::Assistant::connect_ro($RO_CNF);
    my $now = eval { KohaEasy::Assistant::snapshot( { dbh => $ro }, $p ) };
    $ro->disconnect;
    die "$T{err_changed}\n" unless $now && KohaEasy::Assistant::same_snapshot( $now, $p->{before} );
    my $stamp = strftime( '%Y%m%d-%H%M%S', localtime );
    my $target = "$p->{target}{kind}:$p->{target}{id}";
    save_file( "$DIR/undo", "$stamp-$p->{id}.json", $JSON->encode( { action => $p->{action}, target => $target, user => $user,
        before => $p->{before}, diff => $p->{diff}, args => $p->{args} } ) );
    my $done = eval { $run->( $p->{args} ) };
    if ( !$done ) {
        my $e = $@;
        $e = $e->message if ref $e && eval { $e->can('message') };
        $e = "$e" || 'error';
        $e =~ s/ at \S+ line \d+.*//s;
        $e =~ s/\s+$//;
        $p->{state} = 'failed';
        append_log( join( "\t", $stamp, $user // '', "$p->{action} FAILED", $target, $e ) . "\n" );
        die "$T{err_run} $e\n";
    }
    $p->{state}  = 'done';
    $p->{result} = "$done";
    append_log( join( "\t", $stamp, $user // '', $p->{action}, $target, KohaEasy::Assistant::diff_text($p) ) . "\n" );
    return { proposal => public_proposal($p) };
}

# ----------------------------------------------------------------------
# The changes, made by Koha's own objects (as its staff pages do)
# ----------------------------------------------------------------------
# (A sub, not a hash: run() is called above, before any assignment here.)
sub executors {
    return {
        place_hold    => \&do_place_hold,
        update_patron => \&do_update_patron,
        update_record => \&do_update_record,
        write_off     => \&do_write_off,
    };
}

sub do_place_hold {
    my ($a) = @_;
    require C4::Reserves;
    my $can = C4::Reserves::CanBookBeReserved( $a->{patron}, $a->{biblio}, $a->{pickup} );
    my $status = ref $can eq 'HASH' ? $can->{status} // '' : $can // '';
    die "$T{err_hold} ($status)\n" unless $status eq 'OK';
    my $id = C4::Reserves::AddReserve( { branchcode => $a->{pickup}, borrowernumber => $a->{patron}, biblionumber => $a->{biblio},
        priority => C4::Reserves::CalculatePriority( $a->{biblio} ) } );
    die "$T{err_hold}\n" unless $id;
    return $id;
}

sub do_update_patron {
    my ($a) = @_;
    require Koha::Patrons;
    my $patron = Koha::Patrons->find( $a->{patron} ) or die "$T{err_gone}\n";
    $patron->set( { %{ $a->{changes} } } )->store;
    return $a->{patron};
}

# The record's MARC is changed where the framework maps each field (245 $a
# for biblio.title...), then saved with ModBiblio, which updates the
# biblio tables and the search index the same way the record editor does.
sub do_update_record {
    my ($a) = @_;
    require Koha::Biblios;
    require C4::Biblio;
    require MARC::Field;
    my $biblio = Koha::Biblios->find( $a->{biblio} ) or die "$T{err_gone}\n";
    my $record = $biblio->metadata->record;
    for my $name ( sort keys %{ $a->{changes} } ) {
        my $field = $KohaEasy::Assistant::RECORD_FIELDS{$name} or die "$T{err_gone}\n";
        my ( $tag, $code ) = C4::Biblio::GetMarcFromKohaField($field);
        die "$field: $T{err_marc}\n" unless $tag && $code && $tag >= 10;
        my $value = $a->{changes}{$name};
        my $f = $record->field($tag);
        if    ( $f && $value eq '' ) { $f->delete_subfield( code => $code ); $record->delete_field($f) unless $f->subfields }
        elsif ($f) {
            # The ISBD punctuation that ends the subfield ("Title /") stays.
            my ($punct) = ( $f->subfield($code) // '' ) =~ /(\s*[\/:;=,.]+)$/;
            $f->update( $code => $value . ( defined $punct && $value !~ /[\/:;=,.]$/ ? $punct : '' ) );
        }
        elsif ( $value ne '' )       { $record->insert_fields_ordered( MARC::Field->new( $tag, ' ', ' ', $code => $value ) ) }
    }
    C4::Biblio::ModBiblio( $record, $biblio->biblionumber, $biblio->frameworkcode );
    return $a->{biblio};
}

sub do_write_off {
    my ($a) = @_;
    require Koha::Account;
    my $env = C4::Context->userenv;
    Koha::Account->new( { patron_id => $a->{patron} } )->pay( { amount => $a->{amount}, type => 'WRITEOFF', interface => 'intranet',
        library_id => $env ? $env->{branch} : undef, note => 'koha.nexus AI assistant' } );
    return $a->{amount};
}

sub save_file {
    my ( $dir, $name, $data ) = @_;
    mkdir $dir, 0700 unless -d $dir;
    sysopen( my $fh, "$dir/$name", O_CREAT | O_RDWR, 0600 ) or die "$T{err_state}\n";
    print {$fh} $data;
    close $fh or die "$T{err_state}\n";
    return;
}

sub append_log {
    my ($line) = @_;
    open( my $fh, '>>:encoding(UTF-8)', "$DIR/changes.log" ) or return;
    print {$fh} $line;
    close $fh;
    return;
}

sub widget_js {
    return <<'KEIJS';
/* koha-easy-installer: the AI assistant of the staff home page (op=js).
   Draws the chat in #kei-ai (made by the IntranetUserJS block in the place of
   the news). Text from the model is never HTML: it is put in with text nodes,
   and only [[kind:id|label]] references the server verified become links. */
(function ($) {
    "use strict";
    var T = window.KEI_AI_T || {};
    var URL = "/cgi-bin/koha/tools/ai_assistant.pl";
    var REF = /\[\[(biblio|patron|report|syspref|page):([A-Za-z0-9_.-]+)\|([^\]]*)\]\]/g;
    var box = $("#kei-ai");
    if (!box.length || box.data("kei-ready")) return;
    box.data("kei-ready", 1);
    var token = $('meta[name="csrf-token"]').attr("content") || "";
    var busy = false;

    function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text !== undefined && text !== null) e.textContent = text;
        return e;
    }

    // One line of an answer: **bold** and the verified links.
    function inline(line, refs, into) {
        var pos = 0, m;
        REF.lastIndex = 0;
        while ((m = REF.exec(line)) !== null) {
            bold(line.slice(pos, m.index), into);
            var key = m[1] + ":" + m[2], ref = refs && refs[key];
            if (ref && ref.url) {
                var a = el("a", "kei-ai-link kei-ai-" + m[1], m[3] || ref.label);
                a.href = ref.url;
                a.title = ref.label;
                into.appendChild(a);
            } else {
                into.appendChild(document.createTextNode(m[3]));
            }
            pos = REF.lastIndex;
        }
        bold(line.slice(pos), into);
    }
    function bold(text, into) {
        var parts = text.split(/\*\*([^*]+)\*\*/);
        for (var i = 0; i < parts.length; i++) {
            if (!parts[i]) continue;
            into.appendChild(i % 2 ? el("strong", null, parts[i]) : document.createTextNode(parts[i]));
        }
    }
    function render(text, refs) {
        var out = el("div", "kei-ai-text"), list = null;
        $.each(String(text || "").split(/\n/), function (i, line) {
            var item = line.match(/^\s*[-*\u2022]\s+(.*)$/);
            if (item) {
                if (!list) { list = el("ul"); out.appendChild(list); }
                var li = el("li"); inline(item[1], refs, li); list.appendChild(li);
                return;
            }
            list = null;
            if (!line.trim()) return;
            var p = el("p"); inline(line, refs, p); out.appendChild(p);
        });
        return out;
    }

    // An action proposal: the record, each field now and after, and the
    // two buttons. Nothing changes in Koha before Approve & Execute.
    function proposalCard(p) {
        var card = el("div", "kei-ai-proposal kei-ai-" + p.state);
        card.setAttribute("data-id", p.id);
        card.appendChild(el("div", "kei-ai-ptitle", (p.state === "pending" ? T.waiting : T.proposal) + " \u00b7 " + (T["act_" + p.action] || p.action)));
        card.appendChild(el("p", "kei-ai-psummary", p.summary));
        if (p.target && p.target.label) {
            var tp = el("p", "kei-ai-note");
            tp.appendChild(document.createTextNode(T.target + " "));
            if (p.target.url) { var ta = el("a", "kei-ai-link", p.target.label); ta.href = p.target.url; tp.appendChild(ta); }
            else tp.appendChild(document.createTextNode(p.target.label));
            card.appendChild(tp);
        }
        if (p.diff && p.diff.length) {
            var tbl = el("table", "kei-ai-diff"), head = el("thead"), hr = el("tr"), body = el("tbody");
            $.each([T.field, T.current, T.proposed], function (i, h) { hr.appendChild(el("th", null, h)); });
            head.appendChild(hr); tbl.appendChild(head);
            $.each(p.diff, function (i, d) {
                var tr = el("tr");
                tr.appendChild(el("td", "kei-ai-field", d.field));
                tr.appendChild(el("td", "kei-ai-from", d.from === "" || d.from == null ? "-" : String(d.from)));
                tr.appendChild(el("td", "kei-ai-to", d.to === "" || d.to == null ? "-" : String(d.to)));
                body.appendChild(tr);
            });
            tbl.appendChild(body);
            card.appendChild(tbl);
        }
        if (p.action === "open_page" && p.url) {
            var a = el("a", "kei-ai-link", p.label); a.href = p.url;
            var pp = el("p", "kei-ai-note"); pp.appendChild(document.createTextNode(T.act_open_page + ": ")); pp.appendChild(a);
            card.appendChild(pp);
        }
        var st = el("p", "kei-ai-pstate");
        card.appendChild(st);
        if (p.state === "pending") {
            var b = el("div", "kei-ai-pbuttons");
            var no = el("button", "btn btn-sm btn-default kei-ai-reject", T.reject);
            var ok = el("button", "btn btn-sm btn-primary kei-ai-approve", p.action === "open_page" ? T.open_page : T.approve);
            ok.type = no.type = "button";
            $(ok).on("click", function () { decide(card, p, "cud-confirm"); });
            $(no).on("click", function () { decide(card, p, "cud-cancel"); });
            b.appendChild(no); b.appendChild(ok);
            card.appendChild(b);
        } else {
            st.textContent = p.state === "done" ? (p.action === "open_page" ? T.opened : T.done)
                : p.state === "cancelled" ? T.cancelled : T.failed;
        }
        return card;
    }

    function add(entry) {
        var log = box.find(".kei-ai-log");
        var row = el("div", "kei-ai-msg kei-ai-" + entry.role);
        row.appendChild(el("div", "kei-ai-who", entry.role === "user" ? T.you : entry.role === "error" ? T.error : T.assistant));
        if (entry.role === "assistant") row.appendChild(render(entry.text, entry.refs));
        else row.appendChild(el("div", "kei-ai-text", entry.text));
        $.each(entry.proposals || [], function (i, p) { row.appendChild(proposalCard(p)); });
        log.append(row);
        log.scrollTop(log[0].scrollHeight);
    }

    function post(op, data, done) {
        $.ajax({ url: URL, type: "POST", dataType: "json", timeout: 300000,
            data: $.extend({ op: op, csrf_token: token }, data) })
            .done(function (r) { if (r && r.error) add({ role: "error", text: r.error }); else done(r || {}); })
            .fail(function (x) { add({ role: "error", text: x.status === 0 ? T.err_network : T.err_session }); })
            .always(function () { loading(false); });
    }

    function decide(card, p, op) {
        $(card).find("button").prop("disabled", true);
        post(op, { proposal: p.id }, function (r) {
            if (r.go) { window.location.href = r.go; return; }
            if (r.proposal) $(card).replaceWith(proposalCard(r.proposal));
        });
    }

    function loading(on, text) {
        busy = on;
        box.find(".kei-ai-pac").prop("hidden", !on);
        box.find(".kei-ai-status").text(text || "");
        box.find("textarea, .kei-ai-send").prop("disabled", on);
    }

    function ask(q) {
        q = $.trim(q || "");
        if (!q || busy) return;
        add({ role: "user", text: q });
        box.find("textarea").val("").css("height", userH ? userH + "px" : "");
        loading(true, T.thinking);
        post("cud-ask", { question: q }, function (r) { if (r.entry) add(r.entry); box.find("textarea").trigger("focus"); });
    }

    // The frame: title, conversation, Pac-Man while the model works, input.
    box.addClass("page-section").empty();
    var head = el("h3", "kei-ai-head");
    head.appendChild(el("span", "kei-ai-title", T.title));
    head.appendChild(el("span", "kei-ai-badge", T.read_only));
    var tools = el("span", "kei-ai-tools");
    var wide = el("button", "kei-ai-icon", ""); wide.type = "button"; wide.title = T.expand;
    wide.appendChild(el("i", "fa fa-expand"));
    var reset = el("button", "kei-ai-icon", ""); reset.type = "button"; reset.title = T.new_chat;
    reset.appendChild(el("i", "fa fa-eraser"));
    tools.appendChild(wide); tools.appendChild(reset); head.appendChild(tools);
    box.append(head);
    box.append(el("div", "kei-ai-setup"));
    var log = el("div", "kei-ai-log"); log.setAttribute("role", "log"); log.setAttribute("aria-live", "polite");
    box.append(log);
    var pac = el("div", "kei-ai-pac"); pac.hidden = true;
    pac.appendChild(el("span", "kei-ai-pacman"));
    var dots = el("span", "kei-ai-dots"); for (var i = 0; i < 6; i++) dots.appendChild(el("i"));
    pac.appendChild(dots); pac.appendChild(el("span", "kei-ai-status"));
    box.append(pac);
    var form = el("form", "kei-ai-form");
    var ta = el("textarea"); ta.rows = 3; ta.placeholder = T.placeholder; ta.setAttribute("aria-label", T.placeholder);
    var send = el("button", "btn btn-primary kei-ai-send", T.send); send.type = "submit";
    form.appendChild(ta); form.appendChild(send);
    box.append(form);

    $(form).on("submit", function (e) { e.preventDefault(); ask(ta.value); });
    $(ta).on("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); ask(ta.value); } });
    // Three lines to start. The grip in its corner makes it taller (kept after
    // each question), and long text grows it up to half the window.
    var userH = 0;
    function fit() {
        var h = Math.max(userH, ta.offsetHeight);
        if (ta.scrollHeight + 2 > h) ta.style.height = Math.min(ta.scrollHeight + 2, Math.round(window.innerHeight / 2)) + "px";
    }
    $(ta).on("input", fit);
    $(ta).on("mouseup", function () { userH = ta.offsetHeight; });
    $(wide).on("click", function () { box.toggleClass("kei-ai-wide"); $(wide).find("i").toggleClass("fa-expand fa-compress"); });
    $(document).on("keydown", function (e) { if (e.key === "Escape" && box.hasClass("kei-ai-wide")) $(wide).trigger("click"); });
    $(reset).on("click", function () { post("cud-reset", {}, function () { box.find(".kei-ai-log").empty(); greet(); }); });

    function greet() { add({ role: "assistant", text: T.hello, refs: {} }); }

    // The conversation of this login, the token and whether it is set up.
    $.ajax({ url: URL, data: { op: "state" }, dataType: "json", cache: false })
        .done(function (r) {
            if (r.csrf_token) token = r.csrf_token;
            if (r.setup) {
                var s = box.find(".kei-ai-setup").text(r.setup + " ");
                if (r.settings) { var a = el("a", null, T.settings); a.href = r.settings; s.append(a); }
                s.show();
            }
            if (r.transcript && r.transcript.length) $.each(r.transcript, function (i, e) { add(e); });
            else greet();
        })
        .fail(function () { add({ role: "error", text: T.err_session }); });
})(jQuery);
KEIJS
}

