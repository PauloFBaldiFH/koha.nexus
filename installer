(function () {
    var K = $js;
    function copy(num, btn) {
        var done = function () { if (btn) { btn.textContent = K.copied; } };
        if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(num).then(done, function () { fallback(num); done(); }); }
        else { fallback(num); done(); }
    }
    function fallback(num) {
        var t = document.createElement("textarea"); t.value = num; document.body.appendChild(t); t.select();
        try { document.execCommand("copy"); } catch (e) {}
        document.body.removeChild(t);
