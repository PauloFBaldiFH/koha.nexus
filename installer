# ======================================================================
# Koha's services after an update. Exit 1: a core service did not restart;
# 2: Plack; 3: the Elasticsearch indexer; 4: Zebra.
update_task_services() {
    systemctl restart memcached apache2 koha-common || return 1
    if ! ensure_koha_services && ! plack_running; then return 2; fi
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        manage_koha_indexers start || return 3
    else
        zebra_stop
        zebra_start || return 4
        ensure_search_indexing
    fi
    return 0
}

function_update_system() {
    prompt_yes_no "$(t "Update")" \
"$(t "System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first.\n\nContinue?")" 13 74 || return 0
    clear
    tui_title "📦" "$(t "Updating the system")"
    # koha-common's own postinst migrates the database during "apt-get
    # upgrade": the verified safety copy must exist before the packages move.
    local cur_tables pre_update
    if is_koha_installed && cur_tables=$(koha_table_count) && [ "$cur_tables" -gt 0 ]; then
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
            return 1
        fi
        pre_update="${DIR_SQL}/PRE-UPDATE_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        CLEANUP_FILE="$pre_update"
        if ! tui_run "$(t "Saving a safety backup")" create_safety_backup "$pre_update"; then
            CLEANUP_FILE=""
            backup_lock_release
            msg_error "$(t "Safety backup failed")" "$(t 'The safety backup of the current database could not be created or validated (check the free space and ${DIR_SQL}).\n\nNothing was changed.')" 12 76
            return 1
        fi
        CLEANUP_FILE=""
        backup_lock_release
        echo "   $(t "Safety backup:") $pre_update"
        log "pre-update safety backup: $pre_update"
    fi
    if ! tui_run "$(t "Updating the packages")" install_task_upgrade; then
        restore_apt_timers
        msg_error "" "$(t "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if is_koha_installed; then
        if ! tui_run "$(t "Applying database migrations")" /usr/sbin/koha-upgrade-schema "$INSTANCE"; then
            restore_apt_timers
            msg_error "" "$(t "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        local svc_rc=0
        tui_run "$(t "Restarting Koha services")" update_task_services || svc_rc=$?
        if [ "$svc_rc" -ne 0 ]; then
            restore_apt_timers
            case "$svc_rc" in
                1) msg_error "" "$(t "One of the core services did not restart after the update.")" 9 72 ;;
                2) msg_error "" "$(t "Plack did not restart after the update.")" 9 70 ;;
                3) msg_error "" "$(t "The Elasticsearch indexer could not be started after the update.")" 10 76 ;;
                *) msg_error "" "$(t "Zebra could not be started after the update.")" 9 72 ;;
            esac
            return 1
        fi
    fi
    tui_run "$(t "Cleaning temporary files")" install_task_cleanup 14
    restore_apt_timers
    tui_run "$(t "Checking that everything works")" install_task_check "$(t "system update")"
    if [ "$V_FAIL" -eq 0 ]; then
        msg_ok "$(t "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Update with warnings")" "$(t "The update ran but validation found \$V_FAIL failure(s) and \$V_WARN warning(s).\n\nLog: \$VALIDATION_LOG")" 11 76
        show_validation_report
        return 1
    fi
    return 0
}

# ======================================================================
# 20. FULL SYSTEM VALIDATION
# ======================================================================
function_validate_system() {
    clear
    tui_title "🩺" "$(t "Full system validation")"
    tui_run "$(t "Checking that everything works")" install_task_check "$(t "manual validation")"
    if [ "$V_FAIL" -eq 0 ]; then
        msg_ok "$(t "No critical failures.\n\nOK: \$V_OK   Warnings: \$V_WARN")" 10 70
    else
        msg_info "$(t "Issues found")" "$(t "Failures: \$V_FAIL   Warnings: \$V_WARN   OK: \$V_OK")" 10 70
    fi
    show_validation_report
}

# ======================================================================
# 20.0. RESTART / REPAIR KOHA SERVICES
# ======================================================================
repair_task_services() {
    systemctl start mariadb
    start_koha_workers
    is_koha_zebra_running || zebra_start
    ensure_search_indexing
    ensure_koha_services
    return 0
}

function_repair_services() {
    require_koha || return 0
    clear
    tui_title "🔧" "$(t "Restarting Koha services")"
    tui_run "$(t "Restarting Koha services")" repair_task_services
    local mc_state plack_state details="" cache cache_line
    memcached_alive && mc_state="$(t "active")" || mc_state="$(t "inactive")"
    plack_running && plack_state="$(t "running")" || plack_state="$(t "stopped")"
    cache=$(koha_cache_state)
    cache_line=$(koha_cache_text "$cache")
    log "services repaired: memcached=$mc_state plack=$plack_state koha-cache=$cache"
    if memcached_alive && plack_running && [ "$cache" != module ] && [ "$cache" != connect ]; then
        msg_ok "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')\n\n${cache_line}" 13 76
    else
        if ! memcached_alive; then
            details=$(journalctl -u memcached -n 6 --no-pager 2>/dev/null | cut -c1-76)
        else
            details=$(tail -n 8 "/var/log/koha/${INSTANCE}/plack-error.log" 2>/dev/null | cut -c1-76)
        fi
        msg_error "" "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')\n\n${cache_line}\n\n${details}" 22 80
    fi
}

# ======================================================================
# 20.1. DEEP MAINTENANCE & OPTIMIZATION
# ======================================================================
maint_task_logs() {
    journalctl --vacuum-time=7d || true
    find "$LOG_DIR" -name "*.log" -mtime +14 -delete 2>/dev/null || true
    return 0
}

maint_task_restart() {
    systemctl restart memcached || true
    plack_restart || true
    systemctl restart apache2 || true
    return 0
}

function_deep_maintenance() {
    require_database || return 0
    
    prompt_yes_no "$(t "Deep Maintenance")" \
"$(t "This routine will:\n\n• Repair and optimize MariaDB tables\n• Clean system journal logs (> 7 days)\n• Vacuum temporary and backup old files\n\nContinue?")" 14 76 || return 0

    clear
    tui_title "🧹" "$(t "Deep maintenance")"
    : > /tmp/koha_db_optimize.log
    if TUI_LOG=/tmp/koha_db_optimize.log tui_run "$(t "Optimizing the database")" \
            mysqlcheck --auto-repair --optimize --default-character-set=utf8mb4 "$DB_NAME"; then
        log "database optimized successfully"
    else
        log "database optimization reported warnings or errors"
    fi
    tui_run "$(t "Cleaning system logs")" maint_task_logs
    tui_run "$(t "Restarting Koha services")" maint_task_restart

    msg_ok "$(t "Maintenance completed successfully!\n\n• MariaDB tables optimized\n• System logs vacuumed\n• Services restarted and memory flushed")" 12 74
    log "deep maintenance completed"
}

# ======================================================================
# 21. DETAILED STATUS
# ======================================================================
# "🟢 active", "🔴 failed" or "⚪ inactive" for the status screen.
st_mark() {
    case "$1" in
        active) printf '🟢 %s' "$1" ;;
        failed) printf '🔴 %s' "$1" ;;
        *)      printf '⚪ %s' "${1:-unknown}" ;;
    esac
}

# The server status as "GROUP<TAB>LABEL<TAB>VALUE" lines (the classic box
# and the panel's status screen both read them).
detailed_status_rows() {
    local engine idx pend docs bibs plack email g
    engine=$(get_search_engine)
    if is_koha_indexer_running; then idx="🟢 $(t "running")"; else idx="⚪ $(t "stopped")"; fi
    if plack_running; then plack="🟢 $(t "running")"; else plack="🔴 $(t "stopped")"; fi
    if [ -e "$KOHA_EMAIL_FLAG" ]; then email="🟢 koha-email-enable"; else email="⚪ $(t "not configured")"; fi
    pend=$(get_pending_es_jobs)
    docs=$(get_total_es_documents)
    bibs=$(get_total_biblios)
    g=$(t "SERVICES")
    printf '%s\t%s\t%s\n' \
        "$g" "Apache" "$(st_mark "$(systemctl is-active apache2 2>/dev/null)")" \
        "$g" "MariaDB" "$(st_mark "$(systemctl is-active mariadb 2>/dev/null)")" \
        "$g" "Memcached" "$(st_mark "$(systemctl is-active memcached 2>/dev/null)")" \
        "$g" "Koha common" "$(st_mark "$(systemctl is-active koha-common 2>/dev/null)")" \
        "$g" "Cron" "$(st_mark "$(systemctl is-active cron 2>/dev/null)")" \
        "$g" "Plack" "$plack" \
        "$g" "Zebra" "$(if is_koha_zebra_running; then st_mark active; else st_mark inactive; fi)" \
        "$g" "Elasticsearch" "$(st_mark "$(systemctl is-active elasticsearch 2>/dev/null)")" \
        "$g" "ES Indexer" "$idx" \
        "$g" "Cloudflare" "$(st_mark "$(systemctl is-active cloudflared 2>/dev/null)")" \
        "$g" "E-mail" "$email"
    g=$(t "SEARCH")
    printf '%s\t%s\t%s\n' \
        "$g" "$(t "Engine")" "${engine:-?}" \
        "$g" "$(t "Pending jobs")" "${pend:-0}" \
        "$g" "$(t "Index/database")" "${docs:-?} / ${bibs:-?}"
    g=$(t "MACHINE")
    printf '%s\t%s\t%s\n' \
        "$g" "$(t "Memory")" "$(free -h 2>/dev/null | awk 'NR==2{print $3" / "$2}')" \
        "$g" "$(t "Disk (/)")" "$(df -h / 2>/dev/null | awk 'NR==2{print $4" '"$(t "free of")"' "$2}')" \
        "$g" "$(t "Uptime")" "$(uptime -p 2>/dev/null)" \
        "$g" "$(t "Timezone")" "$(get_current_timezone)" \
        "$g" "IP" "$(get_server_ip)"
    g=$(t "BACKUP")
    printf '%s\t%s\t%s\n' \
        "$g" "$(t "Latest SQL")" "$(find "$DIR_SQL" -name '*.sql.gz' -printf '%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null | sort -r | head -n1 | grep . || echo '-')" \
        "$g" "$(t "Cloud")" "$(grep -o 'RCLONE_REMOTE="[^"]*"' "$BACKUP_CONF" 2>/dev/null | cut -d'"' -f2 | grep . || echo "$(t "not configured")")"
}

function_detailed_status() {
    local text="" group="" g label value
    while IFS=$'\t' read -r g label value; do
        if [ "$g" != "$group" ]; then
            [ -n "$group" ] && text+=$'\n'
            text+="${g}"$'\n'
            group=$g
        fi
        text+=$(printf '  %-15s: %s' "$label" "$value")$'\n'
    done < <(detailed_status_rows)
    whiptail --title "$(t "Server Status")" --scrolltext --msgbox "${text%$'\n'}" 29 78 2>/dev/null || true
}

# ======================================================================
# 21.5. READ-ONLY COMMANDS FOR THE WINDOWS TOOLS (AND SUPPORT)
# ----------------------------------------------------------------------
#   config.sh --status-json               one JSON object on stdout
#   config.sh --export-diagnostics DIR    a support folder inside DIR
# The Windows tray polls the first and "Export diagnostics" calls the
# second. Both only read: they skip the panel lock (they work while a panel
# is open), install nothing and never print a password or token.
# ======================================================================
KEI_DIAG_REDACT='[REDACTED]'

# JSON string literal of $1 (quotes, backslashes and control characters escaped).
json_str() {
    local s="$1" out="" c i
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    for (( i = 0; i < ${#s}; i++ )); do
        c="${s:i:1}"
        if [[ "$c" == [$'\x01'-$'\x1f'] ]]; then
            printf -v c '\\u%04x' "'$c"
        fi
        out+="$c"
    done
    printf '"%s"' "$out"
}

# Plain number, or 0.
json_num() { case "$1" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$((10#$1))" ;; esac; }

# HTTP status of a local Koha page, 000 when nothing answers.
kei_http_code() {
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time "${2:-4}" "$1" 2>/dev/null)
    case "$code" in [0-9][0-9][0-9]) printf '%s' "$code" ;; *) printf '000' ;; esac
}

# Newest nightly SQL backup and the last line the backup script logged.
# Prints: epoch size result file   (result: ok | failed | skipped | none)
kei_backup_summary() {
    local newest epoch=0 size=0 file="" last result="none"
    newest=$(find "$DIR_SQL" -maxdepth 1 -name '*.sql.gz' -printf '%T@ %s %p\n' 2>/dev/null | sort -rn | head -n1)
    if [ -n "$newest" ]; then
        epoch="${newest%%.*}"
        size=$(printf '%s' "$newest" | awk '{print $2}')
        file="${newest#* * }"
    fi
    last=$(grep -E '\| (OK|FAILED|INFO: SQL backup skipped)' "${LOG_DIR}/backup_sql.log" 2>/dev/null | tail -n1)
    case "$last" in
        *'| OK:'*) result="ok" ;;
        *'| FAILED'*) result="failed" ;;
        *skipped*) result="skipped" ;;
    esac
    printf '%s %s %s %s\n' "$(json_num "$epoch")" "$(json_num "$size")" "$result" "$file"
}

# Time of the last line of the backup log (epoch), 0 when there is none.
kei_backup_log_epoch() {
    local stamp
    stamp=$(grep -E '\| (OK|FAILED|INFO: SQL backup skipped)' "${LOG_DIR}/backup_sql.log" 2>/dev/null | tail -n1 | cut -d'|' -f1)
    [ -n "$stamp" ] && date -d "$stamp" +%s 2>/dev/null || printf '0'
}

# Overall state for the tray: ok | degraded | stopped | not_installed.
kei_overall_state() {
    local apache="$1" db="$2" koha="$3" staff="$4"
    is_koha_installed || { printf 'not_installed'; return 0; }
    if [ "$apache" = active ] && [ "$db" = active ] && [ "$koha" = active ] && [ "$staff" != 000 ] && [ "$staff" -lt 500 ]; then
        printf 'ok'
    elif [ "$apache" != active ] && [ "$db" != active ] && [ "$koha" != active ]; then
        printf 'stopped'
    else
        printf 'degraded'
    fi
}

# Where people reach Koha, for the panel's dashboard and the tray:
# "access":{...}, (trailing comma). Other computers only get the LAN address
# when they can really use it (host_can lan_direct: not WSL in NAT mode).
# Public hosts are the Cloudflare tunnel's, free address or own domain.
kei_access_json() {
    local ip="" lan=false opac staff mode=""
    if host_can lan_direct; then
        ip="${WIN_LAN_IP:-}"
        [ -n "$ip" ] || ip=$(get_server_ip 2>/dev/null)
        [ "$ip" != "127.0.0.1" ] && lan=true
    fi
    read -r opac staff < <(tunnel_public_hosts 2>/dev/null)
    [ "$opac" = "-" ] && opac=""
    [ "$staff" = "-" ] && staff=""
    if tunnel_mode_is broker; then mode="free"; elif [ -f /etc/cloudflared/config.yml ]; then mode="own"; fi
    printf '"access":{"opac_port":80,"staff_port":8080,"lan_ip":%s,"lan_reachable":%s,' "$(json_str "$ip")" "$lan"
    printf '"tunnel_mode":%s,"public_opac":%s,"public_staff":%s},' "$(json_str "$mode")" "$(json_str "$opac")" "$(json_str "$staff")"
}

kei_status_json() {
    local svc state json="" first=1 apache="" db="" koha="" staff opac plack=false
    local b_epoch b_size b_result b_file df_line d_total d_free mem_total mem_avail
    local r_epoch r_state r_finished r_db r_backup r_index
    for svc in apache2 mariadb memcached rabbitmq-server koha-common cron elasticsearch cloudflared; do
        state=$(systemctl is-active "$svc" 2>/dev/null | head -n1)
        [ -n "$state" ] || state="unknown"
        case "$svc" in apache2) apache="$state" ;; mariadb) db="$state" ;; koha-common) koha="$state" ;; esac
        [ "$first" = 1 ] || json+=","
        first=0
        json+="$(json_str "$svc"):$(json_str "$state")"
    done
    staff=$(kei_http_code "http://127.0.0.1:8080/")
    opac=$(kei_http_code "http://127.0.0.1/")
    plack_running 2>/dev/null && plack=true
    read -r b_epoch b_size b_result b_file < <(kei_backup_summary)
    read -r r_epoch r_state r_finished r_db r_backup r_index < <(stop_guard_summary)
    df_line=$(df -P -B1 / 2>/dev/null | awk 'NR==2{print $2" "$4}')
    d_total="${df_line%% *}" d_free="${df_line##* }"
    mem_total=$(awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo 2>/dev/null)
    mem_avail=$(awk '/^MemAvailable:/{print $2 * 1024}' /proc/meminfo 2>/dev/null)
    printf '{"schema":1,"generated_at":%s,"panel_version":%s,' "$(date +%s)" "$(json_str "${PANEL_VERSION# }")"
    printf '"platform":%s,"wsl_net":%s,"autostart":%s,' "$(json_str "$KEI_PLATFORM")" "$(json_str "${KEI_WSL_NET:-}")" "$(json_str "${WIN_AUTOSTART:-}")"
    printf '"state":%s,"koha_installed":%s,' "$(json_str "$(kei_overall_state "$apache" "$db" "$koha" "$staff")")" "$(is_koha_installed && echo true || echo false)"
    printf '"services":{%s},"plack":%s,' "$json" "$plack"
    printf '"http":{"staff":%s,"opac":%s},' "$(json_num "$staff")" "$(json_num "$opac")"
    printf '"backup":{"last_file":%s,"last_epoch":%s,"last_size":%s,"last_result":%s,"log_epoch":%s},' \
        "$(json_str "${b_file##*/}")" "$(json_num "$b_epoch")" "$(json_num "$b_size")" "$(json_str "$b_result")" "$(json_num "$(kei_backup_log_epoch)")"
    printf '"recovery":{"epoch":%s,"state":%s,"finished":%s,"db":%s,"backup":%s,"index":%s},' \
        "$(json_num "$r_epoch")" "$(json_str "$r_state")" "$(json_num "$r_finished")" "$(json_str "$r_db")" "$(json_str "$r_backup")" "$(json_str "$r_index")"
    kei_access_json
    printf '"disk":{"total":%s,"free":%s},' "$(json_num "$d_total")" "$(json_num "$d_free")"
    printf '"memory":{"total":%s,"available":%s}}\n' "$(json_num "$mem_total")" "$(json_num "$mem_avail")"
}

# Removes secrets from text on stdin: key=value / key: value pairs whose key
# names a password, token or secret, <pass> elements, HTTP authorization
# headers, user:password@ in URLs, Google tokens (ya29., 1//) and Google
# API keys (AIza..., e.g. the Gemini key of the AI cataloguing).
kei_redact() {
    sed -E \
        -e "s#(<(pass|password|user_pass|encryption_key|api_key)>)[^<]*(</[a-z_]+>)#\1${KEI_DIAG_REDACT}\3#Ig" \
        -e "s#([a-z_-]*(pass(word)?|passwd|pwd|secret|token|api[_-]?key)[a-z_-]*[\"']?[[:space:]]*[:=][[:space:]]*[\"']?)[^\"'[:space:],;&}]+#\1${KEI_DIAG_REDACT}#Ig" \
        -e "s#((proxy-)?authorization:[[:space:]]*[a-z]+)[[:space:]]+[^[:space:]]+#\1 ${KEI_DIAG_REDACT}#Ig" \
        -e "s#(bearer|basic)[[:space:]]+[A-Za-z0-9._~+/=-]{8,}#\1 ${KEI_DIAG_REDACT}#Ig" \
        -e "s#://[^/@[:space:]:]+:[^/@[:space:]]+@#://${KEI_DIAG_REDACT}@#g" \
        -e "s#ya29\.[A-Za-z0-9._-]+#${KEI_DIAG_REDACT}#g" \
        -e "s#1//[A-Za-z0-9._-]{20,}#${KEI_DIAG_REDACT}#g" \
        -e "s#AIza[A-Za-z0-9_-]{30,}#${KEI_DIAG_REDACT}#g"
}

# Last $2 lines (default 400) of a log, redacted, into $3. Missing logs are skipped.
kei_diag_tail() {
    local src="$1" n="${2:-400}" dst="$3"
    [ -f "$src" ] && [ -r "$src" ] || return 0
    case "$src" in *.gz) zcat -- "$src" 2>/dev/null | tail -n "$n" ;; *) tail -n "$n" -- "$src" 2>/dev/null ;; esac \
        | kei_redact > "$dst"
}

# Output of a command, redacted, into $1 (never fails the export).
kei_diag_cmd() {
    local dst="$1"; shift
    { printf '$ %s\n' "$*"; timeout 20 "$@" 2>&1 | head -n 2000; printf '\n'; } | kei_redact >> "$dst"
}

# config.sh --export-diagnostics DIR: writes DIR/koha-diagnostics-HOST-DATE
# and prints its path. Only logs and command output go in, each through
# kei_redact; no configuration file (koha-conf.xml, rclone.conf, vision.conf,
# the credentials file) is ever copied.
kei_export_diagnostics() {
    local dir="$1" out f svc name
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
        echo "usage: config.sh --export-diagnostics <existing folder>" >&2
        return 2
    fi
    out="${dir%/}/koha-diagnostics-$(hostname -s 2>/dev/null || echo koha)-$(date +%Y%m%d-%H%M%S)"
    mkdir -m 700 "$out" "$out/logs" || return 1
    kei_status_json > "$out/status.json" 2>/dev/null
    {
        printf 'Koha Easy Install %s  |  %s\n' "${PANEL_VERSION# }" "$(date '+%F %T %z')"
        printf 'platform=%s  wsl_net=%s  autostart=%s  windows_build=%s\n\n' "$KEI_PLATFORM" "${KEI_WSL_NET:--}" "${WIN_AUTOSTART:--}" "${WIN_BUILD:--}"
    } > "$out/system.txt"
    kei_diag_cmd "$out/system.txt" uname -a
    kei_diag_cmd "$out/system.txt" cat /etc/os-release
    kei_diag_cmd "$out/system.txt" uptime
    kei_diag_cmd "$out/system.txt" free -m
    kei_diag_cmd "$out/system.txt" df -h
    kei_diag_cmd "$out/system.txt" df -i /
    kei_diag_cmd "$out/system.txt" timedatectl
    kei_diag_cmd "$out/system.txt" ip -brief address
    kei_diag_cmd "$out/system.txt" ip route
    kei_diag_cmd "$out/system.txt" ss -tlnp
    kei_diag_cmd "$out/system.txt" systemctl --failed --no-pager
    kei_diag_cmd "$out/system.txt" dpkg-query -W koha-common mariadb-server apache2 elasticsearch cloudflared rclone
    for svc in apache2 mariadb memcached rabbitmq-server koha-common cron elasticsearch cloudflared; do
        kei_diag_cmd "$out/services.txt" systemctl status "$svc" --no-pager -n 30
    done
    kei_diag_cmd "$out/services.txt" journalctl -p err -b --no-pager -n 300
    # Error logs only: access logs and the MariaDB query log hold patron data.
    for f in /var/log/apache2/error.log /var/log/mysql/error.log \
             /var/log/koha/"$INSTANCE"/*error*.log /var/log/koha/"$INSTANCE"/worker*.log \
             /var/log/koha/"$INSTANCE"/indexer*.log /var/log/koha/"$INSTANCE"/zebra*.log \
             "$LOG_DIR"/backup_*.log "$LOG_DIR"/stop-guard.log; do
        [ -f "$f" ] || continue
        name=$(printf '%s' "${f#/var/log/}" | tr '/' '_')
        kei_diag_tail "$f" 400 "$out/logs/$name"
    done
    while IFS= read -r f; do
        kei_diag_tail "$f" 1000 "$out/logs/panel_${f##*/}"
    done < <(find "$LOG_DIR" -maxdepth 1 -name 'painel-*.log' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 3 | cut -d' ' -f2-)
    kei_diag_cmd "$out/logs/mariadb_journal.txt" journalctl -u mariadb --no-pager -n 300
    kei_diag_cmd "$out/logs/wsl_dmesg.txt" dmesg --ctime
    cat > "$out/README.txt" << 'EOF'
Koha diagnostics for support.
status.json   services, web pages, last backup, disk and memory
system.txt    operating system, network and package versions
services.txt  state of each service and the recent system errors
logs/         the last lines of the Apache, MariaDB, Koha and panel logs
Passwords, tokens and keys are replaced by [REDACTED]. No configuration
file, database content or credentials file is included.
EOF
    chmod -R go-rwx "$out" 2>/dev/null
    log "diagnostics exported to $out"
    printf '%s\n' "$out"
}

# Panel task "export-diagnostics": the same support folder, always in
# $KEI_DIAG_DIR (the panel's own folder, not wherever it was started),
# keeping the newest $KEI_DIAG_KEEP. Answers @@result path=FOLDER.
KEI_DIAG_DIR="${KEI_DIAG_DIR:-${LOG_DIR}/diagnostics}"
KEI_DIAG_KEEP=5
kei_task_export_diagnostics() {
    local out old
    mkdir -p -m 700 "$KEI_DIAG_DIR" || return 1
    kei_emit step "$(t "Collecting logs and system status")"
    out=$(kei_export_diagnostics "$KEI_DIAG_DIR") || return 1
    while IFS= read -r old; do
        rm -rf -- "$old"
    done < <(find "$KEI_DIAG_DIR" -mindepth 1 -maxdepth 1 -type d -name 'koha-diagnostics-*' -printf '%T@ %p\n' \
             | sort -rn | tail -n +$((KEI_DIAG_KEEP + 1)) | cut -d' ' -f2-)
    kei_result path "$out"
    return 0
}

