printf "  call numbers typed in the tombo field (left out): %d\n", $stat{callno_in_tombo} // 0;
printf "  records with stray letters or symbols (left out): %d\n", $stat{noise_in_tombo} // 0;
print "  the original field is kept in each item's internal note (952 \$x)\n";
