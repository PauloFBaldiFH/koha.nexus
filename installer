cutter_js_block() {
    local label title cn cn_title v
    label=$(t "Cutter Calculator")
    title=$(t "Work out the Cutter number of the author and use it in this field")
    cn=$(t "Call number")
    cn_title=$(t "Work out the call number (class and Cutter) and use it in this field")
    for v in label title cn cn_title; do
        declare -n _s=$v
        _s=${_s//\\/\\\\}; _s=${_s//\"/\\\"}; _s=${_s//</\\u003c}
        unset -n _s
    done
    cat <<CUTJS
${CUTTER_JS_BEGIN}
\$(document).ready(function () {
    var url = "/cgi-bin/koha/cataloguing/cutter_calculator.pl";
    if (/\/cgi-bin\/koha\/cataloguing\/cataloging-home\.pl\$/.test(location.pathname)) {
        var tools = \$("a[href*='tools/inventory.pl'], a[href*='marc_modification_templates.pl'], a[href*='labels/label-home.pl']").closest("ul").first();
        if (!tools.length) tools = \$("a[href*='/cgi-bin/koha/tools/']").closest("ul").last();
        if (tools.length && !tools.find("a[href*='cutter_calculator.pl']").length) {
            var cls = tools.find("a").first().attr("class") || "circ-button";
            var a = \$("<a></a>").attr({ "class": cls, href: url }).append(\$("<i></i>").attr("class", "fa fa-calculator")).append(document.createTextNode(" ${label}"));
            tools.append(\$("<li></li>").append(a));
        }
        return;
    }
    if (!/\/cgi-bin\/koha\/cataloguing\/(addbiblio|additem)\.pl\$/.test(location.pathname)) return;
    // Cutter next to 090 / 092 \$b; Call number next to 090 / 092 \$a and
    // the item call number: the same page, which fills both parts.
    var cutter = "input[id^='tag_090_subfield_b'], input[id^='tag_092_subfield_b']";
    var callno = "input[id^='tag_090_subfield_a'], input[id^='tag_092_subfield_a'], input[id^='tag_952_subfield_o']";
    function button(sel, cls, text, tip) {
        \$(sel).each(function () {
            if (\$(this).nextAll("." + cls).length) return;
            var after = \$(this).nextAll(".kei-cdd").first();
            (after.length ? after : \$(this)).after(\$("<a href=\"#\" style=\"margin-left:4px\"></a>").attr({ "class": cls + " buttonDot", title: tip }).text(text));
        });
    }
    function add() {
        button(cutter, "kei-cutter", "Cutter", "${title}");
        button(callno, "kei-callno", "${cn}", "${cn_title}");
    }
    add();
    new MutationObserver(add).observe(document.body, { childList: true, subtree: true });
    function val(sel) { var v = ""; \$(sel).each(function () { if (!v && this.value) v = this.value; }); return v; }
    // The class part of a call number: what comes before the Cutter number.
    function classOf(v) {
        var t = \$.trim(v || "").split(/\s+/), out = [];
        for (var i = 0; i < t.length && t[i]; i++) { if (/^[A-Z]\d{1,4}[a-z]*\$/.test(t[i])) break; out.push(t[i]); }
        return out.join(" ").slice(0, 40);
    }
    \$(document).on("click", "a.kei-cutter, a.kei-callno", function (e) {
        e.preventDefault();
        var input = \$(this).prevAll("input").first()[0];
        if (!input) return;
        var p = { target: input.id }, bn = (location.search.match(/[?&]biblionumber=(\d+)/) || [])[1];
        if (bn) p.bn = bn;
        if (!/_subfield_b/.test(input.id)) p["class"] = classOf(input.value);
        if (/addbiblio\.pl\$/.test(location.pathname)) {
            var a100 = val("input[id^='tag_100_subfield_a']"), a11x = val("input[id^='tag_110_subfield_a'], input[id^='tag_111_subfield_a']");
            if (a100) { p.name = a100.replace(/[,.\s]+\$/, ""); p.mode = "person"; }
            else if (a11x) { p.name = a11x; p.mode = "corporate"; }
            else p.mode = "title";
            p.title = val("input[id^='tag_245_subfield_a'], textarea[id^='tag_245_subfield_a']").replace(/[\s\/:;=.]+\$/, "");
