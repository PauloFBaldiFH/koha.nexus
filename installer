    def add(self, values, line, source, notes):
        recase(values, self.stats, self.case_examples)
        title = values.get("title", "")
        if not title:
            self.stats["no_title_tombo" if values.get("tombo") or values.get("barcode") else "no_title"] += 1
            if values.get("tombo") or values.get("barcode"):
                self.flags.append("Not imported (no title): %s line %d" % (source, line))
            return
        self.rows.append(Row(values, line, source, notes))

    # ------------------------------------------------------------ keys
    def _isbns(self, row):
        return R.isbn_list(row.v.get("isbn", ""))

    def _desc_key(self, row):
        v = row.v
        authors = R.split_list(v.get("author", ""))
        surname = ""
        if authors:
            inv = R.invert_name(authors[0])
            surname = R.norm_key(inv.split(",")[0])
        vol = volume_key(v["volume"]) if v.get("volume") else title_volume(v.get("title", ""))
        ed = re.sub(r"\D", "", v.get("edition", ""))[:3]
        title = R.norm_key(_VOL_IN_TITLE.sub("", v.get("title", "")))
        return "|".join((title, R.norm_key(v.get("subtitle", "")), surname, R.norm_key(v.get("publisher", "")), ed, vol))

    def plan(self):
        """Groups the rows. Returns the number of ISBNs shared by different
        titles (kept apart unless merge_shared_isbn)."""
        groups = OrderedDict()
        by_isbn = {}
        for row in self.rows:
            valid = [R.isbn13(s) for s, ok in self._isbns(row) if ok]
            vol = volume_key(row.v["volume"]) if row.v.get("volume") else title_volume(row.v.get("title", ""))
            row.v["_desc"] = self._desc_key(row)
            if valid:
                key = "isbn:%s|%s" % (valid[0], vol)
                by_isbn.setdefault(key, []).append(row)
            else:
                groups.setdefault("desc:" + row.v["_desc"], []).append(row)
        shared = 0
        isbn_groups = OrderedDict()
        for key, rows in by_isbn.items():
            titles = OrderedDict()
            for r in rows:
                for t in titles:
                    if R.words_overlap(t, r.v["title"]) >= 0.6:
                        titles[t].append(r)
                        break
                else:
                    titles[r.v["title"]] = [r]
            if len(titles) > 1 and not self.merge_shared_isbn:
                shared += 1
                self.flags.append("ISBN %s shared by different titles (kept apart): %s"
                                  % (key[5:18], " / ".join(list(titles)[:3])))
                for i, (t, rs) in enumerate(titles.items()):
                    isbn_groups["%s|%d" % (key, i)] = rs
            else:
                isbn_groups[key] = rows
        # A row without ISBN joins the one ISBN work with its description.
        desc_index = {}
        for key, rows in isbn_groups.items():
            for d in set(r.v["_desc"] for r in rows):
                desc_index.setdefault(d, set()).add(key)
        for key in list(groups):
            d = key[5:]
            owners = desc_index.get(d, set())
            if len(owners) == 1:
                isbn_groups[owners.pop()].extend(groups.pop(key))
                self.stats["joined_by_description"] += 1
        self._fuzzy(groups)
        self.groups = list(isbn_groups.values()) + list(groups.values())
        self.stats["isbn_shared"] = shared
        return shared

    def _fuzzy(self, groups):
        """Works without ISBN whose titles differ only by a typo ("Dom
        Casmurro" / "Dom Casmuro") become one record when the first author's
        surname, the publisher, the edition, the volume and the year are the
        same and the numbers in the titles (5, XIV) agree."""
        buckets = OrderedDict()
        for key, rows in groups.items():
            title, sub, surname, pub, ed, vol = key[5:].split("|")
            if not surname or not title:
                continue
            year = R.year_of(_most(r.v.get("year", "") for r in rows)[0])
            buckets.setdefault((surname, pub, ed, vol, year), []).append((key, (title + " " + sub).strip()))
        for members in buckets.values():
            kept = []
            for key, text in members:
                for k2, t2 in kept:
                    if _numbers(text) == _numbers(t2) and R.similar(text, t2) >= FUZZY:
                        self.flags.append('Joined as one title (the spelling differs): "%s" / "%s"'
                                          % (groups[k2][0].v["title"][:50], groups[key][0].v["title"][:50]))
                        groups[k2].extend(groups.pop(key))
                        self.stats["fuzzy_joined"] += 1
                        break
                else:
                    kept.append((key, text))

    # ------------------------------------------------------------ records
    def records(self):
        all_codes = Counter()
        for rows in self.groups:
            for r in rows:
                for k in ("tombo", "barcode"):
                    if r.v.get(k):
                        all_codes[r.v[k]] += 1
        used = set()
        out = []
        for rows in self.groups:
            out.append(self._record(rows, all_codes, used))
        return out

    def _unique(self, code, all_codes, used, row, what):
        if code not in used:
            used.add(code)
            return code, ""
        n = 2
        while "%s-%d" % (code, n) in used or "%s-%d" % (code, n) in all_codes:
            n += 1
        new = "%s-%d" % (code, n)
        used.add(new)
        self.stats["renumbered"] += 1
        return new, "%s %s repetido (%s, linha %d)" % (what, code, row.source, row.line)

    def _record(self, rows, all_codes, used):
        pick = lambda k: _most(r.v.get(k, "") for r in rows)
        rec = marc.Record()
        title, _ = pick("title")
        subtitle, _ = pick("subtitle")
        year_txt, years = pick("year")
        if years:
            self.flags.append("Different years in one record (%s): %s" % (title[:40], ", ".join([year_txt] + years[:3])))
            self.stats["differing"] += 1
        for k in ("publisher", "pages", "edition"):
            best, other = pick(k)
            if other:
                self.stats["differing"] += 1
                self.flags.append("Different %s in one record (%s): %s; kept %s" % (k, title[:40], ", ".join(other[:3]), best))
        given = R.LANGUAGES.get(R.norm_header(pick("language")[0]), "")
        lang = given or R.guess_language(title + " " + subtitle) or "por"
        if lang != "por" and not given:
            self.stats["language_guessed"] += 1
        year = R.year_of(year_txt)
        place, _ = pick("place")
        # 008: date entered, s + Date 1 (n + uuuu without a year), place, language, source d.
        rec.control("008", self.today.strftime("%y%m%d") + ("s" + year if year else "nuuuu") + "    "
                    + R.place_code(place) + "|" * 17 + lang + " d")
        isbns = _union([[s for s, _ in self._isbns(r)] for r in rows])
        for s in isbns:
            if R.isbn13(s):
                rec.add("020", " ", " ", ("a", s))
            else:
                rec.add("020", " ", " ", ("z", s))
                self.stats["invalid_isbn"] += 1
        issn, _ = pick("issn")
        if issn:
            rec.add("022", " ", " ", ("a", issn))
        if given and given != "por":
            rec.add("041", "0", " ", ("a", lang))
        cdd, _ = pick("cdd")
        cdu, _ = pick("cdu")
        cutter, _ = pick("cutter")
        if cdu:
            rec.add("080", " ", " ", ("a", cdu))
        if cdd:
            rec.add("082", "0", "4", ("a", cdd))
        klass = cdd or cdu
        if klass:
            rec.add("090", " ", " ", ("a", klass), ("b", cutter))
        authors = _union([R.split_list(r.v.get("author", "")) for r in rows])
        coauthors = _union([R.split_list(x) for r in rows for x in r.v.get("coauthors", [])])
        main = authors[0] if authors else ""
        others = authors[1:] + [c for c in coauthors if R.norm_key(c) != R.norm_key(main)]
        if main:
            if R.is_corporate(main):
                rec.add("110", "2", " ", ("a", main))
            else:
                entry = R.invert_name(main)
                rec.add("100", "1" if "," in entry else "0", " ", ("a", entry))
        vol, _ = pick("volume")
        t = [("a", title + (" :" if subtitle else ""))]
        if subtitle:
            t.append(("b", subtitle))
        if vol and not title_volume(title):
            t.append(("n", vol if not re.fullmatch(r"\d{1,3}", vol) else "v. " + vol))
        # 245 $c, the statement of responsibility, from the 100/110 and 700/710 names.
        names = [R.natural_name(n) for n in ([main] if main else []) + others]
        if names:
            c, last = t[-1]
            t[-1] = (c, last.rstrip(" .") + " /")
            t.append(("c", ", ".join(names[:3]) + (" [et al.]" if len(names) > 3 else "")))
            self.stats["responsibility"] += 1
        rec.add("245", "1" if main else "0", str(R.nonfiling(title)), *t)
        ed, _ = pick("edition")
        if ed:
            rec.add("250", " ", " ", ("a", R.edition_text(ed)))
        pub, _ = pick("publisher")
        imp = []
        if place:
            imp.append(("a", place + (" :" if pub else ("," if year_txt else ""))))
        if pub:
            imp.append(("b", pub + ("," if year_txt else "")))
        if year_txt:
            imp.append(("c", year_txt))
        if imp:
            rec.add("260", " ", " ", *imp)
        pages, _ = pick("pages")
        if pages:
            rec.add("300", " ", " ", ("a", R.pages_text(pages)))
        series, _ = pick("series")
        if series:
            rec.add("490", "0", " ", ("a", series))
        for n in _union([r.v.get("notes", []) for r in rows] + [r.notes for r in rows]):
            rec.add("500", " ", " ", ("a", n))
        for s in _union([R.split_list(x) for r in rows for x in r.v.get("subjects", [])]):
            rec.add("650", " ", "4", ("a", s))
        for o in others:
            if R.is_corporate(o):
                rec.add("710", "2", " ", ("a", o))
            else:
                entry = R.invert_name(o)
                rec.add("700", "1" if "," in entry else "0", " ", ("a", entry))
        items = [item for r in rows for item in self._items(r, klass, cutter, all_codes, used)]
        # The record's item type (942 $c) is the one most of its copies have.
        kinds = Counter(sf[1] for item in items for sf in item.subfields if sf[0] == "y" and sf[1])
        rec.add("942", " ", " ", ("c", kinds.most_common(1)[0][0] if kinds else self.itype))
        rec.fields.extend(items)
        rec.sort()
        self.stats["records"] += 1
        return rec

    def _items(self, row, klass, cutter, all_codes, used):
        v = row.v
        qty = v.get("quantity", "")
        n = int(qty) if re.fullmatch(r"\d{1,3}", qty or "") and int(qty) > 1 and not (v.get("tombo") or v.get("barcode")) else 1
        status = R.norm_header(v.get("itemstatus", ""))
        itype = self.itypes.get(R.norm_header(v.get("itemtype", ""))) or self.itype
        if v.get("itemtype") and not self.itypes.get(R.norm_header(v["itemtype"])):
            self.stats["itemtype_default"] += 1
        cn = v.get("callnumber") or " ".join(x for x in (klass, cutter) if x)
        out = []
        for i in range(1, n + 1):
            notes = []
            barcode, inventory = v.get("barcode", ""), v.get("tombo", "")
            if barcode:
                barcode, note = self._unique(barcode, all_codes, used, row, "código de barras")
                if note:
                    notes.append(note)
            elif inventory:
                barcode, note = self._unique(inventory, all_codes, used, row, "tombo")
                if note:
                    notes.append(note)
            if not barcode:
                self.stats["no_barcode"] += 1
            s = [("a", self.branch), ("b", self.branch), ("y", itype), ("o", cn), ("p", barcode),
                 ("i", inventory), ("t", str(i) if n > 1 else v.get("copy", "")), ("h", v.get("volume", "")),
                 ("d", R.iso_date(v.get("acqdate", ""), self.today)), ("g", R.price(v.get("price", "")))]
            if status in LOST:
                s.append(("1", "1"))
            elif status in WITHDRAWN:
                s.append(("0", "1"))
            elif status in DAMAGED:
                s.append(("4", "1"))
            elif status in NOT_FOR_LOAN:
                s.append(("7", "1"))
            if notes:
                s.append(("x", "; ".join(notes)))
            out.append(marc.Field("952", " ", " ", s))
            self.stats["items"] += 1
        return out
