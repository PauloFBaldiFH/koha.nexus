        msg_error "" "$(t 'The page does not compile with this version of Koha. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    mr_installed && updating=1
    mkdir -p "$MR_DIR" && chown "${INSTANCE}-koha:${INSTANCE}-koha" "$MR_DIR" 2>/dev/null
    chmod 750 "$MR_DIR"
    if [ "$link" = "yes" ] && ! mr_js_latest; then
        tools_safety_backup MARC-REPLACE || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        mr_js_sql add "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    { mkdir -p "$MR_PM_DIR"         && install -o root -g root -m 644 "$TOOLS_WORK/Vision.pm" "$MR_PM_DIR/Vision.pm.new"         && install -o root -g root -m 644 "$TOOLS_WORK/Rules.pm" "$MR_PM_DIR/Rules.pm.new"         && mv -f "$MR_PM_DIR/Vision.pm.new" "$MR_PM_DIR/Vision.pm"         && mv -f "$MR_PM_DIR/Rules.pm.new" "$MR_PM_DIR/Rules.pm"         && install -o root -g root -m 755 "$new" "${MR_FILE}.new" && mv -f "${MR_FILE}.new" "$MR_FILE"; } || {
        msg_error "" "$(t "The page could not be installed. Nothing was changed.")" 8 64; return 1; }
    printf 'installed=%s\nlink=%s\n' "$(date +%F)" "$link" > "$MR_STATE"
    # Plack keeps compiled pages in memory: an updated page needs a restart.
    [ "$updating" = "1" ] && plack_restart
    url="/cgi-bin/koha/tools/marc_replace.pl"
    log "marc_replace: page installed (link=$link)"
    msg_ok "$(t '✅ Page installed. In the staff interface: ${url}\n\nPrevious versions of the replaced records: ${MR_DIR}')" 11 76
}

# The page installed by an older panel: the same page (and AI cataloguing
# modules) as this version, checked with Koha's modules first. Run when the
# panel starts, like aia_refresh.
mr_refresh() {
    mr_installed || return 0
    local work log
    work=$(mktemp -d /tmp/koha_mr.XXXXXX) || return 0
    marc_replace_script > "$work/marc_replace.pl"
    mr_pm_vision > "$work/Vision.pm"
    mr_pm_rules > "$work/Rules.pm"
    if cmp -s "$work/marc_replace.pl" "$MR_FILE" && cmp -s "$work/Vision.pm" "$MR_PM_DIR/Vision.pm" && cmp -s "$work/Rules.pm" "$MR_PM_DIR/Rules.pm"; then
        rm -rf "$work"
        return 0
    fi
    printf '%s\n' "$(t "Updating the Replace a MARC record page...")"
    chmod 755 "$work"
    chmod 644 "$work/marc_replace.pl" "$work/Vision.pm" "$work/Rules.pm"
    log=$(tools_log marc-replace-refresh)
    if koha_exec "$log" perl-check /usr/bin/perl -c "$work/marc_replace.pl" \
       && koha_exec "$log" perl-check /usr/bin/perl -c "$work/Vision.pm" \
       && koha_exec "$log" perl-check /usr/bin/perl -c "$work/Rules.pm" \
       && mkdir -p "$MR_PM_DIR" \
       && install -o root -g root -m 644 "$work/Vision.pm" "$MR_PM_DIR/Vision.pm.new" \
       && install -o root -g root -m 644 "$work/Rules.pm" "$MR_PM_DIR/Rules.pm.new" \
       && mv -f "$MR_PM_DIR/Vision.pm.new" "$MR_PM_DIR/Vision.pm" \
       && mv -f "$MR_PM_DIR/Rules.pm.new" "$MR_PM_DIR/Rules.pm" \
       && install -o root -g root -m 755 "$work/marc_replace.pl" "${MR_FILE}.new" \
       && mv -f "${MR_FILE}.new" "$MR_FILE"; then
        plack_restart
        log "marc_replace: refreshed to panel ${PANEL_VERSION# }"
    else
        log "marc_replace: refresh skipped (see $log)"
    fi
    rm -rf "$work"
    return 0
}

