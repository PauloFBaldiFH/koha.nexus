"""Patrons for Koha's import_patrons.pl. A row becomes a patron only with a
personal identifier: a CPF, an e-mail, a card number from a patron table, or
a birth date with an address. A card number used twice is refused. CPFs are
not a reason to refuse anyone (ROADMAP subject 1): one that fails the modulo
11 check is only counted, and only a valid CPF, the first time it is seen,
goes to the CPF attribute."""
import csv
from collections import Counter

from . import rules as R

COLUMNS = ["cardnumber", "surname", "firstname", "email", "phone", "mobile", "dateofbirth", "address",
           "address2", "city", "state", "zipcode", "sex", "dateexpiry", "dateenrolled", "categorycode",
           "userid", "borrowernotes", "patron_attributes"]


class Patrons:
    def __init__(self, cpf_attr=False, categories=None, today=None):
        self.cpf_attr = cpf_attr
        self.categories = categories or {}
        self.today = today
        self.rows = []
        self.rejected = []          # (source, line, reason)
        self.stats = Counter()
        self.seen_cpf = {}
        self.seen_card = {}
        self.card_from_cpf = False

    def add(self, v, line, source, from_patron_table, has_card_column):
        self.stats["read"] += 1
        # Names and places typed in capitals, written as names ("SILVA, ANA" -> "Silva, Ana").
        for k in ("fullname", "firstname", "surname", "city", "address", "address2"):
            if v.get(k) and R.is_shouting(v[k]):
                fixed = R.smart_case(v[k], "title")
                if fixed != v[k]:
                    v[k] = fixed
                    self.stats["casing"] += 1
        full = v.get("fullname", "")
        first, sur = v.get("firstname", ""), v.get("surname", "")
        if full and not sur:
            f, s = R.split_patron_name(full)
            sur = s
            first = first or f
        raw_cpf = v.get("cpf", "")
        cpf = R.cpf_digits(raw_cpf)
        email = v.get("email", "")
        email_ok = bool(email) and "@" in email
        card = v.get("cardnumber", "") if has_card_column else ""
        if not has_card_column:
            card = cpf
            self.card_from_cpf = True
        dob = R.iso_date(v.get("dateofbirth", ""), self.today)
        reason = ""
        cpf_valid = bool(cpf) and R.cpf_ok(raw_cpf)
        if raw_cpf and not cpf_valid:
            self.stats["invalid_cpf"] += 1
        if not sur:
            reason = "no name"
        elif not card:
            reason = "no card number"
        elif card in self.seen_card:
            reason = "duplicate card number (line %d)" % self.seen_card[card]
            self.stats["duplicates"] += 1
        elif not (cpf or email_ok or (card and from_patron_table) or (dob and v.get("address"))):
            reason = "no personal identifier (CPF, e-mail, card number, or birth date and address)"
        if reason:
            self.rejected.append((source, line, reason))
            return
        keep_cpf = cpf_valid and cpf not in self.seen_cpf
        if cpf:
            self.seen_cpf.setdefault(cpf, line)
        self.seen_card[card] = line
        sex = (v.get("sex", "")[:1] or "").upper()
        notes = []
        if v.get("rg"):
            notes.append("RG: " + v["rg"])
        if v.get("patronnote"):
            notes.append(v["patronnote"])
        out = {
            "cardnumber": card, "surname": sur, "firstname": first, "email": email if email_ok else "",
            "phone": v.get("phone", ""), "mobile": v.get("mobile", ""), "dateofbirth": dob,
            "address": v.get("address", ""), "address2": v.get("address2", ""), "city": v.get("city", ""),
            "state": v.get("state", ""), "zipcode": v.get("zipcode", ""), "sex": sex if sex in ("M", "F") else "",
            "dateexpiry": R.iso_date(v.get("dateexpiry", ""), self.today),
            "dateenrolled": R.iso_date(v.get("dateenrolled", ""), self.today),
            "categorycode": self.categories.get(R.norm_header(v.get("category", "")), ""),
            "userid": v.get("userid", ""), "borrowernotes": "; ".join(notes),
            "patron_attributes": ("CPF:" + cpf) if (keep_cpf and self.cpf_attr and has_card_column) else "",
        }
        if v.get("category") and not out["categorycode"]:
            self.stats["category_default"] += 1
        self.rows.append(out)
        self.stats["ready"] += 1

    def write(self, path):
        cols = [c for c in COLUMNS if c in ("cardnumber", "surname") or any(r[c] for r in self.rows)]
        with open(path, "w", encoding="utf-8", newline="") as fh:
            w = csv.writer(fh, quoting=csv.QUOTE_ALL, lineterminator="\n")
            w.writerow(cols)
            for r in self.rows:
                w.writerow([r[c] for c in cols])
        return cols


def write_koha_layout(table, path):
    """A patron file already in Koha's layout, rewritten as UTF-8 with commas."""
    with open(path, "w", encoding="utf-8", newline="") as fh:
        w = csv.writer(fh, quoting=csv.QUOTE_MINIMAL, lineterminator="\n")
        w.writerow(table.headers)
        n = 0
        for row in table.data():
            if any(row):
                w.writerow(row)
                n += 1
    return n
