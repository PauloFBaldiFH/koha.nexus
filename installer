# ======================================================================
# PANEL TASKS: config.sh --task NAME [ARGS]
# ----------------------------------------------------------------------
# The new panel (panel/) asks a routine's questions in its own screens,
# then runs the routine here with no dialog at all: what the routine would
# show becomes lines of a small protocol on stdout, which
# panel/kei_panel/bridge.py reads while Pac-Man runs:
#   @@step LABEL             a step starts (tui_run)
#   @@done RC LABEL          that step ended
#   @@note TEXT              a progress line (display_explanation)
#   @@title TEXT             the routine's heading (tui_title)
#   @@msg KIND TITLE<TAB>TEXT  the box it would show: ok, info or error
#   @@ask TITLE<TAB>TEXT     a yes/no question: answered with
#                            KEI_TASK_ANSWER (yes by default); the panel
#                            first runs a routine with "no" to show its
#                            preview and question, then again with "yes"
#   @@preview TITLE<TAB>TEXT a text the routine would show in a scroll box
#                            (a dry run's list of changes)
#   @@result KEY=VALUE       a value for the panel's result screen
# New lines inside a text travel as "\n". Only the routines listed in
# kei_task are reachable; the panel's own lock is not taken (the routines
# take the backup lock themselves, as in the classic panel).
# ======================================================================
KEI_TASK=""
kei_emit() {
    local tag="$1" text
    shift
    text="$*"
    text=${text//$'\r'/}
    # On stderr, which the panel reads with stdout: a menu whose answer is
    # captured with $(...) still reaches it.
    printf '@@%s %s\n' "$tag" "${text//$'\n'/\\n}" >&2
}
# A value for the panel (nothing outside a task).
kei_result() { [ -n "${KEI_TASK:-}" ] && kei_emit result "$1=$2"; return 0; }

# The dialogs of the classic panel, as protocol lines.
kei_task_ui() {
    # KEI_TASK_INTERACTIVE=1: the panel answers each question on the KEI_IN
    # descriptor (the pipe it opened as stdin); otherwise KEI_TASK_ANSWER
    # answers every yes/no, menus take their default and boxes are only
    # reported.
    kei_live() { [ "${KEI_TASK_INTERACTIVE:-}" = "1" ] && [ -n "${KEI_IN:-}" ]; }
    kei_reply() { REPLY=""; IFS= read -r REPLY <&"$KEI_IN"; }
    # A box: "@@say KIND TITLE<TAB>TEXT" waits until the person closed it.
    kei_box() {
        if kei_live; then
            kei_emit say "${1} ${2}"$'\t'"${3}"
            kei_reply || true
        else
            kei_emit msg "${1} ${2}"$'\t'"${3}"
        fi
        return 0
    }
    msg_info() { kei_box info "${1}" "${2}"; }
    msg_ok() { kei_box ok "$(t "OK")" "${1}"; }
    msg_error() { kei_box error "${1:-$(t "Error")}" "${2}"; }
    prompt_yes_no() {
        kei_emit ask "${1:-}"$'\t'"${2:-}"
        if kei_live; then
            kei_reply || REPLY="no"
            [ "$REPLY" = "yes" ]
            return
        fi
        [ "${KEI_TASK_ANSWER:-yes}" = "yes" ]
    }
    # A long text: "@@view TITLE<TAB>TEXT" (waits), or a preview for later.
    ui_textbox() {
        local text
        text=$(head -c 200000 "$2" 2>/dev/null)
        if kei_live; then
            kei_emit view "${1:-}"$'\t'"$text"
            kei_reply || true
        else
            kei_emit preview "${1:-}"$'\t'"$text"
        fi
        return 0
    }
    # Menus and text boxes, asked by the panel when it is interactive:
    # "@@choose TITLE<TAB>PROMPT<TAB>DEFAULT<TAB>KEY<TAB>LABEL..." and
    # "@@input TITLE<TAB>PROMPT<TAB>DEFAULT<TAB>password"; the answer is
    # "ok VALUE" or "cancel".
    kei_answer() {
        kei_reply || REPLY="cancel"
        case "$REPLY" in
            "ok "*) REPLY="${REPLY#ok }"; return 0 ;;
            *)      REPLY=""; return 1 ;;
        esac
    }
    kei_choose() {   # TITLE PROMPT DEFAULT KEY LABEL... -> REPLY
        local title="$1" prompt="$2" def="$3" items="" item
        shift 3
        if ! kei_live; then
            REPLY="$def"
            [ -n "$def" ]
            return
        fi
        for item in "$@"; do items+=$'\t'"${item//$'\t'/ }"; done
        kei_emit choose "${title}"$'\t'"${prompt}"$'\t'"${def}${items}"
        kei_answer && [ -n "$REPLY" ]
    }
    kei_typed() {    # TITLE PROMPT [DEFAULT] [password] -> REPLY
        if ! kei_live; then
            REPLY="${3:-}"
            [ -n "$REPLY" ]
            return
        fi
        kei_emit input "${1}"$'\t'"${2}"$'\t'"${3:-}"$'\t'"${4:-}"
        kei_answer
    }
    # The two families of dialogs: ask_* (answer in REPLY) and the tools'
    # ui_* (answer printed, read with $(...)).
    ask_menu() { kei_choose "$@"; }
    ask_input() { kei_typed "$@"; }
    ui_menu() {
        local title="$1" text="$2"
        shift 2
        kei_choose "$title" "$text" "" "$@" || return 1
        printf '%s' "$REPLY"
    }
    ui_input() { kei_typed "$@" || return 1; printf '%s' "$REPLY"; }
    # "@@check TITLE<TAB>PROMPT<TAB>KEY<TAB>LABEL<TAB>ON|OFF..." -> "ok K1<TAB>K2"
    ui_checklist() {
        local title="$1" text="$2" items="" item tag
        shift 2
        if ! kei_live; then
            while [ $# -ge 3 ]; do [ "$3" = "ON" ] && printf '%s\n' "$1"; shift 3; done
            return 0
        fi
        for item in "$@"; do items+=$'\t'"${item//$'\t'/ }"; done
        kei_emit check "${title}"$'\t'"${text}${items}"
        kei_answer || return 1
        while IFS= read -r tag; do [ -n "$tag" ] && printf '%s\n' "$tag"; done <<< "${REPLY//$'\t'/$'\n'}"
        return 0
    }
    # File and folder pickers: "@@file file|dir<TAB>TITLE<TAB>PROMPT<TAB>START<TAB>EXTS"
    kei_pick() {
        kei_live || return 1
        kei_emit file "${1}"$'\t'"${2}"$'\t'"${3}"$'\t'"$(picker_start_dir "${4:-}")"$'\t'"${5:-}"
        kei_answer && [ -n "$REPLY" ] || return 1
        printf '%s' "$REPLY"
    }
    select_file() {
        kei_pick file "$(t "File Explorer")" "${3:-$(t "Pick the backup (.sql or .sql.gz):")}" "${1:-}" "${2:-sql sql.gz}"
    }
    select_directory() { kei_pick dir "$(t "Folder Picker")" "" "${1:-}" ""; }
    # A file to change by hand (the classic panel opens nano):
    # "@@edit TITLE<TAB>PATH<TAB>NOTE"; the panel saves it, then answers "ok".
    kei_edit() {
        kei_live || return 1
        kei_emit edit "${1}"$'\t'"${2}"$'\t'"${3:-}"
        kei_answer
    }
    # A link to open while a tool waits for it (an authorization): shown in
    # the loader, which may then be cancelled ("@@cancel on").
    auth_link_session() {
        local pid="$1" url="$2" hint="${4:-}" text
        text="$(t "Open this address in a browser:")"$'\n'"${url}"
        [ -n "$hint" ] && text+=$'\n\n'"$(printf '%b' "$hint")"
        browser_opener >/dev/null 2>&1 && open_in_browser "$url" >/dev/null 2>&1
        kei_result auth_url "$url"
        kei_emit stage "$(t "Waiting for the authorization...")"$'\t'"$text"
        kei_emit cancel on
        trap 'kill "$pid" 2>/dev/null; exit 130' TERM INT HUP
        wait "$pid" 2>/dev/null
        local rc=$?
        trap - TERM INT HUP
        kei_emit cancel off
        kei_emit stage ""
        unshield_signals 2>/dev/null
        return "$rc"
    }
    display_explanation() { kei_emit note "$(t "$1")"; }
    tui_title() { kei_emit title "$2"; }
    show_validation_report() {
        [ -s "$VALIDATION_LOG" ] || VALIDATION_LOG=$(find "$LOG_DIR" -maxdepth 1 -name 'validacao-*.log' -size +0 \
            -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
        if [ -z "$VALIDATION_LOG" ] || [ ! -s "$VALIDATION_LOG" ]; then
            msg_error "" "$(t "Diagnostic log file not found or is empty.\nPlease run validation first.")"
            return 1
        fi
        kei_emit preview "$(t "Diagnostic Report")"$'\t'"$(cat "$VALIDATION_LOG")"
    }
    # Installation stages and a failed step, for the loader and the error box.
    tui_header() { :; }
    tui_step() {
        local note
        if [ "${5:-}" = "long" ]; then
            note="$(t "This is the longest step: it can take 10 to 20 minutes. Please keep this window open.")"
        else
            note="$(t "This might take a few minutes. Please keep this window open.")"
        fi
        kei_emit stage "[$1/$2] $4"$'\t'"$note"
    }
    tui_fail_card() {
        local step="$1" file="${2:-$TUI_LOG}" text
        text="$(t 'The step "${step}" could not be completed.')\n\n$(t "Nothing was lost. This usually comes from the internet connection, a full disk or another installation running at the same time.")\n\n$(t "If it happens again, send this file to your IT support:")\n${file}"
        kei_emit msg "error $(t "Something needs attention")"$'\t'"$text"
        [ -s "$file" ] && tui_log_tail "$file" 12 | sed 's/^/   /'
    }
    pause_terminal() { :; }
    pause_terminal_continue() { :; }
    clear() { :; }
    # A dialog a routine still opens would wait where nobody can see it.
    whiptail() { kei_emit msg "error $(t "Error")"$'\t'"whiptail: $*"; return 1; }
    dialog() { whiptail "$@"; }
}

# The access credentials as "@@result cred=GROUP<TAB>LABEL<TAB>VALUE" lines,
# in the order function_view_credentials prints them.
kei_cred() { kei_result cred "${1}"$'\t'"$(_cred_label "$2")"$'\t'"${3}"; }
_cred_label() { local label="${1%:}"; printf '%s' "${label%"${label##*[! ]}"}"; }
kei_credentials() {
    local ip cf_opac cf_staff g head
    ip=$(get_server_ip)
    read -r cf_opac cf_staff < <(tunnel_public_hosts 2>/dev/null)
    [ "$cf_opac" = "-" ] && cf_opac=""
    [ "$cf_staff" = "-" ] && cf_staff=""
    g=$(t "ON THIS MACHINE (localhost):")
    kei_cred "$g" "$(t "OPAC  (catalog)       :")" "http://localhost:80"
    kei_cred "$g" "$(t "Staff (administration):")" "http://localhost:8080"
    g=$(t "FROM OTHER COMPUTERS ON THE NETWORK:")
    kei_cred "$g" "$(t "OPAC  (catalog)       :")" "http://${ip}:80"
    kei_cred "$g" "$(t "Staff (administration):")" "http://${ip}:8080"
    if [ -n "$cf_opac" ] || [ -n "$cf_staff" ]; then
        head=$(t "\n[ INTERNET / CLOUDFLARE TUNNEL ]\n")
        g=${head//\\n/}
        [ -n "$cf_opac" ] && kei_cred "$g" "$(t "OPAC  (catalog)       :")" "https://${cf_opac}"
        [ -n "$cf_staff" ] && kei_cred "$g" "$(t "Staff (administration):")" "https://${cf_staff}"
    fi
    g=$(t "SSH ACCESS (remote terminal):")
    kei_cred "$g" "SSH" "ssh $(get_ssh_login "$ip")"
    g=$(t "DATABASE CREDENTIALS (1st Access / Web Installer):")
    kei_cred "$g" "$(t "User :")" "${DB_NAME}"
    kei_cred "$g" "$(t "Pass :")" "$(get_database_password)"
    kei_cred "$g" "$(t "Full file:")" "${CREDENTIALS_FILE}"
}

# What the installation screens need before anything changes: the checks
# (report in @@preview), the ports in use, the timezone and whether an
# instance already exists (reinstalling erases it).
