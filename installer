        icons+=("🔑"); labels+=("$(t "Staff interface (library network)")"); urls+=("http://${ip}:8080")
    fi
    icons+=("💻"); labels+=("$(t "Public catalog (this computer)")"); urls+=("http://localhost")
    icons+=("💻"); labels+=("$(t "Staff interface (this computer)")"); urls+=("http://localhost:8080")

    for i in "${!labels[@]}"; do
