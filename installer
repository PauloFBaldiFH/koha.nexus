kei_task() {
    local name="${1:-}"
    shift
    KEI_TASK="$name"
    kei_task_ui
    # Answers come on the pipe the panel opened as stdin; every command
    # reads /dev/null instead, so none can swallow or wait for an answer.
    [ "${KEI_TASK_INTERACTIVE:-}" = "1" ] && exec {KEI_IN}<&0 </dev/null
    log "panel task: $name"
    case "$name" in
        info)            kei_task_info ;;
        backup-manual)   [ -n "${1:-}" ] || return 2; function_manual_backup "$1" ;;
        backup-test)     function_test_backup "${1:-}" ;;
        restore-check)
            [ -n "${1:-}" ] || return 2
            require_koha || return 1
            require_db_admin || return 1
            if ! restore_preflight "$1"; then
                msg_error "" "$RESTORE_PREFLIGHT_ERROR" 13 76
                return 1
            fi ;;
        restore)         [ -n "${1:-}" ] || return 2; function_restore_database "$1" ;;
        cloud-prepare)   require_database && tui_run "$(t "Installing rclone")" rclone_prepare ;;
        cloud-token)     kei_task_cloud_token ;;
        cloud-authorize) kei_task_cloud_authorize ;;
        cloud-remotes)
            local r
            while IFS= read -r r; do
                [ -n "$r" ] && kei_result remote "${r%:}"
            done < <(rclone listremotes 2>/dev/null)
            return 0 ;;
        cloud-remote)
            require_database || return 1
            rclone_prepare || return 1
            validate_and_register_rclone "${1:-}" ;;
        db-maintenance)  function_deep_maintenance ;;
        reports-install)
            require_database || return 1
            tools_locked _lt_reports_install reports_define "$REPORTS_TAG" "$(t "Essential reports pack")" REPORTS ;;
        reports-remove)
            require_database || return 1
            tools_locked _lt_reports_remove "$REPORTS_TAG" "$(t "Essential reports pack")" REPORTS ;;
        install-check)   kei_task_install_check ;;
        install-free-ports)
            install_precheck >/dev/null
            [ ${#KEI_BUSY_PORTS[@]} -eq 0 ] || install_free_ports ;;
        install)
            # Answers come in KEI_TASK_TZ and KEI_TASK_REINSTALL.
            install_precheck >/dev/null
            if [ "$V_FAIL" -ne 0 ]; then
                msg_error "$(t "Pre-validation Failed")" "$(awk -v tag="❌ " 'index($0, tag) == 1 { print substr($0, length(tag) + 1) }' "$VALIDATION_LOG" | head -n 4)"
                return 1
            fi
            function_install_koha ;;
        timezones)
            local z
            while IFS= read -r z; do
                [ -n "$z" ] && kei_result tz "$z"
            done < <(list_timezones)
            return 0 ;;
        credentials)     require_koha || return 1; kei_credentials ;;
        validation-report)
            show_validation_report ;;
        reboot)          reboot_now ;;
        search-toggle)   function_toggle_search_engine ;;
        search-repair)   function_repair_indexing ;;
        fail2ban)        function_fail2ban_status ;;
        ufw)             function_ufw_rules ;;
        staff-firewall)  function_staff_firewall ;;
        rotate-db-password) function_rotate_db_password ;;
        sizing)          function_size_server ;;
        email)           function_configure_emails ;;
        superlibrarian)  function_create_superlibrarian ;;
        interoperability) function_interoperability ;;
        z3950-list)
            require_database || return 1
            local zl
            while IFS= read -r zl; do
                [ -n "$zl" ] && kei_result row "$zl"
            done < <(z3950_rows)
            return 0 ;;
        z3950-add)       [ -n "${1:-}" ] || return 2; z3950_add "$1" ;;
        sru-bridge)      sru_bridge_install; local brc=$?; sru_bridge_register; return "$brc" ;;
        opac-theme-get)  opac_theme_get ;;
        opac-theme-apply) [ -n "${1:-}" ] || return 2; opac_theme_apply "$1" ;;
        opac-theme-remove) opac_theme_remove ;;
        opac-carousel-refresh) opac_carousel_refresh ;;
        cron-apply)      [ -n "${1:-}" ] || return 2; cron_apply "$1" ;;
        hub-status)      hub_status ;;
        sip-apply)       [ -n "${3:-}" ] || return 2; sip_apply "$1" "$2" "$3" ;;
        cloud-provider)  [ -n "${1:-}" ] || return 2; cloud_provider_add "$1" ;;
        vpn-status)      vpn_status ;;
        vpn-setup)       [ -n "${2:-}" ] || return 2; vpn_setup "$1" "$2" ;;
        vpn-peer-add)    [ -n "${1:-}" ] || return 2; vpn_peer_add "$1" ;;
        vpn-peer-revoke) [ -n "${1:-}" ] || return 2; vpn_peer_revoke "$1" ;;
        vpn-stop)        vpn_stop ;;
        clock)           function_configure_clock ;;
        status)
            local g label value
            while IFS=$'\t' read -r g label value; do
                kei_result row "${g}"$'\t'"${label}"$'\t'"${value}"
            done < <(detailed_status_rows)
            return 0 ;;
        health)          function_validate_system ;;
        repair-services) function_repair_services ;;
        export-diagnostics) kei_task_export_diagnostics ;;
        run)
            # Any other routine of the menu, its questions asked by the panel.
            local fn
            fn=$(panel_action_function "${1:-}") || {
                kei_emit msg "error $(t "Error")"$'\t'"$(t "Unknown panel action:") ${1:-}"
                return 2
            }
            restore_apt_timers
            if [ "${1:-}" != "about" ]; then require_systemd || return 1; fi
            case "$fn" in lt_*|function_brazil_tools|function_messaging|function_cataloguing|function_cdd|\
                          function_koha_plugins|function_cutter) require_koha || return 1 ;; esac
            "$fn" ;;
        ollama-install)
            # Ollama's own install script (AI cataloguing > Local Ollama),
            # or only a start when it is installed but not answering.
            require_systemd || return 1
            if command -v ollama >/dev/null 2>&1 && ollama_answers; then
                msg_ok "$(t "Ollama is already installed and running.")"
                return 0
            fi
            if ! TUI_LOG="$APT_LOG" tui_run "$(t "Installing Ollama")" ollama_install_task; then
                tui_fail_card "$(t "Installing Ollama")" "$APT_LOG"
                return 1
            fi
            msg_ok "$(t "Ollama is installed and running.")" ;;
        tool-install)
            # A terminal program the panel then opens itself (htop, mc).
            case "${1:-}" in
                htop)  command -v htop >/dev/null 2>&1 && command -v nethogs >/dev/null 2>&1 \
                           || install_tool "$(t "Installing htop and nethogs")" htop nethogs ;;
                mc)    command -v mc >/dev/null 2>&1 || install_tool "$(t "Installing Midnight Commander")" mc ;;
                *)     return 2 ;;
            esac
            local rc=$?
            kei_result iface "$(ip route 2>/dev/null | awk '/default/ {print $5; exit}')"
            return "$rc" ;;
        apache-log)
            # The panel follows the file itself; here only where it is.
            local log_file
            log_file=$(apache_error_log "${1:-1}")
            if [ ! -f "$log_file" ]; then
                msg_error "" "$(t "Log file not found: \${log_file}")"
                return 1
            fi
            kei_result file "$log_file" ;;
        *)
            kei_emit msg "error $(t "Error")"$'\t'"$(t "Unknown panel action:") $name"
            return 2 ;;
    esac
}

# Read-only commands (section 21.5): answer and exit before anything else runs.
# The panel's exit cleanup is not used: it removes /tmp/koha_tmp_* files that
# belong to a panel open at the same time.
if [ -n "$KEI_CLI_MODE" ]; then
    trap - EXIT
    case "$KEI_CLI_MODE" in
        --status-json) kei_status_json ;;
        --export-diagnostics) kei_export_diagnostics "${2:-}" ;;
        --broker-heartbeat) broker_heartbeat ;;
        # Not read-only, but idempotent: the Windows installer refreshes the
        # data-safety settings of an existing Koha without opening the panel.
        --install-data-safety) is_koha_installed && install_data_safety ;;
        --rebuild-search-index) kei_rebuild_search_index ;;
        --task) kei_task "${@:2}" ;;
    esac
    exit $?
fi

# ======================================================================
# KEEP THE INSTALLED PANEL UP TO DATE
# ----------------------------------------------------------------------
# After an installation the panel is also copied to /usr/local/bin/config.sh.
# If a newer copy of the installer is run, refresh that copy too, so that
# "sudo config.sh" never keeps running an old version.
# ======================================================================
if [ -f /usr/local/bin/config.sh ] && [ -f "$_SCRIPT_PATH" ] \
   && [ "$(readlink -f "$_SCRIPT_PATH")" != "$(readlink -f /usr/local/bin/config.sh)" ] \
   && ! cmp -s "$_SCRIPT_PATH" /usr/local/bin/config.sh; then
    install_panel_copy
    log "config.sh refreshed from $_SCRIPT_PATH"
fi

# Schedules written by older versions of the panel (see upgrade_cron_tasks).
is_koha_installed && upgrade_cron_tasks
# Data-safety settings for installs made before they existed.
is_koha_installed && install_data_safety
# Catalogue card enabled (Library tools > Brazil): stylesheets for new languages.
is_koha_installed && ficha_refresh
# AI assistant installed by an older panel: same page as this version.
is_koha_installed && aia_refresh
# Replace a MARC record / AI cataloguing installed by an older panel: same page as this version.
is_koha_installed && mr_refresh

# ======================================================================
# PRIMEIRA EXECUÇÃO: IDIOMA OBRIGATÓRIO SE NÃO ESTIVER CONFIGURADO
# ======================================================================
# The new panel asks it in its own first screen when it can run.
kei_panel_language_set() { [ -s "$TRANSLATION_CONFIG" ] && [ -n "$(_read_lang_conf KOHA_PANEL_LANG)" ]; }
kei_ask_panel_language() {
    local _init_choice
    _init_choice=$(whiptail --title "Language / Idioma" \
        --nocancel \
        --default-item "pt-BR" \
        --menu "Select your language / Selecione o idioma:" 22 72 14 \
        "${PANEL_LANG_ITEMS[@]}" \
        3>&1 1>&2 2>&3)
    [ -z "$_init_choice" ] && _init_choice="pt-BR"
    set_panel_language "$_init_choice"
}
if ! kei_panel_language_set; then
    if [ "${1:-}" = "--run" ] || ! kei_panel_ready; then kei_ask_panel_language; fi
fi

# ======================================================================
# ONE ROUTINE: --run <action>
# ======================================================================
# The Koha window on Windows lists the main menu natively and opens the
# terminal straight on the routine picked there: it runs that one routine,
# then the panel ends, with no main menu. The names are a fixed list;
# anything else is refused. Without --run nothing here applies.

if [ "${1:-}" = "--run" ]; then
    _run_fn=$(panel_action_function "${2:-}") || {
        echo "$(t "Unknown panel action:") ${2:-}" >&2
        exit 2
    }
    restore_apt_timers
    # As in the main menu: only About works without systemd.
    if [ "${2:-}" != "about" ]; then require_systemd || exit 1; fi
    "$_run_fn"
    clear
    exit 0
fi

# ======================================================================
# THE NEW PANEL (Textual), when it can run; else the classic menu below
# ======================================================================
restore_apt_timers
if kei_panel_ready; then
    kei_panel_run && { clear; exit 0; }
    kei_panel_explain_fallback "${KEI_PANEL_WHY:-$(t "Unknown error.")}" "$KEI_PANEL_ERRLOG"
fi
kei_panel_language_set || kei_ask_panel_language

