sub tname { my $n = shift; $n =~ s/"//g; $n =~ s/^.*\.//; return lc $n }
sub unescape_copy {
    my $f = shift;
    return undef if $f eq '\N';
    my %e = ( b => "\b", f => "\f", n => "\n", r => "\r", t => "\t", v => "\x0b" );
    $f =~ s{\\(?:([0-7]{1,3})|x([0-9A-Fa-f]{1,2})|(.))}{defined $1 ? chr(oct $1) : defined $2 ? chr(hex $2) : ( $e{$3} // $3 )}ge;
    return $f;
}
# Values of an INSERT: 'text' (with '' and E'\n'), numbers, NULL, true/false.
sub sql_values {
    my $s = shift;
    my ( @rows, @cur );
    pos($s) = 0;
    my $depth = 0;
    while ( pos($s) < length $s ) {
        if    ( $s =~ /\G\s+/gc ) { }
        elsif ( $s =~ /\G\(/gc )  { $depth++; @cur = () }
        elsif ( $s =~ /\G\)/gc )  { $depth--; push @rows, [@cur] }
        elsif ( $s =~ /\G,/gc )   { }
        elsif ( $s =~ /\G(E?)'((?:[^']|'')*)'(?:::[\w ]+)?/gc ) {
            my ( $esc, $v ) = ( $1, $2 );
            $v =~ s/''/'/g;
            $v = unescape_copy($v) if $esc;
            push @cur, $v;
        }
        elsif ( $s =~ /\GNULL/gci ) { push @cur, undef }
        elsif ( $s =~ /\G(true|false)/gci ) { push @cur, lc($1) eq 'true' ? 't' : 'f' }
        elsif ( $s =~ /\G(-?[\d.]+(?:e-?\d+)?)(?:::[\w ]+)?/gci ) { push @cur, $1 }
        elsif ( $s =~ /\G;/gc ) { last }
        else { return undef }
    }
    return \@rows;
}
