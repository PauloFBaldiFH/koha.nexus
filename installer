lt_br_labels() {
    require_database || return 0
    local choice items=() code desc
    choice=$(ui_menu "$(t "Pimaco label templates")" "$(t "Label templates and layouts for Koha's label creator (Tools > Label creator):")" \
        "1" "$(t "Install or update templates")" "2" "$(t "Remove the panel's templates")") || return 0
