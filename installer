# The reader of the PHA book (Python, run as the instance user): the rows
# "Entry number Entry" of the text of the PDF or of its OCR, with the
# numbers the OCR misread put back in order (see its own notes).
cat_pha_rows_py() {
    cat <<'PHAROWS'
"""
pha_rows.py (koha-easy-installer): the rows of the PHA table (Heloísa de
Almeida Prado) from the text of the book, as pdftotext -layout or an OCR
(tesseract) gives it: two letters per page spread ("D F"), each line with
one or more "Entry number Entry" groups (Davidson 28 Favo  Deb 33 Fein).

Out: "left<TAB>number<TAB>right" lines in the order of the book (each pair of
letters in the alphabetical order of its entries), which the panel's table import
reads. The numbers of the book follow the decimal order (28, 281 ... 289,
29) inside each pair of letters, so a number the OCR misread (3 for 8, 5 for
6...) is corrected when one changed digit puts it back in that order; the
rest stays as read and the import lists it for checking against the book.

    Usage: pha_rows.py TEXT OUT    (pages separated by form feeds)
Prints "rows=N", "fixed=N", "pages=N" and up to 40 "fix=..." lines.
Nothing is sent anywhere; only the standard library is used.
"""
import re
import sys
import unicodedata
from collections import Counter

NUM = re.compile(r"^\d{1,4}$")
# Digits the OCR confuses in the typeface of the book.
SIMILAR = {"3": "85", "8": "369", "5": "36", "6": "58", "1": "74", "7": "1", "9": "83", "0": "86", "4": "1"}


def words(line):
    """Tokens of a line; OCR noise (bars, colons, stray marks) left out."""
    out = []
    for tok in line.split():
        tok = tok.strip("|:;,_—-~'`\"“”‘’«»()[]{}")
        if tok and re.search(r"[0-9A-Za-zÀ-ÿ]", tok):
            out.append(tok)
    return out


def is_initial(tok):
    return bool(re.fullmatch(r"[A-ZÀ-Þ]\.?", tok))


def page_groups(lines):
    """[(left, number, right, column, letters)] of one page spread."""
    found = []
    for line in lines:
        toks = words(line)
        idx = [i for i, t in enumerate(toks) if NUM.match(t)]
        if not idx:
            continue
        segs = [toks[:idx[0]]] + [toks[a + 1:b] for a, b in zip(idx, idx[1:])] + [toks[idx[-1] + 1:]]
        # Before the first number: the left entry (noise before it dropped:
        # the last word that is not an initial starts it).
        first = segs[0]
        k = next((j for j in range(len(first) - 1, -1, -1) if not is_initial(first[j]) and len(first[j]) > 1), 0)
        lefts, rights = [first[k:]], []
        for seg in segs[1:-1]:
            # The right entry: a word and the initials after it; the rest is
            # the left entry of the next group.
            k = 1
            while k < len(seg) - 1 and is_initial(seg[k]):
                k += 1
            rights.append(seg[:k])
            lefts.append(seg[k:])
        last = segs[-1]
        k = 1
        while k < len(last) and is_initial(last[k]):
            k += 1
        rights.append(last[:k])
        for col, (n, le, ri) in enumerate(zip(idx, lefts, rights)):
            le, ri = " ".join(le), " ".join(ri)
            if le and ri and le[0].isalpha() and ri[0].isalpha() and short(le) and short(ri):
                found.append((le, toks[n], ri, col))
    # The letters of each column: the most common initials in it (a spread
    # can hold two pairs, as "E I" and "O U").
    letters = {}
    for col in {g[3] for g in found}:
        lc = Counter(g[0][0].upper() for g in found if g[3] == col)
        rc = Counter(g[2][0].upper() for g in found if g[3] == col)
        letters[col] = lc.most_common(1)[0][0] + rc.most_common(1)[0][0]
    groups = [g + (letters[g[3]],) for g in found if (g[0][0].upper() + g[2][0].upper()) == letters[g[3]]]
    # A page of text (the explanation of the table) has few groups.
    return groups if len(groups) >= 30 else []


def short(entry):
    """An entry of the table: a word or two and initials, not a sentence."""
    return len(entry) <= 30 and len(entry.split()) <= 4


def key(entry):
    """The entry as the table sorts it (the panel's name_key, simplified)."""
    s = unicodedata.normalize("NFD", entry.lower())
    s = "".join(c for c in s if not unicodedata.combining(c))
    return re.sub(r" +", " ", re.sub(r"[^a-z0-9 ]", " ", s)).strip()


def candidates(num):
    if len(num) > 3:   # a mark of the page read as one more digit
        return [num[:i] + num[i + 1:] for i in range(len(num))]
    out = []
    for i, d in enumerate(num):
        for s in SIMILAR.get(d, ""):
            out.append(num[:i] + s + num[i + 1:])
    # The numbers of the table have no zeros.
    return [c for c in out if c and "0" not in c]


def anchors(nums):
    """Indexes of the longest increasing run of numbers (decimal order): the
    numbers the OCR read right; the others are measured against them."""
    best, prev = [1] * len(nums), [-1] * len(nums)
    for i in range(len(nums)):
        for j in range(i):
            if nums[j] < nums[i] and best[j] + 1 > best[i]:
                best[i], prev[i] = best[j] + 1, j
    i = max(range(len(nums)), key=lambda k: best[k]) if nums else -1
    keep = set()
    while i >= 0:
        keep.add(i)
        i = prev[i]
    return keep


def repair(rows):
    """Numbers out of the decimal order fixed with one similar digit, when
    exactly that puts them between the numbers around them."""
    fixed = []
    start = 0
    while start < len(rows):
        end = start
        while end < len(rows) and rows[end][4] == rows[start][4]:
            end += 1
        nums = [r[1] for r in rows[start:end]]
        keep = anchors(nums)
        for i in range(len(nums)):
            if i in keep:
                continue
            lo = next((nums[j] for j in range(i - 1, -1, -1) if j in keep), "")
            hi = next((nums[j] for j in range(i + 1, len(nums)) if j in keep), None)
            good = [c for c in candidates(nums[i]) if lo < c and (hi is None or c < hi)]
            if good:
                good.sort(key=lambda c: (len(c) != len(nums[i]), c))
                r = rows[start + i]
                fixed.append(f"{r[0]} {nums[i]} -> {good[0]}")
                rows[start + i] = (r[0], good[0]) + r[2:]
        start = end
    return fixed


def main(src, out):
    with open(src, encoding="utf-8", errors="replace") as fh:
        pages = fh.read().split("\f")
    rows = []
    for page in pages:
        rows += page_groups(page.splitlines())
    # The order of the book: the pairs of letters as they come, each in the
    # alphabetical order of its entries (more reliable in an OCR than the
    # order of the columns on the page).
    first = {}
    for r in rows:
        first.setdefault(r[4], len(first))
    rows.sort(key=lambda r: (first[r[4]], key(r[0])))
    fixed = repair(rows)
    with open(out, "w", encoding="utf-8") as fh:
        for le, num, ri, _, _ in rows:
            fh.write(f"{le}\t{num}\t{ri}\n")
    print(f"rows={len(rows)}\nfixed={len(fixed)}\npages={len(pages)}")
    for f in fixed[:40]:
        print(f"fix={f}")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit("usage: pha_rows.py TEXT OUT")
    main(sys.argv[1], sys.argv[2])
PHAROWS
}

# cat_pdf_rows KIND PDF OUT LOG: the rows of an author table from its PDF
# (only the PHA book: "Entry number Entry"). A PDF with text is read with
# pdftotext; a scanned book is read page by page with tesseract (OCR, in
# Portuguese), so it takes a few minutes. Prints the report of the reader.
cat_pdf_rows() {
    local kind="$1" pdf="$2" out="$3" log="$4" txt pages p pkg lang
    txt="$TOOLS_WORK/table-pdf.txt"
    if ! command -v pdftotext >/dev/null 2>&1 || ! command -v pdftoppm >/dev/null 2>&1; then
        display_explanation "Installing the tools to read the PDF (poppler-utils)..."
        apt_install poppler-utils >/dev/null 2>&1
    fi
    if ! command -v pdftotext >/dev/null 2>&1; then
        pkg="poppler-utils"
        msg_error "" "$(t 'The package ${pkg} could not be installed. Nothing was changed.\n\nLog: ${APT_LOG}')" 10 72
        return 1
    fi
    display_explanation "Reading the text of the PDF..."
    pdftotext -layout -enc UTF-8 "$pdf" "$txt" >> "$log" 2>&1 || : > "$txt"
    # A scanned book has no text (or almost none): read the images of the pages.
    p=$(grep -cE '[[:alpha:]]+ +[0-9]{1,3} +[[:alpha:]]' "$txt" 2>/dev/null)
    if [ "${p:-0}" -lt 200 ]; then
        if ! command -v tesseract >/dev/null 2>&1; then
            display_explanation "Installing the OCR to read the scanned book (tesseract-ocr)..."
            apt_install tesseract-ocr tesseract-ocr-por >/dev/null 2>&1
        fi
        if ! command -v tesseract >/dev/null 2>&1; then
            pkg="tesseract-ocr"
            msg_error "" "$(t 'The package ${pkg} could not be installed. Nothing was changed.\n\nLog: ${APT_LOG}')" 10 72
            return 1
        fi
        lang=por; tesseract --list-langs 2>/dev/null | grep -qx por || lang=eng
        pages=$(pdfinfo "$pdf" 2>/dev/null | sed -n 's/^Pages: *//p')
        [[ "$pages" =~ ^[0-9]+$ ]] && [ "$pages" -le 400 ] || { msg_error "" "$(t "The PDF could not be read. Nothing was changed.")" 8 64; return 1; }
        : > "$txt"
        for ((p = 1; p <= pages; p++)); do
            printf '\r%s' "$(t 'Reading the scanned book with OCR: page ${p} of ${pages}...')"
            pdftoppm -r 300 -gray -png -f "$p" -l "$p" "$pdf" "$TOOLS_WORK/ocr-page" >> "$log" 2>&1
            tesseract "$TOOLS_WORK"/ocr-page*.png - -l "$lang" --psm 6 >> "$txt" 2>> "$log"
            printf '\f' >> "$txt"
            rm -f "$TOOLS_WORK"/ocr-page*.png
        done
        printf '\n'
        printf 'ocr=%s pages, %s\n' "$pages" "$lang" >> "$log"
    fi
    chown "${INSTANCE}-koha:" "$txt" 2>/dev/null || true
    cat_pha_rows_py > "$TOOLS_WORK/pha_rows.py"
    chmod 644 "$TOOLS_WORK/pha_rows.py"
    : > "$out"; chown "${INSTANCE}-koha:" "$out" 2>/dev/null || true
    display_explanation "Reading the rows of the table..."
    koha_exec "$log" pha-rows "$MAGIC_PY" -I "$TOOLS_WORK/pha_rows.py" "$txt" "$out" || return 1
    tools_output "$log"
}

