# Checks the administrator connection (root through the local socket) used
# for every DDL/DML of the panel. A server that is down is started once and
# given DB_WAIT_SECONDS to answer.
# Returns 0 = OK, 1 = MariaDB down, 2 = login refused.
DB_WAIT_SECONDS=30
db_admin_check() {
    local err i
    for ((i = 0; i <= DB_WAIT_SECONDS; i++)); do
        err=$(mysql -e 'SELECT 1;' 2>&1 >/dev/null) && return 0
        case "$err" in *"Access denied"*|*1045*|*1698*) return 2 ;; esac
        if [ "$i" -eq 0 ]; then
            systemctl start mariadb >/dev/null 2>&1 || koha_ctl service mariadb start >/dev/null 2>&1
        fi
        [ "$i" -lt "$DB_WAIT_SECONDS" ] && sleep 1
    done
    return 1
}

require_db_admin() {
    local rc=0
    db_admin_check || rc=$?
    case "$rc" in
        0) return 0 ;;
        2) msg_error "" "$(t "MariaDB refused the administrator login (root through the local socket).\nNothing was changed.\n\nCheck the root account or /root/.my.cnf.")" 12 76 ;;
        *) msg_error "" "$(t "MariaDB is not accepting connections and could not be started.\nNothing was changed.\n\nCheck: systemctl status mariadb")" 12 76 ;;
    esac
    return 1
}

# Logs in as the Koha database user exactly like Koha does (koha-conf.xml
# <hostname>/<port>): "localhost" goes through the socket, an IP address
# through TCP, and MariaDB treats user@localhost and user@127.0.0.1 as two
# different accounts.
db_app_login_ok() {
    local host port user pass db args
    host=$(koha_conf_value hostname); port=$(koha_conf_value port)
    user=$(koha_conf_value user); db=$(koha_conf_value database)
    pass=$(get_database_password)
    [ -n "$user" ] && [ -n "$pass" ] || return 1
    args=(--no-defaults -u "$user" -D "${db:-$DB_NAME}")
    [ "${host:-localhost}" != "localhost" ] && args+=(-h "$host" -P "${port:-3306}" --protocol=TCP)
    MYSQL_PWD="$pass" mysql "${args[@]}" -e 'SELECT 1;' >/dev/null 2>&1
}

get_ssh_ports() {
    local ports
    ports=$(grep -iE '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
    echo "${ports:-22}"
}

adjust_elasticsearch_heap() {
    local jvm_dir="/etc/elasticsearch/jvm.options.d"
    mkdir -p "$jvm_dir" 2>/dev/null || return 1
    local ram_gb
    ram_gb=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)/2}' /proc/meminfo)
    [ "${ram_gb:-0}" -lt 1 ] && ram_gb=1
    [ "${ram_gb:-0}" -gt 4 ] && ram_gb=4
    cat > "${jvm_dir}/koha_heap.options" << EOF
-Xms${ram_gb}g
-Xmx${ram_gb}g
EOF
    return 0
}

# Message boxes are drawn on stdout. A function whose answer is read with
# $(...) (e.g. kind=$(cat_pick_kind)) has its stdout captured: the box would
# wait for OK where nobody can see it and the panel would look frozen, so it
# goes to the terminal instead.
ui_msgbox() {
    if [ ! -t 1 ] && { : >/dev/tty; } 2>/dev/null; then
        whiptail "$@" >/dev/tty
    else
        whiptail "$@"
    fi
}
msg_info() { ui_msgbox --title "$1" --msgbox "$2" "${3:-12}" "${4:-74}"; }
