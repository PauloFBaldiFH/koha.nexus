}

# ask_menu TITLE PROMPT DEFAULT KEY LABEL [KEY LABEL...]: the chosen key in
# REPLY; returns 1 when cancelled. In a panel task (KEI_TASK) the menu is
# asked by the panel (see kei_task_ui); without an interactive panel the
# default is taken.
ask_menu() {
    local title="$1" prompt="$2" def="$3" n
    shift 3
    n=$(( $# / 2 ))
    [ "$n" -gt 12 ] && n=12
    REPLY=$(whiptail --title "$title" --cancel-button "$(t "Back")" ${def:+--default-item "$def"} \
        --menu "$prompt" $(( n + 10 )) 78 "$n" "$@" 3>&1 1>&2 2>&3) || return 1
    [ -n "$REPLY" ]
}

# ask_input TITLE PROMPT [DEFAULT] [password]: the typed value in REPLY;
# returns 1 when cancelled.
ask_input() {
    local box="--inputbox"
    [ "${4:-}" = "password" ] && box="--passwordbox"
    REPLY=$(whiptail --title "$1" "$box" "$2" 10 70 ${3:+"$3"} 3>&1 1>&2 2>&3)
}

prompt_yes_no() {
    local title="${1:-$(t "Warning")}"
    local message="${2:-$(t "Continue?")}"
    local h="${3:-12}"
    local w="${4:-74}"
    local defno=()
    local rc
    # "defaultno" (5th argument): the No button has the focus.
    [ "${5:-}" = "defaultno" ] && defno=(--defaultno)
    [ "${TUI_IN_RUN:-0}" = "1" ] && tui_stop_anim

    if command -v whiptail >/dev/null 2>&1; then
        whiptail --title "$title" "${defno[@]}" --yesno "$message" "$h" "$w" </dev/tty >/dev/tty 2>/dev/tty
        rc=$?
        case "$rc" in
            0) return 0 ;;
            1|255) return 1 ;;
            *) return 1 ;;
        esac
    fi

    printf '\n[%s]\n%s\n' "$title" "$message" >&2

    if [ -r /dev/tty ] && [ -w /dev/tty ]; then
        local ans
        printf '[%s/%s] ' "$(t "Yes")" "$(t "No")" > /dev/tty
        IFS= read -r ans < /dev/tty || return 1
        case "$ans" in
            n|N|nao|NAO|não|NÃO|no|NO|"$(t "No")") return 1 ;;
            *) return 0 ;;
        esac
    fi

    printf '%s\n' "$(t "No interactive terminal is available. Installation cancelled.")" >&2
    return 1
}

