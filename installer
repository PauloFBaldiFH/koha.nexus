def _cell_index(ref):
    m = re.match(r"([A-Z]+)", ref or "")
    if not m:
        return None
    n = 0
    for ch in m.group(1):
        n = n * 26 + ord(ch) - 64
    return n - 1


def _number(v):
    try:
        f = float(v)
    except ValueError:
        return v
    if f.is_integer() and abs(f) < 1e15:
        return str(int(f))
    return repr(f)


def _serial_date(v, date1904):
    try:
        f = float(v)
    except ValueError:
        return v
    base = datetime(1904, 1, 1) if date1904 else datetime(1899, 12, 30)
    d = base + timedelta(days=f)
    return d.date().isoformat() if d.time() == datetime.min.time() or f == int(f) else d.strftime("%Y-%m-%d %H:%M")


def read_xlsx(path, name):
    tables = []
    with zipfile.ZipFile(path) as z:
        names = set(z.namelist())
        shared = []
        if "xl/sharedStrings.xml" in names:
            for si in ET.fromstring(z.read("xl/sharedStrings.xml")).findall("m:si", _NS):
                shared.append("".join(t.text or "" for t in si.iter("{%s}t" % _NS["m"])))
        date_styles = set()
        if "xl/styles.xml" in names:
            st = ET.fromstring(z.read("xl/styles.xml"))
            custom = {}
            for nf in st.findall("m:numFmts/m:numFmt", _NS):
                code = re.sub(r'"[^"]*"|\[[^\]]*\]', "", nf.get("formatCode", "").lower())
                custom[int(nf.get("numFmtId"))] = bool(re.search(r"[dy]", code) or re.search(r"m{1,4}.*[dy]|[dy].*m", code))
            for i, xf in enumerate(st.findall("m:cellXfs/m:xf", _NS)):
                fid = int(xf.get("numFmtId", "0"))
                if fid in _DATE_IDS or custom.get(fid):
                    date_styles.add(i)
        wb = ET.fromstring(z.read("xl/workbook.xml"))
        pr = wb.find("m:workbookPr", _NS)
        date1904 = pr is not None and pr.get("date1904") in ("1", "true")
        rels = {}
        if "xl/_rels/workbook.xml.rels" in names:
            for rel in ET.fromstring(z.read("xl/_rels/workbook.xml.rels")).findall("rel:Relationship", _NS):
                target = rel.get("Target", "")
                target = target[1:] if target.startswith("/") else "xl/" + target
                rels[rel.get("Id")] = os.path.normpath(target).replace(os.sep, "/")
        for sh in wb.findall("m:sheets/m:sheet", _NS):
            target = rels.get(sh.get("{%s}id" % _NS["r"]))
            if not target or target not in names:
                continue
            rows = []
            with z.open(target) as fh:
                for _, el in ET.iterparse(fh):
                    if el.tag != "{%s}row" % _NS["m"]:
                        continue
                    r = int(el.get("r", len(rows) + 1))
                    while len(rows) < r - 1:
                        rows.append([])
                    row = []
                    for c in el.findall("m:c", _NS):
                        idx = _cell_index(c.get("r"))
                        if idx is None:
                            idx = len(row)
                        if idx >= MAX_COLS:
                            continue
                        t = c.get("t", "n")
                        v = c.find("m:v", _NS)
                        val = v.text if v is not None and v.text is not None else ""
                        if t == "s" and val:
                            val = shared[int(val)] if int(val) < len(shared) else ""
                        elif t == "inlineStr":
                            val = "".join(x.text or "" for x in c.iter("{%s}t" % _NS["m"]))
                        elif t == "b":
                            val = "TRUE" if val == "1" else "FALSE"
                        elif t == "n" and val:
                            val = _serial_date(val, date1904) if int(c.get("s", "0")) in date_styles else _number(val)
                        while len(row) < idx:
                            row.append("")
                        row.append(val)
                    rows.append(row)
                    el.clear()
                    if len(rows) >= MAX_ROWS:
                        break
            tables.append(Table("%s: %s" % (name, sh.get("name")), rows, "UTF-8", "XLSX"))
    return tables


