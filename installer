# clean(VALUE, MFN, FIELD): text without control characters, escape leftovers,
# "Informação não encontrada" or empty fillers; carets inside text become
# SEP (the ISIS subfield delimiter between two parts) and are reported.
sub clean {
    my ( $s, $mfn, $field, $sep ) = @_;
    return undef unless defined $s;
    if ( $s =~ s/([$latin14])/$latin14{$1}/g ) { $stat{fix_ordinal}++ }
