# What every cloud set-up needs first: rclone and the backup scripts.
rclone_prepare() {
    command -v rclone >/dev/null 2>&1 || apt_install rclone >/dev/null 2>&1
    if ! command -v rclone >/dev/null 2>&1; then
        msg_error "" "$(t "Could not install rclone.")" 8 66
        return 1
    fi
    [ -f /root/backup_sql.sh ] || write_backup_scripts
    return 0
}

# Cloud backup with a token made on another computer (KEI_RCLONE_TOKEN:
# kept out of the command line).
kei_task_cloud_token() {
    local token="${KEI_RCLONE_TOKEN:-}"
    unset KEI_RCLONE_TOKEN
    require_database || return 1
    if ! rclone_token_clean "$token"; then
        msg_error "" "$(t "[ERROR] Provided JSON is corrupt or was truncated when copying. Try again:")" 9 74
        return 1
    fi
    token=$REPLY
    tui_run "$(t "Installing rclone")" rclone_prepare || { msg_error "" "$(t "Could not install rclone.")" 8 66; return 1; }
    if ! tui_run "$(t "Registering 'gdrive' remote in Rclone...")" rclone_create_gdrive "$token"; then
        msg_error "" "$(t "Failed to register connection in Rclone.")" 8 66
        return 1
    fi
    validate_and_register_rclone "gdrive"
}

# Cloud backup authorized on this server: the link goes to the panel at
# once (@@result auth_url), then this waits for Google's answer. Stopping
# the task stops rclone too (port 53682 is freed).
kei_task_cloud_authorize() {
    local out token rc
    require_database || return 1
    tui_run "$(t "Installing rclone")" rclone_prepare || { msg_error "" "$(t "Could not install rclone.")" 8 66; return 1; }
    out=$(mktemp /root/.kei-rclone-auth.XXXXXX) || return 1
    if ! auth_tool_start "$out" "$RCLONE_AUTH_URL_RE" rclone authorize "drive" --auth-no-open-browser; then
        rm -f "$out"
        msg_error "" "$(t "rclone did not print an authorization link (is port 53682 busy?).")" 9 74
        return 1
    fi
    trap 'kill "$AUTH_PID" 2>/dev/null; rm -f "$out"; exit 130' TERM INT HUP
    kei_result auth_url "$AUTH_URL"
    if browser_opener >/dev/null; then
        open_in_browser "$AUTH_URL" >/dev/null 2>&1 && kei_result auth_opened yes
    else
        kei_result auth_tunnel "ssh -L 53682:127.0.0.1:53682 ${REAL_USER:-root}@$(get_server_ip)"
    fi
    kei_emit note "$(t "Waiting for the authorization...")"
    wait "$AUTH_PID"
    rc=$?
    trap - TERM INT HUP
    token=$(grep -o '{.*}' "$out" 2>/dev/null | head -n1)
    rm -f "$out"
    if [ "$rc" -ne 0 ] || ! is_rclone_token "$token"; then
        msg_error "" "$(t "Could not capture token automatically. Try Option 1.")" 9 74
        return 1
    fi
    if ! tui_run "$(t "Registering 'gdrive' remote in Rclone...")" rclone_create_gdrive "$token"; then
        msg_error "" "$(t "Failed to register gdrive remote in Rclone.")" 8 66
        return 1
    fi
    validate_and_register_rclone "gdrive"
}

# Ollama, the local AI of the cataloguing tools: its official script sets
# up the "ollama" service on 127.0.0.1:11434.
# 0 when Ollama answers on its local port (IPv4: it listens on 127.0.0.1).
ollama_answers() {
    curl -fsS --noproxy '*' --max-time 3 http://127.0.0.1:11434/api/version >/dev/null 2>&1
}

# ollama_wait SECONDS: 0 as soon as Ollama answers.
ollama_wait() {
    local i
    for i in $(seq 1 "$1"); do
        ollama_answers && return 0
        sleep 1
    done
    return 1
}

ollama_install_task() {
    if ! command -v ollama >/dev/null 2>&1; then
        # The install script unpacks a .tar.zst: without zstd it stops at once.
        apt_install curl ca-certificates zstd || return 1
        curl -fsSL https://ollama.com/install.sh | sh || return 1
    fi
    printf '>>> %s\n' "Starting the Ollama service"
    systemctl enable ollama >/dev/null 2>&1 || true
    systemctl restart ollama >/dev/null 2>&1 || true
    ollama_wait 20 && return 0
    # No service, or it does not come up (some WSL2 set-ups): started by
    # hand in the background, kept up by cron after a restart.
    printf '>>> %s\n' "The service did not answer: starting 'ollama serve' in the background"
    systemctl stop ollama >/dev/null 2>&1 || true
    pgrep -x ollama >/dev/null 2>&1 \
        || OLLAMA_HOST=127.0.0.1:11434 setsid nohup ollama serve >> "${LOG_DIR}/ollama.log" 2>&1 < /dev/null &
    if ollama_wait 30; then
        printf '@reboot root OLLAMA_HOST=127.0.0.1:11434 %s serve >> %s 2>&1\n' \
            "$(command -v ollama)" "${LOG_DIR}/ollama.log" > /etc/cron.d/koha-easy-ollama
        chmod 644 /etc/cron.d/koha-easy-ollama
        return 0
    fi
    printf '%s\n' "Ollama does not answer on http://127.0.0.1:11434 (log: ${LOG_DIR}/ollama.log)"
    return 1
}

