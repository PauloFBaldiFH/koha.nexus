"""Fingerprinting: what each member is, from its bytes (magic numbers first,
then structure and content), never from the name alone. The Koha backup
check runs before anything else and wins when it matches."""
import os
import re
from collections import Counter

from . import holdings, intake, marc
from . import rules as R
from . import tables

HEAD = 65536
KOHA_TABLES = {"biblio", "biblio_metadata", "items", "borrowers", "systempreferences", "marc_subfield_structure"}

# Kinds of member and what the panel does with them.
KINDS = {
    "koha_backup": "Koha backup (MariaDB/MySQL dump)",
    "marc": "MARC 21 records (ISO 2709)",
    "marcxml": "MARC 21 records (MARCXML)",
    "isis": "ISIS catalogue (PostgreSQL export)",
    "bf_backup": "Biblioteca Fácil backup",
    "bf_folder": "Biblioteca Fácil data folder",
    "table": "Spreadsheet",
    "mrk": "MARC text (MarcEdit .mrk)",
    "sql_other": "SQL dump of another system",
    "pg_other": "PostgreSQL export of another system",
    "pg_custom": "PostgreSQL custom-format export",
    "cds_isis": "CDS/ISIS master file",
    "unknown": "Not recognised",
    "part": "Part of another member",
}


class Detection:
    def __init__(self, member, kind, confidence, evidence, **info):
        self.member = member
        self.kind = kind
        self.confidence = confidence
        self.evidence = evidence
        self.info = info


def _scan(fh, head, pattern, want, limit=8 << 30):
    """Names matched by pattern (one group) in the stream, stopping at want."""
    found = set(m.group(1).decode("latin-1").lower() for m in pattern.finditer(head))
    tail, read = head[-200:], len(head)
    while len(found & want) < len(want) and read < limit:
        chunk = fh.read(1 << 20)
        if not chunk:
            break
        read += len(chunk)
        buf = tail + chunk
        found.update(m.group(1).decode("latin-1").lower() for m in pattern.finditer(buf))
        tail = buf[-200:]
    return found


_CREATE = re.compile(rb"CREATE TABLE (?:IF NOT EXISTS )?`(\w+)`")
_PG_TABLE = re.compile(rb"(?:COPY|CREATE TABLE|INSERT INTO)\s+(?:\"?public\"?\.)?\"?(\w+)\"?[\s(]", re.I)
_ISO = re.compile(rb"\s*\d{5}[acdnp ][a-z ]{2}[a-z ][ a]22\d{5}")


def detect(member, work):
    try:
        with member.open() as fh:
            head = fh.read(HEAD)
            kind = _by_content(member, fh, head, work)
    except (OSError, EOFError, ValueError) as e:
        return Detection(member, "unknown", 0.0, "cannot be read (%s)" % e)
    return kind


def _by_content(member, fh, head, work):
    base = os.path.basename(member.display)
    if not head:
        return Detection(member, "unknown", 0.0, "empty file")
    if head.startswith(b"PK\x03\x04"):
        office = intake.is_office_zip(member.plain(work))
        if office:
            return Detection(member, "table", 0.99, office.upper() + " workbook", fmt=office)
        return Detection(member, "unknown", 0.0, "zip archive that could not be opened")
    if head.startswith(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1"):
        return Detection(member, "table", 0.9, "Excel 97-2003 workbook (OLE)", fmt="xls")
    if head.startswith(b"PGDMP"):
        return Detection(member, "pg_custom", 0.99, "PostgreSQL custom-format dump (PGDMP)")
    if b"T09_ACER" in head and (b"T01_USUA" in head or b"T04_LEIT" in head):
        return Detection(member, "bf_backup", 0.97, "DBISAM tables T01..T15 of Biblioteca Fácil")
    if re.fullmatch(r"(?i)T\d\d_\w+\.dat", base):
        if base.upper() == "T09_ACER.DAT":
            return Detection(member, "bf_folder", 0.95, "T09_ACER.dat of a Biblioteca Fácil data folder")
        return Detection(member, "part", 1.0, "table of the Biblioteca Fácil data folder")
    if re.fullmatch(r"(?i).*\.(xrf|n0\d|cnt|ifp|ly\d|fst|fdt|pft|stw|any|iyp)", base):
        return Detection(member, "part", 1.0, "CDS/ISIS index or definition file")
    if re.fullmatch(r"(?i).*\.mst", base):
        return Detection(member, "cds_isis", 0.9, "CDS/ISIS master file (.mst)")
    if re.fullmatch(r"(?i).*\.(dbt|fpt|cdx|ntx|ndx|mdx|idx)", base):
        return Detection(member, "part", 1.0, "index or memo file of a dBase table")
    if tables.dbf_header(head):
        return Detection(member, "table", 0.95, "dBase table (DBF)", fmt="dbf")
    if _ISO.match(head) and b"\x1d" in head and b"\x1e" in head:
        return Detection(member, "marc", 0.97, "ISO 2709 leader and record terminators")
    text = head.decode("utf-8", "replace")
    if ("MARC21/slim" in text or re.search(r"<(\w+:)?record[\s>]", text)) and re.search(r"<(\w+:)?(datafield|controlfield|leader)[\s>]", text):
        return Detection(member, "marcxml", 0.97, "MARCXML <record> elements")
    if re.search(r"(?m)^=(LDR|\d{3})  ", text):
        return Detection(member, "mrk", 0.9, "MarcEdit text lines (=245  ...)")
    if re.search(r"-- (MariaDB|MySQL) dump", text) or "CREATE TABLE `" in text or "INSERT INTO `" in text:
        found = _scan(fh, head, _CREATE, KOHA_TABLES)
        hits = sorted(found & KOHA_TABLES)
        if len(hits) >= 4:
            return Detection(member, "koha_backup", 0.99, "Koha tables: " + ", ".join(hits))
        return Detection(member, "sql_other", 0.8, "MySQL dump without Koha's tables")
    if "PostgreSQL database dump" in text or re.search(r"(?m)^COPY \S+ \(", text) or "SET client_encoding" in text:
        found = _scan(fh, head, _PG_TABLE, {"acervo"})
        if "acervo" in found:
            return Detection(member, "isis", 0.95, "PostgreSQL dump with the acervo table")
        return Detection(member, "pg_other", 0.8, "PostgreSQL dump of another system")
    start = head.lstrip(b"\xef\xbb\xbf \t\r\n")
    if re.match(rb'\[\s*[\[{"\d\]-]|\{\s*["}]', start):
        return Detection(member, "table", 0.85, "JSON export", fmt="json")
    if re.match(rb"(?i)<!doctype html|<html", start):
        return Detection(member, "unknown", 0.0, "web page (HTML)")
    if start[:1] == b"<":
        return Detection(member, "table", 0.85, "XML export", fmt="xml")
    if b"\0" in head[:4096]:
        return Detection(member, "unknown", 0.0, "binary file of an unknown format")
    decoded, _ = R.decode_text(head)
    lines = [l for l in decoded.splitlines() if l.strip()][:60]
    if len(lines) >= 1:
        sep = tables.sniff_delimiter(lines)
        widths = [len(l.split(sep)) for l in lines]
        if max(widths) >= 2 and Counter(widths).most_common(1)[0][1] >= 0.6 * len(widths):
            return Detection(member, "table", 0.9, "text with columns separated by %r" % {"\t": "TAB"}.get(sep, sep), fmt="csv")
    return Detection(member, "unknown", 0.0, "text without columns")


# ---------------------------------------------------------------- MARC inspection

LATIN_UPPER = set(range(0xC0, 0xE0))
MARC8_MARKS = {0xE1, 0xE2, 0xE4, 0xE8, 0xF0}   # grave, acute, tilde, umlaut, cedilla
VOWELS = set(b"aeiouAEIOUcCnN")


def guess_iso_encoding(records):
    """'UTF-8', 'ISO_8859-1' or 'MARC-8' with a confidence, from the bytes."""
    unicode_flag = sum(1 for leader, _ in records if leader[9:10] == "a")
    data = b"\x1e".join(d for _, fields in records for _, d in fields)[:1 << 20]
    if not re.search(rb"[\x80-\xff]", data):
        return "UTF-8", 1.0, ""
    try:
        data.decode("utf-8")
        return "UTF-8", 0.99 if unicode_flag else 0.95, ""
    except UnicodeDecodeError:
        pass
    latin = marc8 = 0
    for i in range(len(data) - 1):
        b, nxt = data[i], data[i + 1]
        if b < 0x80:
            continue
        if b in MARC8_MARKS and nxt in VOWELS:
            marc8 += 1
        elif b in LATIN_UPPER or (b >= 0xE0 and (nxt not in VOWELS or b in (0xE7, 0xF5))):
            latin += 1
    sample = ""
    m = re.search(rb"[^\x1e\x1f]{0,30}[\x80-\xff][^\x1e\x1f]{0,30}", data)
    if m:
        sample = m.group(0).decode("latin-1")
    if latin >= 3 * max(marc8, 1) or (latin and not marc8):
        return "ISO_8859-1", 0.9, sample
    if marc8 >= 3 * max(latin, 1) or (marc8 and not latin):
        return "MARC-8", 0.9, sample
    return "ISO_8859-1", 0.5, sample


def _raw(field):
    """A MARCXML field as the data of an ISO 2709 field (UTF-8)."""
    if field.is_control():
        return (field.value or "").encode("utf-8")
    return (field.ind1 + field.ind2).encode("utf-8") + b"".join(
        b"\x1f" + c.encode("utf-8") + v.encode("utf-8") for c, v in field.subfields)


def inspect_marc(member, kind, koha=None):
    """Records, item field layout and encoding of a MARC file (every record
    is counted; the first 3000 are studied). koha: Koha's libraries, item
    types and shelving locations (normalised name or code -> code)."""
    recs = []
    n = n952 = 0
    tag_recs = Counter()
    with member.open() as fh:
        if kind == "marc":
            stream = marc.iso2709_records(fh)
        else:
            stream = ((r.leader, [(f.tag, _raw(f)) for f in r.fields]) for r in marc.marcxml_records(fh))
        for leader, fields in stream:
            n += 1
            tag_recs.update(set(tag for tag, _ in fields))
            n952 += sum(1 for tag, _ in fields if tag == "952")
            if len(recs) < 3000:
                recs.append((leader, fields))
    info = {"records": n, "with_952": tag_recs.get("952", 0), "items_952": n952}
    if kind == "marc":
        enc, conf, sample = guess_iso_encoding(recs[:3000])
        info.update(encoding=enc, enc_conf=conf, enc_sample=sample)
    else:
        info.update(encoding="UTF-8", enc_conf=1.0, enc_sample="")
    info.update(holdings.find(recs, tag_recs, n, info["encoding"], koha or {}))
    return info
