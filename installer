# ---------------------------------------------------------------- CSV / TSV

def sniff_delimiter(lines):
    best, best_score = ",", -1.0
    for d in (";", ",", "\t", "|"):
        counts = []
        for row in csv.reader(lines[:60], delimiter=d):
            if row:
                counts.append(len(row))
        if not counts:
            continue
        top = max(set(counts), key=counts.count)
        if top < 2:
            continue
        score = counts.count(top) / len(counts) + min(top, 30) / 100.0
        if score > best_score:
            best, best_score = d, score
    return best


def read_csv(path, name):
    with open(path, "rb") as fh:
        text, enc = R.decode_text(fh.read())
    lines = text.splitlines()
    sep = sniff_delimiter(lines)
    rows = []
    for row in csv.reader(io.StringIO(text, newline=""), delimiter=sep):
        if len(rows) >= MAX_ROWS:
            break
        rows.append(row)
    t = Table(name, rows, enc, "CSV")
    t.separator = {"\t": "TAB"}.get(sep, sep)
    return [t]


