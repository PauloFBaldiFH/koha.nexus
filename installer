    rmdir "$KEI_PERL_DIR/SMS/Send/KohaEasy" 2>/dev/null
    rm -rf "$MSG_DATA"
    log "messaging: module removed"
    msg_ok "$(t "✅ The messaging module was removed.")"
}

# ======================================================================
# 32. CATALOGUING AIDS: AUTHOR NOTATION (PHA, CUTTER-SANBORN) AND CDD
# ----------------------------------------------------------------------
# Read-only helpers for the cataloguers. The author tables (Tabela PHA of
# Heloísa de Almeida Prado, Cutter-Sanborn) and the Dewey schedules are
# copyrighted and are not distributed with the panel: each library loads
# its own copy as a text file (one entry and its number per line; the PHA
# rows as printed, entry - number - entry, are read as they are). The notation
# follows the rules of the PHA explanation: the entry that comes right
# before the name in alphabetical order, the initial of the surname, the
# number and the initial of the title (the initial article never counts;
# a title starting with "l" gets a capital L), prefixes read as one word
# (La Fonte, O'Donnel) and M' / Mc read as Mac.
# ======================================================================
CAT_DIR="${CONF_DIR}/tables"

# awk functions shared by the table import and the lookup.
cat_awk_lib() {
    cat <<'CATAWK'
function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); return s }
function unaccent(s) {
    gsub(/á|à|â|ã|ä|Á|À|Â|Ã|Ä/, "a", s); gsub(/é|è|ê|ë|É|È|Ê|Ë/, "e", s); gsub(/í|ì|î|ï|Í|Ì|Î|Ï/, "i", s)
    gsub(/ó|ò|ô|õ|ö|Ó|Ò|Ô|Õ|Ö/, "o", s); gsub(/ú|ù|û|ü|Ú|Ù|Û|Ü/, "u", s); gsub(/ç|Ç/, "c", s); gsub(/ñ|Ñ/, "n", s)
    gsub(/ý|ÿ|Ý/, "y", s)
    return s
}
# Name as the tables sort it: lower case, no accents, M' and Mc as Mac,
# a prefix joined to the word after it, only letters and single spaces.
function name_key(s) {
    s = tolower(unaccent(trim(s)))
    if (s ~ /^m'/) s = "mac" substr(s, 3)
    else if (s ~ /^mc/) s = "mac" substr(s, 3)
    gsub(/’|'/, "", s)
    gsub(/[^a-z0-9 ]/, " ", s); gsub(/  +/, " ", s); s = trim(s)
    if (s ~ /^(van der|van den|van de|de la|de las|de los|von der|von) [a-z]/) { sub(/ /, "", s); sub(/ /, "", s) }
    else if (s ~ /^(la|le|les|du|des|van|ten|ter|del|della|delle|di|da|de|dos|das|do|lo|el|al) [a-z]/) sub(/ /, "", s)
    return s
}
# "Surname, Forename" -> key of the surname plus the forename.
function author_key(s,   p, sur, fore) {
    p = index(s, ",")
    if (p == 0) return name_key(s)
    sur = name_key(substr(s, 1, p - 1)); fore = name_key(substr(s, p + 1))
    return fore == "" ? sur : sur " " fore
}
function is_article(w) {
    return w ~ /^(o|a|os|as|um|uma|uns|umas|the|an|el|la|los|las|lo|le|les|un|une|il|gli|der|die|das|ein|eine)$/
}
# Title without its initial article (or without the first IND2 characters).
function title_rest(t, ind2,   w) {
    t = trim(t)
    if (ind2 ~ /^[1-9]$/) return trim(substr(t, ind2 + 1))
    if (tolower(t) ~ /^l'/) return trim(substr(t, 3))
    w = tolower(unaccent(t)); sub(/[ \t].*/, "", w)
    if (is_article(w) && index(t, " ")) return trim(substr(t, index(t, " ") + 1))
    return t
}
function work_mark(t, ind2,   c) {
    t = tolower(unaccent(title_rest(t, ind2)))
    gsub(/[^a-z0-9]/, "", t)
    c = substr(t, 1, 1)
    return c == "l" ? "L" : c
}
CATAWK
}

# cat_table_import KIND SOURCE OUT: author table (pha, cutter) or CDD
# schedule (cdd) in the panel format; the report goes to stdout.
cat_table_import() {
    local kind="$1" src="$2" out="$3"
    LC_ALL=C awk -v kind="$kind" -v out="$out" \
        -v l_lines="$(t "Lines read")" -v l_entries="$(t "Entries")" -v l_skipped="$(t "Lines not understood")" \
        -v l_order="$(t "Numbers out of order (check these lines against the book)")" -v l_dup="$(t "Repeated entries (the first one is kept)")" \
        -v l_letter="$(t "Entries per letter")" -v l_line="$(t "line")" \
        "$(cat_awk_lib)"'
function add(e, num,   k, L) {
    e = trim(e); if (e == "") return
    k = name_key(e); L = substr(k, 1, 1)
    if (L !~ /[a-z]/) { skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " $0; return }
    if ((L SUBSEP k) in seen) { dup++; if (ndu < 30) du[++ndu] = l_line " " NR ": " e " (" seen[L, k] ")"; return }
    seen[L, k] = e " " num
    n++; LET[n] = L; KEY[n] = k; NUM[n] = num; ENT[n] = e; LN[n] = NR
    cnt[L]++
}
{
    line = $0; sub(/\r$/, "", line)
    if (NR == 1) sub(/^\357\273\277/, "", line)
    if (line ~ /^[ \t]*(#|$)/) next
    lines++
    if (kind == "cdd") {
        if (match(line, /^[ \t]*[0-9][0-9][0-9](\.[0-9]+)?/)) {
            num = trim(substr(line, RSTART, RLENGTH)); cap = trim(substr(line, RSTART + RLENGTH))
            sub(/^[\t;,:-]+[ \t]*/, "", cap); cap = trim(cap)
            if (cap != "" && !(num in cdd)) { cdd[num] = cap; order[++n] = num; next }
        }
        skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " line
        next
    }
    # "Entry<sep>number", "number<sep>entry" or the row of the book "Entry number Entry".
    nf = split(line, f, /[\t;]/)
    # A comma separates only next to the number ("Sampaio M.,184"); in
    # "127 Abbot, J." (Cutter-Sanborn) it belongs to the entry.
    if (nf < 2 && index(line, ",")) {
        nc = split(line, f, /,/)
        for (i = 1; i <= nc; i++) if (trim(f[i]) ~ /^[0-9]+$/) { nf = nc; break }
    }
    if (nf < 2) {
        nw = split(line, w, /[ ]+/); left = ""; right = ""; num = ""
        for (i = 1; i <= nw; i++) {
            if (num == "" && w[i] ~ /^[0-9]+$/) num = w[i]
            else if (num == "") left = left (left == "" ? "" : " ") w[i]
            else right = right (right == "" ? "" : " ") w[i]
        }
    } else {
        left = ""; right = ""; num = ""
        for (i = 1; i <= nf; i++) {
            v = trim(f[i])
            if (num == "" && v ~ /^[0-9]+$/) num = v
            else if (num == "") left = left (left == "" ? "" : " ") v
            else right = right (right == "" ? "" : " ") v
        }
    }
    if (num == "" || (left == "" && right == "")) { skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " line; next }
    add(left, num); add(right, num)
}
END {
    if (kind == "cdd") {
        for (i = 1; i <= n; i++) printf "%s\t%s\n", order[i], cdd[order[i]] > out
        printf "%s: %d\n%s: %d\n%s: %d\n", l_lines, lines, l_entries, n, l_skipped, skipped
        for (i = 1; i <= nsk; i++) print "  " sk[i]
        printf "@@entries %d\n@@problems %d\n", n, skipped
        exit
    }
    # Sort by letter and key (insertion sort per letter keeps it simple and stable).
    for (i = 1; i <= n; i++) { L = LET[i]; m = ++per[L]; IDX[L, m] = i }
    bad = 0
    for (L in per) {
        for (a = 2; a <= per[L]; a++) {
            x = IDX[L, a]; b = a - 1
            while (b >= 1 && KEY[IDX[L, b]] > KEY[x]) { IDX[L, b + 1] = IDX[L, b]; b-- }
            IDX[L, b + 1] = x
        }
        for (a = 1; a <= per[L]; a++) {
            x = IDX[L, a]
            printf "%s\t%s\t%s\t%s\n", L, KEY[x], NUM[x], ENT[x] > out
            # Decimal numbering (1, 11, 111, 112 ... 12): compared as text.
            if (a > 1 && (NUM[x] "") < (NUM[IDX[L, a - 1]] "")) { bad++; if (nba < 50) ba[++nba] = l_line " " LN[x] ": " ENT[x] " " NUM[x] " < " ENT[IDX[L, a - 1]] " " NUM[IDX[L, a - 1]] }
        }
    }
    printf "%s: %d\n%s: %d\n%s: %d\n", l_lines, lines, l_entries, n, l_skipped, skipped
    printf "%s:", l_letter
    for (c = 97; c <= 122; c++) { L = sprintf("%c", c); if (L in cnt) printf " %s=%d", toupper(L), cnt[L] }
    printf "\n"
    if (skipped) { print l_skipped ":"; for (i = 1; i <= nsk; i++) print "  " sk[i] }
    if (bad) { printf "%s: %d\n", l_order, bad; for (i = 1; i <= nba; i++) print "  " ba[i] }
    if (dup) { printf "%s: %d\n", l_dup, dup; for (i = 1; i <= ndu; i++) print "  " du[i] }
    printf "@@entries %d\n@@problems %d\n", n, skipped + bad
}' "$src"
}

cat_table_path() { printf '%s/%s.tsv' "$CAT_DIR" "$1"; }
cat_table_name() {
    case "$1" in
        pha) printf '%s' "$(t "PHA table (Heloísa de Almeida Prado)")" ;;
        cutter) printf 'Cutter-Sanborn' ;;
        cdd) printf '%s' "$(t "CDD (Dewey) schedule")" ;;
    esac
}
cat_table_count() { [ -s "$(cat_table_path "$1")" ] && wc -l < "$(cat_table_path "$1")" || echo 0; }

# cat_notation KIND "Surname, Forename" TITLE [IND2] [MODE]: prints
# "NOTATION<TAB>ENTRY<TAB>NUMBER<TAB>PREVIOUS<TAB>NEXT" (numbers of the
# neighbouring entries). MODE: person (default), corporate (first word of
# the name) or title (anonymous work: first word of the title, no mark).
cat_notation() {
    local kind="$1" name="$2" title="${3:-}" ind2="${4:-}" mode="${5:-person}" table
    table=$(cat_table_path "$kind")
    [ -s "$table" ] || return 2
    LC_ALL=C awk -F'\t' -v name="$name" -v title="$title" -v ind2="$ind2" -v mode="$mode" "$(cat_awk_lib)"'
BEGIN {
    if (mode == "title") { key = title_rest(title, ind2); sub(/[ \t].*/, "", key); key = name_key(key); mark = "" }
    else if (mode == "corporate") { key = name; sub(/[ \t,].*/, "", key); key = name_key(key); mark = work_mark(title, ind2) }
    else { key = author_key(name); mark = work_mark(title, ind2) }
    L = substr(key, 1, 1)
    if (L !~ /[a-z]/) exit 3
}
$1 == L {
    if ($2 <= key) { prev = hit; hit = $3; ent = $4; next_n = ""; found = 1; next }
    if (found && next_n == "") next_n = $3
    if (!found && first == "") { first = $3; firstent = $4 }
}
END {
    if (L !~ /[a-z]/) exit 3
    if (!found) { if (first == "") exit 4; hit = first; ent = firstent }
    printf "%s%s%s\t%s\t%s\t%s\t%s\n", toupper(L), hit, mark, ent, hit, prev, next_n
}' "$table"
}

# Call numbers of the catalogue that already use the letter and number
# BASE (e.g. A848, not A8481) in CLASS: "callnumber<TAB>author<TAB>title".
cat_used() {
    local class="$1" base="$2" skip="${3:-0}" re
    [[ "$class" =~ ^[0-9A-Za-z./-]{0,20}$ ]] && [[ "$base" =~ ^[A-Z][0-9]+$ ]] && [[ "$skip" =~ ^[0-9]+$ ]] || return 0
    if [ -n "$class" ]; then re="^${class//./\\.}[[:space:]]+${base}([^0-9]|\$)"; else re="(^|[[:space:]])${base}([^0-9]|\$)"; fi
    run_sql "SELECT DISTINCT i.itemcallnumber, COALESCE(b.author, ''), COALESCE(b.title, '') FROM ${DB_NAME}.items i JOIN ${DB_NAME}.biblio b ON b.biblionumber = i.biblionumber WHERE i.itemcallnumber REGEXP $(sql_quote "$re") AND i.biblionumber <> ${skip} ORDER BY i.itemcallnumber LIMIT 20;"
}

# Report of one notation: the entry used, the call number and the uses of
# the same number in the class (a different author needs another number).
cat_notation_report() {
    local kind="$1" name="$2" title="$3" ind2="$4" mode="$5" class="$6" skip="${7:-0}" out="$8"
    local res rc=0 nota ent num prev nxt base used
    res=$(cat_notation "$kind" "$name" "$title" "$ind2" "$mode") || rc=$?
    if [ "$rc" -ne 0 ]; then
        printf '%s\n' "$(t "No notation: the name must start with a letter (write it as Surname, Forename).")" > "$out"
        return 1
    fi
    IFS=$'\037' read -r nota ent num prev nxt <<< "${res//$'\t'/$'\037'}"
    base="${nota:0:1}${num}"
    {
        printf '%s: %s\n' "$(cat_table_name "$kind")" "$nota"
        printf '\n  %s: %s\n  %s: %s (%s)\n' "$(t "Heading")" "$name" "$(t "Table entry used")" "$ent" "$num"
        [ -n "$title" ] && printf '  %s: %s\n' "$(t "Title")" "$title"
        [ -n "$class" ] && printf '\n  %s:\n      %s\n      %s\n' "$(t "Call number")" "$class" "$nota"
        used=$(cat_used "$class" "$base" "$skip")
        if [ -n "$used" ]; then
            printf '\n%s\n' "$(t "Already used in the catalogue (in the same class, two different authors cannot have the same number):")"
            printf '%s\n' "$used" | awk -F'\t' '{ printf "  %-22s %-28s %s\n", $1, substr($2, 1, 28), substr($3, 1, 40) }'
            printf '\n%s\n' "$(t "If it is another author, use the number right before or right after it, or add one more digit (e.g. 1753):")"
            [ -n "$prev" ] && printf '  %s%s  (%s)\n' "${nota:0:1}" "$prev" "$( [ -n "$(cat_used "$class" "${nota:0:1}${prev}" "$skip")" ] && t "in use" || t "free to use")"
            [ -n "$nxt" ] && printf '  %s%s  (%s)\n' "${nota:0:1}" "$nxt" "$( [ -n "$(cat_used "$class" "${nota:0:1}${nxt}" "$skip")" ] && t "in use" || t "free to use")"
        elif [ -n "$class" ]; then
            printf '\n%s\n' "$(t "Not used yet in this class in the catalogue.")"
        fi
    } > "$out"
}

cat_pick_kind() {   # author table to use (only the loaded ones)
    local items=() k
    for k in pha cutter; do [ -s "$(cat_table_path "$k")" ] && items+=("$k" "$(cat_table_name "$k")"); done
    if [ ${#items[@]} -eq 0 ]; then
        msg_info "$(t "Author notation")" "$(t "Load the PHA or Cutter-Sanborn table of your library first (Load a table).")" 9 70
        return 1
    fi
    [ ${#items[@]} -eq 2 ] && { printf '%s' "${items[0]}"; return 0; }
    ui_menu "$(t "Author notation")" "$(t "Table:")" "${items[@]}"
}

lt_cat_notation() {
    local kind name title class out
    kind=$(cat_pick_kind) || return 0
    name=$(ui_input "$(t "Author notation")" "$(t "Author as in the heading: Surname, Forename (e.g. Assis, Machado de). For an institution, its name.")" "") || return 0
    [ -n "${name// /}" ] || return 0
    title=$(ui_input "$(t "Author notation")" "$(t "Title of the work (for the initial after the number):")" "") || return 0
    class=$(ui_input "$(t "Author notation")" "$(t "Class number (CDD), to check the numbers already used (optional):")" "") || return 0
    class="${class// /}"
    if ! [[ "$class" =~ ^[0-9A-Za-z./-]{0,20}$ ]]; then
        msg_error "" "$(t "Invalid class number.")" 8 60
        return 1
    fi
    tools_workdir || return 1
    out="$TOOLS_WORK/notation.txt"
    cat_notation_report "$kind" "$name" "$title" "" person "${class// /}" 0 "$out"
    ui_textbox "$(t "Author notation")" "$out"
}

# From a catalogue record: 100 (person), 110/111 (institution, first word)
# or the title (anonymous work); class from 082.
lt_cat_record() {
    local kind bn row a100 a110 a111 t245 ind2 c082 name mode out
    kind=$(cat_pick_kind) || return 0
    bn=$(ui_input "$(t "Author notation")" "$(t "Record number (biblionumber):")" "") || return 0
    if ! [[ "$bn" =~ ^[0-9]{1,10}$ ]]; then
        msg_error "" "$(t "Invalid record number.")" 8 60
        return 1
    fi
    row=$(run_sql "SELECT CONCAT_WS(CHAR(31), ExtractValue(metadata, '//datafield[@tag=\"100\"]/subfield[@code=\"a\"]'), ExtractValue(metadata, '//datafield[@tag=\"110\"]/subfield[@code=\"a\"]'), ExtractValue(metadata, '//datafield[@tag=\"111\"]/subfield[@code=\"a\"]'), ExtractValue(metadata, '//datafield[@tag=\"245\"]/subfield[@code=\"a\"]'), ExtractValue(metadata, '//datafield[@tag=\"245\"]/@ind2'), ExtractValue(metadata, '//datafield[@tag=\"082\"]/subfield[@code=\"a\"]'), '') FROM ${DB_NAME}.biblio_metadata WHERE biblionumber = ${bn} AND format = 'marcxml' LIMIT 1;")
    if [ -z "$row" ]; then
        msg_error "" "$(t "Record not found.")" 8 60
        return 1
    fi
    # Unit separator, not tab: empty fields must keep their place.
    IFS=$'\037' read -r a100 a110 a111 t245 ind2 c082 _ <<< "$row"
    t245="${t245%[ /:;=]}"; t245="${t245%[ /:;=]}"
    if [ -n "$a100" ]; then name="${a100%[,.]}"; mode=person
    elif [ -n "${a110}${a111}" ]; then name="${a110:-$a111}"; mode=corporate
    else name="$t245"; mode=title
    fi
    tools_workdir || return 1
    out="$TOOLS_WORK/notation.txt"
    cat_notation_report "$kind" "$name" "$t245" "$ind2" "$mode" "${c082%% *}" "$bn" "$out"
    ui_textbox "$(t "Author notation")" "$out"
}

# Main classes of the DDC (first summary); the rest comes from the
