# The script of the page: the result follows the typing (format=part), Copy
# and "Use in the record" (the notation goes into the field the page was
# opened from: 090 / 092 $b take the notation, a call number keeps its class).
sub page_script {
    my $js = shift;
    return "<script>\nvar K = $js;\n" . <<'JS';
(function () {
    var form = document.getElementById("kei-form"), out = document.getElementById("kei-out"), timer = null, seq = 0;
    function refresh() {
        var q = [], els = form.elements, my = ++seq;
        for (var i = 0; i < els.length; i++) {
            if (!els[i].name || (els[i].type === "checkbox" && !els[i].checked)) continue;
            q.push(encodeURIComponent(els[i].name) + "=" + encodeURIComponent(els[i].value));
        }
        q.push("format=part");
        var x = new XMLHttpRequest();
        x.open("GET", "cutter_calculator.pl?" + q.join("&"));
        x.onload = function () { if (my === seq && x.status === 200) out.innerHTML = x.responseText; };
        x.send();
    }
    form.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(refresh, 150); });
    form.addEventListener("change", function () { clearTimeout(timer); timer = setTimeout(refresh, 50); });
    form.addEventListener("submit", function (e) { e.preventDefault(); refresh(); });
    // Settings of the gear (this browser only): table, classification, the
    // letter of the title, edition and copy added when the record has them.
    var S = { table: "", scheme: "auto", letter: true, edition: true, copy: true }, F = form.elements;
    var orig = { edition: F.edition.value, copy: F.copy.value };
    try {
        var raw = localStorage.getItem("kei_callno_settings"), o = raw ? JSON.parse(raw) : { table: localStorage.getItem("kei_cutter_table") || "" };
        for (var k in S) if (o && o.hasOwnProperty(k) && o[k] !== null) S[k] = o[k];
    } catch (e) {}
    function given(n) { return new RegExp("[?&]" + n + "=").test(location.search); }
    function pick(sel, v) { for (var j = 0; j < sel.options.length; j++) if (sel.options[j].value === v) { if (sel.value === v) return false; sel.value = v; return true; } return false; }
    function settle(first) {
        var changed = false;
        if (S.table && (!first || !given("table")) && pick(F.table, S.table)) changed = true;
        if ((!first || !given("scheme")) && pick(F.scheme, S.scheme)) changed = true;
        if ((!first || !given("noletter")) && F.noletter.checked !== !S.letter) { F.noletter.checked = !S.letter; changed = true; }
        var want = { edition: S.edition ? orig.edition : "", copy: S.copy ? orig.copy : "" };
        for (var f in want) if (F[f].value !== want[f] && (F[f].value === orig[f] || F[f].value === "")) { F[f].value = want[f]; changed = true; }
        if (changed) refresh();
    }
    settle(true);
    F.table.addEventListener("change", function () { S.table = F.table.value; save(); });
    function save() { try { localStorage.setItem("kei_callno_settings", JSON.stringify(S)); } catch (e) {} }
    var box = document.getElementById("kei-set"), gear = document.getElementById("kei-gear");
    function el(id) { return document.getElementById(id); }
    function show(on) {
        box.hidden = !on; gear.setAttribute("aria-expanded", on ? "true" : "false");
        if (!on) return;
        pick(el("kei-s-table"), S.table || F.table.value);
        pick(el("kei-s-scheme"), S.scheme);
        el("kei-s-letter").checked = !!S.letter; el("kei-s-edition").checked = !!S.edition; el("kei-s-copy").checked = !!S.copy;
    }
    gear.addEventListener("click", function () { show(box.hidden); });
    el("kei-s-close").addEventListener("click", function () { show(false); });
    el("kei-s-save").addEventListener("click", function () {
        S = { table: el("kei-s-table").value, scheme: el("kei-s-scheme").value, letter: el("kei-s-letter").checked, edition: el("kei-s-edition").checked, copy: el("kei-s-copy").checked };
        save(); show(false); settle(false);
    });
    function fallback(v) {
        var t = document.createElement("textarea"); t.value = v; document.body.appendChild(t); t.select();
        try { document.execCommand("copy"); } catch (e) {}
        document.body.removeChild(t);
    }
    function copy(v, btn) {
        var done = function () { if (btn) { btn.textContent = K.copied; } };
        if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(v).then(done, function () { fallback(v); done(); }); }
        else { fallback(v); done(); }
    }
    // 090 / 092: the class goes to $a and the Cutter number to $b of the
    // same field; a call number (952 $o) takes both, keeping a location
    // prefix typed before the class (R 869.3 A848d).
    function put(x, v, w) { x.value = v; try { x.dispatchEvent(new w.Event("change", { bubbles: true })); } catch (e) {} }
    function sibling(x, tag, code) {
        var sel = "input[id^='tag_" + tag + "_subfield_" + code + "']", box = x.closest ? x.closest("div.tag") : null;
        return (box && box.querySelector(sel)) || x.ownerDocument.querySelector(sel);
    }
    function apply(n, cls, btn) {
        var w = window.opener, el = null;
        try { el = w && !w.closed ? w.document.getElementById(K.target) : null; } catch (e) { el = null; }
        if (!el) { copy(cls ? cls + " " + n : n, btn); alert(K.gone); return; }
        var t = K.target.match(/^tag_(09[0-9])_subfield_([ab])/), v = el.value.replace(/^\s+|\s+$/g, "");
        if (t && t[2] === "b") {
            put(el, n, w);
            var a = sibling(el, t[1], "a");
            if (a && cls && !a.value) put(a, cls, w);
        } else if (t) {
            var b = sibling(el, t[1], "b");
            if (b) { if (cls) put(el, cls, w); put(b, n, w); } else put(el, (cls ? cls + " " : "") + n, w);
        } else if (cls) {
            var i = v.indexOf(cls);
            put(el, (i > 0 ? v.slice(0, i) : "") + cls + " " + n, w);
        } else {
            var m = v.match(/^(.*?\d{3}(?:[.,]\d+)?)(?:\s|$)/);
            put(el, m ? m[1] + " " + n : n, w);
        }
        el.focus();
        window.close();
    }
    out.addEventListener("click", function (e) {
        var b = e.target.closest ? e.target.closest("button") : null;
        if (!b) return;
        e.preventDefault();
        if (b.className === "use") { F["class"].value = b.getAttribute("data-class"); refresh(); }
        else if (b.className === "apply") apply(b.getAttribute("data-n"), b.getAttribute("data-c"), b);
        else copy(b.getAttribute("data-v"), b);
    });
})();
</script>
</body>
</html>
JS
}
CUTPL2
}

# The buttons in the staff interface (a marked block in IntranetUserJS):
