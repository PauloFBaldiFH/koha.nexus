# ======================================================================
# 34. CDD LOOKUP IN THE CATALOGUING (STAFF INTERFACE)
# ----------------------------------------------------------------------
# cataloguing/cdd_lookup.pl: the CDD (Dewey) searched while cataloguing, by
# number or by subject, with the hierarchy, the list of subjects, a hint of
# how built numbers were made and the numbers the library already uses. A
# CDD button next to the class fields of the cataloguing form opens it and
# puts the chosen number in the field. The DDC is copyrighted by OCLC and
# is not distributed with the panel: the library builds the index from its
# own copy (the PDF, or the text of the PDF) under Library tools > CDD
# lookup, and the index stays on its server (kei-cdd in the folder of the
# instance). The page only
# reads Koha; removing it keeps the index.
# ======================================================================
CDD_DIR="/var/lib/koha/${INSTANCE}/kei-cdd"
CDD_DB="${CDD_DIR}/cdd.sqlite"
CDD_INFO="${CDD_DIR}/cdd.info"
CDD_FILE="${KOHA_INTRA_CGI}/cataloguing/cdd_lookup.pl"
CDD_PM="${KEI_PERL_DIR}/KohaEasy/CDD.pm"
CDD_STATE="${CONF_DIR}/cdd_lookup.state"
CDD_JS_BEGIN="/* koha-easy-installer cdd begin */"
CDD_JS_END="/* koha-easy-installer cdd end */"
# Texts of the page (see cdd_text).
CDD_KEYS="title search_ph search main_classes table no_index index_info edition results no_results in_library titles items \
    with_sub incl_sub apply copy copied narrower subjects subjects_below built analysis analysis_hint rest st_bracket st_option st_index \
    within lib_titles words suggest from build build_hint lookup gone cataloguing"

# The reader of the CDD and the searches of the page (KohaEasy::CDD).
cdd_pm() {
    cat <<'CDDPM'
package KohaEasy::CDD;

# koha-easy-installer: the CDD (Dewey Decimal Classification) lookup.
#
# Reads the text of the library's own copy of the CDD (the text of the PDF,
# as pdftotext gives it) and builds a small SQLite index with three parts:
#
#   - the schedules and the tables (entries): number, caption, notes, the
#     number above it in the hierarchy;
#   - the alphabetical list of subjects with their numbers (terms), when the
#     copy has one ("Tabela Resumida": "869.3 - POESIA BRASILEIRA");
#   - facts about the file (meta): edition, name, date, counts.
#
# The DDC is copyrighted by OCLC: nothing of it is distributed with the
# panel. Each library builds the index from the copy it owns, on its server.
#
# The reader follows the conventions of the printed schedules: a line that
# starts with a number starts an entry (the lines after it are its notes);
# ".5" means the last three-digit number plus ".5"; numbers in [brackets] are
# not used; numbers in (parentheses) are options; "—01" lines are table
# notation. A number is taken only if it keeps the order of the schedules,
# so a number at the start of a wrapped line of notes does not become an
# entry. The summaries ("RESUMO") repeat numbers: the longest text wins.
#
# Used by the panel (build) and by cataloguing/cdd_lookup.pl (the rest).
# Nothing here talks to Koha: text in, index out; index in, answers out.

use strict;
use warnings;
use utf8;
use DBI;
use Encode qw( decode );
use POSIX ();
use Unicode::Normalize qw( NFD );

our $VERSION = '1';
our $SCHEMA  = '1';

# ----------------------------------------------------------------------
# Text helpers
# ----------------------------------------------------------------------

# Lower case, no accents, only letters and digits (for searching).
sub norm {
    my $s = lc( NFD( shift // '' ) );
    $s =~ s/\p{Mn}+//g;
    $s =~ s/[^\p{L}\p{N}]+/ /g;
    $s =~ s/^ +| +$//g;
    return $s;
}

my %STOP = map { $_ => 1 } qw(
    a o e as os um uma de da do das dos em no na nos nas para por com sem ao aos
    the of and in on for to by with an
    el la los las y en del con por para
    le les des du et au aux
);

# Search words of a query: stop words out and the ending of longer words
# dropped, so one form finds the others ("infantis" finds "infantil" and
# "infanto-juvenil", "livros" finds "livro").
sub tokens {
    my %seen;
    my @t;
    for my $w ( split / /, norm(shift) ) {
        next if $STOP{$w} || ( length($w) < 2 && $w !~ /^\d$/ );
        if    ( length($w) >= 7 ) { substr( $w, -2 ) = '' }
        elsif ( length($w) >= 5 ) { $w =~ s/s$// }
        push @t, $w unless $seen{$w}++;
    }
    return @t;
}

# A class number as typed ("869,3", " 869.3 ", "T1-09", "t2—81") in the form
# of the index ("869.3", "T1-09"); undef when it is not one.
sub clean_number {
    my $s = shift // '';
    $s =~ s/^\s+|\s+$//g;
    if ( $s =~ /^T\s*([1-6])\s*[-—–]?\s*(\d+)$/i ) {
        return "T$1-$2";
    }
    $s =~ s/,/./;
    $s =~ s/(?<=\d) (?=\d)//g;
    return $1 if $s =~ /^(\d{3}(?:\.\d+)?)\.?$/;
    return sprintf( '%s00', $1 ) if $s =~ /^(\d)$/;
    return sprintf( '%s0', $1 ) if $s =~ /^(\d\d)$/;
    return undef;
}

# Display form: table notation with the dash of the printed tables.
sub display_number {
    my $n = shift // '';
    $n =~ s/^(T\d)-/$1—/;
    $n =~ s/^(\d{3}(?:\.\d+)?)-(\d{3}(?:\.\d+)?)$/$1–$2/;
    return $n;
}

# Caption and notes of an entry: the caption ends at the first full stop,
# semicolon, " - " or ", incluindo" (", including").
sub split_text {
    my $t = shift // '';
    $t =~ s/^\*+\s*//;
    $t =~ s/\s+/ /g;
    $t =~ s/^\s+|\s+$//g;
    my ( $h, $n ) = ( $t, '' );
    if ( $t =~ /^(.+?)(?:\.\s+(?=\S)|;\s+|\s+(?=\*\p{Lu})|\s+-\s+(?=\p{Lu})|\s*,\s+(?i:incluindo|including|inclusive|incluyendo)\b\s*)(.*)$/s ) {
        ( $h, $n ) = ( $1, $2 );
        $n = "$1 $n" if $t =~ /^\Q$h\E\s*,\s+((?i:incluindo|including|inclusive|incluyendo))\b/;
    }
    if ( length($h) > 160 ) {
        my $cut = rindex( substr( $h, 0, 160 ), ' ' );
        $cut = 160 if $cut < 40;
        $n = substr( $h, $cut ) . ( $n ne '' ? ". $n" : '' );
        $h = substr( $h, 0, $cut ) . '…';
    }
    $h =~ s/[\s.,;:]+$//;
    $n =~ s/^[\s.,;:]+//;
    return ( $h, $n );
}

# ----------------------------------------------------------------------
# Hierarchy
# ----------------------------------------------------------------------

# Numbers above a schedule number, nearest first: 641.59 -> 641.5, 641,
# 640, 600. Table notation: T2-81 -> T2-8.
sub broader {
    my $n = shift // '';
    my @c;
    if ( $n =~ /^(T\d)-(\d+)$/ ) {
        my ( $t, $d ) = ( $1, $2 );
        push @c, "$t-" . substr( $d, 0, $_ ) for reverse 1 .. length($d) - 1;
        return @c;
    }
    my ( $i, $d ) = $n =~ /^(\d{3})(?:\.(\d+))?/ or return ();
    if ( defined $d ) {
        push @c, "$i." . substr( $d, 0, $_ ) for reverse 1 .. length($d) - 1;
        push @c, $i;
    }
    push @c, substr( $i, 0, 2 ) . '0' if substr( $i, 2, 1 ) ne '0';
    push @c, substr( $i, 0, 1 ) . '00' if substr( $i, 1, 2 ) ne '00';
    return @c;
}

# Digits of a schedule number without the point (641.59 -> 64159).
sub digits { my $n = shift // ''; $n =~ s/\D//g; return $n }

# Digits back to a number: a point after the third digit.
sub from_digits {
    my $d = shift // '';
    $d .= '0' x ( 3 - length $d ) if length $d < 3;
    return length $d > 3 ? substr( $d, 0, 3 ) . '.' . substr( $d, 3 ) : $d;
}

# ----------------------------------------------------------------------
# Reading the text of the CDD
# ----------------------------------------------------------------------

my $UP  = qr/[\p{Lu}]/;
my $DEC = qr/\.(?:\d{3}(?: \d{1,3})+|\d+)/;    # ".5", ".900 01" (DDC groups of three)
my $ABS = qr/\d{3}(?:$DEC)?/;

# parse(\@lines) -> { entries => { num => {...} }, terms => [ [num, term] ], meta => {...} }
sub parse {
    my ($lines) = @_;
    my ( %e, @terms, %meta );
    my $mode = 'intro';
    my ( $class, $base, $last, $cur, $term, $table ) = ( undef, undef, '', undef, undef, 0 );
    my ( $summary, $sum_last ) = ( 0, '' );
    my $order = 0;

    my $add = sub {
        my ( $num, $kind, $text, %o ) = @_;
        my $x = $e{$num};
        if ( !$x ) {
            $x = $e{$num} = { num => $num, kind => $kind, text => $text, order => ++$order, %o };
        } elsif ( length($text) > length( $x->{text} ) || $x->{kind} eq 'main' ) {
            @$x{ keys %o } = values %o;
            $x->{text} = $text;
            $x->{kind} = $kind;
        }
        return $x;
    };

    for my $raw (@$lines) {
        my $l = $raw // '';
        $l =~ s/[\x{00a0}\t\x{2002}-\x{200b}]/ /g;
        $l =~ s/\s+/ /g;
        $l =~ s/^ +| +$//g;
        next if $l eq '' || $l =~ /^\d{1,4}$/;    # blank lines, page numbers
        next if $l =~ /\.{6,}/;                   # table of contents
        my $n = norm($l);

        $meta{edition} //= $1 if $n =~ /^(\d{2}) ?(?:a )?(?:edicao|edition|edicion)\b/ || $n =~ /^(?:cdd|ddc) (\d{2})\b/;

        # Section headings.
        if ( $n =~ /tabela resumida|relative index|indice relativo/ && length($n) < 80 ) {
            ( $mode, $term, $cur ) = ( 'index', undef, undef );
            next;
        }
        if ( $l =~ /^(?:Tabela|Table|Tabla) ([1-6])\. ($UP.*)$/ ) {
            ( $mode, $table, $cur, $summary ) = ( 'table', $1, undef, 0 );
            ( $meta{"t$1"} //= $2 ) =~ s/\s*\(.*$//;
            next;
        }
        if ( $n =~ /^(?:classe|class|clase) (\d)00\b/ && length($n) < 80 ) {
            ( $mode, $class, $base, $last, $cur, $summary ) = ( 'schedule', $1, undef, '', undef, 0 );
            next;
        }
        # The heading of the schedules on each page ends the entry before it.
        if ( $mode ne 'intro' && $mode ne 'index' && $l =~ /^(?:CDD|DDC)\s*[–—-]\s*CLASSIFICA/i ) {
            undef $cur;
            next;
        }
        if ( $n =~ /^(?:resumo|summary|resumen|sumario)$/ ) {
            if ( $mode eq 'schedule' || $mode eq 'table' ) {
                ( $summary, $sum_last, $cur ) = ( 1, '', undef );
            }
            next;
        }

        # Main classes ("CDD 23 – Resumo das Classes Básicas": "800 Literatura").
        if ( $mode eq 'intro' && $l =~ /^(\d)00 ($UP.*)$/ ) {
            $add->( "${1}00", 'main', $2 );
            next;
        }

        # The alphabetical list: "869.3 - POESIA BRASILEIRA", a few written
        # the other way round, and captions wrapped on the next line.
        if ( $mode eq 'intro' || $mode eq 'index' ) {
            my ( $num, $t );
            if ( $l =~ /^(\d{3}(?:[.,]\d+)?) ?[-–—] ?(\S.*)$/ || $l =~ /^(\d{3}(?:[.,]\d+)?)\t(\S.*)$/ ) {
                ( $num, $t ) = ( $1, $2 );
            } elsif ( $l =~ /^(\S.*?) [-–—] (\d{3}(?:[.,]\d+)?)$/ ) {
                ( $num, $t ) = ( $2, $1 );
            }
            if ( defined $num ) {
                $mode = 'index';
                $num =~ tr/,/./;
                $term = [ $num, $t ];
                push @terms, $term;
            } elsif ( $mode eq 'index' && $term && $l !~ /\p{Ll}/ ) {
                $term->[1] .= ' ' . $l;
            }
            next;
        }

        if ( $mode eq 'table' ) {
            if ( $l =~ /^>? ?(?:T[1-6] ?)?[—–] ?([\[(]?) ?(\d[\d ]*?)(?: ?[–—-]+ ?(?:T[1-6] ?)?[—–]? ?(\d[\d ]*?))? ?[\])]? ([\p{Lu}*\[(].*)$/ ) {
                my ( $br, $from, $to, $t ) = ( $1, $2, $3, $4 );
                s/ //g for grep { defined } $from, $to;
                my $num = "T$table-$from";
                $num .= "-$to" if defined $to && $to ne $from;
                $cur = $add->(
                    $num, 'table', $t,
                    tbl       => $table,
                    status    => $br eq '[' ? 'bracket' : $br eq '(' ? 'option' : '',
                    range_end => defined $to ? "T$table-$to" : undef
                );
            } elsif ($cur) {
                $cur->{text} .= ' ' . $l;
            }
            next;
        }

        next unless $mode eq 'schedule';

        # A new entry: "641.5 Caption", ".59 Caption" (under the last
        # three-digit number), "1 Caption" (a PDF that lost the point) and
        # ranges "641.593–.599"; brackets, parentheses, "*" and ">" marks.
        my ( $mark, $from, $to, $t, $rel );
        if ( $l =~ /^(?:> ?)?\*? ?([\[(]?) ?($ABS)(?: ?[–—-] ?($ABS|$DEC))? ?[\])]? (.+)$/ ) {
            ( $mark, $from, $to, $t ) = ( $1, $2, $3, $4 );
        } elsif ( $l =~ /^(?:> ?)?\*? ?([\[(]?) ?($DEC)(?: ?[–—-] ?($DEC|$ABS))? ?[\])]? (.+)$/ ) {
            ( $mark, $from, $to, $t, $rel ) = ( $1, $2, $3, $4, 1 );
        } elsif ( $l =~ /^(\d{1,2}) ($UP\p{Ll}.*)$/ ) {
            ( $mark, $from, $to, $t, $rel ) = ( '', ".$1", undef, $2, 1 );
            # "69 Museologia" after 068: the next section, its first digit lost.
            if ( length $1 == 2 && defined $base && defined $class && "$class$1" == $base + 1 ) {
                ( $from, $rel ) = ( "$class$1", 0 );
            }
        }
        if ( defined $from && $t =~ /^(?:\*|[\[(]?$UP|\d{4}\b)/ ) {
            for ( grep { defined } $from, $to ) { s/ //g }
            # Numbers from the point on belong to the last three-digit number
            # before the summary (the summaries do not change it).
            my $num = $rel ? ( defined $base ? substr( $base, 0, 3 ) . $from : undef ) : $from;
            # The summary ends where the numbers start again from the top.
            $summary = 0 if $summary && defined $num && $num le $sum_last;
            # A three-digit number may come out of order (a centred entry printed
            # before its members). The running head of a page ("791 Artes
            # recreativas 791") only says which section goes on.
            $t =~ s/ \Q$from\E\.?$// if !$rel;
            if ( defined $num && ( !defined $class || substr( $num, 0, 1 ) eq $class ) && ( $summary || $num ge $last || !$rel ) ) {
                my $end;
                if ( defined $to ) {
                    $end = $to =~ /^\./ ? substr( $num, 0, 3 ) . $to : $to;
                }
                my $key = defined $end && $end ne $num ? "$num-$end" : $num;
                $cur = $add->(
                    $key, 'schedule', $t,
                    status    => $mark eq '[' ? 'bracket' : $mark eq '(' ? 'option' : '',
                    range_end => $end
                );
                if ($summary) {
                    $sum_last = $num;
                } elsif ( $num lt $last && substr( $num, 0, 3 ) eq substr( $last, 0, 3 ) ) {
                    # Back to the number of the section being read: the
                    # heading repeated on a new page; the order goes on.
                } else {
                    $last = $num;
                    $base = substr( $num, 0, 3 ) unless $rel;
                }
                next;
            }
        }
        $cur->{text} .= ' ' . $l if $cur;
    }

    return { entries => \%e, terms => \@terms, meta => \%meta };
}

# The text of a file: UTF-8, or Windows-1252 when it is not valid UTF-8.
sub read_text {
    my ($path) = @_;
    open my $fh, '<:raw', $path or die "cannot read $path: $!\n";
    my $raw = do { local $/; <$fh> };
    close $fh;
    $raw =~ s/^\xEF\xBB\xBF//;
    my $text = eval { decode( 'UTF-8', $raw, Encode::FB_CROAK ) };
    $text = decode( 'cp1252', $raw ) unless defined $text;
    return $text;
}

# ----------------------------------------------------------------------
# The index
# ----------------------------------------------------------------------

sub connect_db {
    my ( $path, $write ) = @_;
    my %o = ( RaiseError => 1, PrintError => 0, AutoCommit => 1, sqlite_unicode => 1 );
    $o{sqlite_open_flags} = DBD::SQLite::OPEN_READONLY() if !$write && eval { require DBD::SQLite; 1 };
    return DBI->connect( "dbi:SQLite:dbname=$path", '', '', \%o );
}

# build(TEXT_FILE, DB_FILE, NAME) -> { entries, schedule, tables, terms, edition }
# The index is written next to DB_FILE and renamed over it at the end.
sub build {
    my ( $in, $out, $name ) = @_;
    my $p = parse( [ split /\r\n|\r|\n|\f/, read_text($in) ] );
    my $e = $p->{entries};

    my $tmp = "$out.new";
    unlink $tmp;
    my $dbh = connect_db( $tmp, 1 );
    $dbh->do($_) for (
        'CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)',
        'CREATE TABLE entries (num TEXT PRIMARY KEY, kind TEXT, tbl INTEGER, heading TEXT, notes TEXT, status TEXT, range_end TEXT, parent TEXT, sortkey TEXT, hnorm TEXT, norm TEXT)',
        'CREATE TABLE terms (id INTEGER PRIMARY KEY, num TEXT, term TEXT, norm TEXT)',
    );
    $dbh->begin_work;
    my $ins = $dbh->prepare('INSERT INTO entries VALUES (?,?,?,?,?,?,?,?,?,?,?)');
    my %n = ( entries => 0, schedule => 0, tables => 0, terms => 0 );
    for my $num ( sort keys %$e ) {
        my $x = $e->{$num};
        my ( $h, $notes ) = split_text( $x->{text} );
        next if $h eq '';
        my ($start) = $num =~ /^(T\d-\d+|\d{3}(?:\.\d+)?)/;
        my $parent = '';
        for my $b ( broader($start) ) {
            if ( $e->{$b} ) { $parent = $b; last }
        }
        $ins->execute( $num, $x->{kind}, $x->{tbl}, $h, $notes, $x->{status} // '', $x->{range_end}, $parent, $start . ( $num eq $start ? '' : '~' ), norm($h), norm("$h $notes") );
        $n{entries}++;
        $n{ $x->{kind} eq 'table' ? 'tables' : 'schedule' }++;
    }
    my $tins = $dbh->prepare('INSERT INTO terms (num, term, norm) VALUES (?,?,?)');
    my %seen;
    for my $t ( @{ $p->{terms} } ) {
        my ( $num, $term ) = @$t;
        next unless $num =~ /^\d{3}(?:\.\d+)?$/;
        $term =~ s/\s+/ /g;
        $term =~ s/^\s+|\s+$//g;
        next if $term eq '' || $seen{"$num\t$term"}++;
        $tins->execute( $num, $term, norm($term) );
        $n{terms}++;
    }
    my %meta = ( %{ $p->{meta} }, schema => $SCHEMA, name => $name // '', built => POSIX::strftime( '%Y-%m-%d %H:%M', localtime ), edition => $p->{meta}{edition} // '', %n );
    $dbh->do( 'INSERT INTO meta VALUES (?,?)', undef, $_, $meta{$_} ) for sort keys %meta;
    $dbh->do('CREATE INDEX entries_parent ON entries (parent)');
    $dbh->do('CREATE INDEX terms_num ON terms (num)');
    $dbh->commit;
    $dbh->disconnect;
    rename $tmp, $out or die "cannot write $out: $!\n";
    return \%meta;
}

# For the panel (run with koha_exec): KohaEasy::CDD::build_cli(TXT, DB, NAME)
sub build_cli {
    binmode STDOUT, ':encoding(UTF-8)';
    my $m = build(@_);
    print "$_=$m->{$_}\n" for qw( entries schedule tables terms edition );
    return 1;
}

sub meta {
    my ($dbh) = @_;
    return { map { $_->[0] => $_->[1] } @{ $dbh->selectall_arrayref('SELECT k, v FROM meta') } };
}

my $COLS = 'num, kind, tbl, heading, notes, status, range_end, parent, sortkey';

sub entry {
    my ( $dbh, $num ) = @_;
    return $dbh->selectrow_hashref( "SELECT $COLS FROM entries WHERE num = ?", undef, $num );
}

sub children {
    my ( $dbh, $num ) = @_;
    return $dbh->selectall_arrayref( "SELECT $COLS FROM entries WHERE parent = ? ORDER BY sortkey", { Slice => {} }, $num );
}

# The ten main classes (or the top entries of a table: "T1").
sub roots {
    my ( $dbh, $table ) = @_;
    return $dbh->selectall_arrayref( "SELECT $COLS FROM entries WHERE tbl = ? AND parent = '' ORDER BY sortkey", { Slice => {} }, $table ) if $table;
    return $dbh->selectall_arrayref( "SELECT $COLS FROM entries WHERE kind <> 'table' AND parent = '' ORDER BY sortkey", { Slice => {} } );
}

# The entries above a number, from the main class down.
sub ancestors {
    my ( $dbh, $num ) = @_;
    my ($start) = $num =~ /^(T\d-\d+|\d{3}(?:\.\d+)?)/ or return [];
    my @up;
    my %seen;
    my $x = entry( $dbh, $num );
    my @c = $x ? () : broader($start);
    my $p = $x ? $x->{parent} : undef;
    while (1) {
        my $y;
        if ( defined $p ) {
            last if $p eq '' || $seen{$p}++;
            $y = entry( $dbh, $p );
        } else {
            while ( @c && !$y ) { $y = entry( $dbh, shift @c ) }
        }
        last unless $y;
        unshift @up, $y;
        $p = $y->{parent};
    }
    return \@up;
}

# Ranges that hold a number ("641.593–641.599" holds 641.5972, "T1—093-099"
# holds T1—0981).
sub ranges_with {
    my ( $dbh, $num ) = @_;
    my ( $t, $n ) = $num =~ /^(T\d-)?(\d[\d.]*)$/ or return [];
    my $like = defined $t ? "$t%" : substr( $n, 0, 3 ) . '%';
    my $dig = sub { ( my $x = shift ) =~ s/^T\d-//; return digits($x) };
    my $r = $dbh->selectall_arrayref( "SELECT $COLS FROM entries WHERE range_end IS NOT NULL AND num LIKE ? ORDER BY sortkey", { Slice => {} }, $like );
    return [ grep {
        my ( $a, $b ) = ( $dig->( $_->{sortkey} =~ s/~$//r ), $dig->( $_->{range_end} ) );
        my $w = length $b;
        my $d = substr( $dig->($num), 0, $w );
        length($d) == $w && $d ge substr( $a . '0' x $w, 0, $w ) && $d le $b;
    } @$r ];
}

sub terms_of {
    my ( $dbh, $num ) = @_;
    return $dbh->selectcol_arrayref( 'SELECT term FROM terms WHERE num = ? ORDER BY term', undef, $num );
}

# Subjects of the alphabetical list under a number (869 -> 869.3 POESIA...).
sub terms_below {
    my ( $dbh, $num, $limit ) = @_;
    return $dbh->selectall_arrayref( 'SELECT num, term FROM terms WHERE num LIKE ? AND num <> ? ORDER BY num, term LIMIT ?', { Slice => {} }, "$num%", $num, $limit || 60 );
}

# How a number not printed in the schedules was probably built: the
# longest number of the schedules (or of the list of subjects) it starts
# with, then Table 1 (standard subdivisions: terminal zeros of a class or
# division dropped first), Table 2 (areas, after —09 or added directly),
# Table 3 (literary forms, 810-899) or Table 4 (languages, 420-499). Only a
# hint: the notes of the schedules decide.
sub analyse {
    my ( $dbh, $num ) = @_;
    return [] unless $num =~ /^\d{3}(?:\.\d+)?$/;
    my $d = digits($num);
    my @try;
    for my $len ( reverse 3 .. length($d) - 1 ) {
        my $rest = substr( $d, $len );
        # 510 + 05 = 510.5: the zeros of 510 were dropped before adding.
        if ( $len == 3 && $rest !~ /^0/ && ( my $short = substr( $d, 0, 3 ) ) =~ s/0+$// ) {
            $rest = substr( $d, length $short ) if substr( $d, length $short, 1 ) eq '0';
        }
        push @try, [ from_digits( substr( $d, 0, $len ) ), $rest ];
    }
    # 603 = 600 + 03, 520.3 = 520 + 03 (a class or a division plus Table 1).
    for my $k ( 2, 1 ) {
        push @try, [ from_digits( substr( $d, 0, $k ) ), substr( $d, $k ) ] if substr( $d, $k, 1 ) eq '0';
    }
    for my $t (@try) {
        my ( $bn, $rest ) = @$t;
        next if $bn eq $num || $rest eq '';
        my $b = entry( $dbh, $bn );
        if ( !$b ) {
            # A number of the list of subjects can be the base too.
            my $terms = terms_of( $dbh, $bn );
            $b = { num => $bn, heading => $terms->[0], kind => 'index' } if @$terms;
        }
        next if !$b || $b->{kind} eq 'table';
        my @steps = ( { num => $b->{num}, heading => $b->{heading}, add => '' } );
        my $from = sub {
            my ( $tbl, $r ) = @_;
            for my $l ( reverse 1 .. length $r ) {
                my $x = entry( $dbh, "T$tbl-" . substr( $r, 0, $l ) ) or next;
                push @steps, { num => $x->{num}, heading => $x->{heading}, add => substr( $r, 0, $l ) };
                return substr( $r, $l );
            }
            return $r;
        };
        my $i = substr( $d, 0, 3 );
        if ( $rest =~ /^09([1-9]\d*)$/ ) {
            my $x = entry( $dbh, 'T1-09' );
            push @steps, { num => 'T1-09', heading => $x ? $x->{heading} : '', add => '09' };
            $rest = $from->( 2, $1 );
        } elsif ( $rest =~ /^0/ ) {
            $rest = $from->( 1, $rest );
        } elsif ( $i ge '810' && $i le '899' ) {
            $rest = $from->( 3, $rest );    # literature: forms of Table 3
        } elsif ( $i ge '420' && $i le '499' ) {
            $rest = $from->( 4, $rest );    # languages: Table 4
        } else {
            $rest = $from->( 2, $rest );    # areas added directly
        }
        push @steps, { num => '', heading => '', add => $rest } if $rest ne '';
        return \@steps;
    }
    return [];
}

# ----------------------------------------------------------------------
# Search
# ----------------------------------------------------------------------

sub _like { my $t = shift; $t =~ s/([%_\\])/\\$1/g; return "%$t%" }

sub _word { my ( $hay, $t ) = @_; return " $hay " =~ /\Q $t\E/ ? 1 : 0 }

# The sentence of the notes that holds a word of the search.
sub snippet {
    my ( $notes, @tok ) = @_;
    return '' unless defined $notes && $notes ne '';
    for my $s ( split /(?<=[.;])\s+/, $notes ) {
        my $n = norm($s);
        next unless grep { index( $n, $_ ) >= 0 } @tok;
        return length($s) > 240 ? substr( $s, 0, 237 ) . '…' : $s;
    }
    return '';
}

# search(DBH, QUERY, LIMIT) -> [ { num, heading, kind, status, terms => [...], snippet, score } ]
# All the words must be found in one entry or one subject of the list; when
# nothing has them all, the entries with the most of them come first.
sub search {
    my ( $dbh, $q, $limit ) = @_;
    $limit ||= 40;
    my @tok = tokens($q);
    return [] unless @tok;
    my $full = norm($q);
    for my $mode ( 'AND', 'OR' ) {
        my $where = join " $mode ", map {"norm LIKE ? ESCAPE '\\'"} @tok;
        my @args = map { _like($_) } @tok;
        my %r;
        my $ent = $dbh->selectall_arrayref( "SELECT $COLS, hnorm, norm FROM entries WHERE $where LIMIT 4000", { Slice => {} }, @args );
        for my $x (@$ent) {
            my ( $s, $hits ) = ( 0, 0 );
            for my $t (@tok) {
                if ( index( $x->{hnorm}, $t ) >= 0 ) { $s += 10 + 4 * _word( $x->{hnorm}, $t ); $hits++ }
                elsif ( index( $x->{norm}, $t ) >= 0 ) { $s += 2 + _word( $x->{norm}, $t ); $hits++ }
            }
            $s += 25 if $x->{hnorm} eq $full;
            $s += $x->{kind} eq 'table' ? -3 : 3;
            $s -= 8 if $x->{status} eq 'bracket';
            $s -= length( $x->{num} ) * 0.2;
            my $y = $r{ $x->{num} } //= { %$x, score => 0, hits => 0, terms => [] };
            $y->{score} = $s if $s > $y->{score};
            $y->{hits}  = $hits if $hits > $y->{hits};
            $y->{snippet} = index( $x->{hnorm}, $tok[0] ) >= 0 && @tok == 1 ? '' : snippet( $x->{notes}, @tok );
        }
        my $ter = $dbh->selectall_arrayref( "SELECT num, term, norm FROM terms WHERE $where LIMIT 4000", { Slice => {} }, @args );
        for my $x (@$ter) {
            my ( $s, $hits ) = ( 0, 0 );
            for my $t (@tok) {
                next unless index( $x->{norm}, $t ) >= 0;
                $s += 9 + 3 * _word( $x->{norm}, $t );
                $hits++;
            }
            $s += 25 if $x->{norm} eq $full;
            my $y = $r{ $x->{num} } //= { num => $x->{num}, kind => 'index', status => '', heading => '', score => -1, hits => 0, terms => [] };
            push @{ $y->{terms} }, $x->{term} if @{ $y->{terms} } < 4;
            $y->{tscore} = $s if $s > ( $y->{tscore} // 0 );
            $y->{hits} = $hits if $hits > $y->{hits};
        }
        next if !%r && $mode eq 'AND';
        for my $y ( values %r ) {
            $y->{score} = 0 if $y->{score} < 0;
            $y->{score} += ( $y->{tscore} // 0 ) + 2 * ( @{ $y->{terms} } > 1 ? @{ $y->{terms} } - 1 : 0 );
            $y->{score} += 30 * $y->{hits};
        }
        my @r = sort { $b->{score} <=> $a->{score} || $a->{num} cmp $b->{num} } values %r;
        splice @r, $limit if @r > $limit;
        # Captions of the numbers found only in the list of subjects.
        for my $y ( grep { $_->{heading} eq '' } @r ) {
            my $x = entry( $dbh, $y->{num} );
            if ($x) {
                $y->{$_} = $x->{$_} for qw( heading kind status parent );
                $y->{snippet} = '';
            } else {
                $y->{heading} = $y->{terms}[0] // '';
                $y->{kind}    = 'index';
            }
        }
        return \@r;
    }
    return [];
}

1;
CDDPM
}

