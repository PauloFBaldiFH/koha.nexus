            if ev == "start" and el.tag == _q("table", "table"):
                sheet, rows = el.get(_q("table", "name")), []
            elif ev == "end" and el.tag == _q("table", "table-row"):
                row = []
                for cell in el:
                    if cell.tag not in (_q("table", "table-cell"), _q("table", "covered-table-cell")):
                        continue
