# Country menu: common calling codes, or any other code.
lt_msg_country() {
    local cc area
    cc=$(ui_menu "$(t "Phone numbers")" "$(t "Country of the numbers typed without a country code:")" \
        "55"  "Brasil" "351" "Portugal" "244" "Angola" "258" "Moçambique" "238" "Cabo Verde" \
        "54"  "Argentina" "595" "Paraguay" "598" "Uruguay" "56" "Chile" "57" "Colombia" \
        "52"  "México" "34" "España" "1" "USA / Canada" "other" "$(t "Other code")") || return 0
    if [ "$cc" = "other" ]; then
        cc=$(ui_input "$(t "Phone numbers")" "$(t "Country calling code (digits only):")" "") || return 0
    fi
    if ! [[ "$cc" =~ ^[1-9][0-9]{0,2}$ ]]; then
        msg_error "" "$(t "Invalid country code.\nNothing was changed.")" 9 70
        return 1
    fi
    area=$(ui_input "$(t "Phone numbers")" "$(t "Area code used when a number has none (in Brazil, the DDD, e.g. 44). Leave it empty to reject such numbers.")" "$(msg_conf area)") || return 0
    if [ -n "$area" ] && ! [[ "$area" =~ ^[0-9]{1,4}$ ]]; then
        msg_error "" "$(t "Invalid area code.\nNothing was changed.")" 9 70
        return 1
    fi
    if [ "$cc" = "55" ] && [ -n "$area" ] && ! phone_ddd_valid "$area"; then
        msg_error "" "$(t "This DDD does not exist in Brazil.\nNothing was changed.")" 9 70
        return 1
    fi
    msg_install_files && msg_conf_init && msg_conf_set country "$cc" area "$area" || return 1
    log "messaging: numbers +$cc area $area"
    msg_ok "$(t '✅ Numbers without a country code are read as +${cc} ${area}.')" 9 72
}

# Brazilian area codes (DDD) in use.
BR_DDD=" 11 12 13 14 15 16 17 18 19 21 22 24 27 28 31 32 33 34 35 37 38 41 42 43 44 45 46 47 48 49 51 53 54 55 61 62 63 64 65 66 67 68 69 71 73 74 75 77 79 81 82 83 84 85 86 87 88 89 91 92 93 94 95 96 97 98 99 "
phone_ddd_valid() { [[ "$1" =~ ^[0-9]{2}$ ]] && [[ "$BR_DDD" == *" $1 "* ]]; }

# phone_normalize NUMBER [COUNTRY] [AREA]: "E164<TAB>kind" (kind: ok, fixed,
# landline, invalid), with the rules of the Perl module used by Koha (run
# as the instance user, like the other Perl of the panel).
phone_normalize() {
    local lib log rc=0
    tools_workdir || return 1
    lib=$(msg_perl_lib) || return 1
    log="$TOOLS_WORK/phone.log"; : > "$log"
    cat > "$TOOLS_WORK/phone.pl" <<'PHONEPL'
use strict; use warnings; use KohaEasy::Messaging;
my ( $e, $k ) = KohaEasy::Messaging::normalize_phone(@ARGV);
printf "%s\t%s\n", $e // '', $k;
exit( $e ? 0 : 1 );
PHONEPL
    koha_exec "$log" phone /usr/bin/perl -I "$lib" "$TOOLS_WORK/phone.pl" "$1" "${2:-$(msg_conf country)}" "${3:-$(msg_conf area)}" || rc=$?
    if [ "$rc" -eq 2 ] && ! grep -q . <<< "$(tools_output "$log")"; then printf '\tinvalid\n'; return 1; fi
    tools_output "$log"
    return "$rc"
}

# Folder with KohaEasy/Messaging.pm for the Perl of the panel: the
# installed one, or a copy in the work folder (made by the caller).
msg_perl_lib() {
    if msg_installed; then printf '%s' "$KEI_PERL_DIR"; return 0; fi
    [ -d "$TOOLS_WORK" ] || return 1
    mkdir -p "$TOOLS_WORK/perl/KohaEasy" && msg_pm_messaging > "$TOOLS_WORK/perl/KohaEasy/Messaging.pm" || return 1
    chmod -R a+rX "$TOOLS_WORK/perl"
    printf '%s' "$TOOLS_WORK/perl"
}

lt_msg_test() {
    local to log text
    if ! msg_installed || { [ "$(msg_conf whatsapp)" != "on" ] && [ "$(msg_conf telegram)" != "on" ]; }; then
        msg_info "$(t "Send a test message")" "$(t "Turn on WhatsApp or Telegram first.")" 9 60
        return 0
    fi
    to=$(ui_input "$(t "Send a test message")" "$(t "Phone number (as registered in Koha):")" "") || return 0
    if ! phone_normalize "$to" >/dev/null; then
        msg_error "" "$(t "Invalid phone number.\nNothing was sent.")" 9 60
        return 1
    fi
    tools_workdir || return 1
    log=$(tools_log messaging-test)
    text="$(t "Test message from the library system (Koha). If you received it, the notices will arrive here.")"
    printf '%s' "$text" > "$TOOLS_WORK/msg-test.txt"
    cat > "$TOOLS_WORK/msg-test.pl" <<'MSGTEST'
use strict; use warnings; use SMS::Send; use KohaEasy::Messaging;
my ( $to, $file ) = @ARGV;
open( my $fh, '<', $file ) or die "cannot read $file\n";
my $text = do { local $/; <$fh> };
close $fh;
my $ok = eval { SMS::Send->new('KohaEasy::Gateway')->send_sms( to => $to, text => $text ) };
if ($ok) { print "Sent: yes\nChannel: $KohaEasy::Messaging::LAST_CHANNEL\n"; exit 0 }
my $e = $@ || 'failed'; $e =~ s/ at \S+ line \d+.*//s;
print "Sent: no\nReason: $e\n"; exit 1;
MSGTEST
    chmod 644 "$TOOLS_WORK/msg-test.pl" "$TOOLS_WORK/msg-test.txt"
    chown "${INSTANCE}-koha:" "$TOOLS_WORK/msg-test.txt" 2>/dev/null || true
    display_explanation "Sending..."
    if msg_perl "$log" messaging-test "$TOOLS_WORK/msg-test.pl" "$to" "$TOOLS_WORK/msg-test.txt"; then
        local channel
        channel=$(tools_output "$log" | sed -n 's/^Channel: //p')
        log "messaging: test message sent ($channel)"
        msg_ok "$(t '✅ Test message sent through ${channel}.')" 9 70
    else
        ui_textbox "$(t "Send a test message")" "$log"
        msg_error "" "$(t 'The message was not sent. The reason is in the log:\n${log}')" 10 74
    fi
}

lt_msg_notices() {
    local prev
    if msg_notices_on; then
        prev=$(awk -F= '$1 == "prev_driver" { v = substr($0, index($0, "=") + 1) } END { printf "%s", v }' "$MSG_STATE" 2>/dev/null)
        [ "$prev" = "$MSG_DRIVER" ] && prev=""
        local shown="${prev:-—}"
        prompt_yes_no "$(t "Koha notices")" "$(t 'Stop sending the Koha notices through WhatsApp and Telegram? SMSSendDriver goes back to its previous value (${shown}). A verified backup is made first.')" 11 74 defaultno || return 0
        tools_locked _lt_msg_notices_set "$prev" off
        return
    fi
    if ! msg_installed || { [ "$(msg_conf whatsapp)" != "on" ] && [ "$(msg_conf telegram)" != "on" ]; }; then
        msg_info "$(t "Koha notices")" "$(t "Turn on WhatsApp or Telegram first.")" 9 60
        return 0
    fi
    prev=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'SMSSendDriver';")
    local shown="${prev:-—}"
    prompt_yes_no "$(t "Koha notices")" "$(t 'Send the Koha notices of the SMS type through WhatsApp and Telegram? The system preference SMSSendDriver changes from ${shown} to KohaEasy::Gateway (the previous value is kept to be restored). A verified backup is made first.')" 13 76 defaultno || return 0
