_lt_msg_notices_set() {
    local value="$1" mode="$2" prev="${3:-}" log rc=0
    log=$(tools_log messaging-notices)
    tools_safety_backup MESSAGING || return 1
    [ "$mode" = "on" ] && { printf 'prev_driver=%s\n' "$prev" > "$MSG_STATE"; chmod 600 "$MSG_STATE"; }
    koha_tool "$log" koha-preferences set SMSSendDriver "$value" || rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
        ui_textbox "$(t "Koha notices")" "$log"
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    [ "$mode" = "off" ] && rm -f "$MSG_STATE"
    msg_cron_write
    log "messaging: Koha notices $mode (SMSSendDriver=$value)"
    if [ "$mode" = "on" ]; then
        msg_ok "$(t '✅ The Koha notices of the SMS type now go through WhatsApp and Telegram (queue sent every two minutes).\n\nSee What Koha needs to send the notices.\nSafety backup: ${TOOLS_PRE}')" 13 76
    else
        msg_ok "$(t '✅ The Koha notices are no longer sent through WhatsApp and Telegram.\n\nSafety backup: ${TOOLS_PRE}')" 11 72
    fi
}

# Short SMS versions of the circulation notices, in the panel language.
# {library}, {title}, {name}, {items} become Koha template tags.
msg_letter_content() {
    local s
    case "$1" in
        CHECKOUT) s="$(t "{library}: you borrowed {title}. Thank you for your visit!")" ;;
        CHECKIN)  s="$(t "{library}: {title} was returned. Thank you!")" ;;
        ODUE)     s="$(t "{name}, these items are overdue at {library}: {items}Please return or renew them.")" ;;
        PREDUE)   s="$(t "{name}, {title} is due soon. {library}")" ;;
        DUE)      s="$(t "{name}, {title} is due today. {library}")" ;;
        HOLD)     s="$(t "{name}, your hold {title} is waiting for you at {library}.")" ;;
    esac
    local nl=$'\n' lib="[% branch.branchname %]" name="[% borrower.firstname %]" title="[% biblio.title %]" items
    items="${nl}[% FOREACH overdue IN overdues %]- [% overdue.item.biblio.title %] ([% overdue.date_due | \$KohaDates %])${nl}[% END %]"
    s="${s//\{library\}/$lib}"
    s="${s//\{name\}/$name}"
    s="${s//\{title\}/$title}"
    s="${s//\{items\}/$items}"
    [ "$1" = "ODUE" ] && s="[%- USE KohaDates -%]${s}"
    printf '%s' "$s"
}
MSG_LETTERS="CHECKOUT:circulation CHECKIN:circulation ODUE:circulation PREDUE:circulation DUE:circulation HOLD:reserves"

lt_msg_check() {
    local report missing=() code module n pref v
    tools_workdir || return 1
    report="$TOOLS_WORK/messaging-check.txt"
    {
        printf '%s\n\n' "$(t "What Koha needs to send the notices through WhatsApp and Telegram:")"
        v=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'SMSSendDriver';")
        printf '  %s SMSSendDriver = %s\n' "$([ "$v" = "$MSG_DRIVER" ] && echo "✅" || echo "⬜")" "${v:-—}"
        for pref in EnhancedMessagingPreferences EnhancedMessagingPreferencesOPAC; do
            v=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = '${pref}';")
            [ -n "$v" ] && printf '  %s %s = %s\n' "$([ "$v" = "1" ] && echo "✅" || echo "⬜")" "$pref" "$v"
        done
        printf '\n%s\n' "$(t "Notices with an SMS version (used for WhatsApp and Telegram):")"
        for code in $MSG_LETTERS; do
            module="${code#*:}"; code="${code%%:*}"
            n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.letter WHERE module = '${module}' AND code = '${code}' AND message_transport_type = 'sms';")
            printf '  %s %s\n' "$([ "${n:-0}" -gt 0 ] 2>/dev/null && echo "✅" || echo "⬜")" "$code"
        done
        n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.overduerules_transport_types WHERE message_transport_type = 'sms';")
        printf '\n  %s %s: %s\n' "$([ "${n:-0}" -gt 0 ] 2>/dev/null && echo "✅" || echo "⬜")" "$(t "Overdue rules with SMS (Tools > Overdue notice/status triggers)")" "${n:-0}"
        n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE smsalertnumber IS NOT NULL AND smsalertnumber <> '';")
        printf '  %s: %s\n' "$(t "Patrons with an SMS number")" "${n:-0}"
        n=$(run_sql "SELECT COUNT(DISTINCT p.borrowernumber) FROM ${DB_NAME}.borrower_message_preferences p JOIN ${DB_NAME}.borrower_message_transport_preferences t ON t.borrower_message_preference_id = p.borrower_message_preference_id WHERE t.message_transport_type = 'sms' AND p.borrowernumber IS NOT NULL;")
        printf '  %s: %s\n' "$(t "Patrons who chose SMS in their messaging preferences")" "${n:-0}"
        printf '\n%s\n' "$(t "Checkout and check-in notices follow the messaging preferences of each patron (default: Administration > Patron categories). Overdue notices follow the overdue rules.")"
    } > "$report"
    ui_textbox "$(t "What Koha needs to send the notices")" "$report"
    for code in $MSG_LETTERS; do
        module="${code#*:}"; code="${code%%:*}"
        n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.letter WHERE module = '${module}' AND code = '${code}' AND message_transport_type = 'sms';")
        [ "${n:-1}" = "0" ] && missing+=("$code")
    done
    [ ${#missing[@]} -eq 0 ] && return 0
    local codes="${missing[*]}"
    prompt_yes_no "$(t "Koha notices")" "$(t 'Create short SMS versions (for WhatsApp and Telegram) of the notices that have none: ${codes}? They can be edited later in Tools > Notices and slips. A verified backup is made first.')" 12 76 defaultno || return 0
    tools_locked _lt_msg_letters "${missing[@]}"
}

_lt_msg_letters() {
    local log sql code module added
    log=$(tools_log messaging-notices)
    sql="$TOOLS_WORK/letters.sql"
    {
        printf 'START TRANSACTION;\n'
        for code in "$@"; do
            module=$(printf '%s\n' $MSG_LETTERS | awk -F: -v c="$code" '$1 == c { print $2 }')
            [ -n "$module" ] || continue
            printf "INSERT INTO letter (module, code, branchcode, name, is_html, title, content, message_transport_type, lang) SELECT '%s', '%s', '', COALESCE((SELECT l.name FROM letter l WHERE l.module = '%s' AND l.code = '%s' AND l.branchcode = '' LIMIT 1), '%s'), 0, %s, %s, 'sms', 'default' FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM letter WHERE module = '%s' AND code = '%s' AND branchcode = '' AND message_transport_type = 'sms' AND lang = 'default');\n" \
                "$module" "$code" "$module" "$code" "$code" "$(sql_quote "$code")" "$(sql_quote "$(msg_letter_content "$code")")" "$module" "$code"
        done
        printf 'COMMIT;\n'
    } > "$sql"
    cat "$sql" >> "$log"
    tools_safety_backup NOTICES || return 1
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    added=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.letter WHERE message_transport_type = 'sms' AND lang = 'default' AND branchcode = '' AND code IN ($(printf "'%s'," "$@" | sed 's/,$//'));")
    log "messaging: SMS notices created ($*)"
    msg_ok "$(t '✅ SMS notices ready: ${added}\n\nIn Koha: Tools > Notices and slips.\nSafety backup: ${TOOLS_PRE}')" 11 72
}

# Patrons' SMS numbers checked with the same rules as the driver (read-only
# report; the corrected numbers can then be written, with a backup).
lt_msg_phones() {
    local lib data out log fixed
    tools_workdir || return 1
    lib=$(msg_perl_lib) || return 1
    data="$TOOLS_WORK/phones.tsv"; out="$TOOLS_WORK/phones-report.txt"; log=$(tools_log messaging-phones)
    run_sql "SELECT borrowernumber, cardnumber, smsalertnumber FROM ${DB_NAME}.borrowers WHERE smsalertnumber IS NOT NULL AND smsalertnumber <> '';" > "$data"
    printf '%s\n' "$(t "SMS numbers of the patrons (country and area code from the messaging settings):")" "$(t "Complete and correct")" \
        "$(t "Can be corrected")" "$(t "Landlines (WhatsApp only if the number has it)")" "$(t "Invalid (fix them by hand)")" > "$TOOLS_WORK/phones-labels.txt"
    cat > "$TOOLS_WORK/phones.pl" <<'PHONESPL'
use strict; use warnings; use KohaEasy::Messaging;
# phones.pl DATA SQL REPORT LABELS COUNTRY AREA: the patrons' SMS numbers
# checked with the rules of the driver; corrections go to SQL.
my ( $data, $sql, $report, $labels, $cc, $area ) = @ARGV;
open( my $l, '<:encoding(UTF-8)', $labels ) or die "$labels: $!\n";
chomp( my @l = <$l> );
close $l;
my %n = ( ok => 0, fixed => 0, landline => 0, invalid => 0 );
my @lines;
open( my $in, '<:encoding(UTF-8)', $data ) or die "$data: $!\n";
open( my $s, '>', $sql ) or die "$sql: $!\n";
print {$s} "START TRANSACTION;\n";
while ( my $row = <$in> ) {
    chomp $row;
    my ( $bn, $card, $num ) = split /\t/, $row, 3;
    next unless defined $bn && $bn =~ /^\d+$/;
    my ( $e, $k ) = KohaEasy::Messaging::normalize_phone( $num, $cc, $area );
    $n{$k}++;
    if ( $k eq 'fixed' ) {
        push @lines, sprintf( "  %-16s %-22s -> %s", $card // '', $num, $e );
        print {$s} "UPDATE borrowers SET smsalertnumber = '$e' WHERE borrowernumber = $bn;\n";
    } elsif ( $k eq 'invalid' ) {
        push @lines, sprintf( "  %-16s %-22s -> ?", $card // '', $num );
    }
}
print {$s} "COMMIT;\n";
close $s;
open( my $r, '>:encoding(UTF-8)', $report ) or die "$report: $!\n";
printf {$r} "%s\n\n  %s: %d\n  %s: %d\n  %s: %d\n  %s: %d\n\n", $l[0], $l[1], $n{ok}, $l[2], $n{fixed}, $l[3], $n{landline}, $l[4], $n{invalid};
print {$r} "$_\n" for @lines[ 0 .. ( $#lines < 299 ? $#lines : 299 ) ];
close $r;
print "Fixed: $n{fixed}\n";
PHONESPL
    chmod 644 "$data" "$TOOLS_WORK/phones.pl" "$TOOLS_WORK/phones-labels.txt"
    if ! koha_exec "$log" phones /usr/bin/perl -I "$lib" "$TOOLS_WORK/phones.pl" "$data" "$TOOLS_WORK/phones.sql" "$out" \
            "$TOOLS_WORK/phones-labels.txt" "$(msg_conf country)" "$(msg_conf area)" || [ ! -s "$out" ]; then
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    fixed=$(tools_num "$log" "Fixed:")
    ui_textbox "$(t "Check the patrons' phone numbers")" "$out"
    [ "${fixed:-0}" -gt 0 ] 2>/dev/null || return 0
    prompt_yes_no "$(t "Check the patrons' phone numbers")" "$(t 'Write the ${fixed} corrected number(s) to the SMS number of the patrons (international format, e.g. +5544998765432)? A verified backup is made first.')" 11 74 defaultno || return 0
    tools_locked _lt_msg_phones_fix "$fixed"
}

_lt_msg_phones_fix() {
    local log
    log=$(tools_log messaging-phones)
    cat "$TOOLS_WORK/phones.sql" >> "$log"
    tools_safety_backup PHONES || return 1
    if ! koha_sql_run "$log" "$TOOLS_WORK/phones.sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    local fixed="$1"
    log "messaging: $fixed SMS number(s) corrected"
    msg_ok "$(t '✅ Numbers corrected: ${fixed}\n\nSafety backup: ${TOOLS_PRE}')" 10 70
}

