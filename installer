# The marked block of IntranetUserJS: the chat in the place of the news of
# the staff home page (on top of its first column when there is no news).
# The version in the address makes browsers fetch an updated widget.
aia_js_block() {
    local v="${PANEL_VERSION// /}"
    printf '%s\nvar KEI_AI_V = "%s";\n' "$AIA_JS_BEGIN" "${v//[^A-Za-z0-9.-]/}"
    cat <<'AIAJS'
$(document).ready(function () {
    // koha.nexus AI assistant (Library tools > AI assistant on the staff home page).
    if (!$("#main_intranet-main").length || $("#kei-ai").length) return;
    var box = $("<div id=\"kei-ai\"></div>"), news = $("#area-news");
    if (news.length) news.replaceWith(box);
    else {
        var col = $("#area-quote").parent();
        if (!col.length) col = $("#container-main .row").first().children("div").first();
        if (!col.length) return;
        col.prepend(box);
    }
    var url = "/cgi-bin/koha/tools/ai_assistant.pl?v=" + encodeURIComponent(KEI_AI_V) + "&op=";
    $("<link rel=\"stylesheet\">").attr("href", url + "css").appendTo("head");
    $.ajax({ url: url + "js", dataType: "script", cache: true });
});
AIAJS
    printf '%s\n' "$AIA_JS_END"
}

aia_js_sql() {   # aia_js_sql add|remove FILE: SQL that rewrites IntranetUserJS
    local cur new
    cur=$(mr_js_current)
    cur=$(printf '%s\n' "$cur" | awk -v b="$AIA_JS_BEGIN" -v e="$AIA_JS_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }')
    new="$cur"
    if [ "$1" = "add" ]; then new="${cur:+${cur}$'\n'}$(aia_js_block)"; fi
    printf "START TRANSACTION;\nUPDATE systempreferences SET value = %s WHERE variable = 'IntranetUserJS';\nCOMMIT;\n" "$(sql_quote "$new")" > "$2"
}

aia_installed() { [ -f "$AIA_FILE" ]; }
aia_js_on() { mr_js_current | grep -qxF "$AIA_JS_BEGIN"; }
aia_js_latest() {
    [ "$(mr_js_current | awk -v b="$AIA_JS_BEGIN" -v e="$AIA_JS_END" '$0 == b { on = 1 } on { print } $0 == e { on = 0 }')" = "$(aia_js_block)" ]
}
aia_cnf_value() { [ -r "$AIA_CNF" ] && sed -n "s/^$1=//p" "$AIA_CNF" | head -n1; }
aia_ro_exists() { [ "$(run_sql "SELECT COUNT(*) FROM mysql.user WHERE User = '${AIA_RO_USER}';")" -gt 0 ] 2>/dev/null; }

# aia_grants HOST < "table<TAB>column" lines: the GRANTs of the read-only
# account. A table with a password, secret or token column is granted
# column by column without it; the sensitive tables are left out.
aia_grants() {
    awk -F'\t' -v db="$DB_NAME" -v who="'${AIA_RO_USER}'@'$1'" -v skip=" ${AIA_SENSITIVE_TABLES} " -v hide="$AIA_SENSITIVE_COLUMN" '
        function flush() {
            if (tb == "" || index(skip, " " tb " ") || cols == "") return
            if (hidden) printf "GRANT SELECT (%s) ON `%s`.`%s` TO %s;\n", cols, db, tb, who
            else printf "GRANT SELECT ON `%s`.`%s` TO %s;\n", db, tb, who
        }
        $1 != tb { flush(); tb = $1; cols = ""; hidden = 0 }
        $1 !~ /^[A-Za-z0-9_]+$/ || $2 !~ /^[A-Za-z0-9_]+$/ { hidden = 1; next }
        tolower($2) ~ hide { hidden = 1; next }
        { cols = cols (cols == "" ? "" : ", ") "`" $2 "`" }
        END { flush() }'
}

# Creates (or refreshes, after a Koha update brought new tables) the
# read-only account and readonly.cnf. 0 = ready, 1 = MariaDB refused,
# 3 = the database is on another server (the account is made there by hand).
aia_ro_provision() {
    local log="$1" conn port host pass sql cnf
    conn=$(koha_conf_value hostname)
    port=$(koha_conf_value port)
    case "${conn:-localhost}" in
        localhost) host=localhost ;;
        127.0.0.1|::1) host="$conn" ;;
        *) return 3 ;;
    esac
    [[ "$port" =~ ^[0-9]+$ ]] || port=3306
    pass=$(aia_cnf_value password)
    [[ "$pass" =~ ^[A-Za-z0-9]{32,}$ ]] || pass=$(head -c 96 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40)
    sql="$TOOLS_WORK/aia-account.sql"
    ( umask 077
      {
        # Made again from nothing: no privilege of an older version is left.
        printf "DROP USER IF EXISTS '%s'@'%s';\nCREATE USER '%s'@'%s' IDENTIFIED BY '%s';\n" "$AIA_RO_USER" "$host" "$AIA_RO_USER" "$host" "$pass"
        run_sql "SELECT c.TABLE_NAME, c.COLUMN_NAME FROM information_schema.COLUMNS c WHERE c.TABLE_SCHEMA = '${DB_NAME}' ORDER BY c.TABLE_NAME, c.ORDINAL_POSITION;" | aia_grants "$host"
        printf "FLUSH PRIVILEGES;\n"
      } > "$sql" )
    printf '$ mysql < aia-account.sql (%s GRANTs)\n' "$(grep -c '^GRANT' "$sql")" >> "$log"
    # Through stdin: the password never shows up in "ps".
    if ! grep -q '^GRANT' "$sql" || ! mysql < "$sql" >> "$log" 2>&1; then
        rm -f "$sql"
        return 1
    fi
    rm -f "$sql"
    cnf="$TOOLS_WORK/readonly.cnf"
    ( umask 077
      printf '# koha-easy-installer: read-only database account of the AI assistant (SELECT only)\ndsn=dbi:mysql:database=%s;host=%s;port=%s\nuser=%s\npassword=%s\n' \
          "$DB_NAME" "$host" "$port" "$AIA_RO_USER" "$pass" > "$cnf" )
    install -o root -g "${INSTANCE}-koha" -m 640 "$cnf" "${AIA_CNF}.new" && mv -f "${AIA_CNF}.new" "$AIA_CNF"
    local rc=$?
    rm -f "$cnf"
    return "$rc"
}

aia_ro_drop() {
    local h
    for h in localhost 127.0.0.1 ::1; do
        mysql -e "DROP USER IF EXISTS '${AIA_RO_USER}'@'${h}';" 2>/dev/null
    done
    rm -f "$AIA_CNF"
}

# The state of the assistant, for the menu.
aia_status() {
    local provider
    if aia_installed; then printf '%s: %s\n' "$(t "Page")" "$(t "installed")"; else printf '%s: %s\n' "$(t "Page")" "$(t "not installed")"; fi
    if aia_js_on; then printf '%s: %s\n' "$(t "Staff home page")" "$(t "the chat replaces the news block")"; else printf '%s: %s\n' "$(t "Staff home page")" "$(t "unchanged")"; fi
    if aia_ro_exists && [ -r "$AIA_CNF" ]; then printf '%s: %s\n' "$(t "Read-only database account")" "$AIA_RO_USER"; else printf '%s: %s\n' "$(t "Read-only database account")" "$(t "missing")"; fi
    provider=$(sed -n 's/^provider=//p' "${MR_DIR}/vision.conf" 2>/dev/null | head -n1)
    printf '%s: %s' "$(t "AI provider")" "${provider:-$(t "not set up (AI cataloguing > AI settings)")}"
}

function_ai_assistant() {
    require_database || return 0
    local opt
    while true; do
        opt=$(ui_menu "$(t "💬  AI assistant on the staff home page")" "$(t "A chat on the home page of the Koha staff interface, in the place of the news block. Librarians ask in plain language about books, patrons, loans, reports, settings and opening hours; the answers link to the records. It searches with Koha's own search engine and reads through a read-only database account, never with SQL written by the AI. A change it suggests (a hold, a patron's or a record's fields, a write-off) is an action proposal showing each field before and after: Koha makes it only after a click on Approve & Execute, with the librarian's own permissions.")"$'\n\n'"$(aia_status)" \
            "1" "$(t "Install or update the assistant")" \
            "2" "$(t "Remove the assistant")" \
            "3" "$(t "Changes confirmed in the assistant")") || return 0
        case "$opt" in
            1) lt_aia_install ;;
            2) lt_aia_remove ;;
            3) lt_aia_changes ;;
        esac
        clear
    done
}

lt_aia_install() {
    if [ ! -d "${KOHA_INTRA_CGI}/tools" ]; then
        msg_error "" "$(t "The staff interface folder of Koha was not found. Nothing was changed.")" 9 72
        return 1
    fi
    prompt_yes_no "$(t "AI assistant on the staff home page")" "$(t "Install the AI assistant on the home page of the staff interface? It takes the place of the news block there (news for the OPAC are not affected). A database account that can only read is created for it, and a marked block is added to the IntranetUserJS preference (removed with the assistant; a verified backup is made first).")" 14 76 || return 0
    tools_locked _lt_aia_install
}

_lt_aia_install() {
    local log new updating=0 rc
    log=$(tools_log ai-assistant)
    new="$TOOLS_WORK/ai_assistant.pl"
    mkdir -p "$TOOLS_WORK/lib/KohaEasy"
    aia_pm > "$TOOLS_WORK/lib/KohaEasy/Assistant.pm"
    ai_assistant_script > "$new"
    chmod 755 "$TOOLS_WORK/lib" "$TOOLS_WORK/lib/KohaEasy"
    chmod 644 "$new" "$TOOLS_WORK/lib/KohaEasy/Assistant.pm"
    display_explanation "Checking the page with the Perl modules of Koha..."
    if ! koha_exec "$log" perl-check /usr/bin/perl -c "$TOOLS_WORK/lib/KohaEasy/Assistant.pm" \
        || ! koha_exec "$log" perl-check /usr/bin/perl -I"$TOOLS_WORK/lib" -c "$new"; then
        ui_textbox "$(t "AI assistant on the staff home page")" "$log"
        msg_error "" "$(t 'The page does not compile with this version of Koha. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    aia_installed && updating=1
    mkdir -p "$AIA_DIR" && chown "${INSTANCE}-koha:${INSTANCE}-koha" "$AIA_DIR" 2>/dev/null
    chmod 750 "$AIA_DIR"
    display_explanation "Creating the read-only database account..."
    aia_ro_provision "$log"
    rc=$?
    if [ "$rc" = "3" ]; then
        msg_error "" "$(t "The Koha database is on another server, where the panel cannot create the read-only account of the assistant. Nothing was changed.")" 10 74
        return 1
    elif [ "$rc" != "0" ]; then
        msg_error "" "$(t 'The read-only database account could not be created. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    if ! aia_js_latest; then
        tools_safety_backup AI-ASSISTANT || return 1
        local sql="$TOOLS_WORK/intranetuserjs.sql"
        aia_js_sql add "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    { mkdir -p "$AIA_PM_DIR" \
        && install -o root -g root -m 644 "$TOOLS_WORK/lib/KohaEasy/Assistant.pm" "$AIA_PM_DIR/Assistant.pm.new" \
        && mv -f "$AIA_PM_DIR/Assistant.pm.new" "$AIA_PM_DIR/Assistant.pm" \
        && install -o root -g root -m 755 "$new" "${AIA_FILE}.new" && mv -f "${AIA_FILE}.new" "$AIA_FILE"; } || {
        msg_error "" "$(t "The page could not be installed. Nothing was changed.")" 8 64; return 1; }
    printf 'installed=%s\naccount=%s\n' "$(date +%F)" "$AIA_RO_USER" > "$AIA_STATE"
    # Plack keeps compiled pages and modules in memory: an update needs a restart.
    [ "$updating" = "1" ] && plack_restart
    log "ai_assistant: installed (account $AIA_RO_USER)"
    msg_ok "$(t '✅ The assistant is on the home page of the staff interface (reload the page).\n\nIt answers with the AI provider of AI cataloguing > AI settings.')" 11 76
}

# An assistant installed by an older panel: its page and module are brought
# up to this version when the panel starts (look and fixes of the chat), with
# no questions. Only when they differ, and only after they compile with this
# Koha. The IntranetUserJS block is left to "Install or update the
# assistant", which takes a verified backup first.
aia_refresh() {
    aia_installed || return 0
    local work log
    work=$(mktemp -d /tmp/koha_aia.XXXXXX) || return 0
    mkdir -p "$work/lib/KohaEasy"
    aia_pm > "$work/lib/KohaEasy/Assistant.pm"
    ai_assistant_script > "$work/ai_assistant.pl"
    if cmp -s "$work/ai_assistant.pl" "$AIA_FILE" && cmp -s "$work/lib/KohaEasy/Assistant.pm" "$AIA_PM_DIR/Assistant.pm"; then
        rm -rf "$work"
        return 0
    fi
    printf '%s\n' "$(t "Updating the AI assistant of the staff home page...")"
    chmod 755 "$work" "$work/lib" "$work/lib/KohaEasy"
    chmod 644 "$work/ai_assistant.pl" "$work/lib/KohaEasy/Assistant.pm"
    log=$(tools_log ai-assistant-refresh)
    if koha_exec "$log" perl-check /usr/bin/perl -c "$work/lib/KohaEasy/Assistant.pm" \
       && koha_exec "$log" perl-check /usr/bin/perl -I"$work/lib" -c "$work/ai_assistant.pl" \
       && install -o root -g root -m 644 "$work/lib/KohaEasy/Assistant.pm" "$AIA_PM_DIR/Assistant.pm.new" \
       && mv -f "$AIA_PM_DIR/Assistant.pm.new" "$AIA_PM_DIR/Assistant.pm" \
       && install -o root -g root -m 755 "$work/ai_assistant.pl" "${AIA_FILE}.new" \
       && mv -f "${AIA_FILE}.new" "$AIA_FILE"; then
        plack_restart
        log "ai_assistant: refreshed to panel ${PANEL_VERSION# }"
    else
        log "ai_assistant: refresh skipped (see $log)"
    fi
    rm -rf "$work"
    return 0
}

lt_aia_remove() {
    aia_installed || aia_js_on || aia_ro_exists || { msg_info "$(t "AI assistant on the staff home page")" "$(t "Not installed.")" 8 60; return 0; }
    prompt_yes_no "$(t "AI assistant on the staff home page")" "$(t 'Remove the assistant? The news block comes back to the staff home page, the read-only database account is deleted and the saved conversations are erased. The record of confirmed changes and their undo files stay in ${AIA_DIR}.')" 11 76 defaultno || return 0
    tools_locked _lt_aia_remove
}

_lt_aia_remove() {
    local log sql
    log=$(tools_log ai-assistant)
    if aia_js_on; then
        tools_safety_backup AI-ASSISTANT || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        aia_js_sql remove "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    aia_ro_drop
    rm -f "$AIA_FILE" "$AIA_STATE" "$AIA_PM_DIR/Assistant.pm"
    rm -rf "${AIA_DIR}/sessions"
    plack_restart
    log "ai_assistant: removed"
    msg_ok "$(t "✅ The assistant was removed.")"
}

