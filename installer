"""The bridge to the Perl readers that already decode the binary formats
(isis2koha.pl, bfdb2koha.pl, remap952.pl, written by the panel next to the
engine) and to yaz-marcdump. Each one runs as the Koha instance user, like
the engine itself; its report goes to the log and its counts to the
manifest, so the panel commits every stream the same way."""
import os
import re
import shutil
import subprocess

PERL = "/usr/bin/perl"


class ReaderError(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code


def run(cmd, log):
    """Runs a reader; its output goes to the engine's log (stdout). Returns
    (exit code, output text)."""
    shown = " ".join(os.path.basename(c) if i < 2 else c for i, c in enumerate(cmd))
    print("$ %s" % shown, file=log, flush=True)
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    except OSError as e:
        print("cannot run %s: %s" % (cmd[0], e), file=log, flush=True)
        return 127, str(e)
    text = p.stdout.decode("utf-8", "replace")
    log.write(text if text.endswith("\n") or not text else text + "\n")
    log.flush()
    return p.returncode, text


def count(text, label):
    m = None
    for m in re.finditer(r"(?m)^%s\s*(\d+)" % re.escape(label), text):
        pass
    return int(m.group(1)) if m else 0


def reader(readers, name):
    path = os.path.join(readers, name)
    if not os.path.exists(path):
        raise ReaderError(127, "reader %s missing" % name)
    return path


def isis(readers, src, out, opts, log):
    rc, text = run([PERL, reader(readers, "isis2koha.pl"), "--in", src, "--branch", opts.branch,
                    "--itype", opts.itype, "--marc", out], log)
    if rc in (4, 5):
        raise ReaderError(rc, "not an ISIS backup (PostgreSQL export) the panel can read")
    if rc != 0 or not os.path.exists(out):
        raise ReaderError(rc or 1, "the ISIS reader failed")
    return {"records": count(text, "Records:"), "items": count(text, "Items created:"), "report": text}


def biblioteca_facil(readers, src, out_dir, tag, opts, log):
    paths = {k: os.path.join(out_dir, "%s-%s" % (tag, k)) for k in ("koha.mrc", "patrons.csv", "circulation.sql", "circulation-check.sql")}
    cmd = [PERL, reader(readers, "bfdb2koha.pl"), "--in", src, "--branch", opts.branch, "--itype", opts.itype,
           "--marc", paths["koha.mrc"], "--patrons", paths["patrons.csv"],
           "--circ", paths["circulation.sql"], "--circ-check", paths["circulation-check.sql"]]
    if opts.itypes:
        cmd[6:6] = ["--itypes", opts.itypes]
    if opts.cpf_attr:
        cmd.append("--cpf-attr")
    if opts.today:
        cmd += ["--today", opts.today]
    rc, text = run(cmd, log)
    if rc in (4, 5):
        raise ReaderError(rc, "not a Biblioteca Fácil backup or data folder the panel can read")
    if rc != 0:
        raise ReaderError(rc, "the Biblioteca Fácil reader failed")
    return paths, {
        "records": count(text, "Records:"), "items": count(text, "Items created:"),
        "patrons": count(text, "Patrons ready:"), "open": count(text, "Open loans:"),
        "returned": count(text, "Returned loans:"), "holds": count(text, "Holds still valid:"), "report": text,
    }


def yaz_available(yaz="yaz-marcdump"):
    return shutil.which(yaz) is not None


def to_utf8_iso(src, src_format, encoding, out, log, yaz="yaz-marcdump"):
    """ISO 2709 in UTF-8 (leader/09 = a) from ISO 2709 or MARCXML, with
    yaz-marcdump (the toolkit Koha uses for Zebra)."""
    cmd = [yaz, "-i", "marcxml" if src_format == "MARCXML" else "marc", "-o", "marc"]
    if src_format != "MARCXML":
        cmd += ["-f", encoding]
    cmd += ["-t", "UTF-8", "-l", "9=97", src]
    print("$ %s" % " ".join(cmd[:-1] + [os.path.basename(src)]), file=log, flush=True)
    with open(out, "wb") as fh:
        p = subprocess.run(cmd, stdout=fh, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    err = p.stderr.decode("utf-8", "replace").strip()
    if err:
        print(err, file=log, flush=True)
    return p.returncode == 0 and os.path.getsize(out) > 0


def remap952(readers, src, out, tag, mapping, callnumber, opts, log, values=None):
    cmd = [PERL, reader(readers, "remap952.pl"), "--in", src, "--item-tag", tag, "--map", mapping,
           "--callnumber", callnumber, "--branch", opts.branch, "--itype", opts.itype, "--out", out]
    if values:
        cmd[-2:-2] = ["--values", values]
    rc, text = run(cmd, log)
    if rc != 0 or not os.path.exists(out) or os.path.getsize(out) == 0:
        raise ReaderError(rc or 1, "moving the items to 952 failed")
    return {"records": count(text, "Records read:"), "items": count(text, "Items created:"),
            "no_barcode": count(text, "Items without barcode:"), "kept_952": count(text, "Records that already had 952 (kept):"),
            "branch_field": count(text, "Items with their library from the field:"),
            "branch_unknown": count(text, "Libraries Koha does not have (your choice used):"),
            "itype_field": count(text, "Items with their item type from the field:"),
            "itype_unknown": count(text, "Item types Koha does not have (your choice used):"),
            "dropped": count(text, "Values left out (location, date, price or status Koha cannot take):")}
