        var w = window.opener, el = null;
        try { el = w && !w.closed ? w.document.getElementById(K.target) : null; } catch (e) { el = null; }
        if (!el) { copy(num, btn); alert(K.gone); return; }
        var v = el.value.replace(/^\\s+|\\s+\$/g, ""), m = v.match(/^\\S*\\d{3}(?:[.,]\\d+)?(\\s.*)?\$/);
        el.value = (!/^tag_08[23]_/.test(K.target) && m && m[1]) ? num + m[1] : num;
        var box = el.closest ? el.closest(".tag") : null;
        if (/^tag_08[23]_/.test(K.target) && box && K.edition) {
            var ed = box.querySelector("input[id^='" + K.target.slice(0, 7) + "_subfield_2']");
            if (ed && !ed.value) { ed.value = K.edition; }
        }
        try { el.dispatchEvent(new w.Event("change", { bubbles: true })); } catch (e) {}
        el.focus();
        window.close();
    }
    document.addEventListener("click", function (e) {
        var b = e.target.closest ? e.target.closest("button[data-num]") : null;
        if (!b) return;
        e.preventDefault();
        if (b.className.indexOf("apply") >= 0) apply(b.getAttribute("data-num"), b); else copy(b.getAttribute("data-num"), b);
    });
    // Build a number: the notation of the table goes after the number;
    // the final zeros of a class or division (800, 810) are dropped first
    // (510 + 05 = 510.5), and the point goes after the third digit.
    var box = document.querySelector(".build");
    if (box) {
        var base = box.getAttribute("data-base"), input = document.getElementById("kei-add"), out = document.getElementById("kei-built"),
            look = document.getElementById("kei-look"), acts = box.querySelectorAll("button[data-num]");
        input.addEventListener("input", function () {
            var add = input.value.replace(/[^0-9]/g, ""), d = base.replace(".", "");
            if (add && base.indexOf(".") < 0) { d = d.replace(/0+\$/, ""); }
            d = d + add;
            while (d.length < 3) d += "0";
            var n = d.length > 3 ? d.slice(0, 3) + "." + d.slice(3) : d;
            out.textContent = n;
            look.href = look.href.replace(/([?&]n=)[^&]*/, "\$1" + encodeURIComponent(n));
            for (var i = 0; i < acts.length; i++) { acts[i].setAttribute("data-num", n); }
        });
    }
})();
