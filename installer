printf "  control characters removed: %d    escape leftovers (\\N, \\t): %d\n", $stat{control} // 0, $stat{escapes} // 0;
printf "  ª and º repaired: %d    capital words with small accented letters fixed: %d\n", $stat{fix_ordinal} // 0, $stat{fix_case} // 0;
printf "  carets inside text read as separators: %d\n", $stat{caret_text} // 0;
printf "  imprints without a place name found (whole text as publisher): %d\n", $stat{imprint_unsplit} // 0;
printf "  unknown language codes (%s used): %d\n", $o{lang}, $stat{lang_unknown} // 0;
my %review_label = ( 'no title, has a tombo' => 'Not imported (no title, but a tombo in the row)', 'tombo range' => 'Check in Koha, tombo range too long to expand',
    titulo => 'Check in Koha, title with a caret (an ISIS subfield letter may be glued to the next word)', chamada => 'Check in Koha, call number with a caret',
    imprenta => 'Check in Koha, imprint with a caret' );
for my $k ( sort keys %review ) {
    my @m = grep { $_ ne '' } @{ $review{$k} };
    next unless @m;
    printf "%s: MFN %s%s\n", $review_label{$k} // "Check in Koha, $k with a caret", join( ', ', @m[ 0 .. ( $#m > 9 ? 9 : $#m ) ] ), ( @m > 10 ? sprintf( ' and %d more', @m - 10 ) : '' );
}
if ($occ) {
    printf "Occurrences linked to items: %d    without a known tombo (skipped): %d\n", $stat{occ_linked} // 0, $stat{occ_orphan} // 0;
}
my @other = grep { $_ ne $cat && ( !$occ || $_ ne $occ ) } @table_order;
print "Patrons, loans and holds: ", ( @other ? 'not migrated (tables ' . join( ', ', @other ) . ')' : 'not in this backup' ), "\n";
if ( $o{'dry-run'} ) {
    my $n = 0;
    for my $m (@records) {
        last if $n++ >= $o{sample};
        print "\n--- Sample ---\n" if $n == 1;
        print $m->as_formatted, "\n";
    }
}
exit 0;
ISISDB
