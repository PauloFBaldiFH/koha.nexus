            $stat{dup_barcodes}++;
        } else {
            $seen_barcode{$bc} = $mfn || '?';
            $stat{tombo_barcodes}++;
        }
        push @notes, "tombo marcado com \$ no ISIS" if $c->{dollar};
        my $withdrawn = grep {/^baix/} @{ $c->{status} };
        push @notes, map {"($_)"} grep { !/^baix/ } @{ $c->{status} };
        $stat{withdrawn}++ if $withdrawn;
        $stat{with_volume}++ if $c->{vol} ne '';
        my $it = { barcode => $bc, vol => $c->{vol}, withdrawn => $withdrawn, notes => \@notes };
        $item_of_tombo{ $c->{tombo} } //= $it;
        push @{ $rec{items} }, $it;
    }
    if ( !@{ $rec{items} } ) {
        push @{ $rec{items} }, { barcode => "ISIS$mfn", vol => '', notes => ['sem tombo no ISIS'] };
        $stat{isis_barcodes}++;
    }
    $rec{raw} = $raw;
    push @recs, \%rec;
}

# Occurrences (lost copies and other remarks) go to the item they name.
if ($occ) {
    my %c = map { colkey( $cols_of{$occ}[$_] ) => $_ } 0 .. $#{ $cols_of{$occ} };
    my ( $kc, $tc, $lc, $dc ) = ( $c{cod_livro} // $c{registro} // $c{tombo}, $c{ocorrencia}, $c{extraviado}, $c{data_registro} // $c{data} );
    for my $r ( @{ $rows_of{$occ} } ) {
        ( my $k = $r->[$kc] // '' ) =~ s/\D//g;
        my $it = $k ne '' ? $item_of_tombo{$k} : undef;
        if ( !$it ) { $stat{occ_orphan}++; next }
        my $text = clean( defined $tc ? $r->[$tc] : undef, '', undef, ' ' ) // '';
        $text = substr( $text, 0, 500 ) . '...' if length $text > 500;
        my $when = defined $dc ? ( $r->[$dc] // '' ) : '';
        push @{ $it->{notes} }, 'Ocorrência' . ( $when ne '' ? " $when" : '' ) . ( $text ne '' ? ": $text" : '' );
        $stat{occ_linked}++;
        if ( defined $lc && ( $r->[$lc] // '' ) =~ /^(t|true|1|s|y)/i ) { $it->{lost} = 1; $stat{occ_lost}++ }
    }
}

# ---------------------------------------------------------------- MARC
sub names { my $s = shift // return (); return grep { $_ ne '' } map { s/^\s+|\s+$//gr } split /\s*;\s*/, $s }
sub name_sub {
    my $n = shift;
    my @s;
    $n =~ s/^<(\w+)>\s*/$1 /;
    if ( $n =~ s/\s*<([^<>]+)>\s*$// ) { @s = ( a => $n, c => $1 ) } else { $n =~ s/[<>]//g; @s = ( a => $n ) }
    return @s;
}
sub subjects {
    my $s = shift // return ();
    my @h = $s =~ /</ ? ( $s =~ /<([^<>]+)>/g ) : split /\s*;\s*/, $s;
    my %seen;
    return grep { $_ ne '' && !$seen{ norm($_) }++ } map { s/^\s+|\s+$//gr } @h;
}
my @records;
my $today = strftime( '%y%m%d', localtime );
if ( $o{marc} || $o{'dry-run'} ) {
    require MARC::Record; require MARC::Field;
    for my $rec (@recs) {
        my $v = $rec->{v};
        my ( @f, $year, $acq );
        my $data = $v->{data} // '';
        if    ( $data =~ /^(\d{1,2})\/(\d{1,2})\/(\d{4})/ && $2 <= 12 ) { $acq = sprintf '%04d-%02d-%02d', $3, $2, $1 }
        elsif ( $data =~ /^(\d{4})-(\d\d)-(\d\d)/ )           { $acq = "$1-$2-$3" }
        elsif ( $data =~ /\b(1[5-9]\d\d|20\d\d)\b/ )          { $year = $1 }
        my ( $place, $pub, $iy ) = defined $v->{imprenta} ? split_imprint( $v->{imprenta} ) : ( $v->{local} // '', $v->{editora} // '', undef );
        $year //= $iy;
        $stat{imprint_unsplit}++ if defined $v->{imprenta} && $place eq '';
        my $tipo = lc substr( $v->{tipo} // 'm', 0, 1 );
        my $m = MARC::Record->new();
        $m->leader( '00000na' . ( $tipo eq 's' ? 's' : 'm' ) . ' a22000007a 4500' );
        my $lg = $lang{ norm( $v->{idioma} // '' ) };
        $stat{lang_unknown}++ if defined $v->{idioma} && !$lg;
        $lg //= $o{lang};
        push @f, MARC::Field->new( '008', $today . ( $year ? "s$year" : 'nuuuu' ) . '    ' . $o{country} . ( '|' x 17 ) . $lg . ' d' );
        push @f, MARC::Field->new( '020', ' ', ' ', a => $v->{isbn} ) if defined $v->{isbn};
        push @f, MARC::Field->new( '022', ' ', ' ', a => $v->{issn} ) if defined $v->{issn};
        push @f, MARC::Field->new( '035', ' ', ' ', a => "(ISIS)$rec->{mfn}" ) if $rec->{mfn} ne '';
        push @f, MARC::Field->new( '041', '0', ' ', a => $lg ) if defined $v->{idioma};
        my ( $class, $cutter ) = ( '', '' );
        ( $class, $cutter ) = ( $1, $2 // '' ) if ( $v->{chamada} // '' ) =~ /^(\S+)(?:\s+(.+))?$/;
        push @f, MARC::Field->new( '082', '0', '4', a => $class ) if $class =~ /^\D?\d/;
        push @f, MARC::Field->new( '090', ' ', ' ', a => $class, ( $cutter ne '' ? ( b => $cutter ) : () ) ) if $class ne '';
        my @main;
        for ( [ aut_pes => '100', '1' ], [ aut_ent => '110', '2' ], [ aut_ev => '111', '2' ] ) {
            my @n = names( $v->{ $_->[0] } );
            next unless @n;
            if ( !@main ) { @main = ( $_->[1], $_->[2], shift @n ) }
            push @{ $rec->{added}{ $_->[1] } }, @n;
        }
        push @f, MARC::Field->new( $main[0], ( $main[0] eq '100' && $main[2] !~ /,/ ? '0' : $main[1] ), ' ', name_sub( $main[2] ) ) if @main;
        my $t = $v->{titulo};
        my $nf = 0;
        if ( $t =~ s/^<([^<>=]+)>\s*/$1 / ) { $nf = length($1) + 1 }
        $t =~ s/<([^<>=]+)=[^<>]*>/$1/g; $t =~ s/[<>]//g;
        my ( $ta, $tb ) = split / : /, $t, 2;
        push @f, MARC::Field->new( '245', ( @main ? '1' : '0' ), ( $nf > 9 ? 0 : $nf ), a => $ta . ( defined $tb ? ' :' : '' ), ( defined $tb ? ( b => $tb ) : () ) );
        push @f, MARC::Field->new( '250', ' ', ' ', a => $v->{edicao} ) if defined $v->{edicao};
        my @imp;
        push @imp, ( a => $place . ( $pub ne '' ? ' :' : ( $year ? ',' : '' ) ) ) if $place ne '';
        push @imp, ( b => $pub . ( $year ? ',' : '' ) ) if $pub ne '';
        push @imp, ( c => $year ) if $year;
        push @f, MARC::Field->new( '260', ' ', ' ', @imp ) if @imp;
        if ( defined( my $c = $v->{colacao} ) ) { $c =~ s/^(\d+)\s*p(g|ag)?\.?$/$1 p./i; push @f, MARC::Field->new( '300', ' ', ' ', a => $c ) }
        push @f, MARC::Field->new( '362', '1', ' ', a => $v->{colacao_per} ) if defined $v->{colacao_per};
        push @f, MARC::Field->new( '490', '0', ' ', a => $v->{serie} ) if defined $v->{serie};
        push @f, MARC::Field->new( '500', ' ', ' ', a => $_ ) for grep {defined} $v->{nota}, $v->{nota_publ};
        push @f, MARC::Field->new( '500', ' ', ' ', a => "Centro cooperante: $v->{centro}" ) if defined $v->{centro};
        push @f, MARC::Field->new( '502', ' ', ' ', a => $v->{nota_tese} ) if defined $v->{nota_tese};
        push @f, MARC::Field->new( '505', '0', ' ', a => $v->{nota_cont} ) if defined $v->{nota_cont};
        push @f, MARC::Field->new( '536', ' ', ' ', a => $v->{nota_conv} ) if defined $v->{nota_conv};
        for my $h ( subjects( $v->{assunto} ) ) {
            my ( $a, @x ) = split m{\s*/\s*|\s+-\s+}, $h;
            push @f, MARC::Field->new( '650', ' ', '4', a => $a, map { ( x => $_ ) } grep { $_ ne '' } @x );
        }
        for ( [ sec_pes => '700', '1' ], [ sec_ent => '710', '2' ], [ sec_ev => '711', '2' ] ) {
            push @{ $rec->{added}{ $_->[1] =~ s/^7/1/r } }, names( $v->{ $_->[0] } );
        }
        for my $tag (qw( 100 110 111 )) {
            ( my $at = $tag ) =~ s/^1/7/;
            push @f, MARC::Field->new( $at, ( $tag eq '100' && !/,/ ? '0' : ( $tag eq '100' ? '1' : '2' ) ), ' ', name_sub($_) ) for @{ $rec->{added}{$tag} || [] };
        }
        my $host = join ', ', grep {defined} @$v{qw( todo_pes todo_ent todo_ev )};
        push @f, MARC::Field->new( '773', '0', ' ', ( $host ne '' ? ( a => $host ) : () ), ( defined $v->{todo_titulo} ? ( t => $v->{todo_titulo} ) : () ) )
            if $host ne '' || defined $v->{todo_titulo};
        push @f, MARC::Field->new( '942', ' ', ' ', c => $o{itype} ) if $o{itype} ne '';
        for my $it ( @{ $rec->{items} } ) {
            my @s = ( a => $o{branch}, b => $o{branch} );
            push @s, ( y => $o{itype} ) if $o{itype} ne '';
            push @s, ( o => $v->{chamada} ) if defined $v->{chamada};
            push @s, ( p => $it->{barcode} );
            push @s, ( h => $it->{vol} ) if $it->{vol} ne '';
            push @s, ( d => $acq ) if $acq;
            push @s, ( 0 => 1 ) if $it->{withdrawn};
            push @s, ( 1 => 1 ) if $it->{lost};
            my $x = "ISIS MFN $rec->{mfn}" . ( $rec->{raw} ne '' ? "; registro: " . substr( $rec->{raw}, 0, 200 ) : '' );
            $x .= '; ' . join( '; ', @{ $it->{notes} } ) if @{ $it->{notes} };
            push @s, ( x => $x );
            push @f, MARC::Field->new( '952', ' ', ' ', @s );
        }
        $m->append_fields( sort { $a->tag cmp $b->tag } @f );
        push @records, $m;
    }
}

# ---------------------------------------------------------------- output
if ( $o{marc} ) {
    open( my $out, '>:raw', $o{marc} ) or fail( 1, "cannot write $o{marc}" );
    print {$out} encode( 'UTF-8', $_->as_usmarc ) for @records;
