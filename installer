    fi
    grep -q '^USE_MEMCACHED=' "$conf" || echo 'USE_MEMCACHED="yes"' >> "$conf"
    grep -q '^MEMCACHED_SERVERS=' "$conf" || echo 'MEMCACHED_SERVERS="127.0.0.1:11211"' >> "$conf"
    if is_wsl; then     # the STOMP address prepare_wsl_broker gave RabbitMQ
        sed -i -E '/^[[:space:]]*MESSAGE_BROKER_(HOST|PORT)=/d' "$conf"
        printf 'MESSAGE_BROKER_HOST="127.0.0.1"\nMESSAGE_BROKER_PORT="%s"\n' "$(koha_stomp_port)" >> "$conf"
    fi
}

# Shows why the installation stopped (a calm card with the end of the log)
# instead of silently going back to the menu.
install_step_failed() {
    local step="$1" file="${2:-$TUI_LOG}"
    restore_apt_timers
    log "installation aborted at step: $step"
    tui_fail_card "$step" "$file"
    pause_terminal
    return 1
}

# Adds the Elasticsearch 7 APT repository. If it cannot be reached (Elastic
# blocks some regions and proxies), it is removed again so that it does not
# break "apt-get update" for everything else.
ensure_elastic_repo() {
    local list="/etc/apt/sources.list.d/elastic-7.x.list"
    [ -f "$list" ] && return 0
    mkdir -p /usr/share/keyrings
    if curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch \
        | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null; then
        apt_source_line /usr/share/keyrings/elasticsearch-keyring.gpg https://artifacts.elastic.co/packages/7.x/apt stable main > "$list"
        if apt_update_indices; then
            return 0
        fi
    fi
    rm -f "$list"
    apt_update_indices >/dev/null 2>&1
    return 1
}

# On Debian 12+ there is no /var/log/auth.log (logs live in journald) and the
# default fail2ban sshd jail refuses to start. Use the systemd backend there.
configure_fail2ban() {
    host_can fail2ban || { log "Fail2ban skipped: not used on Windows (WSL)"; return 0; }
    command -v fail2ban-client >/dev/null 2>&1 || return 0
    if [ ! -f /var/log/auth.log ] && [ -d /etc/fail2ban/jail.d ]; then
        apt_install python3-systemd >/dev/null 2>&1 || true
        cat > /etc/fail2ban/jail.d/koha-easy-install.local << 'EOF'
# Generated by Koha Easy Installer: this system logs to journald.
[sshd]
enabled = true
backend = systemd
EOF
    fi
    systemctl enable fail2ban >/dev/null 2>&1 || true
    systemctl restart fail2ban >/dev/null 2>&1 || true
}

# koha-create needs the templates shipped in /etc/koha (apache-site.conf.in,
# koha-conf-site.xml.in...). They are dpkg "conffiles": if /etc/koha was
# deleted by hand or by an old uninstall while koha-common stayed installed,
# a plain reinstall does NOT bring them back. --force-confmiss does.
ensure_koha_conffiles() {
    local f missing=0
    while read -r f _; do
        [ -n "$f" ] && [ ! -e "$f" ] && missing=$((missing + 1))
    done < <(dpkg-query -W -f='${Conffiles}\n' koha-common 2>/dev/null)
    [ -f /etc/koha/apache-site.conf.in ] || missing=$((missing + 1))
    [ -f /etc/koha/koha-conf-site.xml.in ] || missing=$((missing + 1))
    [ "$missing" -eq 0 ] && return 0

    log "koha-common: $missing configuration file(s) missing; reinstalling with --force-confmiss"
    DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y \
        -o Dpkg::Options::=--force-confmiss -o Dpkg::Options::=--force-confold \
        -o Acquire::ForceIPv4=true koha-common >>"$APT_LOG" 2>&1
    [ -f /etc/koha/apache-site.conf.in ] && [ -f /etc/koha/koha-conf-site.xml.in ]
}

# Copies the panel (and its dictionaries) to /usr/local/bin/config.sh.
install_panel_copy() {
    local src="$_SCRIPT_PATH"
    install_linux_launcher
    [ -f "$src" ] || return 0
    if [ "$(readlink -f "$src")" != "$(readlink -f /usr/local/bin/config.sh 2>/dev/null)" ]; then
        install -m 755 "$src" /usr/local/bin/config.sh 2>/dev/null || true
    fi
    if [ -d "${_SCRIPT_DIR}/lang" ] && [ "$(readlink -f "${_SCRIPT_DIR}/lang")" != "$(readlink -f "${CONFIG_DIR}/lang" 2>/dev/null)" ]; then
        mkdir -p "${CONFIG_DIR}/lang"
        cp -f "${_SCRIPT_DIR}"/lang/*.cache "${CONFIG_DIR}/lang/" 2>/dev/null || true
    fi
    # The new panel (panel/), when it came with this script.
    if [ -n "$_SCRIPT_DIR" ] && kei_panel_src_ok "${_SCRIPT_DIR}/panel"; then
        kei_panel_install_src "${_SCRIPT_DIR}/panel" 2>/dev/null || true
    fi
}

# ----------------------------------------------------------------------
# The new panel (Textual, Python): panel/ in the repository.
# ----------------------------------------------------------------------
# "sudo config.sh" opens it instead of the classic menu when it can:
# Python 3.9+, its own virtual environment with Textual, and a terminal.
# Every routine is a panel screen: it runs here as "config.sh --task ..."
# (PANEL TASKS), its questions asked by the panel; only full-screen
# programs (htop, mc) get the terminal, with this panel's lock
# descriptor handed down (KEI_PANEL_LOCK_FD, see 4.5).
#   KEI_UI=whiptail (or dialog)  always the classic panel
# Anything that fails (no network for the first set-up, an old Python, a
# crash) opens the classic panel: it stays the safe way in.
KEI_LIB_DIR="/usr/local/lib/koha-easy-installer"
KEI_PANEL_SRC="${KEI_LIB_DIR}/panel"
KEI_PANEL_VENV="${KEI_LIB_DIR}/panel-venv"
KEI_PANEL_FAILED="${KEI_LIB_DIR}/panel-setup-failed"
# Written by the new panel once its first screen is drawn (see kei_panel_run).
KEI_PANEL_STARTED="${KEI_LIB_DIR}/panel-started"
KEI_PANEL_PIDFILE="${KEI_LIB_DIR}/panel.pid"
# Its error log: a Python traceback when it crashes.
KEI_PANEL_ERRLOG="${LOG_DIR}/new-panel.log"
# Seconds the new panel has to draw its first screen before the classic
# panel takes over (a first start on a slow disk takes a few seconds).
KEI_PANEL_START_TIMEOUT="${KEI_PANEL_START_TIMEOUT:-60}"
KEI_PANEL_TARBALL_URL="https://codeload.github.com/PauloFBaldiFH/koha.nexus/tar.gz/refs/heads/main"

# 0 when $1 holds the new panel's sources.
kei_panel_src_ok() { [ -f "$1/kei_panel/__main__.py" ] && [ -f "$1/requirements.txt" ]; }

# Installs the sources from $1 under KEI_LIB_DIR (replaced whole), stamped
# with this panel's version: config.sh then finds them from any folder.
kei_panel_install_src() {
    local from="$1" tmp
    [ "$(readlink -f "$from")" = "$(readlink -f "$KEI_PANEL_SRC" 2>/dev/null)" ] && return 0
    mkdir -p "$KEI_LIB_DIR" || return 1
    tmp="${KEI_PANEL_SRC}.new"
    rm -rf "$tmp"
    cp -r "$from" "$tmp" || return 1
    rm -rf "$tmp"/tests "$tmp"/.venv
    find "$tmp" -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null
    printf '%s\n' "${PANEL_VERSION# }" > "$tmp/.panel-version"
    rm -rf "$KEI_PANEL_SRC" && mv "$tmp" "$KEI_PANEL_SRC"
}

# Only this script reached the server (curl, "Update this panel"): the
# new panel's sources come from the same branch on GitHub.
kei_panel_download_src() {
    local tmp
    tmp=$(mktemp -d /tmp/koha_tmp_panel.XXXXXX) || return 1
    if curl -fsSL --retry 2 --retry-delay 2 --connect-timeout 10 --max-time 120 "$KEI_PANEL_TARBALL_URL" \
         | tar -xz -C "$tmp" --wildcards '*/panel/*' 2>/dev/null \
       && kei_panel_src_ok "$(echo "$tmp"/*/panel)"; then
        kei_panel_install_src "$(echo "$tmp"/*/panel)"
        local rc=$?
        rm -rf "$tmp"
        return "$rc"
    fi
    rm -rf "$tmp"
    return 1
}

# 0 when the venv has the Textual the sources ask for.
kei_panel_venv_ok() {
    local src="$1"
    [ -x "$KEI_PANEL_VENV/bin/python" ] || return 1
    cmp -s "$src/requirements.txt" "$KEI_PANEL_VENV/.requirements" || return 1
    "$KEI_PANEL_VENV/bin/python" -c 'import textual' >/dev/null 2>&1
}

# 0 when the installed sources are this panel's version.
kei_panel_src_current() {
    [ "$(cat "$KEI_PANEL_SRC/.panel-version" 2>/dev/null)" = "${PANEL_VERSION# }" ]
}

# The whole set-up, run under tui_run (Pac-Man on screen, output to the
# log; it runs in the panel's own shell, so KEI_PANEL_WHY reaches the caller).
kei_panel_setup_task() {
    KEI_PANEL_WHY=""
    # Sources older than this script (only the installer was updated) or
    # none at all: fetched from GitHub; an old copy still works if offline.
    if ! kei_panel_src_ok "$KEI_PANEL_SRC" || ! kei_panel_src_current; then
        if ! kei_panel_download_src && ! kei_panel_src_ok "$KEI_PANEL_SRC"; then
            KEI_PANEL_WHY="$(t "Could not download the new panel from GitHub (no internet?).")"
            return 1
        fi
    fi
    if ! command -v python3 >/dev/null 2>&1 && ! apt_install python3; then
        KEI_PANEL_WHY="$(t "Could not install Python 3.")"
        return 1
    fi
    if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))'; then
        KEI_PANEL_WHY="$(t "This system's Python is older than 3.9.")"
        return 1
    fi
    if ! python3 -c 'import ensurepip, venv' >/dev/null 2>&1 && ! apt_install python3-venv; then
        KEI_PANEL_WHY="$(t "Could not install python3-venv.")"
        return 1
    fi
    kei_panel_venv_ok "$KEI_PANEL_SRC" && return 0
    # pip checks HTTPS against the system's certificates (a proxy or
    # antivirus that inspects HTTPS adds its own there), not only its own list.
    local cert=""
    [ -z "${PIP_CERT:-}" ] && [ -s /etc/ssl/certs/ca-certificates.crt ] && cert=/etc/ssl/certs/ca-certificates.crt
    # A venv is tied to its path: built in place, removed again on failure.
    rm -rf "$KEI_PANEL_VENV"
    if ! python3 -m venv "$KEI_PANEL_VENV"; then
        KEI_PANEL_WHY="$(t "Could not create the Python environment (python3 -m venv).")"
        return 1
    fi
    if PIP_CERT="${PIP_CERT:-$cert}" "$KEI_PANEL_VENV/bin/python" -m pip install --quiet \
           --disable-pip-version-check --retries 2 --timeout 20 -r "$KEI_PANEL_SRC/requirements.txt" \
       && cp -f "$KEI_PANEL_SRC/requirements.txt" "$KEI_PANEL_VENV/.requirements" \
       && kei_panel_venv_ok "$KEI_PANEL_SRC"; then
        return 0
    fi
    rm -rf "$KEI_PANEL_VENV"
    KEI_PANEL_WHY="$(t "Could not download Textual from pypi.org (no internet, or HTTPS blocked).")"
    return 1
}

# Why the classic panel opens instead: a box with the reason, the last
# lines of the log and how to choose. Never a silent switch.
kei_panel_explain_fallback() {
    local why="$1" log_file="${2:-$APT_LOG}" tail_txt
    tail_txt=$(tui_log_tail "$log_file" 4 2>/dev/null)
    msg_info "$(t "Classic panel")" "$(t "The new panel could not be opened, so the classic panel opens instead.")\n\n${why}\n\n${tail_txt}\n\n$(t "It is tried again at the next start. KEI_UI=whiptail always opens the classic panel. Log:") ${log_file}" 20 78
}

# 0 when the new panel should be used, setting it up first if needed.
# Decided once per run (KEI_PANEL_STATE): the first-run language question
# and the main menu both ask.
KEI_PANEL_STATE=""
kei_panel_ready() {
    case "$KEI_PANEL_STATE" in ready) return 0 ;; no) return 1 ;; esac
    KEI_PANEL_STATE=no
    case "${KEI_UI:-}" in whiptail|dialog) return 1 ;; esac
    [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] || return 1
    # Sources that came with this script replace the installed copy.
    if [ -n "$_SCRIPT_DIR" ] && kei_panel_src_ok "${_SCRIPT_DIR}/panel"; then
        kei_panel_install_src "${_SCRIPT_DIR}/panel" 2>/dev/null
    fi
    if kei_panel_src_ok "$KEI_PANEL_SRC" && kei_panel_src_current && kei_panel_venv_ok "$KEI_PANEL_SRC"; then
        KEI_PANEL_STATE=ready
        return 0
    fi
    clear
    printf '\n'
    if TUI_LOG="$APT_LOG" tui_run "$(t "Preparing the new panel")" kei_panel_setup_task; then
        rm -f "$KEI_PANEL_FAILED"
        KEI_PANEL_STATE=ready
        return 0
    fi
    mkdir -p "$KEI_LIB_DIR" && printf '%s\n' "${KEI_PANEL_WHY:-?}" > "$KEI_PANEL_FAILED"
    log "new panel: set-up failed: ${KEI_PANEL_WHY:-?} (see $APT_LOG)"
    # An older copy that still works is used.
    if kei_panel_src_ok "$KEI_PANEL_SRC" && kei_panel_venv_ok "$KEI_PANEL_SRC"; then
        KEI_PANEL_STATE=ready
        return 0
    fi
    kei_panel_explain_fallback "${KEI_PANEL_WHY:-$(t "Unknown error.")}"
    return 1
}

# Runs the new panel. 0 = the librarian closed it; anything else (it could
# not start, crashed, or drew nothing in time) = the caller opens the
# classic panel, with KEI_PANEL_WHY saying why. Exit code 3: the language
# was chosen in the new panel's first screen; it starts again in that language.
# Textual draws on stderr: it must stay the terminal (never 2>log); its
# own errors go to KEI_PANEL_ERRLOG.
kei_panel_run() {
    local rc wd timed_out="${KEI_LIB_DIR}/panel-timed-out"
    KEI_PANEL_WHY=""
    mkdir -p "$KEI_LIB_DIR" "$LOG_DIR" 2>/dev/null
    # Only this run's errors: the fallback box shows its last lines.
    : > "$KEI_PANEL_ERRLOG" 2>/dev/null
    while :; do
        rm -f "$KEI_PANEL_STARTED" "$KEI_PANEL_PIDFILE" "$timed_out"
        # Watchdog: no first screen in time = the app is stopped, never a
        # frozen window.
        (
            trap 'exit 0' TERM
            s=0
            while [ "$s" -lt "$KEI_PANEL_START_TIMEOUT" ]; do
                sleep 1
                s=$((s + 1))
                [ -e "$KEI_PANEL_STARTED" ] && exit 0
            done
            pid=$(cat "$KEI_PANEL_PIDFILE" 2>/dev/null)
            [ -n "$pid" ] || exit 0
            : > "$timed_out"
            kill -TERM "$pid" 2>/dev/null
            sleep 3
            kill -KILL "$pid" 2>/dev/null
        ) </dev/null >/dev/null 2>&1 &
        wd=$!
        KEI_INSTALLER="$(readlink -f "$_SCRIPT_PATH")" KEI_PANEL_LOCK_FD=9 \
            KEI_PANEL_ERRLOG="$KEI_PANEL_ERRLOG" KEI_PANEL_READY_FILE="$KEI_PANEL_STARTED" \
            PYTHONPATH="$KEI_PANEL_SRC" PYTHONDONTWRITEBYTECODE=1 \
            sh -c 'echo $$ > "$0"; exec "$@"' "$KEI_PANEL_PIDFILE" \
            "$KEI_PANEL_VENV/bin/python" -m kei_panel
        rc=$?
        kill "$wd" 2>/dev/null
        wait "$wd" 2>/dev/null
        log "new panel: exit $rc"
        if [ -e "$timed_out" ]; then
            rm -f "$timed_out"
            # Killed mid-start: the terminal may still be in the app's mode.
            stty sane 2>/dev/null
            printf '\033[?1049l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?2004l\033[?25h\033[0m'
            KEI_PANEL_WHY="$(t "The new panel did not appear within") ${KEI_PANEL_START_TIMEOUT}s."
            log "new panel: no first screen after ${KEI_PANEL_START_TIMEOUT}s, stopped"
            return 124
        fi
        case "$rc" in
            0) return 0 ;;
            3) set_panel_language "$(_read_lang_conf KOHA_PANEL_LANG_FULL)" ;;
            *) KEI_PANEL_WHY="$(t "The new panel stopped with an error") (exit $rc)."
               return "$rc" ;;
        esac
    done
}

# ----------------------------------------------------------------------
# Linux desktop launcher: "koha.nexus" in the applications menu
# (and on the desktop) of the user who ran the panel with sudo; it opens
# the panel in a terminal. Only on native Linux with a graphical desktop.
# ----------------------------------------------------------------------
LAUNCHER_NAME="koha-descomplicado"
# The Koha icon, 48x48 PNG (from windows/koha.ico).
LAUNCHER_ICON_PNG=""

linux_has_desktop() {
    [ "$KEI_PLATFORM" = "linux" ] || return 1
    compgen -G "/usr/share/xsessions/*.desktop" >/dev/null \
        || compgen -G "/usr/share/wayland-sessions/*.desktop" >/dev/null
}

# Contents of the .desktop file.
launcher_entry() {
    cat <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=koha.nexus : A smart, free and easy-to-use assistant for library management
Name[pt_BR]=koha.nexus : Assistente inteligente e gratuito para facilitar a gestão de bibliotecas
Name[pt]=koha.nexus : Assistente inteligente e gratuito para facilitar a gestão de bibliotecas
Comment=Install and manage Koha
Comment[pt_BR]=Instalar e gerir o Koha
Exec=sudo /usr/local/bin/config.sh
Icon=${LAUNCHER_NAME}
Terminal=true
Categories=System;Education;
Keywords=Koha;library;biblioteca;
StartupNotify=false
EOF
}

install_linux_launcher() {
    linux_has_desktop || return 0
    [ -n "$REAL_HOME" ] && [ -d "$REAL_HOME" ] && [ "$REAL_USER" != "root" ] || return 0
    local icon_dir="/usr/share/icons/hicolor/48x48/apps" apps="${REAL_HOME}/.local/share/applications"
    local desk="" file group first=0
    group=$(id -gn "$REAL_USER" 2>/dev/null) || group="$REAL_USER"
    mkdir -p "$icon_dir" && printf '%s' "$LAUNCHER_ICON_PNG" | base64 -d > "${icon_dir}/${LAUNCHER_NAME}.png" 2>/dev/null
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t /usr/share/icons/hicolor 2>/dev/null
    for file in "$apps" "$(dirname "$apps")" "${REAL_HOME}/.local"; do
        [ -d "$file" ] || { mkdir -p "$file" && chown "$REAL_USER:$group" "$file"; }
    done
    [ -f "${apps}/${LAUNCHER_NAME}.desktop" ] || first=1
    launcher_entry > "${apps}/${LAUNCHER_NAME}.desktop"
    chmod 755 "${apps}/${LAUNCHER_NAME}.desktop"
    chown "$REAL_USER:$group" "${apps}/${LAUNCHER_NAME}.desktop"
    # On the desktop too, the first time only (a launcher the user removed
    # stays removed), marked as trusted (GNOME asks otherwise).
    if [ "$first" = "1" ]; then
        # The desktop folder has a translated name ("Área de Trabalho"):
        # it is read from the user's XDG settings.
        desk=$(sed -n 's/^XDG_DESKTOP_DIR="\(.*\)"$/\1/p' "${REAL_HOME}/.config/user-dirs.dirs" 2>/dev/null | head -n 1)
        desk="${desk//\$HOME/$REAL_HOME}"
        [ -n "$desk" ] && [ "$desk" != "$REAL_HOME" ] || desk="${REAL_HOME}/Desktop"
        [ -d "$desk" ] || desk=""
    fi
    if [ -n "$desk" ]; then
        install -m 755 -o "$REAL_USER" -g "$group" "${apps}/${LAUNCHER_NAME}.desktop" "${desk}/${LAUNCHER_NAME}.desktop"
        su - "$REAL_USER" -c "gio set '${desk}/${LAUNCHER_NAME}.desktop' metadata::trusted true" >/dev/null 2>&1 || true
    fi
    log "launcher: ${apps}/${LAUNCHER_NAME}.desktop${desk:+ and ${desk}}"
    return 0
}

# Packages of the "essential dependencies" step, one per line. Under WSL
# the host tools are left out: UFW and Fail2ban (Windows Defender Firewall
# filters the network) and avahi-daemon (mDNS belongs to Windows).
essential_packages() {
    printf '%s\n' nano curl wget gpg ca-certificates apt-transport-https \
        libsasl2-modules rclone memcached libcache-memcached-fast-perl \
        libxml2-utils unzip pv psmisc
    host_can firewall && printf '%s\n' ufw
    host_can fail2ban && printf '%s\n' fail2ban
    host_can mdns && printf '%s\n' avahi-daemon
    return 0
}

# Install step: NTP. Under WSL the clock belongs to Windows (timesyncd would
# fight with the time WSL takes from the host).
install_clock_sync() {
    if ! host_can ntp; then
        echo "$(t "[INFO] Clock kept by Windows (WSL): NTP skipped.")"
        log "install: NTP skipped (clock kept by Windows)"
        return 0
    fi
    apt_install systemd-timesyncd >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    timeout 15 bash -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done' >/dev/null 2>&1
    return 0
}

# Install step: 4 GB swapfile. Under WSL swap is set by Windows (.wslconfig)
# and a swapfile in /etc/fstab would only waste the virtual disk.
install_swap() {
    if ! host_can swap; then
        echo "$(t "[INFO] SWAP managed by Windows (WSL, .wslconfig): swapfile skipped.")"
        log "install: swapfile skipped (swap managed by Windows)"
        return 0
    fi
    if [ -z "$(swapon --noheadings --show 2>/dev/null)" ] && [ ! -f /swapfile ]; then
        if [ "$(get_free_space_mb /)" -ge 8192 ] 2>/dev/null; then
            fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
            chmod 600 /swapfile
            mkswap /swapfile >/dev/null 2>&1
            if swapon /swapfile 2>/dev/null; then
                grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
                rm -f /swapfile
                echo "$(t "[WARN] SWAP could not be enabled (normal on WSL/containers).")"
            fi
        else
            echo "$(t "[WARN] Not enough space for a 4 GB SWAP. Skipping.")"
        fi
    fi
    return 0
}

# Apache answers on every address of the machine (0.0.0.0 and ::), on 80
# (public catalog) and 8080 (staff interface): the other PCs of the library,
# and Windows' port forwarding under WSL, reach Koha by the machine's own
# address. A Listen bound to one address on those ports (127.0.0.1,
# localhost, [::1], a LAN address) is widened to all of them, and the
# duplicates this can leave are dropped (Apache refuses to start on two
# Listen lines for the same port).
apache_listen_all() {
    local conf="${KEI_APACHE_PORTS:-/etc/apache2/ports.conf}" tmp
    [ -f "$conf" ] || return 1
    sed -i -E 's/^([[:space:]]*Listen[[:space:]]+)([0-9.]+|localhost|\[[0-9a-fA-F:]+\]):(80|8080)([[:space:]]*)$/\1\3\4/' "$conf"
    tmp=$(mktemp "${conf}.XXXXXX") || return 1
    awk '/^[[:space:]]*Listen[[:space:]]+(80|8080)[[:space:]]*$/ { if (seen[$2]++) next } { print }' "$conf" > "$tmp" \
        && chmod 644 "$tmp" && mv -f "$tmp" "$conf" || rm -f "$tmp"
    grep -qE '^[[:space:]]*Listen[[:space:]]+80[[:space:]]*$' "$conf" \
        || sed -i '1i Listen 80' "$conf"
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080[[:space:]]*$' "$conf" \
        || sed -i -E '0,/^[[:space:]]*Listen[[:space:]]+80[[:space:]]*$/s//&\nListen 8080/' "$conf"
    awk '/^[[:space:]]*Listen[[:space:]]/ { l = l " " $2 } END { print "apache: listening on" l }' "$conf" | while IFS= read -r m; do log "$m"; done
    return 0
}

# Installation tasks. Each one runs under tui_run: its output goes to the
# installation log and a non-zero exit code stops the installation with the
# troubleshooting card.
install_task_locales() {
    apt_update_indices || return 1
    apt_install locales || return 1
    local sys_locale="${LANG:-en_US.UTF-8}"
    case "$sys_locale" in
        C|POSIX|C.*|POSIX.*|"") sys_locale="en_US.UTF-8" ;;
    esac
    sys_locale="${sys_locale%%.*}.UTF-8"
    # Debian's locale-gen ignores its arguments and only reads /etc/locale.gen.
    sed -i -E "s/^#[[:space:]]*(${sys_locale}[[:space:]]+UTF-8)/\1/i; s/^#[[:space:]]*(en_US\.UTF-8[[:space:]]+UTF-8)/\1/" /etc/locale.gen 2>/dev/null || true
    locale-gen "$sys_locale" en_US.UTF-8 || locale-gen
    update-locale LANG="$sys_locale" || true
    return 0
}

install_task_upgrade() {
    wait_for_apt_locks || return 1
    apt_update_indices || return 1
    DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"
}

install_task_essentials() {
    local essentials=()
    mapfile -t essentials < <(essential_packages)
    apt_install "${essentials[@]}" || return 1
    # Labels utility installed separately to prevent batch failure if missing from repository
    apt_install glabels || true
    systemctl enable --now memcached
    host_can mdns && systemctl enable --now avahi-daemon
    configure_fail2ban
    return 0
}

install_task_repositories() {
    mkdir -p /usr/share/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://debian.koha-community.org/koha/gpg.asc \
        | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg; then
        echo "$(t "Could not download the Koha repository key. Check your internet connection.")"
        return 1
    fi
    apt_source_line /usr/share/keyrings/koha-keyring.gpg https://debian.koha-community.org/koha stable main > /etc/apt/sources.list.d/koha.list
    if ! ensure_elastic_repo; then
        echo "$(t "[WARN] Elasticsearch repository unavailable; continuing with Zebra only.")"
    fi
    apt_update_indices
}

install_task_koha_packages() {
    prepare_wsl_broker || echo "[WARN] RabbitMQ could not be prepared for WSL."
    apt_install mariadb-server koha-common || return 1
    ensure_koha_conffiles
}

install_task_database() {
    systemctl enable --now mariadb
    if ! mysql -e "SELECT 1;"; then
        systemctl restart mariadb || koha_ctl service mariadb start || true
        sleep 2
    fi
    mysql -e "SELECT 1;"
}

install_task_web() {
    define_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http
    apache_listen_all
    systemctl restart apache2 memcached
    return 0
}

# koha-create keeps its own log: its last lines explain a failure.
install_task_instance() {
    # C.UTF-8 keeps the tools' messages readable in the log (some of them
    # print badly encoded accents in other locales).
    mkdir -p /var/lib/koha
    LC_ALL=C.UTF-8 LANGUAGE=en koha_ctl /usr/sbin/koha-create --create-db "$INSTANCE" > "${LOG_DIR}/koha-create.log" 2>&1 || return 1

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF"

    # Disable the Debian/Ubuntu default site so that port 80 serves the OPAC.
    a2dissite 000-default default-ssl
    rm -f /var/www/html/index.html

    a2enmod headers proxy proxy_http
    a2ensite "$INSTANCE"
    # Memcached first: a Plack started before it runs without cache.
    systemctl enable memcached
    systemctl restart memcached
    systemctl restart apache2 koha-common
    return 0
}

install_task_plack() {
    koha_ctl /usr/sbin/koha-plack --enable "$INSTANCE"
    koha_ctl /usr/sbin/koha-plack --start "$INSTANCE"
    systemctl restart apache2
    return 0
}

install_task_indexing() {
    zebra_start
    write_cron_zebra
    zebra_indexer_start
    start_koha_workers
    return 0
}

install_task_backups() {
    local ip="$1" db_pass="$2" ssh_login="$3"
    write_backup_scripts
    write_cron_tasks
    koha_email_enable || log "koha-email-enable failed (e-mail notices stay off)"

    cat > "$CREDENTIALS_FILE" << EOF
======================================================================
 $(t "KOHA CREDENTIALS (instance: \${INSTANCE})")
 $(t "Generated on:") $(date '+%F %T')
======================================================================
 $(t "Staff (administration):") http://${ip}:8080
 $(t "OPAC  (catalog)       :") http://${ip}:80

 $(t "Username              :") ${DB_NAME}
 $(t "Password              :") ${db_pass}

 $(t "SSH access            :") ssh ${ssh_login}

 $(t "This password belongs to the database user for initial access")
 $(t "(Web Installer). Afterwards, create a dedicated superlibrarian")
 $(t "(menu 9 > Create super librarian) and store this file safely.")

 $(t "Configuration         :") ${KOHA_CONF}
 $(t "Backups               :") ${DIR_SQL} $(t "and") ${DIR_MARC}
 $(t "Dashboard             :") sudo config.sh
======================================================================
EOF
    chmod 600 "$CREDENTIALS_FILE"

    configure_firewall
    write_banner "$ip" "$DB_NAME"
    install_panel_copy
    return 0
}

install_task_cleanup() {
    apt-get clean -y
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y
    journalctl --vacuum-time="${1:-7}d"
    return 0
}

# The final check never stops the installation: its result is shown on the
# last screen and in the validation report.
install_task_check() {
    validate_complete_system "${1:-$(t "installation complete")}"
    return 0
}

# Previous installation: removed only after a verified safety backup.
install_task_remove_previous() {
    manage_koha_indexers stop
    if [ -d "/etc/koha/sites/${INSTANCE}" ]; then
        /usr/sbin/koha-remove "$INSTANCE" || return 2
    fi
    mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; DROP USER IF EXISTS '${DB_NAME}'@'%'; FLUSH PRIVILEGES;" || return 3
    rm -rf "/etc/koha/sites/${INSTANCE}"
    return 0
}

function_install_koha() {
    # The panel (--task install) has already checked the system, asked the
    # questions and passes the answers: KEI_TASK_TZ, KEI_TASK_REINSTALL.
    [ -n "${KEI_TASK:-}" ] || validate_pre_installation || return 1

    # Asked on Windows (WSL) too: the zone WSL copied from Windows is offered
    # first, so due dates and circulation logs follow the library's clock.
    local tz
    if [ -n "${KEI_TASK:-}" ]; then
        tz="${KEI_TASK_TZ:-}"
        [ -n "$tz" ] && { apply_timezone "$tz" || echo "$(t '[WARN] Could not apply the timezone ${tz}.')"; }
    elif tz=$(choose_timezone) && [ -n "$tz" ]; then
        apply_timezone "$tz" || echo "$(t '[WARN] Could not apply the timezone ${tz}.')"
    fi

    clear
    INSTALL_STARTED_AT=$(date '+%F %T')
    log "installation started"
    local steps=7
    tui_header

    tui_step 1 "$steps" "📦" "$(t "Preparing the system")"
    tui_run "$(t "Checking the package manager")" wait_for_apt_locks \
        || { install_step_failed "$(t "Checking the package manager")"; return 1; }
    tui_run "$(t "Setting up language and UTF-8")" install_task_locales \
        || { install_step_failed "$(t "Setting up language and UTF-8")"; return 1; }
    if host_can ntp; then
        tui_run "$(t "Syncing the clock")" install_clock_sync
    fi
    if host_can swap; then
        tui_run "$(t "Creating virtual memory (swap)")" install_swap
    fi
    tui_run "$(t "Updating the system")" install_task_upgrade \
        || { install_step_failed "$(t "Updating the system")"; return 1; }

    tui_step 2 "$steps" "🧰" "$(t "Essential tools")"
    tui_run "$(t "Installing essential packages")" install_task_essentials \
        || { install_step_failed "$(t "Installing essential packages")"; return 1; }
    tui_run "$(t "Adding the Koha repositories")" install_task_repositories \
        || { install_step_failed "$(t "Adding the Koha repositories")"; return 1; }

    tui_step 3 "$steps" "💾" "$(t "Database and Koha")" long
    tui_run "$(t "Downloading and installing Koha")" install_task_koha_packages \
        || { install_step_failed "$(t "Downloading and installing Koha")"; return 1; }
    tui_run "$(t "Starting the database")" install_task_database \
        || { install_step_failed "$(t "Starting the database")"; return 1; }

    tui_step 4 "$steps" "🔧" "$(t "Web server")"
    tui_run "$(t "Configuring Apache and Koha")" install_task_web

    local exists="no"
    [ -d "/etc/koha/sites/${INSTANCE}" ] && exists="yes"
    [ "$(run_sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ] && exists="yes"

    if [ "$exists" = "yes" ]; then
        if [ -n "${KEI_TASK:-}" ]; then
            # The panel asked both questions; it sends the typed word.
            if [ "${KEI_TASK_REINSTALL:-}" != "REINSTALL" ]; then
                restore_apt_timers
                msg_error "$(t "Instance already exists")" "$(t "Wrong confirmation. Nothing was deleted.")"
                return 1
            fi
        else
            prompt_yes_no "$(t "Instance already exists")" \
                "$(t "A Koha installation already exists on this machine.\n\nREINSTALLING DELETES the \${DB_NAME} database and all configuration.\nThis CANNOT be undone by this script.\n\nContinue to the final confirmation?")" 16 76 || { restore_apt_timers; return 0; }

            local confirm
            confirm=$(whiptail --title "$(t "FINAL CONFIRMATION")" --inputbox \
                "$(t "Type exactly the word below to erase everything:\n\nREINSTALL")" 12 66 3>&1 1>&2 2>&3) || { restore_apt_timers; return 0; }
            if [ "$confirm" != "REINSTALL" ]; then
                restore_apt_timers
                msg_info "$(t "Cancelled")" "$(t "Wrong confirmation. Nothing was deleted.")" 8 62
                return 0
            fi
        fi

        if ! backup_lock_acquire; then
            restore_apt_timers
            msg_error "" "$(t "Another backup or restore is already running. Reinstallation was cancelled.")" 9 74
            return 1
        fi
        local rescue db_has_tables
        rescue="${DIR_SQL}/PRE-REINSTALLATION_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        # "Could not count" is not "empty": no DROP without a verified copy.
        db_has_tables=$(koha_table_count) || db_has_tables="unknown"
        if [ "$db_has_tables" != "0" ]; then
            if ! tui_run "$(t "Saving a safety backup")" create_safety_backup "$rescue"; then
                backup_lock_release
                restore_apt_timers
                msg_error "$(t "Safety backup failed")" \
                    "$(t "The pre-reinstallation backup could not be validated.\n\nFor safety, the previous installation will NOT be deleted.")" 11 74
                return 1
            fi
            echo "   $(t "Safety backup:") $rescue"
        fi

        local rm_rc=0
        tui_run "$(t "Removing the old installation")" install_task_remove_previous || rm_rc=$?
        if [ "$rm_rc" -ne 0 ]; then
            backup_lock_release
            restore_apt_timers
            if [ "$rm_rc" -eq 2 ]; then
                msg_error "" "$(t "Koha could not remove the previous instance. No additional DROP was executed.")" 10 74
            else
                msg_error "" "$(t "Could not completely clean the previous database/user.")" 9 74
            fi
            return 1
        fi
        backup_lock_release
    fi

    tui_step 5 "$steps" "📖" "$(t "Your library")"
    if ! tui_run "$(t "Creating the Koha instance")" install_task_instance; then
        install_step_failed "$(t "Creating the Koha instance")" "${LOG_DIR}/koha-create.log"
        return 1
    fi

    # Automatic detection and installation of system language package in Koha
    local auto_lang
    auto_lang=$(detect_koha_locale)
    [ -z "$auto_lang" ] && [ "$KOHA_PANEL_LANG_FULL" != "en-GB" ] && auto_lang="$KOHA_PANEL_LANG_FULL"
    if [ -n "$auto_lang" ] && [ "${auto_lang%%-*}" != "en" ]; then
        tui_run "$(t "Installing the Koha language pack")" \
            /usr/sbin/koha-translate --install "$auto_lang" || true
    fi
    tui_run "$(t "Starting Koha (Plack)")" install_task_plack

    tui_step 6 "$steps" "🔎" "$(t "Search and safety")"
    tui_run "$(t "Turning on the search index")" install_task_indexing

    local db_pass ip
    db_pass=$(get_database_password)
    ip=$(get_server_ip)
    local ssh_login
    ssh_login=$(get_ssh_login "$ip")
    tui_run "$(t "Setting up backups and credentials")" install_task_backups "$ip" "$db_pass" "$ssh_login"

    tui_step 7 "$steps" "🌐" "$(t "Services")"
    tui_run "$(t "Restarting Koha services")" ensure_koha_services
    tui_run "$(t "Cleaning temporary files")" install_task_cleanup
    restore_apt_timers
    tui_run "$(t "Checking that everything works")" install_task_check
    log "installation complete (ok=$V_OK warn=$V_WARN fail=$V_FAIL)"

    if [ -n "${KEI_TASK:-}" ]; then
        # The panel shows the addresses, the report and the reboot question.
        host_can reboot || tui_run "$(t "Restarting Koha services")" restart_koha_stack || true
        kei_result v_ok "$V_OK"
        kei_result v_warn "$V_WARN"
        kei_result v_fail "$V_FAIL"
        kei_result can_reboot "$(host_can reboot && echo yes || echo no)"
        kei_credentials
        return 0
    fi

    tui_celebrate "$ip" "$V_FAIL"
    printf '   %s %s\n' "$(t "User:")" "${DB_NAME}"
    printf '   %s %s\n\n' "$(t "Pass:")" "${db_pass}"
    pause_terminal_continue

    if [ "$V_FAIL" -gt 0 ] || [ "$V_WARN" -gt 0 ]; then
        local diag_msg
        if [ "$V_FAIL" -gt 0 ]; then
            diag_msg="$(t "Final validation found issues (Failures: \$V_FAIL | Warnings: \$V_WARN).\n\nDo you want to see the detailed report now to know what failed?")"
        else
            diag_msg="$(t "Final validation completed with notices (Failures: 0 | Warnings: \$V_WARN).\n\nDo you want to see the detailed report now?")"
        fi

        if prompt_yes_no "$(t "View Diagnostics")" "$diag_msg" 12 76; then
            show_validation_report
        fi
    fi

    if ! host_can reboot; then
        clear
        tui_run "$(t "Restarting Koha services")" restart_koha_stack || true
        msg_info "$(t "Koha is ready")" "$(t "All set! Koha services were restarted.\n\nCredentials have been saved to /root/koha_credentials.txt.")" 11 74
        return 0
    fi

    if prompt_yes_no "$(t "Reboot Server (Recommended)")" \
"$(t "To enable full Plack speed, initialize SWAP, and ensure peak catalog performance, rebooting the system now is strongly recommended.\n\nCredentials have been saved to /root/koha_credentials.txt.\n\nDo you want to reboot the server immediately?")" 15 76; then
        clear
        echo "$(t "Rebooting in 5 seconds to consolidate services...")"
        log "post-install automatic reboot requested by user"
        sleep 5
        reboot_now
    else
        msg_info "$(t "Pending Reboot")" \
"$(t "All set! You chose to reboot later.\n\nRemember: if the catalog feels sluggish, restart the server via option 16 in the panel before heavy indexing.")" 11 74
    fi
}

