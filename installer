def iso2709_records(fh, limit=None):
    """Yields (leader, [(tag, raw bytes)]) from an ISO 2709 stream; damaged
    records are skipped."""
    buf = b""
    n = 0
    while True:
        chunk = fh.read(1 << 20)
        if not chunk and not buf:
            return
        buf += chunk
        while True:
            end = buf.find(b"\x1d")
            if end < 0:
                break
            raw, buf = buf[:end], buf[end + 1:]
            rec = _parse_iso(raw.lstrip(b"\r\n "))
            if rec:
                yield rec
                n += 1
                if limit and n >= limit:
                    return
        if not chunk:
            rec = _parse_iso(buf.strip())
            if rec:
                yield rec
            return


def _parse_iso(raw):
    if len(raw) < 25 or not raw[:5].isdigit():
        return None
    try:
        base = int(raw[12:17])
    except ValueError:
        return None
    leader = raw[:24].decode("latin-1")
    directory = raw[24:base - 1] if base > 24 else b""
    fields = []
    for i in range(0, len(directory) - 11, 12):
        entry = directory[i:i + 12]
        try:
            tag, ln, start = entry[:3].decode("ascii"), int(entry[3:7]), int(entry[7:12])
        except (ValueError, UnicodeDecodeError):
            return None
        data = raw[base + start:base + start + ln].rstrip(b"\x1e")
        fields.append((tag, data))
    return leader, fields


def iso_subfields(data):
    """Raw data of a variable field -> (ind1, ind2, [(code, bytes)])."""
    parts = data.split(b"\x1f")
    ind = parts[0].decode("latin-1")
    subs = [(p[:1].decode("latin-1"), p[1:]) for p in parts[1:] if p]
    return (ind[:1] or " "), (ind[1:2] or " "), subs


def iso_to_record(leader, fields, encoding="utf-8"):
    rec = Record(leader)
    for tag, data in fields:
        if tag < "010":
            rec.control(tag, data.decode(encoding, "replace"))
        else:
            i1, i2, subs = iso_subfields(data)
            rec.fields.append(Field(tag, i1, i2, [(c, v.decode(encoding, "replace")) for c, v in subs]))
    return rec


def marcxml_records(fh, limit=None):
    """Yields Record objects from MARCXML (any namespace prefix)."""
    n = 0
    for _, el in ET.iterparse(fh):
        if el.tag.split("}")[-1] != "record":
            continue
        rec = Record("")
        for child in el:
            name = child.tag.split("}")[-1]
            if name == "leader":
                rec.leader = child.text or ""
            elif name == "controlfield":
                rec.control(child.get("tag", ""), child.text or "")
            elif name == "datafield":
                subs = [(s.get("code", ""), s.text or "") for s in child if s.tag.split("}")[-1] == "subfield"]
                rec.fields.append(Field(child.get("tag", ""), child.get("ind1", " "), child.get("ind2", " "), subs))
        el.clear()
        yield rec
        n += 1
        if limit and n >= limit:
            return
