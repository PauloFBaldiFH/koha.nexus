        isbn:apart)          t "Different titles stay apart (recommended)" ;;
        isbn:merge)          t "One record per ISBN, as the file says" ;;
        column:ignore)       t "Leave the column out" ;;
        column:*)            magic_role_label "$2" ;;
        *)                   printf '%s' "$2" ;;
    esac
}

# magic_ask QUESTIONS ANSWERS: the engine's open questions (one per line:
# id, kind, file or table, subject, samples, options) asked in the panel's
# dialogs; each answer is added to ANSWERS for the next pass. 1 when the
# operator gives up.
magic_ask() {
    local lines=() line id kind where subject samples options olist=() opts=() o ans text title tag roles pairs=()
    mapfile -t lines < "$1"
    title=$(t "🪄  Magic Import Tool")
    for line in "${lines[@]}"; do
        # Empty fields survive: the separator is not a blank for "read".
        line=${line//$'\t'/$'\x1f'}
        IFS=$'\x1f' read -r id kind where subject samples options <<< "$line"
        [ -n "$id" ] && [ -n "$options" ] || continue
        case "$kind" in
            table)    text=$(t 'What does "${where}" hold?\n\nColumns: ${subject}\nFirst row: ${samples}') ;;
            column)   text=$(t 'Column "${subject}" of "${where}" is not clear.\nValues: ${samples}\n\nWhat does it hold?') ;;
            encoding) text=$(t 'Which character set does "${where}" use? Its text reads well in more than one.\n\nSample: ${samples}') ;;
            items)
                # subject: the tag, then code=role for each subfield ("945 b=barcode c=").
                read -r tag o <<< "$subject"
                read -r -a pairs <<< "$o"
                roles=""
                for o in "${pairs[@]}"; do
                    if [ -n "${o#*=}" ]; then
                        roles+="  \$${o%%=*}: $(magic_role_label "${o#*=}")\\n"
                    else
                        roles+="  \$${o%%=*}: $(t "(not used)")\\n"
                    fi
                done
                text=$(t 'The records of "${where}" may keep their copies in field ${tag}. Read from their values, its subfields hold:\n${roles}\nSample: ${samples}\n\nMake one Koha item (952) per field this way?') ;;
            isbn)     text=$(t '${subject} ISBN(s) in "${where}" are shared by different titles.\nExamples: ${samples}\n\nHow should they become records?') ;;
            *)        continue ;;
        esac
        opts=()
        IFS=',' read -r -a olist <<< "$options"
        for o in "${olist[@]}"; do opts+=("$o" "$(magic_option_label "$kind" "$o")"); done
        ans=$(ui_menu "$title" "$text" "${opts[@]}") || return 1
        printf '%s\t%s\n' "$id" "$ans" >> "$2"
        MAGIC_ASKED=$((MAGIC_ASKED + 1))
    done
    chown "${INSTANCE}-koha:" "$2" 2>/dev/null || true
    return 0
}

# magic_pick_one TEXT SQL: the only row of a "code<TAB>name" query, or the operator's choice.
magic_pick_one() {
    local rows
    rows=$(run_sql "$2" 2>/dev/null)
    if [ -n "$rows" ] && [ "$(printf '%s\n' "$rows" | wc -l)" -eq 1 ]; then
        printf '%s' "${rows%%$'\t'*}"
        return 0
    fi
    tools_pick "$(t "🪄  Magic Import Tool")" "$1" "$2"
}

lt_magic_import() {
    require_database || return 0
    local src rc=0
    src=$(magic_pick) || return 0
    if [ ! -r "$src" ] || { [ -f "$src" ] && [ ! -s "$src" ]; } || { [ ! -f "$src" ] && [ ! -d "$src" ]; }; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    # A Koha backup replaces the catalog: Restore database, never an import.
    if [ -f "$src" ]; then
        display_explanation "Checking the file..."
        if magic_is_koha_dump "$src"; then
            magic_to_restore "${src##*/}" && function_restore_database "$src"
            return 0
        fi
    fi
    if [ ! -x "$MAGIC_PY" ]; then
        local p="python3"
        magic_need_packages "$p" "" || return 1
        if [ ! -x "$MAGIC_PY" ]; then
            msg_error "" "$(t 'The ${p} package could not be installed. Nothing was changed.')" 9 70
            return 1
        fi
    fi
    MAGIC_RESTORE=""; MAGIC_RESTORE_DIR=""; MAGIC_SKIP_BACKUP=""; MAGIC_ASKED=0
    tools_locked _lt_magic_run "$src" || rc=$?
    if [ -n "$MAGIC_RESTORE" ]; then
        function_restore_database "$MAGIC_RESTORE"
        rm -rf "$MAGIC_RESTORE_DIR"
        MAGIC_RESTORE=""; MAGIC_RESTORE_DIR=""
    fi
    return "$rc"
}

# Recognition, questions, build, preview and the commit of every stream,
# holding the backup/restore lock. The work copies go when it ends.
_lt_magic_run() {
    local src="$1" log rc round=0 needs tried="" n settings backups=() args=() title
    local recs items pats loans holds casing encfix anom gate mode="keep" cat="" over="no" match="cardnumber" failed=0
    local lines=() line kind fmt enc path nrec nitem extra shown
    title=$(t "🪄  Magic Import Tool")
    MAGIC_ENGINE="$TOOLS_WORK/kei"; MAGIC_WORK="$TOOLS_WORK/magic"
    log=$(tools_log magic-import)
    MAGIC_LOG="$log"
    if ! kei_import_write "$MAGIC_ENGINE" || ! mkdir -p "$MAGIC_WORK/profiles"; then
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    [ -d "$MAGIC_PROFILES" ] && cp -f "$MAGIC_PROFILES"/*.tsv "$MAGIC_WORK/profiles/" 2>/dev/null
    : > "$MAGIC_WORK/answers.tsv"
    # Koha's libraries, item types and shelving locations: the values of a
    # legacy item field are matched against them.
    run_sql "SELECT branchcode, branchname FROM ${DB_NAME}.branches;" > "$MAGIC_WORK/branches.tsv" 2>/dev/null
    run_sql "SELECT itemtype, description FROM ${DB_NAME}.itemtypes;" > "$MAGIC_WORK/itemtypes.tsv" 2>/dev/null
    run_sql "SELECT authorised_value, lib FROM ${DB_NAME}.authorised_values WHERE category = 'LOC';" > "$MAGIC_WORK/locations.tsv" 2>/dev/null
    chown -R "${INSTANCE}-koha:" "$MAGIC_WORK" 2>/dev/null || true
    chmod -R go-rwx "$MAGIC_WORK"
    display_explanation "Copying the file to the work folder..."
    MAGIC_INPUT=$(magic_copy_input "$src") || return 1
    log "tools: magic import of ${src}"

    # 1) What the file is, and what the engine needs to know.
    while :; do
        round=$((round + 1))
        display_explanation "Recognising the files..."
        rc=0
        magic_engine "$log" analyse || rc=$?
        case "$rc" in
            0) ;;
            3|4)
                tools_output "$log" | grep -v '^\(Will build\|Settings\|Importable\|Questions\):' > "$MAGIC_WORK/analysis.txt"
                ui_textbox "$title" "$MAGIC_WORK/analysis.txt"
                if [ "$rc" = 3 ]; then
                    msg_info "$title" "$(t 'Nothing in it can be imported: the list just shown says why.\nNothing was changed.\n\nLog: ${log}')" 11 76
                    return 0
                fi
                msg_error "" "$(t 'The file cannot be read or unpacked safely: the list just shown says why.\nNothing was changed.\n\nLog: ${log}')" 11 76
                return 1 ;;
            *)
                ui_textbox "$title" "$log"
                msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
                return 1 ;;
        esac
        # A Koha backup in the archive goes to Restore database, never to the catalog.
        mapfile -t backups < <(tools_output "$log" | sed -n 's/^Koha backup: //p')
        if [ ${#backups[@]} -gt 0 ] && [ -z "$MAGIC_SKIP_BACKUP" ]; then
            magic_backup_found "${backups[0]}" "$(tools_num "$log" "Importable:")" || return 0
        fi
        needs=$(tools_output "$log" | sed -n 's/^Needs package: //p' | tr '\n' ' ')
        if [ -n "${needs// /}" ]; then
            magic_need_packages "$needs" "$tried" || return 1
            tried+=" $needs"
            continue
        fi
        n=$(tools_num "$log" "Questions:")
        [ "${n:-0}" -gt 0 ] || break
        if [ "$round" -gt 8 ] || ! magic_ask "$MAGIC_WORK/questions.tsv" "$MAGIC_WORK/answers.tsv"; then
            msg_info "$title" "$(t 'Nothing was imported.\n\nLog: ${log}')" 9 72
            return 0
        fi
    done

    # 2) Where the copies and patrons go, then the files for Koha's tools.
    settings=" $(tools_output "$log" | sed -n 's/^Settings: //p') "
    MAGIC_BRANCH=""; MAGIC_ITYPE=""
    if [[ "$settings" == *" branch "* ]]; then
        MAGIC_BRANCH=$(magic_pick_one "$(t "Library of the copies and patrons:")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;") || return 0
    fi
    if [[ "$settings" == *" itype "* ]]; then
        MAGIC_ITYPE=$(magic_pick_one "$(t "Item type for the rows without one:")" "SELECT itemtype, description FROM ${DB_NAME}.itemtypes ORDER BY description;") || return 0
    fi
    run_sql "SELECT categorycode, description FROM ${DB_NAME}.categories;" > "$MAGIC_WORK/categories.tsv" 2>/dev/null
    chown "${INSTANCE}-koha:" "$MAGIC_WORK/categories.tsv" 2>/dev/null || true
    args=(--branch "$MAGIC_BRANCH" --itype "$MAGIC_ITYPE" --categories "$MAGIC_WORK/categories.tsv")
    [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrower_attribute_types WHERE code = 'CPF';" 2>/dev/null)" = "1" ] && args+=(--cpf-attr)
    [ -n "${MAGIC_TODAY:-}" ] && args+=(--today "$MAGIC_TODAY")
    display_explanation "Building the records, items and patrons (nothing is written to Koha yet)..."
    rc=0
    magic_engine "$log" build "${args[@]}" || rc=$?
    if [ "$rc" != 0 ] && [ "$rc" != 3 ]; then
        ui_textbox "$title" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    recs=$(tools_num "$log" "Total records:"); items=$(tools_num "$log" "Total items:"); pats=$(tools_num "$log" "Total patrons:")
    loans=$(tools_num "$log" "Total loans:"); holds=$(tools_num "$log" "Total holds:")
    casing=$(tools_num "$log" "Casing fixes:"); encfix=$(tools_num "$log" "Encoding fixes:"); anom=$(tools_num "$log" "Anomalies:")
    [ -f "$MAGIC_WORK/out/preview.txt" ] && cat "$MAGIC_WORK/out/preview.txt" >> "$log"
    [ -f "$MAGIC_WORK/out/preview.txt" ] && ui_textbox "$(t "Preview (dry run)")" "$MAGIC_WORK/out/preview.txt"
    if [ "$rc" = 3 ] || [ $((recs + pats + loans + holds)) -eq 0 ]; then
        msg_info "$title" "$(t 'Nothing could be built from it: the preview just shown says why.\nNothing was changed.\n\nLog: ${log}')" 11 76
        return 0
    fi
    # The review gate: what was corrected and what to check, above the counts.
    gate=$(t 'Casing fixed: ${casing}  ·  Encoding fixed: ${encfix}  ·  Anomalies to check: ${anom}')
    [ "${anom:-0}" -gt 0 ] && gate+="\n$(t "The anomalies are listed in the summary at the top of the preview.")"
    if ! prompt_yes_no "$title" "${gate}\n\n$(t 'Ready to import:\n  Records: ${recs}\n  Items: ${items}\n  Patrons: ${pats}\n  Loans: ${loans}\n  Holds: ${holds}\n\nGo on? Koha checks each part first (its own dry run) and asks again before it writes, after a verified backup.')" 20 78 defaultno; then
        msg_info "$title" "$(t 'Nothing was imported.\n\nLog: ${log}')" 9 72
        return 0
    fi
    # The answers about the columns hold for the next file with the same columns.
    if compgen -G "$MAGIC_WORK/profiles-new/*.tsv" >/dev/null; then
        mkdir -p "$MAGIC_PROFILES" && chmod 700 "$MAGIC_PROFILES"
        cp -f "$MAGIC_WORK/profiles-new"/*.tsv "$MAGIC_PROFILES/" 2>/dev/null && chmod 600 "$MAGIC_PROFILES"/*.tsv
    fi

    # 3) The commit: each stream with Koha's own tools, as the other tools do.
    if [ "${recs:-0}" -gt 0 ] && [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.biblio;")" != "0" ]; then
        mode=$(ui_menu "$(t "Records already in the catalog")" "$(t "When an incoming record matches one in the catalog (ISBN and title):")" \
            "keep"    "$(t "Keep the catalog record, add only new items")" \
            "replace" "$(t "Replace the catalog record with the incoming one")" \
            "new"     "$(t "Do not compare: every record becomes a new title")") || return 0
    fi
    if [ "${pats:-0}" -gt 0 ]; then
        cat=$(magic_pick_one "$(t "Category for the lines without categorycode:")" "SELECT categorycode, description FROM ${DB_NAME}.categories ORDER BY description;") || return 0
        if [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers;")" -gt 1 ] 2>/dev/null; then
            prompt_yes_no "$(t "Import patrons")" "$(t 'Update the patrons that are already registered (same ${match})?\n\nNo = keep them as they are and import only the new ones.')" 11 72 defaultno && over="yes"
        fi
    fi
    MAGIC_RUN=1
    MAGIC_N_RECS=0; MAGIC_N_REPL=0; MAGIC_N_ITEMS=0; MAGIC_N_NEW=0; MAGIC_N_UPD=0; MAGIC_N_LOANS=0; MAGIC_N_HOLDS=0
    mapfile -t lines < "$MAGIC_WORK/out/manifest.tsv"
    for line in "${lines[@]}"; do
        line=${line//$'\t'/$'\x1f'}
        IFS=$'\x1f' read -r kind fmt enc path nrec nitem extra shown <<< "$line"
        case "$kind" in
            biblio)      _lt_marc_import_run "$path" "$fmt" "$enc" "$mode" "$shown" || { failed=1; break; } ;;
            patrons)     _lt_patron_import_run "$path" "$extra" "$MAGIC_BRANCH" "$cat" "$over" || { failed=1; break; } ;;
            circulation) _lt_br_bfdb_circ "$path" "$extra" || { failed=1; break; } ;;
        esac
    done
    MAGIC_RUN=""
    log "tools: magic import done (records=$MAGIC_N_RECS replaced=$MAGIC_N_REPL items=$MAGIC_N_ITEMS patrons=$MAGIC_N_NEW updated=$MAGIC_N_UPD loans=$MAGIC_N_LOANS holds=$MAGIC_N_HOLDS questions=$MAGIC_ASKED)"
    magic_summary "$failed"
    return "$failed"
}

# The final report: what Koha took in, from the counts of its own tools.
magic_summary() {
    local recs="$MAGIC_N_RECS" repl="$MAGIC_N_REPL" items="$MAGIC_N_ITEMS" pats="$MAGIC_N_NEW" upd="$MAGIC_N_UPD"
    local loans="$MAGIC_N_LOANS" holds="$MAGIC_N_HOLDS" asked="$MAGIC_ASKED" log="$MAGIC_LOG" text
    if [ "$1" = 1 ]; then
        msg_info "$(t "🪄  Magic Import Tool")" "$(t 'The import stopped at the step that failed (previous message). Imported before it: ${recs} record(s), ${items} item(s), ${pats} patron(s).\n\nLog: ${log}')" 13 76
        return 0
    fi
    if [ $((recs + repl + items + pats + upd + loans + holds)) -eq 0 ]; then
        msg_info "$(t "🪄  Magic Import Tool")" "$(t 'Nothing was imported.\n\nLog: ${log}')" 9 72
        return 0
    fi
    if [ "$asked" -eq 0 ]; then
        text=$(t '✅ Successfully imported ${recs} bibliographic record(s), ${items} item(s) and ${pats} patron(s) with zero manual mapping required.')
    else
        text=$(t '✅ Successfully imported ${recs} bibliographic record(s), ${items} item(s) and ${pats} patron(s). Questions answered: ${asked} (remembered for the next file with the same columns).')
    fi
    text+="\n\n$(t 'Records replaced: ${repl}\nPatrons updated: ${upd}\nLoans: ${loans}\nHolds: ${holds}\n\nUndo the records: Library tools > Undo a MARC import.\nSafety backups: ${DIR_SQL}\nLog: ${log}')"
    msg_ok "$text" 20 78
}

