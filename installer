        preview.append("Rows without title (left out): %d" % (st["no_title"] + st["no_title_tombo"]))
        preview.append("Items without barcode: %d" % st["no_barcode"])
        preview.append("Repeated tombos or barcodes renumbered (<code>-<n>, noted in 952 $x): %d" % st["renumbered"])
        preview.append("Rows joined to an ISBN record by their description: %d" % st["joined_by_description"])
        preview.append("Rows without ISBN joined by a similar title (same author, publisher and year): %d" % st["fuzzy_joined"])
        preview.append("Values typed in capitals, recased: %d" % st["casing"])
        for e in grouper.case_examples:
            preview.append("  " + e)
        preview.append("Statements of responsibility (245 $c) written from the authors: %d" % st["responsibility"])
        if st["language_guessed"]:
            preview.append("Languages other than Portuguese read from the title (008): %d" % st["language_guessed"])
        preview.append("ISBNs with a wrong check digit (kept in 020 $z): %d" % st["invalid_isbn"])
        preview.append("ISBNs shared by different titles (%s): %d" % ("merged, your answer" if a.isbn_answer == "merge" else "kept apart", st["isbn_shared"]))
        if st["itemtype_default"]:
