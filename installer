# The buttons in the staff interface (a marked block in IntranetUserJS): CDD
# next to the class fields of the cataloguing form (082 and 083 $a, the call
# numbers 090 and 092 $a, the item call number 952 $o) and CDD lookup in the
# tools of the cataloguing home page. The click is caught on the document,
# so the fields Koha repeats (cloned with the button) work too.
cdd_js_block() {
    local label title v
    label=$(t "CDD lookup")
    title=$(t "Search the CDD and use the number in this field")
    for v in label title; do
        declare -n _s=$v
        _s=${_s//\\/\\\\}; _s=${_s//\"/\\\"}; _s=${_s//</\\u003c}
        unset -n _s
    done
    cat <<CDDJS
${CDD_JS_BEGIN}
\$(document).ready(function () {
    var url = "/cgi-bin/koha/cataloguing/cdd_lookup.pl";
    if (/\/cgi-bin\/koha\/cataloguing\/cataloging-home\.pl\$/.test(location.pathname)) {
        var tools = \$("a[href*='tools/inventory.pl'], a[href*='marc_modification_templates.pl'], a[href*='labels/label-home.pl']").closest("ul").first();
        if (!tools.length) tools = \$("a[href*='/cgi-bin/koha/tools/']").closest("ul").last();
        if (tools.length && !tools.find("a[href*='cdd_lookup.pl']").length) {
            var cls = tools.find("a").first().attr("class") || "circ-button";
            var a = \$("<a></a>").attr({ "class": cls, href: url }).append(\$("<i></i>").attr("class", "fa fa-sitemap")).append(document.createTextNode(" ${label}"));
            tools.append(\$("<li></li>").append(a));
        }
        return;
    }
    if (!/\/cgi-bin\/koha\/cataloguing\/(addbiblio|additem)\.pl\$/.test(location.pathname)) return;
    var fields = "input[id^='tag_082_subfield_a'], input[id^='tag_083_subfield_a'], input[id^='tag_090_subfield_a'], input[id^='tag_092_subfield_a'], input[id^='tag_952_subfield_o']";
    function add() {
        \$(fields).each(function () {
            if (\$(this).next(".kei-cdd").length) return;
            \$(this).after(\$("<a href=\"#\" class=\"kei-cdd buttonDot\" style=\"margin-left:4px\"></a>").attr("title", "${title}").text("CDD"));
        });
    }
    add();
    new MutationObserver(add).observe(document.body, { childList: true, subtree: true });
    \$(document).on("click", "a.kei-cdd", function (e) {
        e.preventDefault();
        var input = \$(this).prev("input")[0];
        if (!input) return;
        var n = (input.value.match(/\d{3}(?:[.,]\d+)?/) || [""])[0], hint = [];
        if (!n) {
            // The subjects of the record first, then its title.
            \$("input[id^='tag_650_subfield_a']").each(function () { if (this.value) hint.push(this.value); });
            var title = \$("input[id^='tag_245_subfield_a']").first().val();
            if (title) hint.push(title);
        }
        var w = window.open(url + "?target=" + encodeURIComponent(input.id) + (n ? "&q=" + encodeURIComponent(n) : "&hint=" + encodeURIComponent(hint.join(" ; ").slice(0, 400))), "kei_cdd", "width=1040,height=780,scrollbars=yes,resizable=yes");
        if (w) w.focus();
    });
});
${CDD_JS_END}
CDDJS
}

cdd_js_sql() {   # cdd_js_sql add|remove FILE: SQL that rewrites IntranetUserJS
    local cur new
    cur=$(mr_js_current)
    cur=$(printf '%s\n' "$cur" | awk -v b="$CDD_JS_BEGIN" -v e="$CDD_JS_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }')
    new="$cur"
    if [ "$1" = "add" ]; then new="${cur:+${cur}$'\n'}$(cdd_js_block)"; fi
    printf "START TRANSACTION;\nUPDATE systempreferences SET value = %s WHERE variable = 'IntranetUserJS';\nCOMMIT;\n" "$(sql_quote "$new")" > "$2"
}

cdd_installed() { [ -f "$CDD_FILE" ]; }
cdd_js_on() { mr_js_current | grep -qxF "$CDD_JS_BEGIN"; }
cdd_js_latest() { [ "$(mr_js_current | awk -v b="$CDD_JS_BEGIN" -v e="$CDD_JS_END" '$0 == b { on = 1 } on { print } $0 == e { on = 0 }')" = "$(cdd_js_block)" ]; }
# cdd_info KEY: a fact about the index (written when it is built).
cdd_info() { [ -s "$CDD_DB" ] && sed -n "s/^$1=//p" "$CDD_INFO" 2>/dev/null | head -n 1; }

# cdd_require_sqlite LOG: DBD::SQLite (Debian package libdbd-sqlite3-perl)
# reads the index; checked with Koha's own Perl, as the instance user.
cdd_require_sqlite() {
    koha_exec "$1" sqlite-check /usr/bin/perl -MDBD::SQLite -e 1 && return 0
    display_explanation "Installing the tools to read the CDD (libdbd-sqlite3-perl)..."
    apt_install libdbd-sqlite3-perl >/dev/null 2>&1
    koha_exec "$1" sqlite-check /usr/bin/perl -MDBD::SQLite -e 1 && return 0
    local pkg="libdbd-sqlite3-perl"
    msg_error "" "$(t 'The package ${pkg} could not be installed. Nothing was changed.\n\nLog: ${APT_LOG}')" 10 72
    return 1
}

function_cdd() {
    require_database || return 0
    local opt status index
    while true; do
        if cdd_installed; then status="$(t "Installed"): /cgi-bin/koha/cataloguing/cdd_lookup.pl"; else status="$(t "Not installed.")"; fi
        if [ -s "$CDD_DB" ]; then
            local n ed name built
            n=$(cdd_info schedule); ed=$(cdd_info edition); name=$(cdd_info name); built=$(cdd_info built)
            index="$(t 'Index: ${n} entries of the schedules (edition ${ed}), built from ${name} on ${built}.')"
        else
            index="$(t "Index: not built yet.")"
        fi
        opt=$(ui_menu "$(t "🔎  CDD lookup in the cataloguing (staff tool)")" "$(t "A page of the staff interface to search the CDD while cataloguing: by number or subject, with the hierarchy and how many titles of the library use each class, and a CDD button next to the class fields that puts the number in the record. The CDD is not distributed with the panel: the index is built from the library's own copy (the PDF or its text) and stays on this server.")"$'\n\n'"$index"$'\n'"$status" \
            "1" "$(t "Build the index from your CDD file (PDF or text)")" \
            "2" "$(t "Install or update the page")" \
            "3" "$(t "Remove the page (the index is kept)")") || return 0
        case "$opt" in
            1) lt_cdd_build ;;
            2) lt_cdd_install ;;
            3) lt_cdd_remove ;;
        esac
        clear
    done
}

lt_cdd_build() {
    local file
    file=$(select_file "$REAL_HOME" "pdf txt" "$(t "Pick your copy of the CDD (.pdf, or .txt with the text of the PDF):")" "$(t "CDD file")") || return 0
    tools_locked _lt_cdd_build "$file" || return 0
    if ! cdd_installed && prompt_yes_no "$(t "CDD lookup")" "$(t "Install the CDD lookup page in the staff interface now?")" 9 70; then
        lt_cdd_install
    fi
}

_lt_cdd_build() {
    local file="$1" log txt stats name n tables terms ed pkg
    log=$(tools_log cdd)
    cdd_require_sqlite "$log" || return 1
    txt="$TOOLS_WORK/cdd.txt"
    if [ "$(head -c 5 "$file" 2>/dev/null)" = "%PDF-" ]; then
        if ! command -v pdftotext >/dev/null 2>&1; then
            display_explanation "Installing the tools to read the CDD (poppler-utils)..."
            apt_install poppler-utils >/dev/null 2>&1
        fi
        if ! command -v pdftotext >/dev/null 2>&1; then
            pkg="poppler-utils"
            msg_error "" "$(t 'The package ${pkg} could not be installed. Nothing was changed.\n\nLog: ${APT_LOG}')" 10 72
            return 1
        fi
        display_explanation "Reading the text of the PDF..."
        printf '$ pdftotext -enc UTF-8 %s\n' "${file##*/}" >> "$log"
        if ! pdftotext -enc UTF-8 "$file" "$txt" >> "$log" 2>&1 || [ ! -s "$txt" ]; then
            msg_error "" "$(t 'The text of the PDF could not be read (a scanned PDF has no text: use the text of an OCR). Nothing was changed.\n\nLog: ${log}')" 11 76
            return 1
        fi
    else
        cp -f -- "$file" "$txt" || return 1
    fi
    chown "${INSTANCE}-koha:" "$txt" 2>/dev/null || true
    mkdir -p "$TOOLS_WORK/KohaEasy"
    cdd_pm > "$TOOLS_WORK/KohaEasy/CDD.pm"
    printf 'use KohaEasy::CDD;\nKohaEasy::CDD::build_cli(@ARGV);\n' > "$TOOLS_WORK/cdd_build.pl"
    display_explanation "Reading the CDD and building the index..."
    stats="$TOOLS_WORK/cdd.stats"
    # The name is only shown on the page; the quoting of koha_exec refuses ' and newlines.
    name=${file##*/}; name=${name//\'/}; name=${name//$'\n'/ }
    if ! koha_exec "$log" cdd-build /usr/bin/perl -I "$TOOLS_WORK" "$TOOLS_WORK/cdd_build.pl" "$txt" "$TOOLS_WORK/cdd.sqlite" "$name"; then
        msg_error "" "$(t 'The index could not be built. Nothing was changed.\n\nLog: ${log}')" 10 72
        return 1
    fi
    tools_output "$log" > "$stats"
    n=$(kv_get "$stats" schedule); tables=$(kv_get "$stats" tables); terms=$(kv_get "$stats" terms); ed=$(kv_get "$stats" edition)
    # Fewer entries than the ten classes and their divisions: not the schedules.
    if [ "${n:-0}" -lt 100 ]; then
        n=${n:-0}
        msg_error "" "$(t 'Only ${n} entries of the schedules were found: this file does not look like the CDD. The previous index was kept.\n\nLog: ${log}')" 11 76
        return 1
    fi
    mkdir -p "$CDD_DIR" && chown "root:${INSTANCE}-koha" "$CDD_DIR" 2>/dev/null
    chmod 750 "$CDD_DIR"
    install -m 640 "$TOOLS_WORK/cdd.sqlite" "$CDD_DB.new" && chown "root:${INSTANCE}-koha" "$CDD_DB.new" 2>/dev/null
    mv -f "$CDD_DB.new" "$CDD_DB" || { msg_error "" "$(t "The index could not be saved. Nothing was changed.")" 8 64; return 1; }
    { cat "$stats"; printf 'name=%s\nbuilt=%s\n' "${file##*/}" "$(date '+%F %H:%M')"; } > "$CDD_INFO"
    chmod 640 "$CDD_INFO"
    log "cdd: index built from ${file##*/} ($n schedule entries, $tables table entries, $terms subjects)"
    ed=${ed:-?}
    msg_ok "$(t '✅ CDD index built: ${n} entries of the schedules, ${tables} of the tables and ${terms} subjects of the alphabetical list (edition ${ed}).\n\nIt stays on this server only: ${CDD_DB}')" 12 76
}

lt_cdd_install() {
    if [ ! -d "${KOHA_INTRA_CGI}/cataloguing" ]; then
        msg_error "" "$(t "The staff interface folder of Koha was not found. Nothing was changed.")" 9 72
        return 1
    fi
    local link="no"
    prompt_yes_no "$(t "CDD lookup")" "$(t "Also add the shortcuts in the staff interface: a CDD button next to the class number fields of the cataloguing form (082, 090, item call number) and CDD lookup in the tools of the cataloguing home page? (a marked block in the IntranetUserJS preference, removed with the page; a verified backup is made first)")" 13 76 && link="yes"
    tools_locked _lt_cdd_install "$link"
}

_lt_cdd_install() {
    local link="$1" log new sql updating=0 url note=""
    log=$(tools_log cdd)
    cdd_require_sqlite "$log" || return 1
    new="$TOOLS_WORK/cdd_lookup.pl"
    mkdir -p "$TOOLS_WORK/KohaEasy"
    cdd_page_script > "$new"
    cdd_pm > "$TOOLS_WORK/KohaEasy/CDD.pm"
    chmod 644 "$new" "$TOOLS_WORK/KohaEasy/CDD.pm"
    chmod 755 "$TOOLS_WORK/KohaEasy"
    display_explanation "Checking the page with the Perl modules of Koha..."
    if ! koha_exec "$log" perl-check /usr/bin/perl -I "$TOOLS_WORK" -c "$new"; then
        ui_textbox "$(t "CDD lookup")" "$log"
        msg_error "" "$(t 'The page does not compile with this version of Koha. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    cdd_installed && updating=1
    if [ "$link" = "yes" ] && ! cdd_js_latest; then
        tools_safety_backup CDD || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        cdd_js_sql add "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    { mkdir -p "${CDD_PM%/*}" \
        && install -o root -g root -m 644 "$TOOLS_WORK/KohaEasy/CDD.pm" "${CDD_PM}.new" && mv -f "${CDD_PM}.new" "$CDD_PM" \
        && install -o root -g root -m 755 "$new" "${CDD_FILE}.new" && mv -f "${CDD_FILE}.new" "$CDD_FILE"; } || {
        msg_error "" "$(t "The page could not be installed. Nothing was changed.")" 8 64; return 1; }
    printf 'installed=%s\nlink=%s\n' "$(date +%F)" "$link" > "$CDD_STATE"
    # Plack keeps compiled pages in memory: an updated page needs a restart.
    [ "$updating" = "1" ] && plack_restart
    url="/cgi-bin/koha/cataloguing/cdd_lookup.pl"
    [ -s "$CDD_DB" ] || note="$(t "The page asks for the index until it is built (option 1).")"
    log "cdd: page installed (link=$link)"
    msg_ok "$(t '✅ Page installed. In the staff interface: ${url}')"${note:+$'\n\n'"$note"} 11 76
}

lt_cdd_remove() {
    cdd_installed || cdd_js_on || { msg_info "$(t "CDD lookup")" "$(t "Not installed.")" 8 60; return 0; }
    prompt_yes_no "$(t "CDD lookup")" "$(t 'Remove the page and its buttons? The index (${CDD_DB}) is kept.')" 10 74 defaultno || return 0
    tools_locked _lt_cdd_remove
}

_lt_cdd_remove() {
    local log sql
    log=$(tools_log cdd)
    if cdd_js_on; then
        tools_safety_backup CDD || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        cdd_js_sql remove "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    rm -f "$CDD_FILE" "$CDD_STATE" "$CDD_PM"
    plack_restart
    log "cdd: page removed"
    msg_ok "$(t "✅ The page was removed.")"
}

# ======================================================================
# 35. KOHA PLUGINS (ON OR OFF)
# ----------------------------------------------------------------------
# Koha's own plugin system (Administration > Manage plugins) is off in a new
# Debian instance: <enable_plugins>0</enable_plugins> in koha-conf.xml. This
# turns it on or off without touching the plugins themselves: turned off,
# the plugin files and their data stay where they are, and turning it on
# again brings them back as they were. Also: whether .kpz files can be
# uploaded in the staff interface or only plugins of the plugin
# repositories installed (<plugins_restricted>), the plugins folder
# (<pluginsdir>, owned by the instance user) and Koha's own registration of
# plugins copied into that folder by hand (koha-plugins --install).
# koha-conf.xml is only replaced by a well-formed copy that reads back with
# the new values; the previous file stays next to it (koha-conf.xml.bak-*).
# ======================================================================
PLUGINS_DEFAULT_DIR="/var/lib/koha/${INSTANCE}/plugins"
# The repositories Koha's koha-conf.xml lists (commented out) as examples.
PLUGINS_REPOS="ByWater Solutions|bywatersolutions|github
Theke Solutions|thekesolutions|gitlab
PTFS Europe|ptfs-europe|github"

# Values of the main <config> section, read with xmllint: a tag inside an
# XML comment is not a setting and is never read.
plugins_conf_get()   { xmllint --xpath "string(/yazgfs/config/$1[1])" "$KOHA_CONF" 2>/dev/null | tr -d '[:space:]'; }
plugins_conf_count() { local n; n=$(xmllint --xpath "count(/yazgfs/config/$1)" "$KOHA_CONF" 2>/dev/null); printf '%s' "${n:-0}"; }
plugins_enabled()    { [ "$(plugins_conf_get enable_plugins)" = "1" ]; }
plugins_restricted() { [ "$(plugins_conf_get plugins_restricted)" = "1" ]; }
plugins_dir()        { local d; d=$(plugins_conf_get pluginsdir); printf '%s' "${d:-$PLUGINS_DEFAULT_DIR}"; }

# plugins_conf_edit TAG=VALUE [...]: new koha-conf.xml (path printed) with
# each simple tag of the main <config> section set to VALUE. A tag already
# there (outside comments) gets the new value; a missing one is added at the
# end of the section, like the <elasticsearch> block (the main section is
# closed by the LAST </config>; Zebra's <server> sections have <config>
# elements too). With KEI_PLUGIN_REPOS set, the repositories are also put
# into <plugin_repos> (inside an existing empty element, or a new one).
plugins_conf_edit() {
    local tmp
    tmp=$(mktemp "${KOHA_CONF}.XXXXXX") || return 1
    KEI_SET="$(printf '%s\n' "$@")" awk '
        BEGIN {
            n = split(ENVIRON["KEI_SET"], kv, "\n")
            for (i = 1; i <= n; i++) {
                if (kv[i] == "") continue
                p = index(kv[i], "="); tag = substr(kv[i], 1, p - 1)
                val[tag] = substr(kv[i], p + 1); order[++tags] = tag
            }
            m = split(ENVIRON["KEI_PLUGIN_REPOS"], rp, "\n")
            for (i = 1; i <= m; i++) {
                if (rp[i] == "") continue
                split(rp[i], f, "|")
                repos = repos "    <repo>\n        <name>" f[1] "</name>\n        <org_name>" f[2] "</org_name>\n        <service>" f[3] "</service>\n    </repo>\n"
            }
        }
        { line[NR] = $0; if (index($0, "</config>")) last = NR }
        END {
            incomment = 0
            for (i = 1; i <= NR; i++) {
                s = line[i]
                # Text of the line outside XML comments (a comment may span lines).
                out = ""; rest = s
                while (rest != "") {
                    if (incomment) {
                        e = index(rest, "-->"); if (!e) { rest = ""; break }
                        rest = substr(rest, e + 3); incomment = 0
                    } else {
                        b = index(rest, "<!--"); if (!b) { out = out rest; break }
                        out = out substr(rest, 1, b - 1); rest = substr(rest, b + 4); incomment = 1
                    }
                }
                for (t = 1; t <= tags; t++) {
                    tag = order[t]
                    if (!done[tag] && index(out, "<" tag ">") && index(out, "</" tag ">")) {
                        p = index(s, "<" tag ">"); q = index(s, "</" tag ">")
                        s = substr(s, 1, p + length(tag) + 1) val[tag] substr(s, q)
                        done[tag] = 1
                    }
                }
                if (repos != "" && !repodone && index(out, "</plugin_repos>")) {
                    q = index(s, "</plugin_repos>"); head = substr(s, 1, q - 1)
                    if (head ~ /[^ \t]/) { print head; head = "" }
                    printf "%s", repos
                    s = head substr(s, q); repodone = 1
                }
                if (i == last) {
                    p = index(s, "</config>")
                    if (p > 1) print substr(s, 1, p - 1)
                    for (t = 1; t <= tags; t++) if (!done[order[t]]) print " <" order[t] ">" val[order[t]] "</" order[t] ">"
                    if (repos != "" && !repodone) printf " <plugin_repos>\n%s </plugin_repos>\n", repos
                    s = substr(s, p)
                }
                print s
            }
        }' "$KOHA_CONF" > "$tmp" || { rm -f "$tmp"; return 1; }
    printf '%s' "$tmp"
}

# plugins_conf_apply LOG TAG=VALUE [...]: koha-conf.xml changed and checked;
# on any failure the file is left exactly as it was. Keeps the previous
# file as koha-conf.xml.bak-<time> (PLUGINS_BAK).
plugins_conf_apply() {
    local log="$1" tmp kv tag want
    shift
    command -v xmllint >/dev/null 2>&1 || apt_install libxml2-utils >/dev/null 2>&1
    command -v xmllint >/dev/null 2>&1 || { printf 'xmllint not available\n' >> "$log"; return 1; }
    local n=1 base
    base="${KOHA_CONF}.bak-$(date +%Y%m%d-%H%M%S)"; PLUGINS_BAK="$base"
    while [ -e "$PLUGINS_BAK" ]; do n=$((n + 1)); PLUGINS_BAK="${base}-${n}"; done
    cp -p "$KOHA_CONF" "$PLUGINS_BAK" || { printf 'could not back up %s\n' "$KOHA_CONF" >> "$log"; return 1; }
    tmp=$(plugins_conf_edit "$@") || return 1
    _replace_koha_conf "$tmp" || { printf 'the new koha-conf.xml was not well-formed: not used\n' >> "$log"; return 1; }
    for kv in "$@"; do
        tag="${kv%%=*}"; want="${kv#*=}"
        if [ "$(plugins_conf_get "$tag")" != "$want" ]; then
            printf 'koha-conf.xml: %s does not read back as %s: previous file restored\n' "$tag" "$want" >> "$log"
            cp -p "$PLUGINS_BAK" "$KOHA_CONF"
            return 1
        fi
        printf 'koha-conf.xml: %s = %s\n' "$tag" "$want" >> "$log"
    done
    if [ -n "${KEI_PLUGIN_REPOS:-}" ] && [ "$(plugins_conf_count 'plugin_repos/repo')" -eq 0 ]; then
        printf 'koha-conf.xml: the plugin repositories do not read back: previous file restored\n' >> "$log"
        cp -p "$PLUGINS_BAK" "$KOHA_CONF"
        return 1
    fi
    return 0
}

# The plugins folder exists and belongs to the instance user (Koha unpacks
# uploaded .kpz files there). Only folders of this instance are chowned.
plugins_dir_ready() {
    local d
    d=$(plugins_dir)
    mkdir -p "$d" || return 1
    case "$d" in
        "/var/lib/koha/${INSTANCE}/"*) chown -R "${INSTANCE}-koha:${INSTANCE}-koha" "$d" 2>/dev/null || true ;;
    esac
    chmod 755 "$d"
}

# Koha reads koha-conf.xml when its processes start: Plack and the
# background workers are restarted and the cached settings dropped.
plugins_reload() {
    memcached_flush || true
    plack_restart
    if [ -x /usr/sbin/koha-worker ]; then
        koha_ctl /usr/sbin/koha-worker --restart "$INSTANCE" >/dev/null 2>&1 || true
        koha_ctl /usr/sbin/koha-worker --restart --queue long_tasks "$INSTANCE" >/dev/null 2>&1 || true
    fi
}

function_koha_plugins() {
    require_database || return 0
    [ -f "$KOHA_CONF" ] || { msg_error "" "$(t "koha-conf.xml of the instance was not found. Nothing was changed.")" 9 70; return 1; }
    # The state shown comes from xmllint (package libxml2-utils).
    command -v xmllint >/dev/null 2>&1 || apt_install libxml2-utils >/dev/null 2>&1
    local opt state source status
    while true; do
        if plugins_enabled; then state="$(t "on")"; else state="$(t "off")"; fi
        if plugins_restricted; then source="$(t "only the plugin repositories")"; else source="$(t ".kpz upload and the plugin repositories")"; fi
        status="$(t 'Now: ${state}')"$'\n'"$(t 'Installation: ${source}')"$'\n'"$(t "Folder"): $(plugins_dir)"
        opt=$(ui_menu "$(t "🧩  Koha plugins (turn on or off)")" "$(t "Koha's own plugin system (Administration > Manage plugins). Turning it off keeps the plugins and their data: turned on again, they come back as they were.")"$'\n\n'"$status" \
            "1" "$(t "Turn Koha plugins on")" \
            "2" "$(t "Turn Koha plugins off")" \
            "3" "$(t "Where plugins can be installed from")" \
            "4" "$(t "Register plugins copied into the folder")") || return 0
        case "$opt" in
            1) lt_plugins_on ;;
            2) lt_plugins_off ;;
            3) lt_plugins_source ;;
            4) lt_plugins_register ;;
        esac
        clear
    done
}

lt_plugins_on() {
    if plugins_enabled && [ -d "$(plugins_dir)" ]; then
        msg_info "$(t "Koha plugins")" "$(t "Koha plugins are already on.")" 8 60
        return 0
    fi
    prompt_yes_no "$(t "Koha plugins")" "$(t "Turn on Koha's plugin system? Administration > Manage plugins appears in the staff interface, for the staff with the plugins permission. koha-conf.xml is changed (the previous file is kept next to it) and Koha is restarted.")" 12 76 || return 0
    tools_locked _lt_plugins_set 1
}

lt_plugins_off() {
    if ! plugins_enabled; then
        msg_info "$(t "Koha plugins")" "$(t "Koha plugins are already off.")" 8 60
        return 0
    fi
    prompt_yes_no "$(t "Koha plugins")" "$(t "Turn off Koha's plugin system? No plugin runs while it is off; the plugins and their data are kept for when it is turned on again. koha-conf.xml is changed (the previous file is kept next to it) and Koha is restarted.")" 12 76 defaultno || return 0
    tools_locked _lt_plugins_set 0
}

_lt_plugins_set() {   # _lt_plugins_set 1|0
    local want="$1" log args=()
    log=$(tools_log plugins)
    args=("enable_plugins=$want")
    if [ "$want" = "1" ]; then
        # A missing <pluginsdir> is added with Debian's own folder.
        [ "$(plugins_conf_count pluginsdir)" -gt 0 ] || args+=("pluginsdir=$PLUGINS_DEFAULT_DIR")
        [ "$(plugins_conf_count plugins_restricted)" -gt 0 ] || args+=("plugins_restricted=0")
    fi
    if ! plugins_conf_apply "$log" "${args[@]}"; then
        msg_error "" "$(t 'koha-conf.xml could not be changed. Nothing was changed.\n\nLog: ${log}')" 10 72
        return 1
    fi
    if [ "$want" = "1" ]; then
        plugins_dir_ready || printf 'the plugins folder could not be prepared\n' >> "$log"
        # Koha before 21.05 also needs the UseKohaPlugins preference (gone later).
        if [ -n "$(run_sql "SELECT variable FROM ${DB_NAME}.systempreferences WHERE variable = 'UseKohaPlugins';")" ]; then
            run_sql "UPDATE ${DB_NAME}.systempreferences SET value = '1' WHERE variable = 'UseKohaPlugins';" >/dev/null
            printf 'UseKohaPlugins = 1\n' >> "$log"
        fi
    fi
    plugins_reload
    log "plugins: enable_plugins=$want (previous koha-conf.xml: $PLUGINS_BAK)"
    if [ "$want" = "1" ]; then
        msg_ok "$(t "✅ Koha plugins are on: Administration > Manage plugins in the staff interface.")" 9 72
    else
        msg_ok "$(t "✅ Koha plugins are off. The plugins and their data were kept.")" 8 70
    fi
}

lt_plugins_source() {
    local choice now
    if plugins_restricted; then now="$(t "only the plugin repositories")"; else now="$(t ".kpz upload and the plugin repositories")"; fi
    choice=$(ui_menu "$(t "Where plugins can be installed from")" "$(t 'Now: ${now}')" \
        "open" "$(t "Upload .kpz files and the plugin repositories")" \
        "restricted" "$(t "Only the plugin repositories (no .kpz upload)")") || return 0
    tools_locked _lt_plugins_source "$choice"
}

_lt_plugins_source() {   # _lt_plugins_source open|restricted
    local log want=0 repos=""
    log=$(tools_log plugins)
    [ "$1" = "restricted" ] && want=1
    if [ "$want" = "1" ] && [ "$(plugins_conf_count 'plugin_repos/repo')" -eq 0 ]; then
        if [ "$(plugins_conf_count plugin_repos)" -gt 1 ] || grep -q '<plugin_repos */>' "$KOHA_CONF"; then
            printf 'plugin_repos: layout not recognised, left as it is\n' >> "$log"
        elif prompt_yes_no "$(t "Where plugins can be installed from")" "$(t "No plugin repository is set, so nothing new could be installed from the staff interface. Add the repositories koha-conf.xml lists as examples (ByWater Solutions, Theke Solutions, PTFS Europe)?")" 11 76; then
            repos="$PLUGINS_REPOS"
        fi
    fi
    if ! KEI_PLUGIN_REPOS="$repos" plugins_conf_apply "$log" "plugins_restricted=$want"; then
        msg_error "" "$(t 'koha-conf.xml could not be changed. Nothing was changed.\n\nLog: ${log}')" 10 72
        return 1
    fi
    plugins_reload
    log "plugins: plugins_restricted=$want (previous koha-conf.xml: $PLUGINS_BAK)"
    if [ "$want" = "1" ]; then
        msg_ok "$(t "✅ Plugins can only be installed from the plugin repositories.")" 8 70
    else
        msg_ok "$(t "✅ Plugins can be uploaded as .kpz files or installed from the plugin repositories.")" 9 72
    fi
}

lt_plugins_register() {
    local d
    d=$(plugins_dir)
    if ! plugins_enabled; then
