        preview.append("Patrons ready: %d" % pats.stats["ready"])
        preview.append("Names and places typed in capitals, recased: %d" % pats.stats["casing"])
        preview.append("Rejected: %d" % len(pats.rejected))
        preview.append("Invalid CPF (imported, not kept as CPF): %d" % pats.stats["invalid_cpf"])
        preview.append("Duplicates: %d" % pats.stats["duplicates"])
        if pats.card_from_cpf:
            preview.append("No card number column: the CPF is used as the card number.")
        if any(r["patron_attributes"] for r in pats.rows) or not opts.cpf_attr:
            if not opts.cpf_attr and any(c.role == "cpf" for p in a.tables for c in p.columns) and not pats.card_from_cpf:
