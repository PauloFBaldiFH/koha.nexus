HEADERS = {role: set(spec[2].split("|")) for role, spec in ROLES.items()}
ENTITY_ROLES = {e: [r for r, s in ROLES.items() if s[0] == e] for e in ("bib", "pat", "circ")}
# Roles that a table holds once (the others may repeat and are joined).
MULTI = {"notes", "subjects", "coauthors", "patronnote"}
# Roles whose column holds few distinct values.
FEW = {"itemtype", "category", "language", "sex", "state", "active", "itemstatus"}
# Roles that must be (almost) distinct in their column.
UNIQUE = {"tombo", "barcode", "cardnumber"}
# Accepted from their values alone (check digits or an unmistakable shape).
STRONG = {"isbn", "issn", "cpf", "email"}

BIB_EVIDENCE = {"isbn": 2, "issn": 1, "title": 2, "publisher": 1, "year": 1, "edition": 1, "pages": 1,
                "cdd": 1, "cdu": 1, "callnumber": 1, "tombo": 1, "subjects": 1, "cutter": 1}
PAT_EVIDENCE = {"cpf": 2, "rg": 1, "email": 1, "phone": 1, "mobile": 1, "zipcode": 1, "address": 1,
                "dateofbirth": 1, "category": 1, "cardnumber": 1}
CIRC_EVIDENCE = {"loandate": 1, "duedate": 1, "returndate": 1, "holddate": 1}

# Koha's own patron columns (import_patrons.pl reads them as they are).
KOHA_BORROWER = set("""cardnumber surname firstname middle_name title othernames initials pronouns streetnumber
streettype address address2 city state zipcode country email phone mobile fax emailpro phonepro
B_streetnumber B_streettype B_address B_address2 B_city B_state B_zipcode B_country B_email B_phone
dateofbirth branchcode categorycode dateenrolled dateexpiry date_renewed gonenoaddress lost debarred
debarredcomment contactname contactfirstname contacttitle borrowernotes relationship sex password
