# readonly.cnf (written by the panel, readable by root and the instance
# user): dsn=, user=, password= lines.
sub connect_ro {
    my ($cnf) = @_;
    my %c;
    open( my $fh, '<', $cnf ) or die "NOT_SET_UP\n";
    while (<$fh>) { chomp; my ( $k, $v ) = split /=/, $_, 2; $c{$k} = $v if defined $v && $k =~ /^(dsn|user|password)$/ }
    close $fh;
    die "NOT_SET_UP\n" unless $c{dsn};
    my $mysql = $c{dsn} =~ /^dbi:mysql:/i;
    my $dbh = DBI->connect( $c{dsn}, $c{user}, $c{password}, { RaiseError => 1, PrintError => 0, AutoCommit => 1, $mysql ? ( mysql_enable_utf8 => 1 ) : () } )
        or die "the read-only database account could not log in\n";
    if ($mysql) {
        $dbh->do('SET NAMES utf8mb4');
        $dbh->do('SET SESSION TRANSACTION READ ONLY');
        $dbh->do('SET SESSION max_statement_time = 10');
    }
    return $dbh;
}

sub _rows {
    my ( $ctx, $sql ) = @_;
    my $rows = eval { $ctx->{dbh}->selectall_arrayref( $sql, { Slice => {} } ) };
    if ( !$rows ) {
        my $e = $@ || $DBI::errstr || 'query failed';
        $e =~ s/ at \S+ line \d+.*//s;
        die { error => 'database: ' . substr( $e, 0, 300 ) };
    }
    return $rows;
}

# ----------------------------------------------------------------------
# Quoting (the only way a model string reaches the SQL of the tools)
# ----------------------------------------------------------------------
sub lit {
    my ( $s, $max ) = @_;
    $s = defined $s ? "$s" : '';
    $s =~ s/[\\\x00-\x1f%]//g;
    $s = substr( $s, 0, $max || 80 );
    $s =~ s/'/''/g;
    return "'$s'";
}
sub like { my $s = lit(shift); return "'%" . substr( $s, 1, -1 ) . "%'" }

sub _num {
    my ( $v, $name ) = @_;
    ( my $n = $v // '' ) =~ s/,/./;
    die { error => "$name must be a number" } unless $n =~ /^-?\d+(?:\.\d+)?$/;
    return $n + 0;
}

