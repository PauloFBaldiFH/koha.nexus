# Drop folders that exist, one per line. The first one (in the home of the
# panel's user) is created the first time the tool opens.
magic_drop_dirs() {
    local d first=1
    # shellcheck disable=SC2086  # a list of folders
    for d in $MAGIC_DROP_DIRS; do
        # The one in the home always; the others where their parent exists
        # (C:\Koha on Windows, or C:\KohaEasy for an install made before the
        # folder was renamed).
        if [ "$first" = 1 ] && [ ! -d "$d" ]; then
            mkdir -p "$d" 2>/dev/null && chown "${REAL_USER:-root}:" "$d" 2>/dev/null
        elif [ ! -d "$d" ] && [ -d "${d%/*}" ]; then
            mkdir "$d" 2>/dev/null
        fi
        first=0
        [ -d "$d" ] && printf '%s\n' "$d"
    done
    return 0
}

# A folder as the operator knows it: C:\Koha\Importar, not /mnt/c/... (Windows).
magic_shown_path() {
    local p="$1"
    if [[ "$p" =~ ^/mnt/([a-z])(/.*)?$ ]]; then
        p="${BASH_REMATCH[2]:-/}"
        printf '%s:%s' "${BASH_REMATCH[1]^^}" "${p//\//\\}"
    else
        printf '%s' "$p"
    fi
}

# The file, folder or archive to import: what waits in the drop folders,
# or any file picked in the file explorer.
magic_pick() {
    local dirs=() items=() paths=() d f n=0 choice shown="" prompt
    mapfile -t dirs < <(magic_drop_dirs)
    for d in "${dirs[@]}"; do
        shown+="${shown:+  /  }$(magic_shown_path "$d")"
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            n=$((n + 1)); paths[n]="$d/$f"
            if [ -d "$d/$f" ]; then items+=("$n" "${f:0:44}/"); else items+=("$n" "${f:0:44}"); fi
        done < <(find "$d" -mindepth 1 -maxdepth 1 ! -name '.*' ! -iname 'desktop.ini' ! -iname 'Thumbs.db' -printf '%f\n' 2>/dev/null | sort | head -n 60)
    done
    prompt=$(t "Don't question it, just drop here what you want to import: a spreadsheet, MARC, the backup of the old system, an archive... Files left in \${shown} are offered first.")
    if [ "$n" -eq 0 ]; then
        select_file "$REAL_HOME" "*" "$prompt" "$(t "File")"
        return
    fi
    items+=("other" "$(t "Another file (file explorer)")")
    choice=$(ui_menu "$(t "🪄  Magic Import Tool")" "$(t "Don't question it, just drop here what you want to import.\n\nWaiting in \${shown}:")" "${items[@]}") || return 1
    if [ "$choice" = "other" ]; then
        select_file "$REAL_HOME" "*" "$prompt" "$(t "File")"
        return
    fi
    [ -n "${paths[choice]:-}" ] || return 1
    printf '%s' "${paths[choice]}"
}

# magic_is_koha_dump FILE: 0 when FILE (plain or gzip) is a mysqldump of a
# Koha database: the dump header, then at least four of Koha's core tables.
# Read as a stream, so a backup of several GB is never copied; the engine
# applies the same rule inside archives.
magic_is_koha_dump() {
    local head
    head=$(gzip -dcf -- "$1" 2>/dev/null | head -c 4096 | tr -d '\0')
    [[ "$head" == *"-- MySQL dump"* || "$head" == *"-- MariaDB dump"* ]] || return 1
    gzip -dcf -- "$1" 2>/dev/null | LC_ALL=C awk '
        /^CREATE TABLE `(biblio|biblio_metadata|items|borrowers|systempreferences|marc_subfield_structure)`/ {
            if (!($3 in seen)) { seen[$3] = 1; n++ }
            if (n >= 4) { found = 1; exit }
        }
        END { exit !found }'
}

# magic_to_restore SHOWN: asks before a Koha backup goes to Restore database.
magic_to_restore() {
    local shown="$1"
    prompt_yes_no "$(t "Koha backup")" "$(t '"${shown}" is a Koha backup: a full copy of a Koha database, not a list of records. It replaces the whole catalog, so it goes to Restore database, which tests it in a temporary database first.\n\nOpen Restore database with it?')" 14 76
}

# magic_keep_backup PATH CODEC SHOWN: the Koha backup found in an archive or
# folder, copied (decompressed if needed) where Restore database reads it
# once the import tool has let go of its work folder and its lock.
magic_keep_backup() {
    local path="$1" codec="$2" name="${3##*/}" dir
    name="${name//[^A-Za-z0-9._-]/_}"; name="${name%.gz}"; name="${name%.bz2}"; name="${name%.xz}"
    [[ "${name,,}" == *.sql ]] || name="${name}.sql"
    dir=$(mktemp -d /var/tmp/kei-restore.XXXXXX) || return 1
    case "$codec" in
        gz)  cp -f -- "$path" "$dir/${name}.gz" && name="${name}.gz" ;;
        bz2) bzip2 -dc -- "$path" > "$dir/$name" ;;
        xz)  xz -dc -- "$path" > "$dir/$name" ;;
        *)   cp -f -- "$path" "$dir/$name" ;;
    esac || { rm -rf "$dir"; return 1; }
    chmod 600 "$dir/$name"
    MAGIC_RESTORE="$dir/$name"; MAGIC_RESTORE_DIR="$dir"
}

# magic_backup_found LINE IMPORTABLE: a Koha backup inside the dropped
# archive or folder ("path<TAB>codec<TAB>name", from the engine). 0 = go on
# importing the other files; 1 = stop here (the backup then goes to Restore
# database, or the operator gave up).
magic_backup_found() {
    local path codec shown choice
    IFS=$'\t' read -r path codec shown <<< "$1"
    if [ "${2:-0}" -gt 0 ]; then
        choice=$(ui_menu "$(t "Koha backup")" "$(t '"${shown}" is a Koha backup: a full copy of a Koha database, which replaces the whole catalog. The other files can be imported instead.')" \
            "restore" "$(t "Restore database with the backup")" \
            "import"  "$(t "Import the other files (leave the backup out)")") || return 1
        if [ "$choice" = "import" ]; then MAGIC_SKIP_BACKUP=1; return 0; fi
    else
        magic_to_restore "$shown" || return 1
    fi
    if ! magic_keep_backup "$path" "$codec" "$shown"; then
        msg_error "" "$(t "The file could not be copied to the work folder.\nNothing was changed.")" 10 70
    fi
    return 1
}

# magic_copy_input SRC: copy of SRC (file or folder) in the engine's work
# folder, readable by the instance user only (it may hold patron data);
# prints its path. A Biblioteca Fácil table (T09_ACER.dat...) comes with the
# other tables of its folder.
magic_copy_input() {
    local src="${1%/}" dst="$MAGIC_WORK/input" name base need free
    name="${src##*/}"; name="${name//[$'\'\n\r\t']/_}"
    need=$(du -sm -- "$src" 2>/dev/null | cut -f1)
    free=$(get_free_space_mb "$TOOLS_WORK")
    # The copy, and as much again twice for what the engine unpacks and builds.
    if [ $(( ${need:-0} * 3 + 64 )) -gt "${free:-0}" ]; then
        msg_error "" "$(t 'Not enough free space in /tmp for the import: about ${need} MB, three times over, and ${free} MB are free.\nNothing was changed.')" 11 76
        return 1
    fi
    mkdir -p "$dst" || return 1
    if [ -d "$src" ]; then
        cp -r -- "$src" "$dst/$name" || return 1
    elif [[ "${name,,}" =~ ^t[0-9][0-9]_[a-z0-9]+\.dat$ ]]; then
        name="$(basename -- "$(dirname -- "$src")")"; name="${name//[$'\'\n\r\t']/_}"
        [ "$name" = "/" ] && name="dados"
        mkdir -p "$dst/$name" || return 1
        find "$(dirname -- "$src")" -maxdepth 1 -type f -iname 'T[0-9][0-9]_*.dat' -exec cp -f -- {} "$dst/$name/" \; || return 1
    else
        cp -f -- "$src" "$dst/$name" || return 1
        # A dBase table keeps its long texts in a memo file next to it.
        if [[ "${name,,}" == *.dbf ]]; then
            base="${src##*/}"; base="${base%.*}"
            find "$(dirname -- "$src")" -maxdepth 1 -type f \( -iname "${base}.dbt" -o -iname "${base}.fpt" \) -exec cp -f -- {} "$dst/" \;
        fi
    fi
    chown -R "${INSTANCE}-koha:" "$dst" 2>/dev/null || true
    chmod -R go-rwx "$dst"
    printf '%s' "$dst/$name"
}

# magic_engine LOG analyse|build [OPTIONS...]: the engine, as the instance
# user (koha-shell), on the copy of the dropped file.
magic_engine() {
    local log="$1"
    shift
    koha_exec "$log" kei_import "$MAGIC_PY" -I -B "$MAGIC_ENGINE/kei_import_run.py" "$@" \
        --in "$MAGIC_INPUT" --work "$MAGIC_WORK" --answers "$MAGIC_WORK/answers.tsv" \
        --profiles "$MAGIC_WORK/profiles" --readers "$MAGIC_ENGINE/readers" --yaz "$YAZ_MARCDUMP" \
        --branches "$MAGIC_WORK/branches.tsv" --itypes "$MAGIC_WORK/itemtypes.tsv" --locations "$MAGIC_WORK/locations.tsv"
}

# magic_need_packages "PKG..." "TRIED...": Debian packages a format needs
# (python3-xlrd for .xls, yaz for legacy MARC), installed with the
# operator's OK. 1 when one is refused or still missing after a try.
magic_need_packages() {
    local p
    # shellcheck disable=SC2086  # lists of package names
    for p in $1; do
        if [[ " $2 " == *" $p "* ]]; then
            msg_error "" "$(t 'The ${p} package could not be installed. Nothing was changed.')" 9 70
            return 1
        fi
    done
    # shellcheck disable=SC2086
    for p in $1; do
        if [ "$p" = "yaz" ]; then
            require_yaz || return 1
        else
            prompt_yes_no "$(t "Missing tool")" "$(t 'This file needs the ${p} package (Debian).\n\nInstall it now?')" 10 72 || return 1
            apt_install "$p" >/dev/null 2>&1
        fi
    done
    return 0
}

