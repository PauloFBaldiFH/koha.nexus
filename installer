# cat_cdd_lookup QUERY OUT: by number (the chain of classes above it and
# the entries below it) or by word (captions containing it), plus how the
# catalogue already uses the number or the word.
cat_cdd_lookup() {
    local q="$1" out="$2" table like
    table=$(cat_table_path cdd)
    {
        if [[ "$q" =~ ^[0-9]{1,3}(\.[0-9]*)?$ ]]; then
            q="${q%.}"
            printf '%s %s\n\n' "$(t "CDD number")" "$q"
            { cat_ddc_classes; [ -s "$table" ] && cat "$table"; } | LC_ALL=C awk -F'\t' -v q="$q" '
                function sig(n) { if (n ~ /\./) return n; sub(/0+$/, "", n); return n == "" ? "0" : n }
                !($1 in seen) { seen[$1] = 1; p = sig($1)
                    if (index(q, p) == 1) up[$1] = $2
                    else if (index($1, q) == 1 && length($1) <= length(q) + 2 && $1 != q) down[$1] = $2 }
                END {
                    n = 0; for (k in up) keys[++n] = k
                    for (i = 2; i <= n; i++) { x = keys[i]; for (j = i - 1; j >= 1 && keys[j] > x; j--) keys[j + 1] = keys[j]; keys[j + 1] = x }
                    for (i = 1; i <= n; i++) printf "  %-10s %s\n", keys[i], up[keys[i]]
                    m = 0; for (k in down) d[++m] = k
                    for (i = 2; i <= m; i++) { x = d[i]; for (j = i - 1; j >= 1 && d[j] > x; j--) d[j + 1] = d[j]; d[j + 1] = x }
                    if (m) print ""
                    for (i = 1; i <= m && i <= 60; i++) printf "      %-10s %s\n", d[i], down[d[i]]
                }'
            like=$(sql_quote "${q}%")
            printf '\n%s\n' "$(t "In the catalogue (items by class number):")"
            run_sql "SELECT SUBSTRING_INDEX(TRIM(itemcallnumber), ' ', 1) AS c, COUNT(*) FROM ${DB_NAME}.items WHERE itemcallnumber LIKE ${like} GROUP BY c ORDER BY c LIMIT 40;" \
                | awk -F'\t' '{ printf "  %-12s %s\n", $1, $2 } END { if (NR == 0) print "  -" }'
        else
            printf '%s: %s\n\n' "$(t "Subject")" "$q"
            { cat_ddc_classes; [ -s "$table" ] && cat "$table"; } | awk -F'\t' -v q="$q" "$(cat_awk_lib)"'
                BEGIN { w = tolower(unaccent(q)) }
                { c = tolower(unaccent($2)); if (index(c, w)) { printf "  %-10s %s\n", $1, $2; n++ } if (n >= 60) exit }
                END { if (!n) print "  -" }'
            [ -s "$table" ] || printf '\n%s\n' "$(t "Only the main classes are built in: load the CDD schedule of your library to search all of it.")"
            like=$(sql_quote "%$(printf '%s' "$q" | sed 's/[%_\\]/\\&/g')%")
            printf '\n%s\n' "$(t "How the catalogue classified titles with this word:")"
            run_sql "SELECT SUBSTRING_INDEX(TRIM(i.itemcallnumber), ' ', 1) AS c, COUNT(*) AS n FROM ${DB_NAME}.items i JOIN ${DB_NAME}.biblio b ON b.biblionumber = i.biblionumber WHERE b.title LIKE ${like} AND i.itemcallnumber REGEXP '^[0-9]{3}' GROUP BY c ORDER BY n DESC, c LIMIT 15;" \
                | awk -F'\t' '{ printf "  %-12s %s\n", $1, $2 } END { if (NR == 0) print "  -" }'
        fi
    } > "$out"
}

lt_cat_cdd() {
    local q out
    q=$(ui_input "$(t "CDD")" "$(t "Class number (e.g. 869.3) or a word of the subject (e.g. poetry):")" "") || return 0
    q="${q#"${q%%[![:space:]]*}"}"; q="${q%"${q##*[![:space:]]}"}"
    [ -n "$q" ] || return 0
    if [ "${#q}" -gt 60 ]; then
        msg_error "" "$(t "The text is too long.")" 8 60
        return 1
    fi
    tools_workdir || return 1
    out="$TOOLS_WORK/cdd.txt"
    cat_cdd_lookup "$q" "$out"
    ui_textbox "$(t "CDD")" "$out"
}

lt_cat_load() {
    local kind="${1:-}" file utf8 new report problems entries
    [ -n "$kind" ] || kind=$(ui_menu "$(t "Load a table")" "$(t "The tables are copyrighted and are not distributed with the panel. Load the copy of your library: a text file (UTF-8 or Windows-1252) with one entry and its number per line, e.g. Sampaio M.;184, or the rows of the PHA book as printed (Rau 184 Sampaio M.).")" \
        "pha"    "$(cat_table_name pha)" \
        "cutter" "Cutter-Sanborn" \
        "cdd"    "$(t "CDD (Dewey) schedule: number and caption per line")") || return 0
    if [ "$kind" = "pha" ]; then
        file=$(select_file "$REAL_HOME" "txt csv tsv pdf" "$(t "Pick the table file (.txt, .csv, .tsv, or the PDF of the book, even scanned):")" "$(t "Table")") || return 0
    else
        file=$(select_file "$REAL_HOME" "txt csv tsv" "$(t "Pick the table file (.txt, .csv or .tsv):")" "$(t "Table")") || return 0
    fi
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    tools_workdir || return 1
    utf8="$TOOLS_WORK/table-utf8.txt"; new="$TOOLS_WORK/table.tsv"; report="$TOOLS_WORK/table-report.txt"
    local pdfrep="" log fixed rows
    if [ "$(head -c 5 "$file" 2>/dev/null)" = "%PDF-" ]; then
        log=$(tools_log tables)
        pdfrep="$TOOLS_WORK/table-pdf-report.txt"
        if [ "$kind" != "pha" ] || ! cat_pdf_rows "$kind" "$file" "$utf8" "$log" > "$pdfrep" || [ ! -s "$utf8" ]; then
            msg_error "" "$(t 'The rows of the table could not be read from this PDF. Nothing was changed.\n\nLog: ${log}')" 10 74
            return 1
        fi
    elif file_is_utf8 "$file"; then cp -f -- "$file" "$utf8"; else iconv -f WINDOWS-1252 -t UTF-8 "$file" > "$utf8" 2>/dev/null || return 1; fi
    : > "$new"
    cat_table_import "$kind" "$utf8" "$new" > "$report" 2>&1
    entries=$(sed -n 's/^@@entries //p' "$report"); problems=$(sed -n 's/^@@problems //p' "$report")
    sed -i '/^@@/d' "$report"
    {
        printf '%s\n\n' "$(cat_table_name "$kind")"
        if [ -n "$pdfrep" ]; then
            rows=$(sed -n 's/^rows=//p' "$pdfrep"); fixed=$(sed -n 's/^fixed=//p' "$pdfrep")
            printf '%s\n' "$(t 'Rows read from the PDF: ${rows}')"
            printf '%s\n' "$(t 'Numbers corrected by their order, as the OCR misread them (check them against the book): ${fixed}')"
            sed -n 's/^fix=/  /p' "$pdfrep"
            printf '\n'
        fi
        cat "$report"
    } > "$report.2" && mv -f "$report.2" "$report"
    ui_textbox "$(t "Load a table")" "$report"
    if [ "${entries:-0}" = "0" ]; then
        msg_error "" "$(t "No entry was understood. Nothing was changed.")" 8 64
        return 1
    fi
    if [ "${problems:-0}" != "0" ]; then
        prompt_yes_no "$(t "Load a table")" "$(t 'The file has ${problems} problem(s) listed in the report. Load the ${entries} entries anyway? You can correct the file and load it again later.')" 11 74 defaultno || return 0
    else
        prompt_yes_no "$(t "Load a table")" "$(t 'Load the ${entries} entries? A table loaded before is replaced.')" 9 70 || return 0
    fi
    mkdir -p "$CAT_DIR" && chmod 755 "$CAT_DIR"
    install -m 644 "$new" "$(cat_table_path "$kind").new" && mv -f "$(cat_table_path "$kind").new" "$(cat_table_path "$kind")" || return 1
    log "cataloguing: $kind table loaded ($entries entries from $file)"
    msg_ok "$(t '✅ Table loaded: ${entries} entries.')" 8 60
}

lt_cat_remove() {
    local items=() k kind
    for k in pha cutter cdd; do [ -s "$(cat_table_path "$k")" ] && items+=("$k" "$(cat_table_name "$k") ($(cat_table_count "$k"))"); done
    if [ ${#items[@]} -eq 0 ]; then
        msg_info "$(t "Remove a table")" "$(t "No table is loaded.")" 8 60
        return 0
    fi
    kind=$(ui_menu "$(t "Remove a table")" "$(t "Table to remove from this server:")" "${items[@]}") || return 0
    prompt_yes_no "$(t "Remove a table")" "$(t "Remove this table from the server? The catalogue is not changed.")" 9 70 defaultno || return 0
    rm -f "$(cat_table_path "$kind")"
    log "cataloguing: $kind table removed"
    msg_ok "$(t "✅ Table removed.")"
}

function_cataloguing() {
    require_database || return 0
    local opt status tables=()
    # Loading and removing tables is kept out of the menu (ROADMAP subject 1);
    # KEI_TABLE_UPLOAD=1 shows it again (lt_cat_load / lt_cat_remove).
    [ "${KEI_TABLE_UPLOAD:-0}" = "1" ] && tables=(
            "4" "$(t "Load a table (PHA, Cutter-Sanborn, CDD)")"
            "5" "$(t "Remove a table")")
    while true; do
        status="$(t "Loaded tables"): PHA $(cat_table_count pha), Cutter-Sanborn $(cat_table_count cutter), CDD $(cat_table_count cdd)"
        opt=$(ui_menu "$(t "📝  Cataloguing aids: PHA, Cutter, CDD")" "$(t "Read-only helpers: nothing in the catalogue is changed.")"$'\n'"$status" \
            "1" "$(t "Author notation (PHA or Cutter-Sanborn)")" \
            "2" "$(t "Author notation of a catalogue record")" \
            "3" "$(t "CDD: look up a number or a subject")" \
            "${tables[@]}") || return 0
        case "$opt" in
            1) lt_cat_notation ;;
            2) lt_cat_record ;;
            3) lt_cat_cdd ;;
            4) lt_cat_load ;;
            5) lt_cat_remove ;;
        esac
        clear
    done
}

