    @staticmethod
    def profile_key(headers):
        return hashlib.sha1(json.dumps([R.norm_header(h) for h in headers]).encode("utf-8")).hexdigest()[:16]

    def load_profile(self, headers):
        if not self.profiles_dir or not headers:
            return None
        p = os.path.join(self.profiles_dir, self.profile_key(headers) + ".tsv")
        if not os.path.exists(p):
            return None
        prof = {"entity": None, "roles": {}}
        with open(p, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if parts[0] == "entity" and len(parts) >= 2:
                    prof["entity"] = parts[1]
                elif parts[0] == "column" and len(parts) >= 4 and parts[1].isdigit():
                    prof["roles"][int(parts[1])] = parts[3] if parts[3] != "-" else ""
        return prof

    @staticmethod
    def save_profile(out_dir, headers, entity, columns):
        os.makedirs(out_dir, exist_ok=True)
        key = Questions.profile_key(headers)
        with open(os.path.join(out_dir, key + ".tsv"), "w", encoding="utf-8") as fh:
            fh.write("entity\t%s\n" % entity)
            for c in columns:
                fh.write("column\t%d\t%s\t%s\n" % (c.index, flat(c.header, 60), c.role or "-"))
        return key
