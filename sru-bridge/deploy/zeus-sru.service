# systemd unit for the Zeus SRU bridge, for a Koha server installed by hand
# (the koha.nexus installer writes its own unit, koha-zeus-sru, the same way).
# Ports: 5000 Zeus here (the SRU gateway on the central server), 5006 Pergamum.
# Keep it on 127.0.0.1: only the Koha on this machine talks to it. The
# central server runs sru-gateway instead, which embeds Zeus and Pergamum.
# Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now zeus-sru
[Unit]
Description=Zeus SRU bridge (Koha -> Catálogo Zeus/UFSC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/koha.nexus/sru-bridge
Environment=ZEUS_SRU_HOST=127.0.0.1
Environment=ZEUS_SRU_PORT=5000
ExecStart=/opt/koha.nexus/sru-bridge/.venv/bin/python -m zeus_sru
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
