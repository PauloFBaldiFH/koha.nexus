# systemd unit for the Zeus SRU bridge.
# Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now zeus-sru
[Unit]
Description=Zeus SRU bridge (Koha -> Catálogo Zeus/UFSC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/koha.nexus/sru-bridge
Environment=ZEUS_SRU_HOST=127.0.0.1
Environment=ZEUS_SRU_PORT=5000
ExecStart=/opt/koha.nexus/sru-bridge/.venv/bin/python -m zeus_sru
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
