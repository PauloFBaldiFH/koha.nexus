# systemd unit for the koha.nexus SRU gateway (the central server: one
# SRU database per catalogue, /sru/{id}). It runs the Zeus and Pergamum
# clients in-process, so do not also run zeus-sru on port 5000 there.
# Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now sru-gateway
[Unit]
Description=koha.nexus SRU gateway (Koha -> 48 catalogues by /sru/{id})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/koha.nexus/sru-bridge
# Koha servers reach it over the internet: listen on every address and
# open port 5000 in the firewall (and the cloud's security list).
Environment=SRU_GATEWAY_HOST=0.0.0.0
Environment=SRU_GATEWAY_PORT=5000
# Logins, when a catalogue needs one: SRU_GATEWAY_LOGIN_<ID>=user:password
EnvironmentFile=-/etc/default/sru-gateway
ExecStart=/opt/koha.nexus/sru-bridge/.venv/bin/python -m sru_gateway
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
