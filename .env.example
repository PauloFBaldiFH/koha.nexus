# Copy to /etc/koha-easy-install/.env (root only: chmod 600), or point
# KEI_ENV_FILE at another file. Real values never go into the repository:
# .env is in .gitignore. A variable already set in the environment wins.
#
# The koha.nexus panel's own database logins are not here: it reads them
# from Koha's /etc/koha/sites/<instance>/koha-conf.xml at run time.

# Bibliothèque nationale de France (Z39.50): the public login the BnF
# publishes for its catalogue. Leave empty to type it with Login instead.
KEI_Z3950_BNF_USER=
KEI_Z3950_BNF_PASSWORD=
