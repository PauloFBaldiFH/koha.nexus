+/** Koha.Nexus cookie preference isolation. SPDX-License-Identifier: GPL-3.0-or-later */
+import type { Operation } from 'fast-json-patch';
+
+/** A stale user snapshot must never undo unrelated profile updates. */
+export function cookieMetadataOperations(operations: Operation[]): Operation[] {
+  const field = '/metadata/dspace.agreements.cookies';
+  return operations.filter((operation) =>
+    (operation.op === 'add' || operation.op === 'replace' || operation.op === 'remove' || operation.op === 'test') &&
+    (operation.path === field || operation.path.startsWith(field + '/')),
+  );
+}
