# /etc/nexus-pix/pix.env  (root:nexus-pix, mode 0640). Never commit a filled copy.
KOHA_API_BASE=https://biblioteca.exemplo.br/api/v1
KOHA_OPAC_BASE=https://biblioteca.exemplo.br
# Dedicated Koha API user with only the permissions to read patrons/accounts and post credits.
KOHA_API_USER=nexus-pix
KOHA_API_PASSWORD=troque-por-uma-senha-longa
# One capturing group: the card number as printed on the OPAC account page. Confirm it on your OPAC.
KOHA_CARDNUMBER_RE=data-cardnumber="([^"]+)"
PIX_PROVIDER_URL=https://psp.exemplo.com.br/pix/cob
PIX_PROVIDER_TOKEN=token-do-psp
# At least 32 characters; must match the secret configured at the bank/PSP.
PIX_WEBHOOK_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
PIX_DB_PATH=/var/lib/nexus-pix/charges.db
PIX_MAX_AMOUNT=500.00
PIX_CHARGE_TTL=3600
PIX_CREDIT_TYPE=PAYMENT
# Leave empty unless your Koha authorised values include a payment type for Pix.
PIX_CREDIT_PAYMENT_TYPE=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8790
