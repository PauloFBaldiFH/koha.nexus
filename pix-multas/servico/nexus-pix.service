# /etc/systemd/system/nexus-pix.service  (root:root, mode 0644)
[Unit]
Description=Koha.Nexus Pix fine payments (webhook and charges)
After=network-online.target
Wants=network-online.target

[Service]
User=nexus-pix
Group=nexus-pix
EnvironmentFile=/etc/nexus-pix/pix.env
ExecStart=/usr/bin/python3 -I /opt/nexus-pix/pix_webhook.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nexus-pix

[Install]
WantedBy=multi-user.target
