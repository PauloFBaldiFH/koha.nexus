#!/bin/bash
# Test double for Koha's command-line tools (koha-plack, koha-zebra, ...).
# Installed by tests/run.sh as symlinks in /usr/sbin, on disposable test
# machines only. State lives in /run/kei-mock:
#   calls.log      every invocation ("koha-plack --start library")
#   run/<svc>      the service is "running"
#   fail/<tool>    make that tool fail (exit 1)
#   daemons.pids   detached processes started by "--start", like the real
#                  daemons (they inherit the caller's open descriptors)
S=/run/kei-mock
name=$(basename "$0")
mkdir -p "$S/run" "$S/fail"
printf '%s %s\n' "$name" "$*" >> "$S/calls.log"
[ -e "$S/fail/$name" ] && { echo "$name: simulated failure" >&2; exit 1; }

action=""
for a in "$@"; do
    case "$a" in --start|--stop|--restart|--status|--enable|--disable|--rebuild) action="$a" ;; esac
done

svc=""
case "$name" in
    koha-plack)            svc=plack ;;
    koha-zebra)            svc=zebra ;;
    koha-indexer)          svc=indexer ;;
    koha-es-indexer)       svc=es-indexer ;;
    koha-worker)           svc=worker ;;
    koha-sip)              svc=sip ;;
    koha-z3950-responder)  svc=z3950 ;;
esac

if [ -n "$svc" ]; then
    case "$action" in
        --start|--restart)
            touch "$S/run/$svc"
            # Like Starman/daemon(1): detach but keep inherited descriptors.
            # (fd 3 is the test runner's own pipe, not part of the simulation)
            setsid sleep 600 </dev/null >/dev/null 2>&1 3>&- &
            echo $! >> "$S/daemons.pids"
            ;;
        --stop)   rm -f "$S/run/$svc" ;;
        --status) if [ -e "$S/run/$svc" ]; then echo "$svc running"; else echo "$svc not running"; exit 1; fi ;;
    esac
    exit 0
fi

case "$name" in
    koha-list) echo library ;;
    koha-shell)
        # koha-shell INSTANCE -c "command": like the real one (Perl), the
        # command is wrapped in single quotes for the instance user's shell
        # and the whole line goes through /bin/sh. Runs as root (tests only),
        # with the Koha Perl doubles of tests/mocks/perl5 on @INC.
        shift
        [ "${1:-}" = "-c" ] && { shift; exec /bin/sh -c "env KOHA_CONF=/etc/koha/sites/library/koha-conf.xml PERL5LIB=/usr/local/lib/kei-mock/perl5 /bin/bash -c '$*'"; }
        ;;
    koha-mysql)
        # koha-mysql INSTANCE [mysql options]: SQL from stdin, Koha's database.
        shift
        exec mysql --default-character-set=utf8mb4 koha_library "$@"
        ;;
    koha-email-enable)
        mkdir -p "/var/lib/koha/$1" && touch "/var/lib/koha/$1/email.enabled"
        echo "Enabled email for instance $1."
        ;;
esac
exit 0
